  "narrative": {
    "northStar": "蓝色研究纸面",
    "overview": "案卷以明亮、可信、精致的研究工具为视觉基调。浅蓝工作区承托连续白色阅读面，正文、来源元数据、原文和核查判断通过留白、细线和文字层级区分。\n\n蓝色承担导航、操作和定位；状态文字与保存的真实语义共同表达执行及证据情况。保留已有本地字体，中文使用系统回退。当前实现没有图片素材。",
    "keyCharacteristics": [
      "浅蓝工作区与白色连续纸面",
      "正文优先、细目录辅助",
      "文本说明与语义颜色并用",
      "可见键盘焦点与减少动效"
    ],
    "rules": [
      {
        "name": "The Saved Meaning Rule",
        "body": "状态颜色只解释已保存的语义；来源身份、读取成功和证据成立分别表达。",
        "section": "colors"
      },
      {
        "name": "The Continuous Reading Rule",
        "body": "元数据和引用保留在连续阅读上下文中，用分隔与层级组织，避免把每段材料拆成同权卡片。",
        "section": "typography"
      },
      {
        "name": "The Flat Paper Rule",
        "body": "默认不用阴影；通过纸面与工作区的色差、边线及留白表达层级。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 保留“案卷”名称、本地字体和系统中文回退。",
      "Do 使用真实状态文字、44px 重要交互目标、可见焦点与长 URL 换行。",
      "Do 沿保存的引用映射定位，保留返回回答的路径。",
      "Do 在窄屏将阅读目录移到正文上方，并让元数据单列。"
    ],
    "donts": [
      "Don't 用官方来源身份或读取成功的颜色暗示主张已被证明。",
      "Don't 为视觉填充虚构菜单、指标、进度、来源或调查结果。",
      "Don't 用整屏同质卡片替代正文与原文的连续阅读。",
      "Don't 引入字体安装或将测试材料表现为真实调查结论。"
    ]
  }
}
