generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InvestigationStatus {
  PENDING
  RUNNING
  AWAITING_CONFIRMATION
  SUCCEEDED
  FAILED
  CANCELLED
}

enum InvestigationStage {
  CREATED
  IDENTITY
  RETRIEVAL
  SOURCE_FETCH
  VERIFICATION
  ANSWER
  COMPLETED
}

enum JobStatus {
  PENDING
  RUNNING
  AWAITING_CONFIRMATION
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AttemptStatus {
  RUNNING
  AWAITING_CONFIRMATION
  SUCCEEDED
  FAILED
  LEASE_EXPIRED
}

model Investigation {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question         String              @db.VarChar(4000)
  researchDepth    String              @default("AUTO") @db.VarChar(16)
  status           InvestigationStatus @default(PENDING)
  stage            InvestigationStage  @default(CREATED)
  error            Json?               @db.JsonB
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  startedAt        DateTime?           @db.Timestamptz(3)
  completedAt      DateTime?           @db.Timestamptz(3)
  resultSnapshotId String?             @unique @db.Uuid
  resultSnapshot   EvidenceSnapshot?   @relation("CurrentResult", fields: [resultSnapshotId, id], references: [id, investigationId], onDelete: Restrict, onUpdate: NoAction)
  snapshots        EvidenceSnapshot[]  @relation("InvestigationSnapshots")
  jobs             Job[]

  @@unique([resultSnapshotId, id])
  @@index([status, createdAt])
}

model Job {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  investigationId     String             @unique @db.Uuid
  investigation       Investigation      @relation(fields: [investigationId], references: [id], onDelete: Restrict)
  idempotencyKey      String             @unique @db.VarChar(200)
  requestHash         String             @db.Char(64)
  status              JobStatus          @default(PENDING)
  availableAt         DateTime           @default(now()) @db.Timestamptz(3)
  attemptCount        Int                @default(0)
  failureCount        Int                @default(0)
  manualRetryCount    Int                @default(0)
  maxAttempts         Int                @default(3)
  leaseOwner          String?
  leaseExpiresAt      DateTime?          @db.Timestamptz(3)
  heartbeatAt         DateTime?          @db.Timestamptz(3)
  runDeadlineAt       DateTime?          @db.Timestamptz(3)
  executionToken      String?            @unique @db.Uuid
  lastError           Json?              @db.JsonB
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  completedAt         DateTime?          @db.Timestamptz(3)
  confirmationRequest Json?              @db.JsonB
  confirmedIdentity   Json?              @db.JsonB
  completionHash      String?            @db.Char(64)
  publishedSnapshotId String?            @unique @db.Uuid
  publishedSnapshot   EvidenceSnapshot?  @relation("JobPublication", fields: [publishedSnapshotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attempts            ExecutionAttempt[]

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([investigationId, createdAt])
}

model ExecutionAttempt {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId          String             @db.Uuid
  job            Job                @relation(fields: [jobId], references: [id], onDelete: Restrict)
  attemptNumber  Int
  executionToken String             @unique @db.Uuid
  workerId       String
  status         AttemptStatus      @default(RUNNING)
  stage          InvestigationStage @default(CREATED)
  startedAt      DateTime           @default(now()) @db.Timestamptz(3)
  heartbeatAt    DateTime           @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?          @db.Timestamptz(3)
  error          Json?              @db.JsonB

  @@unique([jobId, attemptNumber])
  @@index([jobId, startedAt])
}

model EvidenceSnapshot {
  id               String             @id @db.Uuid
  investigationId  String             @db.Uuid
  investigation    Investigation      @relation("InvestigationSnapshots", fields: [investigationId], references: [id], onDelete: Restrict)
  version          Int
  parentSnapshotId String?            @db.Uuid
  parent           EvidenceSnapshot?  @relation("SnapshotHistory", fields: [parentSnapshotId, investigationId], references: [id, investigationId], onDelete: Restrict, onUpdate: NoAction)
  children         EvidenceSnapshot[] @relation("SnapshotHistory")
  contractVersion  String             @db.VarChar(32)
  body             Json               @db.JsonB
  generatedAt      DateTime           @db.Timestamptz(3)
  currentFor       Investigation?     @relation("CurrentResult")
  answers          Answer[]
  advice           Advice[]
  publishedBy      Job?               @relation("JobPublication")

  @@unique([investigationId, version])
  @@unique([id, investigationId])
  @@index([parentSnapshotId, investigationId])
}

model Answer {
  id          String           @id @db.Uuid
  snapshotId  String           @db.Uuid
  snapshot    EvidenceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  body        Json             @db.JsonB
  generatedAt DateTime         @db.Timestamptz(3)

  @@index([snapshotId, generatedAt])
}

model Advice {
  id          String           @id @db.Uuid
  snapshotId  String           @db.Uuid
  snapshot    EvidenceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  body        Json             @db.JsonB
  generatedAt DateTime         @db.Timestamptz(3)

  @@index([snapshotId, generatedAt])
}
