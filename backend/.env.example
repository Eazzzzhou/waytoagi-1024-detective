# 仅本地开发；由 Next、Worker 与 Prisma CLI 在服务端读取。
# 必填：开发/业务 PostgreSQL。下面的凭据仅匹配 infra/compose.yaml 的本地容器。
DATABASE_URL=postgresql://investigation:local_dev_only@localhost:55432/investigation?schema=public
# 运行测试时必填：必须是不同数据库名且以 _test 结尾。测试只在此库的随机 schema 写入夹具。
TEST_DATABASE_URL=postgresql://investigation:local_test_only@localhost:55433/investigation_test?schema=public
# 以下均可省略并使用所示默认值；单位为毫秒，次数为正整数。
# Worker 空闲及数据库断线后的轮询间隔。
WORKER_POLL_MS=1000
# 每次领取后的租约长度；续租必须在数据库租约到期前完成。
WORKER_LEASE_MS=30000
# 必须小于 lease/timeout 较小值的一半；只影响 Worker，不影响 Web 读取状态。
WORKER_HEARTBEAT_MS=10000
# 单次尝试的硬截止时间；心跳不能越过此数据库截止点。
WORKER_TIMEOUT_MS=660000
# 入队时写入新 Job 的失败预算；改配置不会重置已有任务。
WORKER_MAX_ATTEMPTS=3
# 自动重试指数退避基数与上限；手动重试另有每项调查两次的固定上限。
WORKER_RETRY_BASE_MS=1000
WORKER_RETRY_MAX_MS=60000
# 收到 SIGINT/SIGTERM 后的关闭宽限；超出后退出，等待数据库租约回收。
WORKER_SHUTDOWN_GRACE_MS=10000
# 主模型：非流式 Chat Completions JSON mode；BASE_URL 不含 /chat/completions。
# 当前官方 DeepSeek 模型名已核对；实际返回版本另存快照 modelCalls。
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_API_KEY=
MODEL_TIMEOUT_MS=45000
MODEL_MAX_TOKENS=6000
# DeepSeek官方支持的显式开关；兼容服务不支持时留空/删除本项。
MODEL_THINKING=disabled
# 第二模型可选；未配置时明确 NOT_CONFIGURED，不声称完成独立复核。
# 配置后必须与主模型不同；建议 WORKER_TIMEOUT_MS=600000 留出复核预算。
# REVIEW_MODEL_BASE_URL=
# REVIEW_MODEL_NAME=
# REVIEW_MODEL_API_KEY=
# REVIEW_MODEL_TIMEOUT_MS=45000
# 禁止 NEXT_PUBLIC_ 密钥、提交 .env 或把密钥放入结果 JSON。

# A1 元宝搜索，二选一；文件支持包含唯一sk-服务密钥的腾讯云CSV。
TENCENTCLOUD_WSA_APIKEY=
## Optional: authenticated Tavily search; without it the API uses capped keyless access.
TAVILY_API_KEY=
TENCENTCLOUD_WSA_APIKEY_FILE=
# 默认留空。仅本机TUN映射域名到198.18/15时设local-tun；公开部署禁用。
COLLECTION_DNS_MODE=
# 可选人工元宝网页导入，必须匹配当次query，标记为半自动。
YUANBAO_IMPORT_PATH=
# 可选X官方API授权，未提供时X帖子返回RESTRICTED。
X_BEARER_TOKEN=
