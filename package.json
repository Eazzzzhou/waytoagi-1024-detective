{
  "name": "ai-investigation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p config/tsconfig.worker.json --noEmit",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:db": "vitest run --config config/vitest.db.config.ts",
    "test:runtime": "tsx scripts/acceptance/runtime.ts",
    "audit:bundles": "tsx scripts/acceptance/bundles.ts",
    "docs:check": "tsx scripts/acceptance/docs.ts",
    "d1:evaluate": "tsx scripts/d1/evaluate.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify": "npm run check && npm run test:db && npm run build && npm run test:runtime && npm run audit:bundles && npm run docs:check",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "investigation:enqueue": "tsx scripts/investigation/enqueue.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:test:migrate": "tsx scripts/db/migrate-test.ts",
    "db:up": "docker compose -f infra/compose.yaml up -d --wait postgres postgres-test",
    "db:stop": "docker compose -f infra/compose.yaml stop postgres postgres-test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cheerio": "1.1.2",
    "dotenv": "18.0.9",
    "jsdom": "30.1.3",
    "next": "16.4.3",
    "pg": "8.23.1",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
