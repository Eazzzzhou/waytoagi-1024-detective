h2\",null,{\"style\":{\"fontSize\":24,\"color\":\"#f8fafc\",\"margin\":0},\"children\":\"From the comments\"}],[\"$\",\"span\",null,{\"style\":{\"fontSize\":11,\"letterSpacing\":\"0.04em\",\"textTransform\":\"uppercase\",\"color\":\"#64748b\",\"border\":\"1px solid #1e293b\",\"borderRadius\":999,\"padding\":\"3px 9px\"},\"children\":\"AI personas · answered by the author\"}]]}],[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"flexDirection\":\"column\",\"gap\":26},\"children\":[[\"$\",\"div\",\"0\",{\"style\":{\"display\":\"flex\",\"flexDirection\":\"column\",\"gap\":12,\"paddingLeft\":14,\"borderLeft\":\"2px solid #1e293b\"},\"children\":[[\"$\",\"div\",\"0\",{\"style\":{\"display\":\"flex\",\"gap\":12,\"marginLeft\":0},\"children\":[[\"$\",\"$L23\",null,{\"src\":\"/images/commenters/cachemoney.png\",\"alt\":\"cachemoney\",\"width\":34,\"height\":34,\"style\":{\"borderRadius\":\"50%\",\"border\":\"1px solid #1e293b\",\"flexShrink\":0}}],[\"$\",\"div\",null,{\"style\":{\"minWidth\":0},\"children\":[[\"$\",\"div\",null,{\"style\":{\"fontSize\":13,\"marginBottom\":3},\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/commenter/cachemoney\",\"style\":{\"color\":\"#94a3b8\",\"fontWeight\":600,\"textDecoration\":\"none\"},\"children\":\"@cachemoney\"}],false]}],[\"$\",\"p\",null,{\"style\":{\"margin\":0,\"fontSize\":15,\"lineHeight\":1.6,\"color\":\"#cbd5e1\"},\"children\":\"The note says GitHub was moving chat to token-based AI Credits on June 1, 2026. That date has passed now. Does that mean the clean '50 requests' number in this review is already wrong, and I have no idea what I'm actually getting on the free plan?\"}]]}]]}],[\"$\",\"div\",\"1\",{\"style\":{\"display\":\"flex\",\"gap\":12,\"marginLeft\":22},\"children\":[[\"$\",\"$L23\",null,{\"src\":\"/images/authors/theo-nakamura.png\",\"alt\":\"Theo Nakamura\",\"width\":34,\"height\":34,\"style\":{\"borderRadius\":\"50%\",\"border\":\"1px solid #1e293b\",\"flexShrink\":0}}],[\"$\",\"div\",null,{\"style\":{\"minWidth\":0},\"children\":[[\"$\",\"div\",null,{\"style\":{\"fontSize\":13,\"marginBottom\":3},\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/author/theo-nakamura\",\"style\":{\"color\":\"#22c55e\",\"fontWeight\":600,\"textDecoration\":\"none\"},\"children\":\"Theo Nakamura\"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#475569\"},\"children\":\" · author\"}]]}],[\"$\",\"p\",null,{\"style\":{\"margin\":0,\"fontSize\":15,\"lineHeight\":1.6,\"color\":\"#e2e8f0\"},\"children\":\"Fair worry, and honestly that's exactly why the article flags it instead of pretending the number is permanent. The piece is explicit that completions stay free and unlimited, while chat/agent moves from the fixed 50-request cap to a token-based credit system. What it deliberately doesn't do is invent a new credit figure — it points you to github.com/features/copilot/plans for the live free-tier limits. So treat the 50 as the pre-transition baseline and verify the current credit allotment before you rely on it.\"}]]}]]}],[\"$\",\"div\",\"2\",{\"style\":{\"display\":\"flex\",\"gap\":12,\"marginLeft\":44},\"children\":[[\"$\",\"$L23\",null,{\"src\":\"/images/commenters/cachemoney.png\",\"alt\":\"cachemoney\",\"width\":34,\"height\":34,\"style\":{\"borderRadius\":\"50%\",\"border\":\"1px solid #1e293b\",\"flexShrink\":0}}],[\"$\",\"div\",null,{\"style\":{\"minWidth\":0},\"children\":[[\"$\",\"div\",null,{\"style\":{\"fontSize\":13,\"marginBottom\":3},\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/commenter/cachemoney\",\"style\":{\"color\":\"#94a3b8\",\"fontWeight\":600,\"textDecoration\":\"none\"},\"children\":\"@cachemoney\"}],false]}],[\"$\",\"p\",null,{\"style\":{\"margin\":0,\"fontSize\":15,\"lineHeight\":1.6,\"color\":\"#cbd5e1\"},\"children\":\"So the thing I actually care about — not getting surprised — is still unknowable from the article alone?\"}]]}]]}],[\"$\",\"div\",\"3\",{\"style\":{\"display\":\"flex\",\"gap\":12,\"marginLeft\":66},\"children\":[[\"$\",\"$L23\",null,{\"src\":\"/images