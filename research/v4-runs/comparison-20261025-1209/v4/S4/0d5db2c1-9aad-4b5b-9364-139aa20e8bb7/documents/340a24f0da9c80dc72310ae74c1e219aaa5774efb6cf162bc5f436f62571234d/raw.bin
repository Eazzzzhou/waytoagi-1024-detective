    (function () {
      function bindClearFix() {
        if (!window.jQuery) return;
        var $ = window.jQuery;
        var sel = '#csdn-toolbar .toolbar-search .clear-icon';
        $(document)
          .off('mousedown.blogDetailSearchClear', sel)
          .on('mousedown.blogDetailSearchClear', sel, function (e) {
            e.preventDefault();
          });
      }
      if (window.jQuery) {
        window.jQuery(bindClearFix);
        window.jQuery(document).on('toolbarReady', bindClearFix);
      } else {
        document.addEventListener('DOMContentLoaded', bindClearFix);
      }
    })();
    </script>
