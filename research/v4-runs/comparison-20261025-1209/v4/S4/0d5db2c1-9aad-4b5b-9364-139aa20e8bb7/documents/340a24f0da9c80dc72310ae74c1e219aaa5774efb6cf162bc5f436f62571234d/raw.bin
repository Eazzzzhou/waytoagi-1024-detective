.csdn-taotoken-motion {
  --tao-ease: cubic-bezier(.22,.68,.22,1);
  --tao-scale: 1;
  position: relative;
  display: block;
  width: 100%;
  height: min(660px, calc(100dvh - 64px)) !important;
  overflow: hidden;
  isolation: isolate;
  cursor: pointer;
  text-decoration: none !important;
  color: #745239;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
  pointer-events: auto;
}
.csdn-taotoken-motion:focus-visible { outline: 2px solid #745239; outline-offset: -3px; }
.csdn-taotoken-motion *, .csdn-taotoken-motion *::before { box-sizing: border-box; }
.csdn-taotoken-motion img { display: block; max-width: none !important; height: auto !important; object-fit: contain !important; border: 0; user-select: none; -webkit-user-drag: none; }
.csdn-taotoken-motion__stage { position: absolute; top: 0; pointer-events: none; }
.csdn-taotoken-motion--left { height: min(860px, calc(100dvh - 64px)) !important; }
.csdn-taotoken-motion--left .csdn-taotoken-motion__stage {
  width: 320px; height: 860px; right: 0;
  transform: scale(var(--tao-scale)); transform-origin: right top;
}
.csdn-taotoken-motion__brand {
  position: absolute; top: 46px; left: 75px; z-index: 8;
  color: #745239;
  display: flex; gap: 8px; align-items: center;
  font: 600 25px/32px Arial, "PingFang SC", sans-serif;
  white-space: nowrap; opacity: .5; transition: opacity 400ms var(--tao-ease);
}
.csdn-taotoken-motion__mark { display: block; width: 26px; height: 26px; flex: 0 0 26px; }
.csdn-taotoken-motion__cards {
  position: absolute; inset: 0; opacity: .49;
  transition: opacity 400ms var(--tao-ease);
  -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 65%, transparent 100%);
  mask-image: linear-gradient(90deg, #000 0%, #000 65%, transparent 100%);
}
.csdn-taotoken-motion__card {
  position: absolute; left: 0; top: 0; width: 280px !important; height: auto;
  transform-origin: 0 0;
  transform: translate(var(--rest-x), var(--rest-y)) rotate(var(--angle));
  transition: transform 420ms var(--tao-ease);
  filter: drop-shadow(-8px 10px 12px rgb(84 52 24 / .08));
}
.csdn-taotoken-motion--left:is(:hover, :focus-visible, .is-preview-active) .csdn-taotoken-motion__card {
  transform: translate(var(--open-x), var(--open-y)) rotate(var(--angle));
}
.csdn-taotoken-motion--left:is(:hover, :focus-visible, .is-preview-active) :is(.csdn-taotoken-motion__cards, .csdn-taotoken-motion__brand) { opacity: 1; }

.csdn-taotoken-motion--right .csdn-taotoken-motion__stage {
  width: 360px; height: 500px; left: 0;
  transform: scale(var(--tao-scale)); transform-origin: left top;
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 100%);
  mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 100%);
}
.csdn-taotoken-motion__title {
  position: absolute; left: 45px; top: 66px; width: 210px !important; height: auto;
  /* Keep the text's left-to-right fade independent of stage size and position. */
  -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / .15) 0%, #000 55%);
  mask-image: linear-gradient(90deg, rgb(0 0 0 / .15) 0%, #000 55%);
  opacity: .3; transform: translate(0, 0) scale(1); transform-origin: 0 50%;
  transition: transform 320ms var(--tao-ease) 160ms, opacity 300ms ease 160ms;
}
.csdn-taotoken-motion__composition { position: absolute; inset: 0; }
.csdn-taotoken-motion__main {
  position: absolute; left: 8px; top: 142px; width: 325px !important; height: auto;
  z-index: 4; opacity: 0;
  transform: translate(-25px, -56px) scale(.2); transform-origin: 30% 35%;
  transition: transform 330ms var(--tao-ease) 160ms, opacity 270ms ease 160ms;
}
.csdn-taotoken-motion__decor {
  position: absolute; inset: 0; opacity: 0;
  transform: scale(.18) rotate(var(--tao-enter-angle, 0deg)); transform-origin: 165px 231px;
  transition: transform 180ms var(--tao-ease), opacity 150ms ease;
}
.csdn-taotoken-motion__decor img { position: absolute; height: auto; }
/* Opposing entrance turns settle back to the original supplied composition. */
.csdn-taotoken-motion__ribbons { z-index: 1; --tao-enter-angle: 7deg; }
