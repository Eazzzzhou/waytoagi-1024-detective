    <script>
    (function () {
      var prep = window.__CSDN_BLOG_SIDEBAR_PREP__ || {};
      var drawer = !!prep.drawer;
      var collapsed = prep.collapsed !== false;
      var body = document.body;
      body.classList.add('csdn-sidebar-prep');
      body.classList.remove(
        'csdn-sidebar-mode-collapse',
        'csdn-sidebar-mode-drawer',
        'csdn-sidebar-expanded',
        'csdn-sidebar-collapsed',
        'csdn-sidebar-hidden'
      );
      if (drawer) {
        body.classList.add('csdn-sidebar-mode-drawer', 'csdn-sidebar-hidden');
      } else {
        body.classList.add('csdn-sidebar-mode-collapse');
        body.classList.add(collapsed ? 'csdn-sidebar-collapsed' : 'csdn-sidebar-expanded');
      }
    })();
    </script>
