<script>
(function () {
  var prep = window.__CSDN_BLOG_SIDEBAR_PREP__ || {};
  var root = document.getElementById('csdn-blog-sidebar');
  if (!root) {
    return;
  }
  var drawer = !!prep.drawer;
  var collapsed = prep.collapsed !== false;
