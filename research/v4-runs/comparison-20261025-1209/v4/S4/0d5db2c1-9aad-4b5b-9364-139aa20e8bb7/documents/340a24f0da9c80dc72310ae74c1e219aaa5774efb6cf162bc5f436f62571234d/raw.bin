      #csdn-toolbar .toolbar-search .toolbar-search-container {
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
        width: 100% !important;
        height: 32px !important;
        padding: 0 4px 0 16px !important;
        gap: 0 !important;
        border-radius: 100px !important;
      }
      #csdn-toolbar .toolbar-search:focus-within .toolbar-search-container,
      #csdn-toolbar .toolbar-search .toolbar-search-container.is-focus {
        padding: 0 2px 0 16px !important;
      }
      #csdn-toolbar .toolbar-search .toolbar-search-container input {
        flex: 1 1 auto !important;
        width: auto !important;
        min-width: 0 !important;
        height: 100% !important;
        margin-right: 0 !important;
        padding-right: 0 !important;
        text-indent: 0 !important;
        border: 0 none !important;
        border-radius: 0 !important;
        background: transparent !important;
        font-size: 14px !important;
      }
      #csdn-toolbar .toolbar-search .toolbar-search-container input:focus {
        border: 0 none !important;
      }
      #csdn-toolbar .toolbar-search .toolbar-search-container .icon-fire {
        left: 16px !important;
      }
      #csdn-toolbar .toolbar-search .toolbar-search-container input.input-fire-hidden,
      #csdn-toolbar .toolbar-search.onlySearch .toolbar-search-container input {
        text-indent: 0 !important;
      }
      #csdn-toolbar .toolbar-search .toolbar-search-container .icon-fire + input,
      #csdn-toolbar .toolbar-search .toolbar-search-container:has(.icon-fire:not(.icon-fire-hidden)) input {
        text-indent: 20px !important;
      }
      #csdn-toolbar .toolbar-search .toolbar-search-container .gradient {
        display: none !important;
      }
      #csdn-toolbar .toolbar-search .toolbar-search-container .clear-icon {
        position: static !important;
        transform: none !important;
        flex: 0 0 18px !important;
        width: 18px !important;
        height: 18px !important;
        margin: 0 4px 0 auto !important;
        display: inline-block !important;
        cursor: pointer;
        z-index: 2;
      }
      #csdn-toolbar .toolbar-search #toolbar-search-button {
        flex: 0 0 40px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 40px !important;
        min-width: 40px !important;
        height: 28px !important;
        margin: 0 0 0 auto !important;
        padding: 0 !important;
        border-radius: 100px !important;
        background-color: #FC5531 !important;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease, background-color 0.2s ease;
      }
      #csdn-toolbar .toolbar-search .toolbar-search-container:has(.clear-icon) #toolbar-search-button {
        margin-left: 0 !important;
      }
      #csdn-toolbar .toolbar-search:focus-within #toolbar-search-button,
      #csdn-toolbar .toolbar-search .toolbar-search-container.is-focus #toolbar-search-button {
        opacity: 1;
        pointer-events: auto;
      }
