        {
          "start": 268,
          "end": 274,
          "cells": [
            {
              "start": 268,
              "end": 272,
              "text": "帐户类型",
              "header": true,
              "rowSpan": 1,
              "colSpan": 1
            },
            {
              "start": 272,
              "end": 274,
              "text": "选项",
              "header": true,
              "rowSpan": 1,
              "colSpan": 1
            }
          ]
        },
        {
          "start": 274,
          "end": 438,
          "cells": [
            {
              "start": 274,
              "end": 278,
              "text": "个人帐户",
              "header": false,
              "rowSpan": 1,
              "colSpan": 1
            },
            {
              "start": 278,
              "end": 438,
              "text": "Copilot Pro： $10 USD 每个日历月。Copilot Pro+： $39 USD 每个日历月。Copilot Max： $100 USD 每个日历月。Copilot Student：不收取任何费用访问 Copilot 高级功能。Copilot Free：对 Copilot功能的访问权限有限，且无需费用。",
              "header": false,
              "rowSpan": 1,
              "colSpan": 1
            }
          ]
        },
        {
          "start": 438,
          "end": 479,
          "cells": [
            {
              "start": 438,
              "end": 440,
              "text": "组织",
              "header": false,
              "rowSpan": 1,
              "colSpan": 1
            },
            {
              "start": 440,
              "end": 479,
              "text": "Copilot Business： $19 USD 每个用户每月（按月计费）。",
              "header": false,
              "rowSpan": 1,
              "colSpan": 1
            }
          ]
        },
        {
          "start": 479,
          "end": 548,
          "cells": [
            {
              "start": 479,
              "end": 481,
              "text": "企业",
              "header": false,
              "rowSpan": 1,
              "colSpan": 1
            },
            {
              "start": 481,
              "end": 548,
              "text": "选择 Copilot Business 或 Copilot Enterprise，或在组织之间混合它们。 两者按月计费，定价各不相同。",
              "header": false,
              "rowSpan": 1,
              "colSpan": 1
            }
          ]
        }
      ]
    }
  ]
