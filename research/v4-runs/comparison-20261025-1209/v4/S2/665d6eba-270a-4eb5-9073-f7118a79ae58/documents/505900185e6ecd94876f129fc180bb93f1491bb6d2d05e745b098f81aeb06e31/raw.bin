how-tos/set-up-payment/manage-enterprise-invoice","title":"管理企业发票","childPages":[]},{"href":"/zh/billing/how-tos/set-up-payment/india-one-time-payments","title":"印度付款","childPages":[]}]},{"href":"/zh/billing/how-tos/manage-plan-and-licenses","title":"管理方案和许可证","childPages":[{"href":"/zh/billing/how-tos/manage-plan-and-licenses/upgrade-plan","title":"升级计划","childPages":[]},{"href":"/zh/billing/how-tos/manage-plan-and-licenses/downgrade-plan","title":"降级计划","childPages":[]},{"href":"/zh/billing/how-tos/manage-plan-and-licenses/change-billing-cycle","title":"更改计费周期","childPages":[]},{"href":"/zh/billing/how-tos/manage-plan-and-licenses/manage-pending-changes","title":"管理待处理的更改","childPages":[]},{"href":"/zh/billing/how-tos/manage-plan-and-licenses/view-enterprise-usage","title":"查看企业使用情况","childPages":[]},{"href":"/zh/billing/how-tos/manage-plan-and-licenses/manage-user-licenses","title":"管理用户许可证","childPages":[]}]},{"href":"/zh/billing/how-tos/set-up-budgets","title":"设置预算","childPages":[]},{"href":"/zh/billing/how-tos/products","title":"产品","childPages":[{"href":"/zh/billing/how-tos/products/view-productlicense-use","title":"查看产品/许可证的使用情况","childPages":[]},{"href":"/zh/billing/how-tos/products/download-license-use","title":"下载许可证使用情况","childPages":[]},{"href":"/zh/billing/how-tos/products/buy-advanced-security","title":"购买高级安全性","childPages":[]},{"href":"/zh/billing/how-tos/products/estimate-spending","title":"查看和估计支出","childPages":[]},{"href":"/zh/billing/how-tos/products/use-cost-centers","title":"使用成本中心","childPages":[]},{"href":"/zh/billing/how-tos/products/manage-ghas-licenses","title":"管理 GHAS 许可证","childPages":[]},{"href":"/zh/billing/how-tos/products/disable-ghas-for-enterprise","title":"禁用企业版 GitHub 高级安全功能 (GHAS)","childPages":[]}]},{"href":"/zh/billing/how-tos/pay-third-parties","title":"向第三方付款","childPages":[{"href":"/zh/billing/how-tos/pay-third-parties/upgrade-marketplace-app","title":"升级市场应用","childPages":[]},{"href":"/zh/billing/how-tos/pay-third-parties/downgrade-marketplace-app","title":"市场应用降级","childPages":[]},{"href":"/zh/billing/how-tos/pay-third-parties/cancel-marketplace-app","title":"取消市场应用","childPages":[]},{"href":"/zh/billing/how-tos/pay-third-parties/upgrade-sponsorship","title":"赞助升级","childPages":[]},{"href":"/zh/billing/how-tos/pay-third-parties/downgrade-sponsorship","title":"赞助降级","childPages":[]},{"href":"/zh/billing/how-tos/pay-third-parties/cancel-sponsorship","title":"取消赞助","childPages":[]},{"href":"/zh/billing/how-tos/pay-third-parties/end-sponsorship","title":"结束赞助","childPages":[]}]},{"href":"/zh/billing/how-tos/manage-for-client","title":"为客户端管理","childPages":[{"href":"/zh/billing/how-tos/manage-for-client/create-client-org","title":"创建客户组织","childPages":[]},{"href":"/zh/billing/how-tos/manage-for-client/create-client-enterprise","title":"创建客户端企业","childPages":[]},{"href":"/zh/billing/how-tos/manage-for-client/create-as-csp-partner","title":"创建为 CSP 合作伙伴","childPages":[]},{"href":"/zh/billing/how-tos/manage-for-client/manage-client-org","title":"管理客户端组织","childPages":[]}]},{"href":"/zh/billing/how-tos/troubleshooting","title":"故障排除","childPages":[{"href":"/zh/billing/how-tos/troubleshooting/declined-card","title":"银行卡被拒绝","childPages":[]},{"href":"/zh/billing/how-tos/troubleshooting/authorization-holds","title":"授权冻结","childPages":[]},{"href":"/zh/billing/how-tos/troubleshooting/locked-account","title":"已锁定的帐户","childPages":[]},{"href":"/zh/billing/how-tos/troubleshooting/azure-sub-connection","title":"Azure子连接","childPages":[]},{"href":"/zh/billing/how-tos/troubleshooting/enterprise-license-usage","title":"企业许可证使用情况","childPages":[]}]}]},{"href":"/zh/billing/reference","title":"参考","childPages":[{"href":"/zh/billing/reference/actions-runner-pricing","title":"Actions 运行程序定价","childPages":[]},{"href":"/zh/billing/reference/azure-billing","title":"Azure计费","childPages":[]},{"href":"/zh/billing/reference/azure-subscription","title":"Azure订阅","childPages":[]},{"href":"/zh/billing/reference/billing-reports","title":"账单报告","childPages":[]},{"href":"/zh/billing/reference/billing-roles","title":"计费角色","childPages":[]},{"href":"/zh/billing/reference/cost-center-allocation","title":"成本中心分配","childPages":[]},{"href":"/zh/billing/reference/github-license-users","title":"GitHub许可证用户","childPages":[]},{"href":"/zh/billing/reference/license-reports","title":"许可证报告","childPages":[]},{"href":"/zh/billing/reference/product-and-sku-names","title":"产品和 SKU 名称","childPages":[]},{"href":"/zh/billing/reference/product-usage-included","title":"产品使用情况包括在内","childPages":[]},{"href":"/zh/billing/reference/supported-payment-methods","title":"支持的付款方式","childPages":[]}]},{"href":"/zh/billing/tutorials","title":"教程","childPages":[{"href":"/zh/billing/tutorials/automate-usage-reporting","title":"自动报告使用情况","childPages":[]},{"href":"/zh/billing/tutorials/soft-budgets","title":"使用软预算监视成本","childPages":[]},{"href":"/zh/billing/tutorials/control-costs-at-scale","title":"在大规模情况下控制成本","childPages":[]},{"href":"/zh/billing/tutorials/gather-insights","title":"收集见解","childPages":[]}]}],"layout":"discovery-landing"},"status":200,"xHost":"docs.github.com"},"articleContext":{"title":"GitHub Copilot许可证","intro":"\u003cp\u003e了解Copilot许可证是如何工作的，包括使用情况的测量和预算的管理。\u003c/p\u003e","effectiveDate":"","renderedPage":"\u003cp\u003eGitHub Copilot 的使用情况通过许可证和 AI credits 来衡量。 请参阅 \u003ca href=\"/zh/copilot/concepts/billing-and-usage/individuals/billing\"\u003e个人基于使用情况的计费\u003c/a\u003e 和 \u003ca href=\"/zh/copilot/concepts/billing-and-usage/organizations-and-enterprises/billing\"\u003e组织和企业的基于使用情况的计费\u003c/a\u003e。\u003c/p\u003e\n\u003ch2 id=\"licenses-for-copilot\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#licenses-for-copilot\"\u003e针对Copilot的许可证\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eCopilot 每个使用 Copilot的用户都需要许可证。 根据帐户类型，许可证可通过不同的计划获得。\u003c/p\u003e\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003ctable aria-labelledby=\"licenses-for-copilot\"\u003e\u003cthead\u003e\u003ctr\u003e\u003cth scope=\"col\"\u003e帐户类型\u003c/th\u003e\u003cth scope=\"col\"\u003e选项\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003e个人帐户\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003e\u003cul\u003e\u003cli\u003eCopilot Pro： $10 USD 每个日历月。\u003c/li\u003e\u003cli\u003eCopilot Pro+： $39 USD 每个日历月。\u003c/li\u003e\u003cli\u003eCopilot Max： $100 USD 每个日历月。\u003c/li\u003e\u003cli\u003eCopilot Student：不收取任何费用访问 Copilot 高级功能。\u003c/li\u003e\u003cli\u003eCopilot Free：对 Copilot功能的访问权限有限，且无需费用。\u003c/li\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003e组织\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eCopilot Business： $19 USD 每个用户每月（按月计费）。\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003e企业\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003e选择 Copilot Business 或 Copilot Enterprise，或在组织之间混合它们。 两者按月计费，定价各不相同。\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\n\u003cdiv class=\"ghd-alert ghd-alert-accent\" data-container=\"alert\"\u003e\u003cp class=\"ghd-alert-title\"\u003e\u003csvg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon mr-2\" aria-hidden\u003e\u003cpath d=\"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z\"\u003e\u003c/path\u003e\u003c/svg\u003e注意\u003c/p\u003e\n\u003cp\u003e 如果你当前有有效的Copilot Pro、Copilot Pro+或Copilot Max计划，随后又被分配到Copilot Business或Copilot Enterprise计划中的一个席位，你的个人Copilot计划将被自动取消。 你将收到个人计划当前计费周期剩余部分的按比例退款。 然后，可以根据公司设置的策略继续使用 Copilot 。\u003c/p\u003e\n\u003c/div\u003e\n\u003ch2 id=\"free-use-of-copilot\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#free-use-of-copilot\"\u003e免费使用 Copilot\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003e有多种方法可供免费使用 Copilot 。\u003c/p\u003e\n\u003ch3 id=\"copilot-free\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#copilot-free\"\u003eCopilot Free\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e提供对 Copilot 功能的有限访问，且不收费。\u003c/li\u003e\n\u003cli\u003e包含每月定额的代码补全次数，以及限量的聊天与智能体使用次数。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e仅供个人使用\u003c/strong\u003e（不适用于组织或企业）。\u003c/li\u003e\n\u003cli\u003e对于超出免费计划限制的使用情况，请升级到 Copilot Pro。\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 id=\"educational-and-open-source-benefits\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#educational-and-open-source-benefits\"\u003e教育和开源优势\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eCopilot Student为已验证的学生提供Copilot的免费高级功能。 请参阅“\u003ca href=\"/zh/copilot/how-tos/copilot-on-github/set-up-copilot/enable-copilot/set-up-for-students\"\u003e以学生身份免费访问GitHub Copilot\u003c/a\u003e”。\u003c/li\u003e\n\u003cli\u003eCopilot Pro免费，可供受验证的教师和热门开放源代码项目的维护人员使用。 请参阅“\u003ca href=\"/zh/copilot/how-tos/copilot-on-github/set-up-copilot/enable-copilot/set-up-for-teachers-and-os-maintainers\"\u003e作为教师或开源维护者免费访问Copilot Pro\u003c/a\u003e”。\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2 id=\"how-usage-of-copilot-licenses-is-measured\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#how-usage-of-copilot-licenses-is-measured\"\u003e如何衡量许可证的 Copilot 使用情况\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003e许可证的 Copilot 使用情况按使用的席位数来衡量。\u003c/p\u003e\n\u003ch3 id=\"personal-accounts\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#personal-accounts\"\u003e个人帐户\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e升级会立即生效。 你将被收取新计划的全价，减去你为当前计划支付的金额。\u003c/li\u003e\n\u003cli\u003e降级在下一个计费周期开始时生效，通常不会按比例进行降级。\u003c/li\u003e\n\u003cli\u003e取消月度订阅计划将保持访问权限，直到当前计费周期结束，不会按比例退款。\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e有关计费和比例的详细信息，请参阅 \u003ca href=\"/zh/copilot/concepts/billing-and-usage/individuals/billing\"\u003e个人基于使用情况的计费\u003c/a\u003e。\u003c/p\u003e\n\u003ch3 id=\"organizations-and-enterprises\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#organizations-and-enterprises\"\u003e组织和企业\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e一个席位相当于给一位使用者的“许可证”。\u003c/li\u003e\n\u003cli\u003e组织和企业按每月计费周期结束时分配的席位数计费。\u003c/li\u003e\n\u003cli\u003e如果用户在同一企业中的多个组织中拥有席位，则每个周期仅对企业计费一次。\u003c/li\u003e\n\u003cli\u003e如果同时分配了一 Copilot Business 个席位和一个 Copilot Enterprise 席位，则只会对企业席位进行计费。\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e有关座位分配的详细信息，请参阅 \u003ca href=\"/zh/copilot/reference/copilot-billing/seat-assignment\"\u003eGitHub Copilot 席位分配\u003c/a\u003e。\u003c/p\u003e\n\u003ch2 id=\"using-more-than-your-plans-included-seats\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#using-more-than-your-plans-included-seats\"\u003e使用超过计划中包含的席位数\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003e个人计划与单个帐户相关联，不能包括额外的席位。 若要许可多个用户，请升级到组织计划。\u003c/p\u003e\n\u003cp\u003e对于 \u003cstrong\u003e组织和企业\u003c/strong\u003e：\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e可以随时分配其他 Copilot 席位。\u003c/li\u003e\n\u003cli\u003e对于当前计费周期的其余部分，其他席位会立即按比例计费。\u003c/li\u003e\n\u003cli\u003e分配的用户可以立即访问 Copilot 功能。\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e有关添加席位计费的详细信息，请参阅 \u003ca href=\"/zh/copilot/reference/copilot-billing/license-changes\"\u003e对 GitHub Copilot 许可证进行更改\u003c/a\u003e。\u003c/p\u003e\n\u003ch2 id=\"paying-for-copilot-licenses\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#paying-for-copilot-licenses\"\u003e支付 Copilot 许可证费用\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003e使用为 GitHub 帐户设置的付款方式支付其他许可证的费用。 请参阅“\u003ca href=\"/zh/billing/how-tos/set-up-payment/manage-payment-info\"\u003e管理付款和账单信息\u003c/a\u003e”。\u003c/p\u003e\n\u003ch2 id=\"managing-your-budget-for-copilot-licenses\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#managing-your-budget-for-copilot-licenses\"\u003e管理 Copilot 许可证的预算\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003e若要帮助管理许可证的预算 Copilot ，请考虑以下策略。\u003c/p\u003e\n\u003ch3 id=\"personal-accounts-1\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#personal-accounts-1\"\u003e个人帐户\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e可以为个人帐户设置预算，当预算达到 75%、90%、和 100% 时接收电子邮件警报。\u003c/li\u003e\n\u003cli\u003e预算有助于监视支出，但不会停止许可证费用。\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"ghd-alert ghd-alert-accent\" data-container=\"alert\"\u003e\u003cp class=\"ghd-alert-title\"\u003e\u003csvg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon mr-2\" aria-hidden\u003e\u003cpath d=\"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z\"\u003e\u003c/path\u003e\u003c/svg\u003e注意\u003c/p\u003e\n\u003cp\u003e Additional usage may be capped. If you use all AI credits available on your plan, we recommend upgrading to a higher plan.\u003c/p\u003e\n\u003c/div\u003e\n\u003cp\u003e有关使用预算控制支出的详细信息，请参阅 \u003ca href=\"/zh/billing/how-tos/set-up-budgets\"\u003e设置预算以控制按流量计费的产品的支出\u003c/a\u003e。\u003c/p\u003e\n\u003ch3 id=\"organizations-and-enterprises-1\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#organizations-and-enterprises-1\"\u003e组织和企业\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003e所有者和计费经理可以在用户、组织、成本中心和企业级设置预算，以监视和控制 AI credits 消耗。 请参阅“\u003ca href=\"/zh/copilot/tutorials/budgets/getting-started-with-budget-controls\"\u003e预算控制入门\u003c/a\u003e”。\u003c/p\u003e","renderedPageHast":{"type":"root","children":[{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"GitHub Copilot 的使用情况通过许可证和 AI credits 来衡量。 请参阅 "},{"type":"element","tagName":"a","properties":{"href":"/zh/copilot/concepts/billing-and-usage/individuals/billing"},"children":[{"type":"text","value":"个人基于使用情况的计费"}]},{"type":"text","value":" 和 "},{"type":"element","tagName":"a","properties":{"href":"/zh/copilot/concepts/billing-and-usage/organizations-and-enterprises/billing"},"children":[{"type":"text","value":"组织和企业的基于使用情况的计费"}]},{"type":"text","value":"。"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"licenses-for-copilot","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#licenses-for-copilot"},"children":[{"type":"text","value":"针对Copilot的许可证"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Copilot 每个使用 Copilot的用户都需要许可证。 根据帐户类型，许可证可通过不同的计划获得。"}]},{"type":"text","value":"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"},{"type":"element","tagName":"table","properties":{"ariaLabelledBy":"licenses-for-copilot"},"children":[{"type":"element","tagName":"thead","properties":{},"children":[{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[{"type":"text","value":"帐户类型"}]},{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[{"type":"text","value":"选项"}]}]}]},{"type":"element","tagName":"tbody","properties":{},"children":[{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"个人帐户"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"ul","properties":{},"children":[{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Copilot Pro： $10 USD 每个日历月。"}]},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Copilot Pro+： $39 USD 每个日历月。"}]},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Copilot Max： $100 USD 每个日历月。"}]},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Copilot Student：不收取任何费用访问 Copilot 高级功能。"}]},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Copilot Free：对 Copilot功能的访问权限有限，且无需费用。"}]}]}]}]},{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"组织"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Copilot Business： $19 USD 每个用户每月（按月计费）。"}]}]},{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"企业"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"选择 Copilot Business 或 Copilot Enterprise，或在组织之间混合它们。 两者按月计费，定价各不相同。"}]}]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName"