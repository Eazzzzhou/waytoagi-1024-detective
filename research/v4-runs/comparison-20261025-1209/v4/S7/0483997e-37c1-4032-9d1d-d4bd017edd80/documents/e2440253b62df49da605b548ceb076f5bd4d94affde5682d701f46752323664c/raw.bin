List\u002FFETCH",UPDATE_STATE:"@\u002Fview\u002Fuser\u002FdetailList\u002FeventList\u002FUPDATE_STATE",FETCH_MORE:"@\u002Fview\u002Fuser\u002FdetailList\u002FeventList\u002FFETCH_MORE",RESET:"@\u002Fview\u002Fuser\u002FdetailList\u002FeventList\u002FRESET"}},selfColumnList:{list:[],hasMore:a,skeleton:a,loading:a,cursor:f,actionType:{FETCH:"@\u002Fview\u002Fuser\u002FdetailList\u002FcolumnList\u002FFETCH",UPDATE_STATE:"@\u002Fview\u002Fuser\u002FdetailList\u002FcolumnList\u002FUPDATE_STATE",FETCH_MORE:"@\u002Fview\u002Fuser\u002FdetailList\u002FcolumnList\u002FFETCH_MORE",RESET:"@\u002Fview\u002Fuser\u002FdetailList\u002FcolumnList\u002FRESET"}},columnFollowedList:{list:[],hasMore:a,skeleton:a,loading:a,cursor:f,actionType:{FETCH:"@\u002Fview\u002Fuser\u002FdetailList\u002FcolumnFollowedList\u002FFETCH",UPDATE_STATE:"@\u002Fview\u002Fuser\u002FdetailList\u002FcolumnFollowedList\u002FUPDATE_STATE",FETCH_MORE:"@\u002Fview\u002Fuser\u002FdetailList\u002FcolumnFollowedList\u002FFETCH_MORE",RESET:"@\u002Fview\u002Fuser\u002FdetailList\u002FcolumnFollowedList\u002FRESET",FILTER:"@\u002Fview\u002Fuser\u002FdetailList\u002FcolumnFollowedList\u002FFILTER"}},realtimes:{list:[],cursor:f,hasMore:a,loading:a,skeleton:a,actionType:{FETCH:"@\u002Fview\u002Fuser\u002FdetailList\u002Frealtimes\u002FFETCH",UPDATE_STATE:"@\u002Fview\u002Fuser\u002FdetailList\u002Frealtimes\u002FUPDATE_STATE",FETCH_MORE:"@\u002Fview\u002Fuser\u002FdetailList\u002Frealtimes\u002FFETCH_MORE",RESET:"@\u002Fview\u002Fuser\u002FdetailList\u002Frealtimes\u002FRESET",DELETE:"@\u002Fview\u002Fuser\u002FdetailList\u002Frealtimes\u002FDELETE"}},realtimeliked:{list:[],cursor:f,hasMore:a,loading:a,skeleton:a,actionType:{FETCH:"@\u002Fview\u002Fuser\u002FdetailList\u002Frealtimeliked\u002FFETCH",UPDATE_STATE:"@\u002Fview\u002Fuser\u002FdetailList\u002Frealtimeliked\u002FUPDATE_STATE",FETCH_MORE:"@\u002Fview\u002Fuser\u002FdetailList\u002Frealtimeliked\u002FFETCH_MORE",RESET:"@\u002Fview\u002Fuser\u002FdetailList\u002Frealtimeliked\u002FRESET",DELETE:"@\u002Fview\u002Fuser\u002FdetailList\u002Frealtimeliked\u002FDELETE"}},robotList:{list:[],cursor:f,type:t,hasMore:a,skeleton:a,loading:a,actionType:{FETCH:"@\u002Fview\u002Fuser\u002FdetailList\u002FrobotList\u002FFETCH",UPDATE_STATE:"@\u002Fview\u002Fuser\u002FdetailList\u002FrobotList\u002FUPDATE_STATE",FETCH_MORE:"@\u002Fview\u002Fuser\u002FdetailList\u002FrobotList\u002FFETCH_MORE",RESET:"@\u002Fview\u002Fuser\u002FdetailList\u002FrobotList\u002FRESET"}}}},tag:{tag:{},actionType:{FETCH:"@\u002Fview\u002Ftag\u002FFETCH",FETCH_LIST:"@\u002Fview\u002Ftag\u002FFETCH_LIST",RESET:"@\u002Fview\u002Ftag\u002FRESET"},list:{list:[],cursor:f,loading:a,skeleton:a,hasMore:a,actionType:{UPDATE_STATE:"@\u002Fview\u002Ftag\u002Flist\u002FUPDATE_STATE",FETCH_MORE:"@\u002Fview\u002Ftag\u002Flist\u002FFETCH_MORE",FETCH:"@\u002Fview\u002Ftag\u002Flist\u002FFETCH",RESET:"@\u002Fview\u002Ftag\u002Flist\u002FRESET"}}},notification:{user:{actionType:{RESET:"@\u002Fview\u002Fnotification\u002Fuser\u002FRESET"},listState:{list:[],cursor:f,hasMore:a,isLoading:a,messageType:q,msgTotal:b,msgSubMap:{"1":b,"2":b,"3":b,"4":b,"7":b}},list:{pageSize:h,page:g,total:b,pointer:c,lastPointer:c,list:[],loading:a,error:c,canPrev:d,canNext:d,linkList:[],lastFetchOnServer:a,actionType:{UPDATE:"@\u002Fview\u002Fnotification\u002Fuser\u002Flist\u002FUPDATE",FETCH:"@\u002Fview\u002Fnotification\u002Fuser\u002Flist\u002FFETCH",FORCE_FETCH:"@\u002Fview\u002Fnotification\u002Fuser\u002Flist\u002FFORCE_FETCH",FETCH_MORE:"@\u002Fview\u002Fnotification\u002Fuser\u002Flist\u002FFETCH_MORE",RESET:"@\u002Fview\u002Fnotification\u002Fuser\u002Flist\u002FRESET"}}},system:{actionType:{RESET:"@\u002Fview\u002Fnotification\u002Fsystem\u002FRESET"},list:{pageSize:h,page:g,total:b,pointer:c,lastPointer:c,list:[],loading:a,error:c,canPrev:d,canNext:d,linkList:[],lastFetchOnServer:a,actionType:{UPDATE:"@\u002Fview\u002Fnotification\u002Fsystem\u002Flist\u002FUPDATE",FETCH:"@\u002Fview\u002Fnotification\u002Fsystem\u002Flist\u002FFETCH",FORCE_FETCH:"@\u002Fview\u002Fnotification\u002Fsystem\u002Flist\u002FFORCE_FETCH",FETCH_MORE:"@\u002Fview\u002Fnotification\u002Fsystem\u002Flist\u002FFETCH_MORE",RESET:"@\u002Fview\u002Fnotification\u002Fsystem\u002Flist\u002FRESET"}}}},column:{serverRenderList:a,column:{id:k},entry:{id:k,screenshot:l,liked:a,article_id:k,article_info:{article_id:k,user_id:u,category_id:"6809637769959178254",tag_ids:[2546581,7467857238494020000,6809640408797168000],visible_level:b,link_url:e,cover_image:e,is_gfw:b,title:v,brief_content:w,is_english:b,is_original:g,user_index:4.972785340826996,original_type:b,original_author:e,content:e,ctime:"1788364470",mtime:"1788364511",rtime:"-62135596800",draft_id:x,view_count:b,collect_count:b,digg_count:b,comment_count:b,hot_index:b,is_hot:b,rank_index:b,status:g,verify_status:b,audit_status:y,mark_content:e,display_count:b,is_markdown:g,app_html_content:e,version:g,web_html_content:"\u003Cstyle\u003E.markdown-body{word-break:break-word;line-height:1.75;font-weight:400;font-size:16px;overflow-x:hidden;color:#252933}.markdown-body h1,.markdown-body h2,.markdown-body h3,.markdown-body h4,.markdown-body h5,.markdown-body h6{line-height:1.5;margin-top:35px;margin-bottom:10px;padding-bottom:5px}.markdown-body h1{font-size:24px;line-height:38px;margin-bottom:5px}.markdown-body h2{font-size:22px;line-height:34px;padding-bottom:12px;border-bottom:1px solid #ececec}.markdown-body h3{font-size:20px;line-height:28px}.markdown-body h4{font-size:18px;line-height:26px}.markdown-body h5{font-size:17px;line-height:24px}.markdown-body h6{font-size:16px;line-height:24px}.markdown-body p{line-height:inherit;margin-top:22px;margin-bottom:22px}.markdown-body img{max-width:100%}.markdown-body hr{border:none;border-top:1px solid #ddd;margin-top:32px;margin-bottom:32px}.markdown-body code{word-break:break-word;border-radius:2px;overflow-x:auto;background-color:#fff5f5;color:#ff502c;font-size:.87em;padding:.065em .4em}.markdown-body code,.markdown-body pre{font-family:Menlo,Monaco,Consolas,Courier New,monospace}.markdown-body pre{overflow:auto;position:relative;line-height:1.75}.markdown-body pre\u003Ecode{font-size:12px;padding:15px 12px;margin:0;word-break:normal;display:block;overflow-x:auto;color:#333;background:#f8f8f8}.markdown-body a{text-decoration:none;color:#0269c8;border-bottom:1px solid #d1e9ff}.markdown-body a:active,.markdown-body a:hover{color:#275b8c}.markdown-body table{display:inline-block!important;font-size:12px;width:auto;max-width:100%;overflow:auto;border:1px solid #f6f6f6}.markdown-body thead{background:#f6f6f6;color:#000;text-align:left}.markdown-body tr:nth-child(2n){background-color:#fcfcfc}.markdown-body td,.markdown-body th{padding:12px 7px;line-height:24px}.markdown-body td{min-width:120px}.markdown-body blockquote{color:#666;padding:1px 23px;margin:22px 0;border-left:4px solid #cbcbcb;background-color:#f8f8f8}.markdown-body blockquote:after{display:block;content:\"\"}.markdown-body blockquote\u003Ep{margin:10px 0}.markdown-body ol,.markdown-body ul{padding-left:28px}.markdown-body ol li,.markdown-body ul li{margin-bottom:0;list-style:inherit}.markdown-body ol li .task-list-item,.markdown-body ul li .task-list-item{list-style:none}.markdown-body ol li .task-list-item ol,.markdown-body ol li .task-list-item ul,.markdown-body ul li .task-list-item ol,.markdown-body ul li .task-list-item ul{margin-top:0}.markdown-body ol ol,.markdown-body ol ul,.markdown-body ul ol,.markdown-body ul ul{margin-top:3px}.markdown-body ol li{padding-left:6px}.markdown-body .contains-task-list{padding-left:0}.markdown-body .task-list-item{list-style:none}@media (max-width:720px){.markdown-body h1{font-size:24px}.markdown-body h2{font-size:20px}.markdown-body h3{font-size:18px}}\u003C\u002Fstyle\u003E\u003Cstyle data-highlight data-highlight-key=\"juejin\"\u003E.markdown-body pre,.markdown-body pre\u003Ecode.hljs{color:#333;background:#f8f8f8}.hljs-comment,.hljs-quote{color:#998;font-style:italic}.hljs-keyword,.hljs-selector-tag,.hljs-subst{color:#333;font-weight:700}.hljs-literal,.hljs-number,.hljs-tag .hljs-attr,.hljs-template-variable,.hljs-variable{color:teal}.hljs-doctag,.hljs-string{color:#d14}.hljs-section,.hljs-selector-id,.hljs-title{color:#900;font-weight:700}.hljs-subst{font-weight:400}.hljs-class .hljs-title,.hljs-type{color:#458;font-weight:700}.hljs-attribute,.hljs-name,.hljs-tag{color:navy;font-weight:400}.hljs-link,.hljs-regexp{color:#009926}.hljs-bullet,.hljs-symbol{color:#990073}.hljs-built_in,.hljs-builtin-name{color:#0086b3}.hljs-meta{color:#999;font-weight:700}.hljs-deletion{background:#fdd}.hljs-addition{background:#dfd}.hljs-emphasis{font-style:italic}.hljs-strong{font-weight:700}\u003C\u002Fstyle\u003E\u003Ch2 data-id=\"heading-0\"\u003EDevin估值470亿了，但我的AI编程踩坑史告诉你另一面\u003C\u002Fh2\u003E\n\u003Cp\u003E今天看到一条消息差点把咖啡喷屏幕上。\u003C\u002Fp\u003E\n\u003Cp\u003ECognition AI——就是做AI编程代理Devin那家公司——即将完成约10亿美元融资，估值470亿美元。\u003C\u002Fp\u003E\n\u003Cp\u003E470亿什么概念？三个月前它刚融完一轮，估值260亿。三个月，翻了将近一倍。\u003C\u002Fp\u003E\n\u003Cp\u003E我第一反应不是\"哇好厉害\"，而是\"等一下，Devin真的好用吗？\"\u003C\u002Fp\u003E\n\u003Cp\u003E因为我是真用过Devin的人。不是看Demo视频吹的，是实打实拿来干过活的人。今天就说说真实体验。\u003C\u002Fp\u003E\n\u003Ch3 data-id=\"heading-1\"\u003E先说Devin到底是什么\u003C\u002Fh3\u003E\n\u003Cp\u003E如果你不了解，简单说：Devin是Cognition开发的AI编程代理。跟Cursor、Copilot这些\"辅助你写代码\"的工具不同，Devin的定位是\"自己写代码\"——你给它一个任务描述，它自己规划、写代码、跑测试、修bug，理论上你只要等结果就行。\u003C\u002Fp\u003E\n\u003Cp\u003E听起来很美好是吧？\u003C\u002Fp\u003E\n\u003Cp\u003ECognition靠着这个故事，拿到了近100亿美元的投资意向。营收确实也在涨。投资人的逻辑很简单：AI编程是刚需，市场够大，Devin是赛道头部。\u003C\u002Fp\u003E\n\u003Cp\u003E但作为实际用户，我必须说几句实话。\u003C\u002Fp\u003E\n\u003Ch3 data-id=\"heading-2\"\u003E我的Devin使用经历\u003C\u002Fh3\u003E\n\u003Cp\u003E今年早些时候，我拿到Devin的使用资格后，第一时间拿了个真实项目喂给它。\u003C\u002Fp\u003E\n\u003Cp\u003E任务不复杂：给一个Go微服务加个Redis缓存层，缓存接口返回的数据，设置合理的过期策略。\u003C\u002Fp\u003E\n\u003Cp\u003E这种活我手写大概半小时，我想看看Devin能多快搞定。\u003C\u002Fp\u003E\n\u003Cp\u003E结果呢？Devin花了大概40分钟，产出了三版完全不同的实现方案。第一版，缓存key设计有问题，多个接口共用同一个key导致数据串了。第二版，过期策略写死了，没考虑不同接口的缓存需求不同。第三版，功能倒是实现了，但代码风格跟我现有项目完全不搭——它用了一种很奇怪的分层结构，硬塞进来之后整个文件的逻辑线被打断了。\u003C\u002Fp\u003E\n\u003Cp\u003E最后我还是自己重写了。\u003C\u002Fp\u003E\n\u003Cp\u003E但我没有因此否定Devin。我又试了几个任务：写单元测试、做数据迁移脚本、处理简单的CRUD接口。这几个场景下Devin确实有产出，尤其是写测试用例，覆盖得比我手写的还全。\u003C\u002Fp\u003E\n\u003Cp\u003E所以我的结论是：\u003Cstrong\u003EDevin不是不能用，是得知道在什么场景下用。\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Ch3 data-id=\"heading-3\"\u003EAI编程工具的真相\u003C\u002Fh3\u003E\n\u003Cp\u003E从Devin到Cursor、Copilot、Claude Code、TRAE，我过去半年把这些工具轮了一遍。总结下来有几个血泪教训：\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003E第一，\"全自动\"是个伪命题。\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E任何AI编程工具，不管是辅助模式还是自主模式，都需要人的review。Devin生成的代码看起来能跑，但线上环境跟你本地的差异太大——缓存策略要考虑一致性，接口设计要考虑版本兼容，错误处理要考虑上游服务挂掉的情况。这些AI目前都做不好，因为它没有你的业务上下文。\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003E第二，工具的\"聪明程度\"跟你给的上下文质量正相关。\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E我用Cursor的时候，如果只是说\"帮我写个登录接口\"，出来的代码基本是demo级别的。但如果我把项目的路由结构、数据库schema、中间件配置全部喂进去，再描述清楚需求，生成的代码质量能直接到\"微调一下就能用\"的级别。\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003E第三，越贵的工具不一定越好用。\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cp\u003EDevin的定价不低，但在我实际使用中，它的表现并没有比Cursor的Agent模式好出一个量级。相反，Cursor的Agent模式在理解项目上下文方面反而更灵活，因为它可以直接读你的整个代码库。\u003C\u002Fp\u003E\n\u003Ch3 data-id=\"heading-4\"\u003E470亿估值背后的逻辑\u003C\u002Fh3\u003E\n\u003Cp\u003E说完体验，回到估值这件事。\u003C\u002Fp\u003E\n\u003Cp\u003E470亿美元，这个数字放在AI赛道里不算疯了。毕竟OpenAI估值上万亿，Anthropic也到了几千亿。但Cognition跟它们不一样——Cognition目前只有一个核心产品（Devin），营收虽然激增但绝对值远不到这个估值对应的体量。\u003C\u002Fp\u003E\n\u003Cp\u003E投资人赌的是什么？\u003Cstrong\u003E赌AI编程会成为下一个云计算级别的赛道。\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E这个判断我部分认同。AI编程确实是刚需，而且渗透率还很低。大量企业连Copilot都没用上，更别说自主编程代理了。但问题在于：\u003C\u002Fp\u003E\n\u003Cp\u003E赛道是确定方向，不等于确定赢家。\u003C\u002Fp\u003E\n\u003Cp\u003EDevin现在的技术壁垒有多高？说实话，不算高。它的核心能力——理解需求、规划代码、执行测试——依赖的底层模型能力，各家都在快速拉平。一旦OpenAI、Google把模型能力开放给第三方，Devin的护城河就会变浅。\u003C\u002Fp\u003E\n\u003Cp\u003E更要命的是，\u003Cstrong\u003EOpenAI已经在断供Cursor的模型了。\u003C\u002Fstrong\u003E 11月12日生效，理由是\"控制权变更\"。如果哪天OpenAI觉得Devin威胁到了自己的编程产品线，同样可以断供。\u003C\u002Fp\u003E\n\u003Cp\u003E当然Cognition可能在训练自己的模型，降低对OpenAI的依赖。但自研模型的成本是天文数字，470亿估值的公司扛得住吗？这是个大问号。\u003C\u002Fp\u003E\n\u003Ch3 data-id=\"heading-5\"\u003E我现在用AI编程工具的方式\u003C\u002Fh3\u003E\n\u003Cp\u003E说了这么多，不是唱衰Devin或AI编程。恰恰相反，我是AI编程的重度用户，每天都在用。\u003C\u002Fp\u003E\n\u003Cp\u003E但经过踩坑之后，我的用法变了：\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003E\u003Cstrong\u003E写新模块、新功能\u003C\u002Fstrong\u003E：用Cursor的Agent模式，把项目上下文喂够，生成初版代码，然后人工review和重构。\u003C\u002Fli\u003E\n\u003Cli\u003E\u003Cstrong\u003E写测试用例\u003C\u002Fstrong\u003E：这个场景AI做得最好，让它批量生成，我挑能用的。\u003C\u002Fli\u003E\n\u003Cli\u003E\u003Cstrong\u003E做代码迁移和重构\u003C\u002Fstrong\u003E：比如把一个旧框架迁移到新框架，AI能帮你做大量机械工作。\u003C\u002Fli\u003E\n\u003Cli\u003E\u003Cstrong\u003EDebug\u003C\u002Fstrong\u003E：把报错信息和相关代码喂进去，让AI帮定位，比自己翻日志快。\u003C\u002Fli\u003E\n\u003Cli\u003E\u003Cstrong\u003E不交给AI做的事\u003C\u002Fstrong\u003E：架构决策、核心业务逻辑、安全相关代码、性能关键路径。\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Cp\u003E这套打法让我从\"被AI牵着走\"变成了\"用AI当工具人\"。470亿估值的Devin可以继续炒概念，但对我这种每天要交付代码的人来说，好用比好听重要。\u003C\u002Fp\u003E\n\u003Ch3 data-id=\"heading-6\"\u003E最后说句大实话\u003C\u002Fh3\u003E\n\u003Cp\u003ECognition融资470亿，对整个AI编程赛道是利好。因为钱多了，技术迭代就快，我们用工具的人就受益。\u003C\u002Fp\u003E\n\u003Cp\u003E但作为开发者，别被估值数字忽悠了。470亿是投资人的故事，跟你用什么工具、写得好不好没有直接关系。\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003E工具再贵，不如用对工具。工具再强，不如你知道什么时候不用它。\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E这话是我踩了无数坑之后总结出来的，值470块，不收470亿。\u003C\u002Fp\u003E\n\u003Chr\u003E\n\u003Cp\u003E你现在在用什么AI编程工具？有没有跟我一样踩过坑的？评论区说说你最崩溃的一次AI编程翻车经历，我赌评论区比文章精彩。\u003C\u002Fp\u003E",meta_info:"{\"plugins\":[],\"video_count\":0}",catalog:"[{\"title\":\"Devin估值470亿了，但我的AI编程踩坑史告诉你另一面\",\"hash\":\"#heading-0\",\"deep\":1,\"children\":[{\"title\":\"先说Devin到底是什么\",\"hash\":\"#heading-1\",\"deep\":2,\"children\":[],\"visible\":true},{\"title\":\"我的Devin使用经历\",\"hash\":\"#heading-2\",\"deep\":2,\"children\":[],\"visible\":true},{\"title\":\"AI编程工具的真相\",\"hash\":\"#heading-3\",\"deep\":2,\"children\":[],\"visible\":true},{\"title\":\"470亿估值背后的逻辑\",\"hash\":\"#heading-4\",\"deep\":2,\"children\":[],\"visible\":true},{\"title\":\"我现在用AI编程工具的方式\",\"hash\":\"#heading-5\",\"deep\":2,\"children\":[],\"visible\":true},{\"title\":\"最后说句大实话\",\"hash\":\"#heading-6\",\"deep\":2,\"children\":[],\"visible\":true}],\"visible\":true}]",homepage_top_time:-62135596800,homepage_top_status:b,content_count:b,read_time:"1分钟",pics_expire_time:b,in_aicoding:d},author_user_info:{user_id:u,user_name:z,company:e,job_title:"AI应用开发工程师 \u002F 全栈",avatar_large:"https:\u002F\u002Fp6-passport.byteacctimg.com\u002Fimg\u002Fuser-avatar\u002F3bc84c7be853e7aed73bc2f1a3b6b17f~300x300.image",level:q,description:"专注AI应用开发与落地实战。Agent开发、LLM集成、AI工具链实践，分享从踩坑到上线的真实经验。不写水文，只写用过才知道的东西。",followee_count:57,follower_count:24,post_article_count:A,digg_article_count:154,got_digg_count:A,got_view_count:26489,post_shortmsg_count:61,digg_shortmsg_count:18,isfollowed:a,favorable_author:b,power:B,study_point:b,university:{university_id:f,name:e,logo:e},major:{major_id:f,parent_id:f,name:e},student_status:b,select_event_count:b,select_online_course_count:b,identity:b,is_select_annual:a,select_annual_rank:b,annual_list_type:b,extraMap:{},is_logout:b,annual_info:[],account_amount:b,user_growth_info:{user_id:2350111542479753,jpower:B,jscore:1289.2,jpower_level:q,jscore_level:5,jscore_title:"先锋掘友",author_achievement_list:[],vip_level:b,vip_title:e,jscore_next_level_score:2000,jscore_this_level_mini_score:500,vip_score:b},is_vip:a,become_author_days:b,collection_set_article_count:b,recommend_article_count_daily:b,article_collect_count_daily:b,user_priv_info:{administrator:b,builder:b,favorable_author:b,book_author:b,forbidden_words:b,can_tag_cnt:b,auto_recommend:b,signed_author:b,popular_author:b,can_add_video:b}},category:{category_id:"6809637769959178254",category_name:"后端",category_url:"backend",rank:g,back_ground:"https:\u002F\u