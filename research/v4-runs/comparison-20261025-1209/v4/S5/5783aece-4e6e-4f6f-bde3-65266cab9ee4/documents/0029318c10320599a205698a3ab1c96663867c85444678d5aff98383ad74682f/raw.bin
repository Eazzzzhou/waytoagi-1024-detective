</script></div></div> </section> <section id="sidebar" class="right-column col-lg-4 col-md-5 d-md-block d-none"> <div> <div class="module card text-center mb-3"> <div class="card-header py-1"> <h4>Gold Sponsor</h4></div> <div id="mod-custom265" class="mod-custom custom"> <p> <br><a href="/sponsors/12105" target="_blank" rel="noopener"><img data-src="https://res.cloudinary.com/tbmg/q_auto,f_auto/ctf/extra/sponsors/Maxon_logo-200.png" alt="" border="0" class="lazyload"></a></p></div></div> <div class="module card text-center mb-3"> <div class="card-header py-1"> <h4>View Entries by</h4></div> <div id="mod-custom262" class="mod-custom custom"> <div class="card-body"> <h4>Contest Category</h4></div> <ul class="list-group list-group-flush"> <li class="list-group-item"><a href="/2026/entries/aerospace-and-defense/by-date">Aerospace &amp; Defense</a></li> <li class="list-group-item"><a href="/2026/entries/automotive-transportation/by-date">Automotive/​​​Transportation</a></li> <li class="list-group-item"><a href="/2026/entries/electronics/by-date">Electronics</a></li> <li class="list-group-item"><a href="/2026/entries/energy-power-and-propulsion/by-date">Energy, Power &amp; Propulsion</a></li> <li class="list-group-item"><a href="/2026/entries/manufacturing-and-materials/by-date">Manufacturing &amp; Materials</a></li> <li class="list-group-item"><a href="/2026/entries/medical/by-date">Medical</a></li> <li class="list-group-item"><a href="/2026/entries/robotics-and-automation/by-date">Robotics &amp; Automation</a></li></ul> <div class="card-body"> <h4>Also</h4></div> <ul class="list-group list-group-flush"> <li class="list-group-item"><a href="/tags">Tag Cloud</a></li> <li class="list-group-item"><a href="/2026/entrants">2026 Entrants</a></li> <li class="list-group-item"><a href="/2026/top-votes">Number of Votes</a></li> <li class="list-group-item"><a href="/2026/entries/by-views">Number of Page Views</a></li> <li class="list-group-item"><a href="/2026/entries">View All Ent