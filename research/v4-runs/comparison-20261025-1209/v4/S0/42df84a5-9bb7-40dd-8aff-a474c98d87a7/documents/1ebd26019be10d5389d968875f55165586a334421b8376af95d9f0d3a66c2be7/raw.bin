img src="https://s.yimg.com/lo/mysterio/api/c7adfcfdfdac33755ead56f450e9b95dd7b1e8a1b0e4d9339ec0993950757a4a/lightyear_networkapi/resizefill_h48%3Bquality_100%3Bformat_webp/http%3A%2F%2Fl.yimg.com%2Fos%2F649%2F2011%2F12%2F05%2Faasmall_070048.gif" alt="AASTOCKS" class="provider-logo" loading="lazy" width="24" height="24" fetchpriority="auto">  </a> </div> <div class="cover-headline yf-d62p20"><h1 class="cover-title yf-d62p20">DeepSeek：正測試新長文本模型結構  API服務不變</h1>    <label data-testid="typography" class=" type-ui-xxl-reg    yf-gjjls9"> </label></div></div>  <div class="byline yf-kcfqgj"><div class="byline-attr yf-kcfqgj"> <div><div class="byline-attr-author yf-kcfqgj">  AASTOCKS </div> <div class="byline-attr-time-style yf-kcfqgj"> <time class="byline-attr-meta-time" datetime="2026-02-15T23:32:52+00:00" data-timestamp="2026-02-15T23:32:52+00:00">2026年2月16日</time> <span class="byline-attr-mins-read yf-1pgkgts">1 分鐘閱讀時間</span></div></div></div> <div class="byline-share yf-kcfqgj"><div><span class="share-dialog yf-uc2fyh"><div class="menuContainer  yf-1uspju" style="                    " role="presentation">    <button class="tertiary-btn fin-size-medium menuBtn tw-p-1    rounded   highlightWhenExpanded yf-7mptsx" data-ylk="elmt:menu;itc:1;elm:btn;sec:consolidated-share-popup;g:49650f80-e0e7-3a0c-ab12-c4d91e1332ce;slk:share-menu-open" data-yga="{&quot;yLinkElementType&quot;:&quot;menu&quot;,&quot;yLinkElement&quot;:&quot;btn&quot;,&quot;yModuleName&quot;:&quot;consolidated-share-popup&quot;,&quot;yDestinationContentUUID&quot;:&quot;49650f80-e0e7-3a0c-ab12-c4d91e1332ce&quot;,&quot;yLinkText&quot;:&quot;share-menu-open&quot;}" aria-haspopup="true" aria-controls="menu-ie2tp67f" tabindex="0" title="Share links" data-testid="share-link" dialogAlignLeftValue="-120px" dialogAlignTopValue="40px" aria-label="Share links"> <div aria-hidden="true" class="icon fin-icon primary-icn sz-x-large  yf-15ilbqr" data-icon-type="ios-share" data-testid="desktop-share-icon"><!-- HTML_TAG_START --><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="m16 5-1.42 1.42-1.59-1.59V16h-1.98V4.83L9.42 6.42 8 5l4-4zm4 5v11c0 1.1-.9 2-2 2H6a2 2 0 0 1-2-2V10c0-1.11.89-2 2-2h3v2H6v11h12V10h-3V8h3a2 2 0 0 1 2 2"/></svg><!-- HTML_TAG_END --> </div>  </button>  <div class="dialog-container menu-surface-dialog modal tw-hidden     yf-1uspju" id="menu-ie2tp67f" aria-hidden aria-label=""></div> </div></span> <span class="mweb-share-dialog yf-uc2fyh">    <button class="icon2-btn fin-size-medium     rounded   highlightWhenExpanded yf-7mptsx" data-ylk="elm:share;itc:1;sec:consolidated-share-popup;g:49650f80-e0e7-3a0c-ab12-c4d91e1332ce;slk:share-menu-open" data-yga="{&quot;yLinkElement&quot;:&quot;share&quot;,&quot;yModuleName&quot;:&quot;consolidated-share-popup&quot;,&quot;yDestinationContentUUID&quot;:&quot;49650f80-e0e7-3a0c-ab12-c4d91e1332ce&quot;,&quot;yLinkText&quot;:&quot;share-menu-open&quot;}" data-icon-type="ios-share" title="分享連結" aria-label="分享連結" data-testid="mobile-share-button"><div aria-hidden="true" class="icon fin-icon inherit-icn sz-large  yf-15ilbqr"><!-- HTML_TAG_START --><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="m16 5-1.42 1.42-1.59-1.59V16h-1.98V4.83L9.42 6.42 8 5l4-4zm4 5v11c0 1.1-.9 2-2 2H6a2 2 0 0 1-2-2V10c0-1.11.89-2 2-2h3v2H6v11h12V10h-3V8h3a2 2 0 0 1 2 2"/></svg><!-- HTML_TAG_END --> </div>  </button></span></div> </div> </div>  </div>  <div class="body-wrap yf-jo6sif"> <div class="body yf-v6n2s3" data-testid="article-body">  <div class="bodyItems-wrapper">        <p class="text text-block paragraph text-left  neo-font-paragraph-xl-reg  yf-18d6y07" style="text-decoration: none; font-style: normal; text-transform: none; text-align: inherit; font-variant-numeric: normal;"><!-- HTML_TAG_START -->DeepSeek官方助手在開發者交流群中表示，DeepSeek網頁及APP正在測試新的長文本模型結構，支持1M上下文，而API服務不變，仍為V3.2，僅支持128K上下文。此次測試為2月11日啟動的灰度測試。該新模型上下文窗口較此前128K的版本提升明顯，單次可處理相當於500頁A4文檔的文本量，能覆蓋長文檔分析及跨章節推理等場景。不過，有用戶反饋新版本交互風格有所變化。業內推測該版本或為DeepSeek-V4-Lite，犧牲部分質量換取速度，為正式版本做壓力測試。(ta/u)~阿思達克財經新聞網址: www.aastocks.com<!-- HTML_TAG_END -->  </p>    <script type="application/json" data-cds-metadata="nwapi" data-cds-disable-injection="">{"contentId":"49650f80-e0e7-3a0c-ab12-c4d91e1332ce","canonicalUrl":"https://hk.finance.yahoo.com/news/deepseek-%E6%AD%A3%E6%B8%AC%E8%A9%A6%E6%96%B0%E9%95%B7%E6%96%87%E6%9C%AC%E6%A8%A1%E5%9E%8B%E7%B5%90%E6%A7%8B-api%E6%9C%8D%E5%8B%99%E4%B8%8D%E8%AE%8A-233252601.html","owningPropertyUrl":"https://hk.finance.yahoo.com/news/deepseek-%E6%AD%A3%E6%B8%AC%E8%A9%A6%E6%96%B0%E9%95%B7%E6%96%87%E6%9C%AC%E6%A8%A1%E5%9E%8B%E7%B5%90%E6%A7%8B-api%E6%9C%8D%E5%8B%99%E4%B8%8D%E8%AE%8A-233252601.html","providerId":"aastocks.com","commerceSiteId":"","site":"finance","region":"HK","lang":"zh-Hant-HK","tags":[{"value":"_enrichment_ccm-models-lib-version-0.0.927","property":null,"uuid":null,"type":"system"},{"value":"yfinance:region=hk","property":null,"uuid":null,"type":"system"},{"value":"ymedia:signal=summary_source:provider","property":null,"uuid":null,"type":"system"},{"value":"ymedia:category=100000003","property":null,"uuid":null,"type":"system"},{"value":"ymedia:category=100000002","property":null,"uuid":null,"type":"system"},{"value":"ymedia:provider_id=aastocks.com","property":null,"uuid":null,"type":"system"},{"value":"NOW","property":null,"uuid":null,"type":"system"},{"value":"yfinance:partner=apple","property":null,"uuid":null,"type":"system"},{"value":"ymedia:hosted=yes","property":null,"uuid":null,"type":"system"},{"value":"ymedia:provider_category=NOW","property":null,"uuid":null,"type":"system"}],"categories":[{"name":"Technology \u0026 Electronics","score":0.661355,"code":"yct:001000931"},{"name":"Currency","score":0.695652,"code":"yct:001000329"}],"commerceArticleType":""}</script>   </div>    </div></div> <span class="article-footer yf-127tkty"><section class="privacy-container yf-1oqrg4r inline" style="--privacy-link-font-weight: var(--font-normal); --privacy-link-color: inherit;"> <div class="terms-an