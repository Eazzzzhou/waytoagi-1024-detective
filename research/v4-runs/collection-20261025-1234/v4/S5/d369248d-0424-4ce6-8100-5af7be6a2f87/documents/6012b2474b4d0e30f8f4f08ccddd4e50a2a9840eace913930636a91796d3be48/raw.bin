tic/immutable/chunks/39y6i3sb4_a9h.js\",\"/marketing-static/_next/static/immutable/chunks/1w14ox4_yw7md.js\",\"/marketing-static/_next/static/immutable/chunks/1liqif1phdqy-.js\",\"/marketing-static/_next/static/immutable/chunks/1m2hi47run6lr.js\",\"/marketing-static/_next/static/immutable/chunks/03c7z786xp5-7.js\",\"/marketing-static/_next/static/immutable/chunks/11eladxv1n32_.js\",\"/marketing-static/_next/static/immutable/chunks/15zjkswn7xc7j.js\",\"/marketing-static/_next/static/immutable/chunks/1f5zx4jioj1zi.js\",\"/marketing-static/_next/static/immutable/chunks/27xcftm7q6diq.js\",\"/marketing-static/_next/static/immutable/chunks/18-1r7telr_2_.js\",\"/marketing-static/_next/static/immutable/chunks/3w2m5qreo7m45.js\",\"/marketing-static/_next/static/immutable/chunks/3b03r8yt5ja7g.js\"],\"default\"]\n77:I[180185,[\"/marketing-static/_next/static/immutable/chunks/16n01jo8q9i3r.js\",\"/marketing-static/_next/static/immutable/chunks/2bgqd3nyf2poa.js\",\"/marketing-static/_next/static/immutable/chunks/1jwg6g97ujn-5.js\",\"/marketing-static/_next/static/immutable/chunks/2qrpjzi1rhnwc.js\",\"/marketing-static/_next/static/immutable/chunks/39y6i3sb4_a9h.js\",\"/marketing-static/_next/static/immutable/chunks/1w14ox4_yw7md.js\",\"/marketing-static/_next/static/immutable/chunks/1liqif1phdqy-.js\",\"/marketing-static/_next/static/immutable/chunks/1m2hi47run6lr.js\",\"/marketing-static/_next/static/immutable/chunks/03c7z786xp5-7.js\",\"/marketing-static/_next/static/immutable/chunks/11eladxv1n32_.js\",\"/marketing-static/_next/static/immutable/chunks/15zjkswn7xc7j.js\",\"/marketing-static/_next/static/immutable/chunks/1f5zx4jioj1zi.js\",\"/marketing-static/_next/static/immutable/chunks/27xcftm7q6diq.js\",\"/marketing-static/_next/static/immutable/chunks/18-1r7telr_2_.js\",\"/marketing-static/_next/static/immutable/chunks/3w2m5qreo7m45.js\",\"/marketing-static/_next/static/immutable/chunks/3b03r8yt5ja7g.js\"],\"default\"]\n"])</script><script nonce="45ZmkHxO1PJ9TIi/okDw7g==">self.__next_f.push([1,"72:[\"$\",\"div\",null,{\"className\":\"prose prose--block prose--blog col-span-full!\",\"children\":[[\"$\",\"p\",null,{\"children\":\"编码智能体正在改变软件的构建方式。\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"模型现在可以连续运行数小时，完成大规模的多文件重构，并持续迭代直到测试通过。但要充分发挥智能体的能力，你需要理解它们的工作原理，并形成新的使用范式。\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"本指南重点介绍如何使用 Cursor 智能体的各种技巧。无论你是刚开始尝试基于智能体的编码，还是想了解我们团队是如何使用 Cursor 的，我们都会系统性地讲解使用智能体编码的最佳实践。\"}],\"\\n\",[\"$\",\"$L76\",null,{\"as\":\"h2\",\"id\":\"harness\",\"children\":\"理解智能体 harness\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"一个智能体 harness 建立在三个组件之上：\"}],\"\\n\",[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Instructions\"}],\"：引导智能体行为的 system prompt 和规则\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Tools\"}],\"：文件编辑、代码库搜索、终端执行等工具\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Model\"}],\"：你为任务选择的智能体模型\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Cursor 的智能体 harness 会为我们支持的每个模型编排这些组件。我们会基于内部评估和外部基准测试，为每个前沿模型专门\",[\"$\",\"$L3a\",null,{\"href\":\"/blog/codex-model-harness\",\"children\":\"调整 instructions\"}],\"和\",[\"$\",\"$L3a\",null,{\"href\":\"/blog/semsearch\",\"children\":\"工具\"}],\"。\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"harness 之所以重要，是因为不同模型对相同提示词的响应方式不同。一个在 shell 导向工作流上经过大量训练的模型，可能更偏好使用 \",[\"$\",\"code\",null,{\"children\":\"grep\"}],\" 而不是专门的搜索工具；另一个模型可能需要明确的指令，在编辑后调用 linter 工具。Cursor 的智能体会为你处理这些问题，因此当新模型发布时，你可以专注于构建软件。\"]}],\"\\n\",[\"$\",\"$L76\",null,{\"as\":\"h2\",\"id\":\"\",\"children\":\"从规划开始\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"你能做出的最大改变，就是在编写代码之前先进行规划。\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"来自芝加哥大学的\",[\"$\",\"$L3a\",null,{\"href\":\"/blog/productivity\",\"children\":\"一项研究\"}],\"发现，有经验的开发者更倾向于在生成代码之前先进行规划。规划会促使你更清晰地思考自己要构建的内容，并为 Agent 提供明确的目标去实现。\"]}],\"\\n\",[\"$\",\"$L76\",null,{\"as\":\"h3\",\"id\":\"plan\",\"children\":\"使用 Plan 模式\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"在 agent 输入框中按下 \",[\"$\",\"code\",null,{\"children\":\"Shift+Tab\"}],\" 以切换 Plan 模式。agent 不会立即编写代码，而是会：\"]}],\"\\n\",[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"分析你的代码库以查找相关文件\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"就你的需求提出澄清问题\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"创建包含文件路径和代码引用的详细实现计划\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"在开始构建前等待你的确认\"}],\"\\n\"]}],\"\\n\",[\"$\",\"$L77\",null,{\"loop\":true,\"src\":\"https://ptht05hbb1ssoooe.public.blob.vercel-storage.com/assets/changelog/changelog-2-1-0.mp4\",\"caption\":\"Plan 模式实战：agent 会提出澄清问题并创建可审查的计划。\",\"width\":2832,\"height\":2160}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"计划会以 Markdown 文件的形式打开，你可以直接编辑它们，以删除不必要的步骤、调整实现方式，或补充 agent 遗漏的上下文。\"}],\"\\n\",[\"$\",\"blockquote\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"提示：\"}],\" 点击 “Save to workspace” 将计划存储到 \",[\"$\",\"code\",null,{\"children\":\".cursor/plans/\"}],\"。这样可以为你的团队创建文档，方便在中断后继续工作，并为未来在同一特性上工作的 agent 提供上下文。\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"并不是每个任务都需要详细的计划。对于一些简单的小改动，或是你已经做过很多次的任务，直接交给 agent 处理就可以。\"}],\"\\n\",[\"$\",\"$L76\",null,{\"as\":\"h3\",\"id\":\"-1\",\"children\":\"从计划重新开始\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"有时 agent 生成的内容并不符合你的预期。与其试图通过后续提示来修修补补，不如回到计划本身。\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"先回滚这些改动，重新细化计划，把你的需求描述得更具体，然后再运行一次。这样通常比修一个进行中的 agent 更快，生成的结果也更干净利落。\"}],\"\\n\",[\"$\",\"$L76\",null,{\"as\":\"h2\",\"id\":\"-2\",\"children\":\"管理上下文\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"随着你越来越习惯由 agent 编写代码，你的主要工作就变成：为每个 agent 提供完成其任务所需的上下文。\"}],\"\\n\",[\"$\",\"$L76\",null,{\"as\":\"h3\",\"id\":\"agent\",\"children\":\"让 agent 自行获取上下文\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"你不需要在提示里手动标记每一个文件。\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Cursor 的 agent 具备强大的\",[\"$\",\"$L3a\",null,{\"href\":\"/blog/semsearch\",\"children\":\"搜索工具\"}],\"，并且可以按需获取上下文。比如，当你询问 “the authentication flow”（身份验证流程）时，agent 会通过 \",[\"$\",\"code\",null,{\"children\":\"grep\"}],\" 和语义搜索找到相关文件，即使你的提示里没有包含这些完全相同的词语。\"]}],\"\\n\",[\"$\",\"$L77\",null,{\"loop\":true,\"src\":\"https://ptht05hbb1ssoooe.public.blob.vercel-storage.com/assets/changelog/changelog-2-1-2.mp4\",\"caption\":\"即时 grep 让 agent 能在毫秒级搜索你的代码库。\",\"width\":2804,\"height\":2160}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"保持简单：如果你知道确切的文件，就在提示中引用它；如果不知道，就交给 agent 去查找。包含不相关的文件可能会让 agent 弄不清哪些内容才是重要的。\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Cursor 的 agent 还提供了许多实用工具，比如 \",[\"$\",\"code\",null,{\"children\":\"@Branch\"}],\"，可以让你为 agent 提供你当前工作的上下文。诸如 “Review the changes on this branch” 或 “What am I working on?” 之类的请求，会成为引导 agent 了解你当前任务的自然方式。\"]}],\"\\n\",[\"$\",\"$L76\",null,{\"as\":\"h3\",\"id\":\"-3\",\"children\":\"什么时候开始一个新对话\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"许多人都会问：我应该继续这个对话，还是重新开始一个新的？\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"在以下情况下开始新对话：\"}]}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"你要切换到一个不同的任务或功能\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Agent 看起来很困惑，或者总是在犯同样的错误\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"你已经完成了一个逻辑完整的工作单元\"}],\"\\n\"]}],\"\\n\",\"$L78\",\"\\n\",\"$L79\",\"\\n\",\"$L7a\",\"\\n\",\"$L7b\",\"\\n\",\"$L7c\",\"\\n\",\"$L7d\",\"\\n\",\"$L7e\",\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\",\"\\n\",\"$L88\",\"\\n\",\"$L89\",\"\\n\",\"$L8a\",\"\\n\",\"$L8b\",\"\\n\",\"$L8c\",\"\\n\",\"$L8d\",\"\\n\",\"$L8e\",\"\\n\",\"$L8f\",\"\\n\",\"$L90\",\"\\n\",\"$L91\",\"\\n\",\"$L92\",\"\\n\",\"$L93\",\"\\n\",\"$L94\",\"\\n\",\"$L95\",\"\\n\",\"$L96\",\"\\n\",\"$L97\",\"\\n\",\"$L98\",\"\\n\",\"$L99\",\"\\n\",\"$L9a\",\"\\n\",\"$L9b\",\"\\n\",\"$L9c\",\"\\n\",\"$L9d\",\"\\n\",\"$L9e\",\"\\n\",\"$L9f\",\"\\n\",\"$La0\",\"\\n\",\"$L