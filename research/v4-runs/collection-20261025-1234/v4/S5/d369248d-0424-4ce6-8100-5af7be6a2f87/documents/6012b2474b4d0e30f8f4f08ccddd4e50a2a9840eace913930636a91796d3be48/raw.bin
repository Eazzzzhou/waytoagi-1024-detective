ting-static/_next/static/immutable/chunks/03c7z786xp5-7.js\",\"/marketing-static/_next/static/immutable/chunks/11eladxv1n32_.js\",\"/marketing-static/_next/static/immutable/chunks/15zjkswn7xc7j.js\",\"/marketing-static/_next/static/immutable/chunks/1f5zx4jioj1zi.js\",\"/marketing-static/_next/static/immutable/chunks/27xcftm7q6diq.js\",\"/marketing-static/_next/static/immutable/chunks/18-1r7telr_2_.js\",\"/marketing-static/_next/static/immutable/chunks/3w2m5qreo7m45.js\",\"/marketing-static/_next/static/immutable/chunks/3b03r8yt5ja7g.js\"],\"\"]\n"])</script><script nonce="45ZmkHxO1PJ9TIi/okDw7g==">self.__next_f.push([1,"28:[\"$\",\"$L29\",null,{\"dictionary\":{},\"dictionaryTranslations\":{},\"translations\":{\"000520aaea1a8776\":\"编辑中\",\"0043eaa0358840c5\":\"接下来我会规范交互标签并添加会话标记，以便产品团队筛选特定群组：\",\"0053d0265ebfdcde\":\"查看所有博客文章\",\"0074dc59c42a66f8\":\"查看条款\",\"007e1d519c8a3a5b\":\"优先使用新功能\",\"0091f77ad1ec3df1\":\"已构建聚合管道，并使用物化视图来提升性能。API 端点位于 /api/metrics/[period]。\",\"009705a340687c13\":\"浏览 Web\",\"00efa9a87c6c4daf\":\"通过 iOS 原生移动应用，随时随地使用 Cursor 工作。\",\"0105ab37b3295133\":\"这是一个由 Datadog 构建并经 Cursor 验证的插件，可让您通过预配置的 Datadog MCP 服务器，直接在 Cursor 中使用 Datadog。您可以通过自然对话查询日志、指标、链路追踪、仪表盘等内容。该插件目前处于预览阶段。\",\"010e512bb66b88c6\":\"构建落地页\",\"01237b7e8546a946\":\"我们的团队将尽快联系您，确认将您的定制 Cursor 键盘寄送至何处。在此期间，您可以下载 Cursor 或查阅文档。\",\"0130c7b2265d9be6\":\"所有团队成员共享的用量池\",\"014e72a2b100246d\":\"读取 components/Dashboard.tsx、components/Navigation.tsx、components/ContentTabs.tsx\",\"017d93b20cd67836\":\"Cursor 会请求哪些 Slack 权限？\",\"019869a6c0157892\":\"服务条款\",\"01a78922e94e2f5e\":\"无论您在哪里编写代码，Cursor CLI 都能融入您现有的工作流。\",\"01b2289c36286f24\":\"邮编\",\"021e0af7480aacc1\":\"按照您团队的工作方式定制 Cursor\",\"026e0133ddc5b240\":\"思考 7 秒\",\"02a0f5de3f896b88\":\"使用适合您团队的模型、规则、工具和审查流程。Cursor 为智能体留出施展空间，同时仍将工程判断纳入流程。\",\"02f220673d79b09b\":\"已用 grep 搜索 updateInventory\",\"02f9a28d649f4a43\":\"了解其优势、投入级别、工具、定价和可用性。\",\"0302bd1957d84529\":\"Bugbot 的发现率高得惊人。缺陷发现得越早，后续节省的成本就越可观。\",\"03b23ab49cace4c9\":\"借助 Cursor iOS 应用，随时随地开发。灵感来袭时即可启动智能体，工作进入待审查时接收通知，并随时随地合并 PR。\",\"0444cc925fff818d\":\"缺乏用量可见性\",\"044d0639bddf25c3\":\"代码库、模型和 MCP 访问控制\",\"045741aa62df51f8\":\"所有\",\"04586242689516bf\":\"将问题委派给智能体，清理您的待办积压。\",\"04caa08abf946368\":\"在云端以自动化方式运行这些迁移，意味着它们会在后台持续执行，不会影响其他工作，也不会占用开发者的时间。\",\"04e9d7343f6bf3ff\":\"接受所有\",\"0517f6325c5bb7f6\":\"在会话线程中 @Cursor，即可在保留完整上下文的情况下委派任务。\",\"05352823306f0edd\":[\"所有即将举行的 Cursor Cafes、线下聚会和工作坊都列在我们的 \",{\"c\":\"Luma calendar\",\"i\":1,\"t\":\"a\"},\" 上。您可以订阅，以便在您附近有新活动时收到通知。\"],\"0570606078e641c8\":\"构建您的第一个自动化\",\"057236a0a0f7235d\":\"访问顶尖模型\",\"05a5d77f162be573\":\"SCIM 用户预配\",\"05c75fb690768c76\":\"使用无头 CLI\",\"061357d71ac13fb6\":\"作者：{name}\",\"0620c34158fe0b46\":{\"c\":\"阅读案例 →\",\"i\":1,\"t\":\"ResolvedLink\"},\"063b2f78b38bbd80\":\"按频道配置默认值，将关键词路由到正确的代码仓库，并始终由您掌控隐私设置。\",\"06893c985b2a2dde\":\"自主云端智能体是下一步。每个智能体都在自己的虚拟机上运行，因此您可以交办任务后继续处理其他事情。智能体会持续工作数小时，反复迭代并测试，最终返回可供您审查的工件，而不是一个需要您自行还原的会话。人类的角色也从逐行指导，转变为定义问题并设定审查标准。\",\"06cebfc340f757fd\":\"调试 Checkout 页面\",\"06f39d058328ca03\":\"请输入您的街道地址\",\"0701c6f018274237\":\"智能代码仓库和模型路由\",\"0735ce53a3a2f5b4\":\"查看更多\",\"0751d36957cf9b2a\":\"lgtm，@cursor 合并吧\",\"075bb4f8e3113243\":\"思考 6 秒\",\"07939f34549c6e15\":\"参加 Cursor 活动时可以期待什么？\",\"07dec9ca61a08fde\":\"可在浏览器中运行云端智能体，无需安装。\",\"080502143f3f3a09\":\"您计划如何使用 Cursor？\",\"080c4edc84be87b0\":\"开始使用 Cursor CLI\",\"08144ff2d441e250\":\"这些智能体在云端各自独立的机器上运行，可由预定计划或您已经在使用的工具触发。它们负责规划、构建、测试、监控和维护，随后交回可供您审查的成果。只有在真正关键的环节，才需要人类参与。\",\"0857b1aaf24259e7\":\"撰写文章\",\"08c5726012d5e86b\":\"Cursor Start 是一款专为印度开发者打造的亲民月度规划。除提供云端智能体访问权限、支持远程控制的 Cursor iOS 版，以及通过插件、MCP 服务器、钩子和技能将 Cursor 扩展到其他工具和工作流的能力外，Start 还提供更多 Grok 和 Composer 模型访问权限。\",\"08cbda9f66186976\":\"有限的 Tab 补全\",\"0967ed3c1e7b5c8b\":\"Plus 的 4 倍\",\"098bfc2c61b023de\":\"毫无疑问，Cursor 是我目前正在付费使用的最实用的 AI 工具。它速度快，会在您需要的时候和位置自动补全，能正确处理括号，键盘快捷键设计合理，还支持自带模型……整体打磨得非常到位。\",\"09a9bd8f1f2ec3b1\":\"₹649/月\",\"09cd7427e471ed64\":{\"d\":{\"b\":{\"other\":{\"c\":[{\"c\":{\"i\":4,\"k\":\"_gt_n_4\",\"v\":\"n\"},\"i\":3,\"t\":\"span\"},{\"c\":\"条回复\",\"i\":5,\"t\":\"span\"}],\"i\":2,\"t\":\"C2\"},\"plural\":{\"c\":[{\"c\":{\"i\":4,\"k\":\"_gt_n_4\",\"v\":\"n\"},\"i\":3,\"t\":\"span\"},{\"c\":\"条回复\",\"i\":5,\"t\":\"span\"}],\"i\":2,\"t\":\"C2\"},\"singular\":{\"c\":[{\"c\":{\"i\":4,\"k\":\"_gt_n_4\",\"v\":\"n\"},\"i\":3,\"t\":\"span\"},{\"c\":\"条回复\",\"i\":5,\"t\":\"span\"}],\"i\":2,\"t\":\"C2\"}},\"t\":\"p\"},\"i\":1,\"t\":\"Plural\"},\"09e1baafad0af281\":\"Cursor 正与工业 AI 协会合作，共同推进由智能体驱动的工业软件与产品工程。\",\"0a863e23682fd778\":\"思考 2 秒\",\"0aa0e901f2f4db0d\":\"一个智能体，贯穿您的整个工作流。\",\"0add45989a7cd5a3\":\"Bugbot 审查 PR、标记真实问题，并在缺陷进入生产环境前推送修复。\",\"0b1d1692895304cf\":\"获取团队版\",\"0b5ca3c7f0b909ac\":\"构建并运行测试\",\"0b8ea8767d109318\":\"AI 代码跟踪 API\",\"0be55ba5b238b54f\":\"商业方案\",\"0c0048059797ade0\":\"用户访问控制\",\"0c063904b2116ab1\":\"我原本是那种一辈子都站队 IntelliJ 的人，现在却成了 Cursor 的头号拥趸之一。总体来看，我们已经看到工程效率提升了 2–5 倍，在处理技术债务、代码重构和单元测试方面也更出色，还能把原本需要数周才能做出原型的想法，在几小时内做出原型。\",\"0c096eec95ccebed\":\"自动审查 PR，对潜在问题发表评论，并在缺陷进入生产环境前修复缺陷。\",\"0c1c3c83a17f1148\":\"高级版\",\"0c3b9762b2bccef6\":\"所有工作坊\",\"0c72523f35c36b7f\":\"@Cursor 添加单元测试，检查 Git URL 工具函数\",\"0c7d0f9e64cfeb51\":\"继续探索\",\"0c808b8028e9043c\":\"支持。隐私模式受支持：Cursor 和 LLM 提供商都不会使用您的数据进行训练。您还可以控制在包含外部成员的 Slack Connect 频道中是否显示智能体摘要。不支持隐私模式（Legacy），因为云端智能体在运行期间需要临时代码存储。\",\"0cb42a347367888c\":\"请输入您的电话号码\",\"0cb50ac22851134f\":\"思考 3 秒\",\"0cbe4790e630bd31\":\"包含个人的所有功能，另加：\",\"0d2931d7f8ee4ab7\":\"现场套件申请表\",\"0d2ca5ff08a6a474\":\"筛选点播课程\",\"0d349228d3846747\":\"Cursor 会使用哪些上下文信息来界定工作范围？\",\"0d381d934f1c8d7e\":\"深受全球顶尖开发者信赖\",\"0d3a0f1a631d8ea6\":\"有限的 Agent 请求次数\",\"0d3bbb837c0d96d8\":\"Web 与移动端\",\"0d58d5a2c67ecc21\":\"打开项目\",\"0d7be5f51183eca2\":\"通过 SDK 构建的云端智能体使用与 Cursor 的 Cloud Agents 相同的运行时。如果您需要不同的运行时，同一个 SDK 也可在本地或自托管环境中运行。\",\"0d820e74fe415fc2\":\"查看文档\",\"0d83261899df73c2\":\"加入我们，一起塑造开发的未来！Ambassador 致力于赋能社区，让我们的生态系统更具活力与协作精神。\",\"0d871ed82140a33c\":\"正在打开 https://nextjs.org/docs\",\"0d97f9c66db79593\":\"名\",\"0d996d48ed2da685\":\"云端智能体可自主控制自己的计算机，构建富有雄心的软件。\",\"0dc00cb6c2595ad0\":\"cursor.com/team/new-team\",\"0e38ebf4df211f43\":\"您可以使用此表单联系我们的销售团队。感谢您的关注。\",\"0e889966aa0da646\":\"在全局范围内配置模型访问权限、MCP 控制和系统级智能体规则。\",\"0ecfb5780a0ed42b\":\"申请团队培训\",\"0ef5e4afce113012\":\"获取 Cursor 的最新动态。\",\"0efde7eab6950270\":\"客户案例\",\"0f04d736307585b4\":\"Cursor 智能体会使用代码仓库上下文和编程工具，在做出变更前先了解系统的运行方式。\",\"0f18c24c479c5e44\":\"使用 AMP 运行 PyTorch MNIST 实验并分析结果\",\"0f2527dae52b4642\":\"构建电商仪表盘\",\"0f25e71bb01cc7b1\":\"为大规模团队打造经久耐用的软件\",\"0f561950a1bff871\":\"开始使用 Cursor Enterprise。\",\"0f614a25abb9b06a\":\"我可以自定义 Bugbot 的代码审查方式吗？\",\"0f8421715298256c\":\"访问我们的论坛\",\"0faf657712a9d10a\":\"规划\",\"0fce019bf9c57475\":[{\"c\":\"GitHub 深色\",\"i\":1,\"t\":\"option\"},{\"c\":\"深色+ (VS Code)\",\"i\":2,\"t\":\"option\"},{\"c\":\"Nord\",\"i\":3,\"t\":\"option\"},{\"c\":\"Rosé Pine\",\"i\":4,\"t\":\"option\"},{\"c\":\"One 深色 Pro\",\"i\":5,\"t\":\"option\"},{\"c\":\"Dracula\",\"i\":6,\"t\":\"option\"},{\"c\":\"Monokai\",\"i\":7,\"t\":\"option\"},{\"c\":\"Vitesse 深色\",\"i\":8,\"t\":\"option\"},{\"c\":\"Min 深色\",\"i\":9,\"t\":\"option\"},{\"c\":\"Solarized 深色\",\"i\":10,\"t\":\"option\"}],\"0fef8deb0811c604\":\"招聘\",\"10095e73697ca626\":\"集中式计费与管理\",\"10161e01d8b54e40\":\"部分界面\",\"102fbe92ac5e33b6\":\"重新播放演示\",\"103a62614f8598df\":\"用 Cursor 自动化重复性工作。\",\"1044788f1df495c5\":\"发生错误，请重试。\",\"105236735d527307\":\"MDM 分发\",\"105ea70f0999ab4d\":\"{price}（按月付费）\",\"105f2ac7d5c0c7b4\":\"选择按年付费，节省 20%\",\"107734be2c6d570e\":\"查看公告\",\"10b2a727cf9748a0\":\"将具体实现委派给后台智能体，让您的团队专注于更高层级的方向把控。多智能体工作流可将数周的工作压缩到几天内完成。\",\"1106f2d99ebeee36\":\"查看代码的演变过程，并可随时回滚到之前的快照。\",\"110ede0a7f2c004e\":\"查看所有工作坊\",\"1130dfe0ca538f12\":\"深受以下公司的工程团队信赖\",\"115f319d56bc136b\":\"正在根据您的偏好规划后续步骤\",\"115f8af592ad9ca7\":\"切换 {name}\",\"117e211c7dc425c2\":\"Cursor Start 在哪些地区可用？\",\"11930106846e26be\":\"自动运行\",\"11e5b92501e978f9\":\"深受打造高质量产品的团队信赖。\",\"1210d73f0c5ea91b\":\"在移动端使用 Cursor 进行构建\",\"12142a8c3b441850\":\"我的规划是否已包含 Grok API？\",\"1233443c4445f586\":\"自动委派工作\",\"123e6988cd2e7d98\":\"已合并到 main。\",\"124395984ddcb3f9\":\"选择 Pro+\",\"126a2f2821b99142\":\"思考 12 秒\",\"126d48d2163cc3ff\":\"联系销售\",\"1282cf10745d2596\":[{\"c\":\"您要查找的页面不见了，不过别担心！\",\"i\":1,\"t\":\"p\"},{\"c\":\"让我们带您回到正轨。\",\"i\":2,\"t\":\"p\"}],\"129191fef1e38159\":\"下载指南\",\"129fac7366443c00\":\"所有团队均可编辑\",\"12a71bf8c2747c0f\":\"最佳的 LLM 应用都应具备一个自主性滑杆：由您来控制赋予 AI 多大的自主空间。在 Cursor 中，您可以使用 Cmd+K 进行有针对性的编辑，也可以切换到完全自主的智能体模式，放手让它全力发挥。\",\"12d03024b489f5be\":\"品牌\",\"12f1b640154bdb0f\":\"未启动？请重试或在下方选择其他平台。\",\"1339ae6268a22afa\":\"使用语音输入，像和同事交流一样，把您的创意直接说出来。\",\"133f04c24b836d85\":\"创建了带有文件资源管理器和语法高亮的 Cursor IDE 演示\",\"138c0bb69670bd2a\":\"感谢您的提交\",\"13c358b4aeea450c\":\"AI 正在改变软件的构建方式。\",\"13d9a5926cecdbeb\":\"在正向评价中，93% 的工程师选择 Cursor 作为他们首选的 AI 编程工具。\",\"13e5cf3f011db0da\":\"获取此集成\",\"13f0b8b4274e1b49\":\"走进社区\",\"144b077d72c9222c\":\"用量分析\",\"14613292a64ced76\":{\"c\":\"快速切换：\",\"i\":1,\"t\":\"span\"},\"147ffbbb322e4d8a\":\"将你现有的上下文提供给 Cursor，并添加自定义功能。\",\"14896e81ec62d44e\":\"粘贴堆栈跟踪，或描述一下缺陷。其余的交给 Cursor。\",\"1497bb187255ddc7\":\"只需 ₹649/月，即可享受更多访问权限和更高的用量上限。\",\"149a9f4df69f9a13\":[\"年化收益率（“APY”）截至 \",{\"i\":1,\"k\":\"_gt_value_1\",\"v\":\"v\"},\" 准确有效，之后可能调整。收益率和适用资格因订阅和司法管辖区而异。The X Subscription 的高级版、Super 或 Ultra 规划订阅者，以及旧版 X Premium+ 订阅者，均符合享受 \",{\"i\":2,\"k\":\"_gt_value_2\",\"v\":\"v\"},\" APY 的条件。所有其他用户在满足合格直接存款要求后，可能有资格享受提升至 \",{\"i\":3,\"k\":\"_gt_value_3\",\"v\":\"v\"},\" 的 APY。纽约州居民的储值账户不享有 APY、利息或利息加成。有关详情、适用资格和当前收益率，请查看\",{\"c\":\"此处\",\"i\":4,\"t\":\"a\"},\"。费用可能影响你的收益。你的资金存放于 FDIC 成员银行 Cross River Bank 及其他受 FDIC 保险保障的机构。穿透式存款保险保障须满足特定条件方可适用。X Payments LLC 并非受 FDIC 保险保障的银行。存款保险仅承保受保银行倒闭的情况。\"],\"14f6a8e1cb34569a\":\"云端智能体\",\"14fb80e79f058d36\":\"隐私模式\",\"1532cdd8a1e9bdec\":\"没问题\",\"15360e22a6defd23\":\"直接在终端中。\",\"158c454e7818dd18\":\"在 Optiver，我们最近已将 Cursor 的使用扩展到全公司范围。我们的团队始终认为，Cursor 稳定可靠、具备上下文感知能力，而且足够灵活，能够支撑一家全球交易公司所需的规模与复杂性。\",\"1590a31a24434712\":\"动态路由的关键特性：\\n\\n• **参数**：通过 `params` 属性访问路由参数\\n• **静态生成**：使用 `generateStaticParams` 预渲染页面\\n• **嵌套路由**：可与布局文件结合使用\\n• **Catch-all**：使用 `[...slug]` 匹配多个片段\\n\\n路由 `/blog/my-post` 会匹配此模式，`params.slug` 的值将是 `'my-post'`。\",\"15cd186f0b3f3b07\":\"智能体会定期分享数据更新、生成代码库摘要，并更新文档。\",\"15e4a8481fd5c063\":\"我们可以如何帮助您？\",\"16072d2ebe6990b5\":\"AI 共享用量池\",\"166661f94b300f5b\":\"完成\",\"16ad0acfe286ec0a\":\"通过 SCIM 控制分发范围并进行访问控制\",\"16c7e913f1a1e4de\":\"如何使用 Cursor 调试 JavaScript 或 React 应用？\",\"16ca5c362c96b0bb\":\"下一步操作预测。\",\"17164bbc3bb0a1d9\":\"与其他 Cursor 用户建立联系。\",\"1738f499d0c9cf60\":\"研究\",\"173f04a39f8d525a\":\"智能体限额为标准版的 3 倍\",\"17503a24f3657b87\":\"我们很高兴基于 Cursor SDK 构建我们的编程智能体基础设施。这包括 Slack 机器人、客户支持自动化，以及供我们内部后台智能体使用的 harness。能够以编程方式访问完整的 Cursor 智能体，并灵活访问运行时和模型，让我们可以统一部署，而不必为不同工作流程对接不同接口。\",\"176fb13e62f659f3\":\"个人版和团队版套餐的价格按当前汇率估算。\",\"17d8ba525326ba71\":\"免费\",\"17ed772aade6d804\":\"继续阅读\",\"17f18ec9bd9000f2\":\"移动应用（iOS）和远程控制\",\"18299d266f20f300\":\"Cursor Start 目前向印度用户开放。未来可能会逐步扩展到部分地区。\",\"18680eb76d8305d7\":\"阅读案例\",\"18b52a73cbe6ca8c\":\"读取 components/ChatMessage.tsx\",\"18ed776423bd8218\":\"每个团队都会沿着同一条曲线演进。起点是 Tab：低熵、击键级的建议。接着是同步智能体，此时开发者在提示与响应的循环中指挥工作，并在每一步都保持参与。\",\"18f71a4dede4311a\":\"读取中\",\"190bcb4243c71a44\":\"适合智能体原生团队\",\"193bda6a94fecc26\":\"汇总用量\",\"193c27ac4d20d97c\":\"CLI\",\"19600c47b96ff097\":\"使用直接存款可享 {rate}\",\"1980c3aaf0926297\":{\"c\":\"分享您的专业知识，组织活动，并培育充满活力的开发者社区。\",\"i\":1,\"t\":\"p\"},\"19be644bc942c37f\":\"工厂\",\"19d409e0bb1063ac\":\"将个人工作流转化为团队共享的基础能力。\",\"19ed295bdbbd37e9\":\"隐私政策\",\"19fbb605a61bc3ad\":\"粘贴一条错误信息，Cursor 会沿着你的代码库一路追踪，定位到引发错误的那一行代码。\",\"1a69170d892d1e8f\":\"正在提交...\",\"1acfe6b95c77a499\":\"我来创建一个命令行运行脚本，让实验更易于执行：\",\"1b06a6b4a549ab66\":\"无广告滚动浏览\",\"1b483159a62f8f71\":\"应用市场\",\"1b767a5b7e0073da\":\"可通过浏览器或手机运行 Cursor。云端智能体在自己的计算机上运行，助您构建复杂的软件。\",\"1b793590eb6db4fd\":\"Cursor 可跨文件找出缺陷、解释根本原因，并应用修复。您可以直接在编辑器中调试和重构 JavaScript、React、Python、Java 等代码。\",\"1b95b4d8aa018299\":[{\"c\":\"移动端 Cursor 智能体演示\",\"i\":1,\"t\":\"h1\"},{\"c\":\"交互式演示展示 Cursor 的移动端智能体界面，呈现 AI 驱动的移动端 AI 助手体验。\",\"i\":2,\"t\":\"p\"}],\"1bae2c44c63e6c40\":\"您的健康检查端点目前只检查服务是否在线。正在添加响应时间指标：\",\"1bbfd506511ac9d7\":[{\"c\":\"订阅我们的校园新闻简报\",\"i\":1,\"t\":\"a\"},\"，即可抢先获取即将举行的活动信息、专属折扣和入门指南。\"],\"1bd26b9368234927\":\"了解 Tab\",\"1bdeba6fd62ab0a7\":\"你的键盘刚刚升职了。\",\"1bf40d71d8607857\":\"推动工作进展\",\"1bf75845e1ae876c\":\"智能体可跨文件批量应用大范围更改，而您可以审查每一处 diff。\",\"1c4e7ffd651ae5d5\":\"找到问题了！checkout API 调用使用的是 GET 而不是 POST，而且购物车商品没有包含在请求 body 中。API 返回了 405 Method Not Allowed 错误。\\n\\n我会修复 `handleSubmit` 函数，以正确通过 POST 提交购物车数据：\",\"1c7eb83ed13b21b0\":\"Blog\",\"1d0ea2743837d731\":\"在 Cursor 中修复\",\"1d5d56866a0bba85\":\"请输入您的邮编\",\"1d787830aa3d3ccd\":\"将某个问题分配给 @Cursor，或在评论中提及 @Cursor。Cursor 会分析该问题并启动一个云端智能体。\",\"1db881229ff7daf0\":\"按工程师分别设置智能体，容易造成配置分散\",\"1dc5abe270bd948b\":\"用 Cursor 启动你的下一项任务 →\",\"1dec3bd27e548ec2\":\"同一套工作流适用于所有主流语言和框架。\",\"1e6d9523cc91a66c\":\"使用 Cursor Start 开始构建\",\"1e716df42ef0447f\":\"Grok Bot 的访问、网络和审计控制\",\"1e8ecc3e09a7c510\":\"了解模型\",\"1ea6526b14e4170e\":\"改变你的团队构建软件的方式。\",\"1eafc6704f1cdb21\":\"无法加载 Cookie 类别。请点击“接受所有”，也可以重试。\",\"1ed3de800becb130\":\"请查收您的电子邮件，获取报告副本以及有关如何使用团队版试用的信息。\",\"1f266c4baff96f60\":\"当前暂无已安排的即将举行的工作坊。\",\"1f41c8bde7d3cd8c\":\"通过智能体直接运行 shell 命令，并进行安全检查和显示输出。\",\"1f57dde5f8d583ba\":\"面向整个团队的 Bugbot、云端智能体和自动化\",\"1f87f354dab3ab46\":\"阅读关于我们安全性的内容\",\"1fa6d65ca414c680\":\"定价页面\",\"1fe3b8b7905a7df1\":\"读取 brand-guidelines.pdf\",\"200396109b626b6b\":\"Grok 4.7 在智能体编程和知识工作基准测试中的表现。\",\"2027abb04ba2a01a\":\"兼具本地与云端优势\",\"202c4e0f4aaf43a8\":\"开始使用 Bugbot\",\"204167c06dc9fb6e\":\"状态\",\"20815fef57ab15f0\":\"查找严重缺陷 → 创建修复方案\",\"20a275a3df633dbf\":\"演示胜过 diff\",\"20cc2055c35d0f22\":\"已读取 notebooks/train_model.py（当前实现）\",\"20edf4cce8e91b95\":\"将您团队中最佳工程师的设置应用给每个人\",\"2101db6ec26c4c17\":\"您可以从 Cursor 应用市场安装 Datadog 插件，也可以在 Cursor 设置的插件下安装。使用 MCP 服务器前，您需要选择 Datadog 域名并完成 OAuth 登录。\",\"2152482e32a80707\":\"创建一个自动化，用于分析新提交中的高严重性缺陷，并提交安全的修复方案。\",\"21967c1e688f4e74\":\"团队级隐私模式\",\"21a97c4017e31a49\":\"已读取 src/domain/ride.rs、src/geo/mod.rs\",\"21b6748b2590c9a4\":\"图像生成（Imagine）\",\"21b9a8bf7d73d803\":\"系统主题\",\"21c3a553a9322fc3\":\"用自主智能体构建\",\"21f359f0de820ba6\":\"深受超过半数《财富》500 强企业信赖，以安全且可规模化的方式加速开发。\",\"22439bb8cd01a52f\":\"基于 SAML 的 SSO 集成，保障用户安全访问。\",\"22443d8b4d9fe0d0\":\"最新更新与改进。\",\"224b6eecfd42b515\":\"Blog\",\"22905d413a63bd5b\":\"自定义嵌入模型为智能体在大型代码库中提供业界领先的召回效果。\",\"22a304da415a1b25\":\"成为 Cursor Campus Lead\",\"22b8f0d7a9818d72\":\"高级版认证标志\",\"22b99825e8a1eb24\":\"了解更多\",\"22c87218af6cf041\":\"打开 {fileName}\",\"22dde13cc894aa15\":\"云端智能体可以在自动化中使用 Datadog MCP 吗？\",\"236ee66b15293aea\":\"已读取 .cursor/rules/*.mdc 文件\",\"23983c791ad5d9a8\":\"额外权益\",\"23987d2259b47dad\":\"为任意公开频道设置默认代码仓库和基础分支，这样队友提及 @Cursor 时，无需再指定这两项。\",\"23c94233c50f0867\":\"Hobby\",\"23dee9aef1be0948\":\"企业管理员可以设置角色权限，将代码仓库、模型和 MCP 服务器加入白名单或阻止名单，并配置全局智能体运行设置。\",\"23e099a30844e1ee\":\"Bugbot 对大型 MR 特别有帮助。它生成的摘要能够准确概括实际的代码变更。我见过它发现连人工代码审查都遗漏的实现错误。\",\"23f0f812cf8b8128\":\"连接 Linear\",\"23f664c064cfb6b2\":\"分析仪表盘仅限管理员访问\",\"23fd477aabf7697a\":\"始终掌控发布内容\",\"243a30e57151b032\":\"在不同角色和资历层级中，我们看到 PR 数量增长了 25% 以上，平均每个 PR 的规模增长了 100% 以上。综合来看，这意味着我们的代码交付量大约提升了 50%。\",\"245c34b6a30df38f\":\"构建\",\"24912a9c16e05498\":\"深受开发者喜爱\",\"24a510232843dccd\":\"包含高级版的全部功能，另享：\",\"2500ef6e08ab7840\":\"视频后台播放\",\"250474470097d714\":\"可以。Datadog MCP 是云端智能体可用的工具，无论是手动启动，还是通过按计划运行或响应事件触发的自动化启动，均可使用。\",\"250716628e9cbe4d\":\"深受世界一流团队日常信赖\",\"2538c2d97c9b5e23\":\"进行中\",\"253dba75f81779d6\":\"移动端\",\"2574d58b302a4005\":\"此优惠仅面向符合条件的个人和组织，资格由 Cursor 自行认定。提交此表单或预约会议并不保证您一定能获得键盘。键盘数量有限，送完即止。\",\"25be61b57b4924d0\":\"子智能体会并行运行，探索你的代码库，并为每项任务选用最佳模型。\",\"26205fd1b4454824\":\"Slack 和 Microsoft 团队版\",\"262b6fc7fc66c7de\":\"查看所有\",\"2630e7b58f5f271b\":\"继续\",\"2632f324dc2d9c48\":\"智能体\",\"26389167fa52d341\":\"近期亮点\",\"263999ebe15be0d0\":\"全球合规与安全认证\",\"264a534b63a703c3\":\"我可以通过经销商或第三方购买 Cursor 吗？\",\"26859ccb4f0c22f8\":\"Cursor 让我们这些此前没有 Web 开发经验的学生，也能快速构建出 alphaXiv，而这款应用如今已被数十万名研究人员使用。\",\"268cd4299d184cb9\":\"支持多行更改、跨文件跳转，以及贯穿整个代码库的重构。\",\"2691935711df54b0\":\"智能体会在隔离的 VM 中并行运行，每个都有各自的开发环境，用于编写代码、测试并确认更改。\",\"269f12f59c04e25e\":\"面向全球学生的 AI 编程新方式。\",\"26afe1c2ac971108\":\"常见问题\",\"26d50b5eba7ebe59\":\"先从几个用于处理日常重复性工作的始终运行工作流开始。我们建议优先使用这些工作流。\",\"26e7afeaadfeb09e\":\"请输入有效的邮箱地址\",\"273d4e88494ecd0f\":\"选择你的国家\",\"2797fc138ccd4a69\":\"app/page.tsx +52 -0\",\"27db937cba80a4da\":\"团队版\",\"282f72577432aaf5\":\"打开标注工具，在图片上做标注，并在固定位置添加评论。\",\"284bd84147bae4d2\":\"设置始终在线的智能体，让它们按计划或触发条件运行，帮助构建、维护和修复你的软件。\",\"2852037b91615e74\":\"面向有抱负团队的编程智能体。\",\"286799383e9ee00e\":\"获取可直接合并的 PR\",\"286b203808713145\":\"把工作交给云端智能体\",\"2871d92f80fa4910\":\"打开导航\",\"288444ddbb0804d5\":\"Auto-run、浏览器和网络控制\",\"288c2d92df27a68c\":\"模型\",\"28a6e9345c35fe69\":\"您需要拥有 Cursor 管理员权限，并使用已启用 Rovo 的 Jira Commercial Cloud。\",\"28aadb8b0fa9ff77\":\"产品\",\"28b8a5ff2c994d23\":\"正在加载日历...\",\"28d9d35874b5e3f1\":\"读取 .add-to-cart 按钮元素\",\"2915a272ff411af7\":\"支持。我们支持主流 IdP（如 Okta、Azure AD、Google Workspace 等）。管理员可以强制启用 SSO、禁用本地登录，并通过 SCIM 配置或取消配置用户。\",\"2915edddbb99ce17\":\"添加领域知识，让 Cursor 能够发现并运行专业化的提示和代码。\",\"293cecd06c136d07\":\"无需承担构建和维护整套智能体技术栈的开销，也能构建智能体。\",\"2969e8a543c3df52\":\"只需一句提示词，即可使用 Datadog。\",\"2a3012c0c74b4dca\":\"已搜索 domain 层中现有的 RideRequest 和 geo 类型\",\"2a3c29b646342f39\":\"创建团队\",\"2a551f2951953cfb\":\"使用 Cursor SDK 构建程序化智能体\",\"2a9faae8db103f7e\":\"让您的工程团队使用统一的工具和最佳实践。\",\"2ac3c0a8906e5cb1\":\"**缺陷：函数返回的是对象而不是字符串（逻辑缺陷）**\\n`composerOpenModeToggleKeybinding` 是一个需要调用才能获取其值的函数。这会导致该条件始终为真。\",\"2b01f3f4e07b7e05\":\"在您偏好的 IDE 中使用\",\"2b0c8e42ef395da5\":\"app/dashboard/page.tsx +84\",\"2b6b966c94d044da\":\"审查每个 PR\",\"2b9119d7a856c165\":\"选择适合您的规划\",\"2b946ae68a8bddc8\":\"多种模型可选\",\"2b9ca3266edb8642\":\"Cursor 和 LLM 提供商都不会使用您的数据进行训练。您还可以控制智能体摘要是否显示在包含外部成员的 Slack Connect 频道中。\",\"2bcd3025ad7afcd8\":\"KTLO / 重构\",\"2c095b47f573462f\":\"要试用 Cursor 智能体，请[下载 Cursor]({link})。\",\"2c1843519c94014f\":\"1 个团队应用市场\",\"2c54b8a76b4f2d72\":{\"c\":\"壁纸\",\"i\":1,\"t\":\"span\"},\"2c6e8f4284c59baf\":\"Cursor 帮助我在更短的时间内完成更多工作，也让我能真正专注于自己最喜欢的部分，比如性能优化和界面设计，而不是被前端中的各种小问题拖住。\",\"2c74b921df11a7cc\":\"你的键盘即将大展身手\",\"2cb8572680e61a03\":\"感谢您\",\"2d30a660ba311bdb\":\"智能体可自主调查事件、检测并修复缺陷，并生成测试。\",\"2d5f1ed27063382d\":\"Cursor 带来了颠覆性的变化。它不仅能帮助编写代码，更重要的是，它还具备独立研究代码库、最佳实践和实现策略的能力。感觉就像拥有一位随时待命的研究助手。\",\"2d8b0218c89a3472\":\"商品页面上的“添加到购物车”按钮消失了。\",\"2ddaf5fa16e7e8a6\":{\"c\":\"功能\",\"i\":1,\"t\":\"label\"},\"2ddcdb83267c1e45\":\"搜索中\",\"2e2287d661aae72a\":\"添加仿射缺口比对。我们目前只有基础的 NW 比对，但我需要 Gotoh 算法来更好地处理插入缺失。此外，也请修复 FASTA 解析器。\",\"2e65adda08f68610\":\"完善的数据保护\",\"2e7057bc1f618169\":\"开始使用 Cursor 团队版。\",\"2e904a9990381ecb\":\"为我们的 Next.js 仪表盘应用设置 Cursor 规则，以确保团队内模式保持一致\",\"2e9902c7aebf6273\":\"将问题委派给 @Cursor，或在评论中提及 @Cursor，即可直接从 Linear 启动智能体。\",\"2e9fa07032210ad4\":\"在浏览器中调试\",\"2eb39a53ad7f7c34\":\"产品\",\"2eb3a76273535c21\":\"提升整个团队的水平\",\"2ec70609f6be4c14\":\"听起来不错。我们打算用什么技术栈？\",\"2ecf88ef9e8e4259\":\"首页\",\"2ed50cabd08367a2\":\"提升代码质量\",\"2f1369fcf0065266\":\"Hobby\",\"2f2ba5520c5ad14b\":\"不可以。订阅仅由 X Subscription Corp. 直接销售。我们未授权任何经销商或第三方卖家。通过其他渠道购买的订阅均未经授权，可能涉及欺诈、存在安全风险，或是通过滥用我们的系统获取的。相关账户可能随时被停用或注销。为保障你的访问权限和安全，请仅通过我们的官方网站购买 X Subscription。\",\"2f339de5a1484382\":\"现在我来把 Haversine 距离计算和 geofence 验证添加到 geo 模块中：\",\"2f39da125f98bb6c\":\"Max\",\"2f583b3ba59a53af\":\"我们一直引以为傲的一点，就是让工程师在入职第一天就能提交 PR。大家开始使用 Cursor 后，会获得出色的体验，因为我们降低了上手门槛，也降低了推广采用的门槛。\",\"3024bf32c7fd44ba\":\"启动云端智能体，在您继续工作的同时，让它们完成构建、测试并发起 PR。\",\"30589efe06e4d26f\":\"刚刚\",\"3096009ed234ce28\":\"在 Cursor 里使用之前，我在 Opus 或 GPT 上都没有感受到那种 AGI 时刻。用了 Cursor 之后，我对编程智能体的期待被拉得极高，以至于再在其他编程环境中使用这些模型都变得难以忍受。\",\"30a26a1d57dc9a0e\":\"了解自动化 →\",\"30cc3b0b7c5223f9\":\"团队版\",\"30e602443b55cd97\":\"从工单到 PR。\",\"313a83e1a9a6173c\":\"将工作委派给云端智能体\",\"314bd8cd0d81f926\":{\"c\":\"指南\",\"i\":1,\"t\":\"Link\"},\"316101379dc1416c\":\"刚刚\",\"31650c11719643c3\":\"标签演示\",\"316d18e019311efa\":\" 创建您的团队。选择名称和计费周期，然后打开您的仪表盘，复制邀请链接或发送邮件邀请。有人加入后，就会新增一个计费席位。系统将按比例收取当前计费周期剩余天数的费用。\",\"316dc2e57cfbd764\":\"Cursor 很快就在 Stripe 内部从数百名极其热情的员工扩展到数千名。我们在研发和软件开发上的投入超过其他任何事务，而让这一流程变得更高效会带来显著的经济效益。\",\"31734973c7818065\":\"Cursor 会在终端运行你的测试套件，并在你提交前确认修复有效。\",\"31800f99c8bb9cd2\":\"远程控制\",\"322b3925cb3d4a01\":\"我可以让 Cursor 做什么？\",\"3230203820653db1\":\"更新日志\",\"32392ff86819f0d0\":\"禁止用户使用自己的 API key\",\"324d9a22a9f40d97\":\"读取 AppManager.tsx\",\"325c1b66985e3336\":\"Java\",\"32881d87c7f08d58\":\"我真的是 Cursor 的忠实拥趸。我一直很享受坚持做自己热爱的、也是倾注了毕生热情的事情，而现在看到这个 AI 工具如何改变我创建软件的方式，更让我感到兴奋。\",\"32b6942e140b561d\":\"借助 AI 编程智能体进行开发的实用教程和手册。\",\"32c06f55ac5af03a\":\"从我们的团队和社区获取解答。\",\"32f5be26785746b2\":\"Cursor Start 是面向印度开发者的亲民规划，价格为 ₹649/月。它为日常智能体式开发提供充足的使用额度，可在 Web、桌面端、CLI 和 Cursor iOS 版上使用 Cursor 强大且高性价比的 Grok 和 Composer 模型。\",\"3310bb07c2699513\":\"无论代码库规模大小，都能轻松理解\",\"3317e6ad9030ac0b\":\"CursorBench 3.1 难度更高\",\"3318987ced27b5a4\":\"免费\",\"331d202443ac4375\":\"不只是自动补全\",\"33491e72172b82ae\":\"lib/inventory.ts +14 -6\",\"33771bd783d6980b\":\"太棒了！我已经添加了：\\n\\n1. **Gotoh 算法**，使用正确的仿射 gap 罚分（gap open：-10，extend：-1）\\n2. **修复后的 FASTA 解析器**，可处理多行序列并清理空白字符和数字\\n3. **ORF 查找器**，可在全部三个阅读框中搜索起始/终止密码子\\n4. **反向互补**函数，用于同时搜索两条链\\n\\nGotoh 实现使用三个矩阵（M、X、Y）分别跟踪匹配/不匹配和 gap 状态，因此对于带有插入缺失的序列，能够得到更好的比对结果。您现有的 `nw_align` 函数保持不变。\\n\\n要我创建一个快速测试，确认一切都能正常工作吗？\",\"337fc3727734dcf0\":\"查看更多文章\",\"33a6e1d039c22e4b\":\"按 Ctrl+C 停止\",\"33c56205fb9fed4e\":\"云端智能体会测试并确认其工作，然后返回视频、截图和日志等产物。\",\"343548079c6f962e\":\"请选择您需要哪方面的帮助\",\"347c8ad4a96b2d98\":\"查看所有指南\",\"3489f50920086dda\":\"快速搜索代码库\",\"34911158c72918f7\":\"思考 5 秒\",\"34b7075af03dd20b\":\"联系销售\",\"34f8d19c66148401\":\"正在编写测试\",\"3528ed0ea406d645\":\"公司\",\"3567f3f0792ba591\":\"比较各规划的功能\",\"3591fff21853bc7a\":\"身份验证是如何处理的？\",\"359ce1060d921922\":\"在整个组织范围内强制执行\",\"35b85c2be3392d46\":\"自动化让工作中重复性的部分更容易被分担出去。通过创建自动化来汇总任务、处理文档更新并回复 Slack 消息，我就能专注于真正重要的事情。\",\"360e1dc944cbc91e\":\"浏览活动\",\"361478784ed819e3\":\"Cursor 会在内置浏览器中打开应用，读取控制台错误，并修复状态管理、异步和渲染方面的缺陷。\",\"36176f21802c7bdf\":\"这与 Bugbot 有何不同？\",\"36485e1e5ea09775\":\"在问题中描述所需功能或缺失的测试覆盖，Cursor 会完成实现，然后打开一个 PR 供审查。\",\"366451888f3910ae\":\"将缺陷报告转化为修复方案。Cursor 会根据工单中已有的描述、评论和上下文开展工作。\",\"3666b0d9244feaa5\":\"builder.rs +89 -12\",\"36e2486b3ac57bee\":\"将 Linear 问题分配给 Cursor，或在评论中 @Cursor，即可启动会创建拉取请求的云端智能体。\",\"36ec0ea9129f1b20\":\"让 @Dropdown.tsx 看起来像 🌐 stripe.com/checkout\",\"36ffad4f631c30cf\":\"默认启用隐私模式、SAML/OIDC 单点登录，以及 RBAC\",\"37158848c91182b9\":\"使用生产就绪的云基础设施\",\"3725d2153aaf8692\":\"指南\",\"372ab972d4e067da\":\"您可以从任意界面发起并管理更多并行运行的智能体。\",\"37479b5348d1cdcd\":\"已读取 types/user.ts\",\"374a1ddaa78d8cf7\":\"无需信用卡\",\"37a318097d13899e\":\"管理访问权限、落实隐私保护，并跟踪用量。\",\"37d5f04832254b86\":\"自动化会遵循您的自定义指令，仅在任务需要时才会调用 Datadog MCP。\",\"37dda061afe0c8e8\":\"感谢您——让您的键盘发挥更大价值。\",\"37e540c0a3c4d41a\":{\"c\":\"内边距：\",\"i\":1,\"t\":\"label\"},\"381475c4965207a6\":\"发现得好，合并中！\",\"3830d250935346a2\":\"当前活跃\",\"38410da8fdac6584\":\"Cursor 提供了出色的云端体验，让您可以从编辑器和 CLI 并行运行多个智能体。我们对 SDK 也非常期待，因为它让我们能够在同一云运行时上运行自己的程序化智能体，无需管理 VM，也不用费力规避内存限制，从而在不需要开发者持续干预的情况下保持代码库健康。\",\"3863066195ee7a75\":\"合作伙伴聚焦\",\"38848dddebaebbe7\":\"Grok 构建\",\"38ce9b4cc26534d9\":\"了解智能体驱动的开发\",\"38e230d9b460e24d\":\"安排一个智能体审查新的错误日志，识别可能的根本原因，并在您的团队开始工作前就总结出调查结果。\",\"38e673865704fb36\":\"适合协作交付的团队\",\"38fbca7a03b30cd0\":\"通过面向插件、技能、规则和钩子的团队应用市场，集中沉淀您最优秀工程师的工作流。\",\"3902e316be3f33d5\":\"团队管理与计费\",\"390c7241e5ad4918\":\"团队版包含哪些用量？\",\"392e65b8c8164c73\":[\"Campus Lead 通过分享行之有效的方法、组织活动和壮大学生社区，在各自学校代表 Cursor。名额有限。\",{\"c\":\"前往我们的 Campus Lead 页面了解更多并申请\",\"i\":1,\"t\":\"a\"},\"。\"],\"3966ca5528eac1ef\":\"我们将这一流程自动化，让 Cursor 实现并执行每项实验，于是原本需要数月的工作在四天内就完成了。\",\"39677365ef5dde5d\":\"联系销售团队\",\"397e527cc3aa17be\":\"已搜索“gotoh algorithm implementation python”\",\"398613665537a551\":\"Grok API 访问\",\"39bb80937ee72e70\":\"可从 GitHub、Slack、Linear、JetBrains IDEs 等平台启动智能体。\",\"39c38a7c8eb42898\":\"联系表单 - 邮箱步骤\",\"39cf02c79e7cfd45\":\"正在规划后续步骤\",\"39f816f8bbc424df\":\"请描述该缺陷或粘贴报错信息。Cursor 会先提出假设，通过在您的代码中加入日志语句进行观测，再利用由此产生的运行时数据定位根本原因，然后应用您可审查的修复。\",\"3a38d8a4f875951a\":\"智能体\",\"3a78a1a39fbe45f8\":\"已 grep UserProfile.tsx\",\"3ab928741d208f41\":\"正在加载...\",\"3ac2b68383b89909\":\"产品场次\",\"3ac800cada315164\":\"我再使用 tokio 创建异步测试来验证 dispatcher：\",\"3acfc64feeec1c38\":\"街道地址\",\"3b05ed056a1db7ac\":\"我希望能直接跳转到 cursor.com/changelog#1.0 来查看 1.0 的更新日志\",\"3b28878accf137fb\":\"公司\",\"3b2ba331943e031b\":\"Cursor 帮助你的整个团队交付雄心勃勃的产品。\",\"3b5027192f9a223a\":\"桌面端\",\"3b59df5f14e962d7\":\"帮助您了解团队行为的用量分析\",\"3b654811c92e5146\":\"感谢您预约与我们的销售团队的会议。\",\"3b69519735ec5a12\":\"Datadog MCP 是云端智能体可以自主使用的工具。您可以将它接入按计划运行或由事件触发的自动化。\",\"3b6eed562a1a63a2\":\"构建并测试项目\",\"3bbf014885dd2a5f\":\"请描述该任务...\",\"3bfb294f5a551248\":\"插件、MCP、钩子和技能\",\"3bfe28aeb15e4890\":\"默认关闭\",\"3c185b31f0be16ff\":\"请描述该缺陷...\",\"3c426320fae94089\":\"自动更新文档、触发安全审查，或构建自定义编程智能体。\",\"3c68a5ff6b5eb984\":\"查看所有即将举行的工作坊。\",\"3cbd178fbe0ce588\":\"下载 Grok Bot →\",\"3d0c87d1057cfe13\":\"企业\",\"3d26c791d3bcb69a\":\"安全\",\"3d4124e66f69377e\":\"阅读 AI 软件开发的第三个时代\",\"3d436cb9d7699759\":\"覆盖所有工具，贯穿每一步\",\"3d7777433929e536\":\"每位工程师都得独自摸索 Cursor\",\"3db36f8fcd2f6f14\":\"将你的偏好教给 Cursor，从团队约定到具体的架构决策。\",\"3db62ff1b89fc1bc\":\"app/api/health/route.ts +12 -3\",\"3dbc1becd9b80bbe\":\"读取 app/layout.tsx、styles/theme.css\",\"3de4be9ec364e438\":\"middleware.ts +28 -4\",\"3e1fded18cc21f76\":\"编程智能体 CLI\",\"3e3c2283205574d4\":\"订阅我们的新闻简报，获取博客更新和原创内容\",\"3e74a7c1fef80184\":\"启用组织范围的隐私模式后，您的代码绝不会被用于训练。Cursor 还与所有模型提供商签订了零数据保留协议。\",\"3e7cd48f17545cfd\":\"Cursor\",\"3ea28cba51c2c414\":\"CursorBench 3.1 包含比早期版本更难的问题，包括更大规模的编辑和更复杂的代码仓库。分数应在同一评测版本内比较。\",\"3eb2c31479c86a92\":\"云端智能体\",\"3f30d07bc3811512\":\"学生\",\"3f500d31523707a9\":\"已读取 bio/sequence_alignment.py、bio/fasta.py、bio/translate.py\",\"3fae9fe69734245c\":\"太好了！我已经创建了一个可用的电商仪表盘，其中包含：\\n\\n• **导航**：带有 emoji 图标的 Analytics 和 Orders 分区\\n• **内容**：带加载状态的动态营收计算和订单数量\\n• **支持聊天**：使用 react-query 获取消息的客户支持\\n\\n该仪表盘使用 react-query 获取消息数据，并显示加载状态。客户支持与 messages API 集成。试试按下 `Cmd+K`，将焦点切换到聊天输入框！\",\"4009635f36c1e5f9\":\"选择 Pro\",\"401256b1db062d38\":\"可放心交付实际工作的 AI 队友。\",\"402837c388448bdf\":\"更高的回复曝光提升\",\"407fe6ae2619d562\":\"从维护到创新\",\"40a0d8540799f744\":\"借助智能体交付代码\",\"40a854a7cad65ec4\":{\"c\":\"禁用交互\",\"i\":1,\"t\":\"span\"},\"40ac37d5a02ca2f0\":\"提供我的邮箱，即表示我同意接收所请求项目的访问权限。勾选营销订阅后，我还同意接收来自 Anysphere, Inc. 的产品、更新、优惠和活动等营销信息。我可随时取消订阅营销信息。更多详情，请参阅我们的\",\"40f525b817bc6a24\":\"从 Slack 发起并行智能体，让它们自行测试并返回已完成的 PR。\",\"40fb300a1dcd3d2c\":\"Bugbot 按用量计费\",\"4109ce1cc07036be\":\"/用户/月\",\"411405b7b6c33ba0\":\"**缺陷：全局 Blob 存储导致数据泄露**\\n`blobStore` 被声明为模块级全局常量，因此会在所有 `AgentConnectClient` 实例之间共享。这会导致数据泄露，因为一个客户端会话或对话中的内存 blob 数据可能会被其他实例访问。\",\"412bc1b1f307e7a8\":\"分诊生产环境错误\",\"41a1b5979fbaf9ee\":\"构建所需的一切，尽在一个方案中\",\"41e3e2428daf504a\":\"获取演示\",\"41e84700c9fa5bc5\":\"Cursor 或 LLM 提供商不会使用您的数据进行训练，并对每位团队成员强制执行。\",\"41fdb51faa6c1ae8\":\"团队规则\",\"424dbafdc4a91469\":\"可接受使用政策\",\"42eb8ae47cb3418e\":\"高信噪比，低噪音\",\"430c9e86017cb261\":\"仪表盘很慢，首次加载要 4 秒以上。@cursor 您能帮忙看看吗？\",\"4316cfaa5bbc17c9\":\"从堆栈跟踪入手\",\"43246719d5488314\":\"上次回复于 {time}\",\"432cce3758bc3df5\":\"MCP、技能和钩子\",\"434861b888e4814b\":\"发帖赚取收益\",\"43494087956350bc\":\"《财富》500 强企业中使用 Cursor 的占比。\",\"4354d29e9ae72d6d\":{\"c\":\"全部保留\",\"i\":1,\"t\":\"button\"},\"4367a9c275ed7c28\":\"Cursor 最新动态\",\"437973d3f403f17b\":\"Plus 的 4-50 倍\",\"437cb4b5ea2420b8\":\"帮助\",\"43810731508e486e\":\"安装指南、智能体和 MCP 集成。\",\"441e9441a875f8d5\":\"思考 3 秒\",\"442ee666599c0987\":\"AI 辅助\",\"444af2af70cd47be\":\"更快交付更优秀的软件\",\"4461ee9bb868fa21\":\"Cursor 可以免费试用吗？\",\"4491c204f453f78f\":\"思考 4 秒\",\"4491e800fb07f434\":\"下载视频\",\"44a823d8decbafc5\":\"阅读我们的博客\",\"44fb0e5195eae9f9\":\"访问第三方模型\",\"44ff78b7c8dbff3c\":[\"同样适用于第三方模型，包括 Auto 路由至第三方模型的情况。第一方模型（包括 Grok 和 Composer）不受此限制。\"],\"4514be6be3aa4e63\":\"所有文章\",\"45155b70abfb9f85\":\"请输入您的姓氏\",\"451bb96ccd44f765\":\"媒体报道\",\"451d9f26a9388711\":\"现在我来更新评估模块，以保存结果并生成详细报告：\",\"45261ef25191b8d4\":\"Cursor 已通过 SOC 2 Type II 认证，并定期开展渗透测试。相关报告可在我们的信任中心查看。\",\"4540c89dcfdd1a6b\":\"查看企业控制\",\"458d40a7d12f7a62\":\"包含 Start 的所有内容，外加：\",\"45aa9b00fc63fddb\":\"您可以直接在调试所在的对话线程中，查询某个时间窗口内的指标趋势，或查看哪些监控项正在告警。\",\"462453d9edf1ab85\":\"让您始终保持心流的编辑器\",\"464d1ab2abb65f60\":\"智能体限额提升\",\"46585e34b0d3c0fb\":\"AI 后\",\"4659933c29d96a02\":\"将您的可观测性数据接入智能体。\",\"466aad857f096515\":\"可以！Bugbot Rules 可让您定义自定义编码规范，推行行之有效的开发方式，并设置符合您团队需求的项目专属指南。\",\"4687f080dee674c0\":\"创建支持可配置限制并具备适当 Redis 清理机制的速率限制器：\",\"468d9fc08136a918\":\"我会构建项目并运行测试套件，以确认一切正常。\",\"46a0a85ad688a5d7\":\"文件已更改\",\"46c6844907247969\":\"赋能新一代创造者。今天就免费开始使用。\",\"46ffeadef1aa3964\":\"无论您在哪里工作，都能启动智能体，覆盖 SDLC 的每个阶段——从 IDE 和 CLI，到云端智能体、自动化、移动端和代码审查界面。\",\"470a3d8e6f4a9c3b\":\"出错了，请重试。\",\"47561f49ac547e71\":\"个人席位\",\"4758b716df9ce3dd\":\"可在 OpenAI、Anthropic、Gemini、SpaceXAI 和 Cursor 的所有尖端模型中进行选择。\",\"479381a0da261d9d\":\"代码审查\",\"47cb439e4dd834a9\":\"我会前往 Next.js 文档站点，查找最新功能。\",\"47d11082edb8d87d\":\"我会增强你的 MNIST 训练器，加入完整的实验框架，包括混合精度、验证集划分和规范的配置管理。先从重写训练模块开始：\",\"47e03f4545d79dba\":\"AI 软件工厂。\",\"47e1965359e56754\":\"联系我们的团队，共同规划您的首批智能体工作流。\",\"47f3316fcd69d727\":\"组织范围隐私模式\",\"4837cbcd7b106817\":\"在您沟通的地方写代码。\",\"483ba61595062161\":\"不提供 SCIM 访问控制\",\"4885caf5eba903db\":\"让工作在云端持续推进\",\"488e820d7de6c6c2\":\"把创意变成代码\",\"48b70f0d7e986dac\":\"AI 开发成熟度曲线\",\"48d513774949d748\":\"包含 Pro 的所有功能，另加：\",\"48de21dffb27aea4\":\"更新日志\",\"48ed89c99da1a291\":\"包括：\",\"49071a7305c69c8d\":\"Bugbot 结合 frontier 模型和自研模型进行代码审查。我们发现的缺陷中，超过一半最终会由工程师修复。\",\"492a27907d62a25b\":\"如何从 Jira 启动 Cursor 智能体？\",\"496e0c67f1cb0270\":\"智能体在运行过程中会响应您的消息，然后回复一个链接，方便您在 GitHub 中打开 PR，或直接跳转到 Cursor 桌面端。\",\"496fc34ce5dffbcd\":\"优先支持和账户管理\",\"497182659c04380b\":\"src/components/Checkout.tsx +5 -1\",\"497da78317b2c9d5\":\"接下来由团队接手\",\"4984e6ccae2ef55c\":\"与 Cursor 对话\",\"4986fa1f8d806e36\":\"正在生成\",\"49ab64b61f10d412\":\"{count, plural, one { {count} 个 token} other { {count} 个 token}}\",\"49d8b34279f9d073\":\"按用量计费如何运作？\",\"49f4929f15bd89f5\":\"Cursor 支持本地部署或 VPC 部署吗？\",\"49f7cbd0032b21ef\":\"stripe-billing\",\"4a124bd2d45f8547\":\"分析仪表盘\",\"4a1f6dfd52b9de37\":\"继续阅读 {site}\",\"4a601a09d6864d36\":\"请输入您的名字\",\"4ab7cd6a64298583\":\"包含 Start 的所有功能，另加：\",\"4ac3864890a86507\":\"我们的入门规划：\",\"4b0fef7aa7f6705a\":\"将 Jira 问题转为 PR。\",\"4b253a5ff9aeed07\":\"支持\",\"4b6558b9ff07f710\":\"返回 PR\",\"4b8e42708611e847\":\"读取 app/checkout/actions.ts\",\"4b923c21d674c2f3\":\"启动智能体\",\"4b9e16a0cb4dc79b\":\"静态数据采用 AES-256 加密，传输中数据采用 TLS 1.2 及以上版本。\",\"4bf1941397bcf2cc\":\"/月\",\"4c035703e473ef3e\":\"将 Cursor CLI 与 GitHub Actions 集成，用于自动化 CI/CD 工作流。\",\"4c05db15de29fc10\":\"添加功能和测试\",\"4c08f7ce2a952eef\":\"个人\",\"4c1d398ba00992a9\":\"共享\",\"4c3bb6de2f986784\":\"Lenny \u0026 Friends Summit 参会者可领取 SpaceXAI 提供的 Grok Bot 企业免费试用。请告诉我们要在哪里设置，我们将为您开通试用。\",\"4c5b185110955a4e\":\"频道设置\",\"4cb65658b72ac4df\":\"现在我会实现 SupportChat 组件，并使用 react-query 获取消息：\",\"4cb8669cfe472dbe\":\"Bugbot 如何集成到我现有的工作流中？\",\"4cd3a0ae6907eec5\":\"代码审查\",\"4cdb052c45663b98\":\"是的。Cursor 为个人用户提供免费套餐。下载 Cursor，打开你的项目，然后让智能体修复你的第一个缺陷。\",\"4ce24d68613cb3e3\":\"我们已经看到，有些功能一天内就能构建出来，而原本可能需要数周才能做出原型。它能帮助团队快速上手陌生的代码库，生成有意义的代码，并以更高的速度和信心调试复杂问题。\",\"4d08bbf5a178e689\":{\"c\":\"用于补充说明您请求的字段。\",\"i\":1,\"t\":\"div\"},\"4d15e9065c692d83\":\"Grind\",\"4d2f014f6112c6f9\":\"阅读案例\",\"4d3509b32eee31f1\":\"通过 @ 提及和图片上传作为参考，让 Cursor 精准定位到你需要关注的内容。\",\"4d3dfbd730562dd7\":\"增强版创作者工具\",\"4d3dfbf2bd4644f4\":\"创意\",\"4d5c13bd91dc2e1f\":\"查找最新的 Next.js 文档并总结新功能\",\"4d620d61d1f7717f\":\"把任务交给 Cursor，加快开发速度，而您则专注于决策。\",\"4db16fda95fa614e\":\"+/用户/月\",\"4dc13799becbf624\":{\"c\":\"我们的团队将审查您的请求，并尽快回复您。与此同时，开始使用 Cursor 或查阅我们的文档。\",\"i\":1,\"t\":\"h2\"},\"4df4cf3b2be7dd37\":\"解锁项目\",\"4e0e1c7cdac3034c\":\"将关键词映射到代码仓库或多代码仓库环境，让智能体每次启动时都能获得正确的上下文。\",\"4e3707f8e33ade5c\":\"正在前往页面...\",\"4e4f83ebaf244146\":\"Linear 和 Jira\",\"4e9d9b3677cafafe\":\"您可以搜索日志和链路追踪、查询指标、查看哪些监控项正在告警、列出仪表盘，以及调查 SLO、事件，以及某项服务的健康状态、错误和依赖关系——这一切都可以直接用自然语言完成。\",\"4ebad3a0708124a9\":\"Skills\",\"4eca9b0ad3d040f7\":\"了解云端智能体 →\",\"4ef289ab8bca72e7\":\"开始使用 Cursor\",\"4efd1e2c37926242\":\"Cursor Start 如何计费？\",\"4f0cd1da4acc7c04\":\"获取 CLI\",\"4f2c4889fb71b435\":\"面板已就绪。正在组合成网格布局：\",\"4f58d23bb198d60e\":\"一次性更改所有调用点\",\"4fc7dc81031ae587\":\"获取 Ultra\",\"4fe3cde32c00b2ae\":\"思考 6 秒\",\"4fefee28f94fe3d9\":\"为您的团队引入 Cursor\",\"4ff78effad6f8886\":\"Super\",\"5004547dc22a40db\":\"下载\",\"5019859a81b23843\":\"Media Studio\",\"501fa7ed3aadd5f3\":\"让 Cursor 构建、规划、修复一切\",\"5045cc4acd4dc489\":\"到 2025 年 2 月，Coinbase 的每一位工程师都已经使用过 Cursor，它也成为我们大多数开发者首选的 IDE。现在，单个工程师就能在几天内完成代码库重构、升级或构建新的代码库，而不再需要几个月。\",\"50491cad857c230a\":\"Cursor 支持哪些编程语言？\",\"5079eaf989b92263\":\"即使笔记本电脑合上后，云端智能体也会持续工作，并且能够测试、确认和验证其工作结果。\",\"50870e64c8658fe7\":\"截图 localhost:3000/cart\",\"508e49336de580a8\":\"州/省\",\"50a4896e739c4354\":{\"c\":\"与此同时，开始使用 Cursor 或查阅我们的文档。\",\"i\":1,\"t\":\"p\"},\"50b6ab96f52f8ffb\":\"Cursor 自动化和 SDK 可帮助您构建能够持续维护并改进团队代码库的智能体。\",\"50c4e61365b40d6b\":\"Cursor 最新动态 — 最新更新与发布说明\",\"50d06b325fd5cddd\":\"随时随地通过浏览器或手机启动云端智能体。\",\"50d9642b2ca87bb5\":\"回到您的笔记本电脑前，在 Cursor 中打开该智能体完成的工作，以审查更改、添加后续指示，或直接编辑代码。\",\"51220106f3b4bff5\":\"观看工作坊\",\"5147d5a7674d0294\":\"Cursor 会为你的代码添加插桩，并利用真实的执行数据精准定位修复位置。\",\"515ff9ed076dfc5c\":\"面向团队的自主智能体\",\"51704beb565c12fe\":\"打造经久不衰的软件\",\"518044cc4c1b241c\":\"开始使用\",\"51b96897e6c0aeb5\":\"工程团队使用 Cursor 进行调试和重构。\",\"51ea95b7b3e48659\":\"在它们处理这些面板时，我会搭建共享基础设施。首先，添加一个用于实时更新的钩子：\",\"51fbac7dd554cab8\":\"作为一名有技术背景的学生创业者，Cursor 改变了我的人生。它帮助我在几天内把创业创意变成现实，搭建高层架构、设计前端样式、与我的自定义后端实现全面集成，并在每一步修复缺陷。\",\"5224e9d894806eb0\":{\"c\":[{\"c\":\"IDE 布局\",\"i\":2,\"t\":\"option\"},{\"c\":\"智能体布局\",\"i\":3,\"t\":\"option\"}],\"i\":1,\"t\":\"select\"},\"5227e76253758cf2\":{\"c\":\"演示模式\",\"i\":1,\"t\":\"span\"},\"525e944cd1b60591\":[\"不是。Cursor 订阅仅通过\",{\"c\":\"cursor.com\",\"i\":1,\"t\":\"a\"},\"官方直接销售。我们不授权任何经销商或第三方卖家。通过任何其他渠道购买的订阅均未经授权，并且可能存在欺诈、不安全，或通过滥用我们系统获得的情况。这些账户可能随时被暂停或终止。为保障您的访问权限和安全，请仅通过我们的官方网站购买 Cursor。\"],\"529c64288ab2ad9f\":\"AI 用量\",\"52dd301200516c77\":\"Cursor 可以编辑文件、运行终端命令、搜索 Web 等。\",\"531803cc5edc6e51\":\"最大上下文窗口\",\"533d94ade1f18e6e\":\"checkout 按钮无法正常工作。点击后没有任何反应。您能检查一下哪里出了问题吗？\",\"5364b362031795ca\":\"Cursor 是每位工程师（包括我自己）在处理复杂问题或遇到瓶颈时，都会本能地求助的工具。在我们的工程团队实现 100% 采用后，Cursor 已成为我们构建流程中不可或缺的一部分。\",\"539bc91f1cb53abe\":\"以更少限制，畅快编码。\",\"53b579e86cfd8a96\":\"将实现工作委派出去，以专注于更高层次的方向。\",\"53b91122838bce63\":\"参与其中\",\"53be298d2539927b\":\"使用带服务器 action 的 App Router。\",\"53d4773d31f86e6a\":\"Cursor 支持 SSO 和 SCIM 吗？\",\"53d4a3dffcbb6de5\":\"按角色划分的场次\",\"53d947000278d0ae\":\"版本 {versionText}\",\"5439c4a5b640f097\":{\"c\":[{\"c\":\"演示功能\",\"i\":2,\"t\":\"h2\"},{\"c\":[{\"c\":[\"• \",{\"c\":\"灵活组合：\",\"i\":5,\"t\":\"strong\"},\"可混合移动端演示、桌面窗口和自定义内容\"],\"i\":4,\"t\":\"li\"},{\"c\":[\"• \",{\"c\":\"多种布局预设：\",\"i\":7,\"t\":\"strong\"},\"为不同使用场景预设布局\"],\"i\":6,\"t\":\"li\"},{\"c\":[\"• \",{\"c\":\"交互式窗口：\",\"i\":9,\"t\":\"strong\"},\"支持拖动、调整大小和焦点管理（启用时）\"],\"i\":8,\"t\":\"li\"},{\"c\":[\"• \",{\"c\":\"无边框移动设备：\",\"i\":11,\"t\":\"strong\"},\"无窗口装饰的简洁设备展示\"],\"i\":10,\"t\":\"li\"},{\"c\":[\"• \",{\"c\":\"自定义内容窗口：\",\"i\":13,\"t\":\"strong\"},\"可嵌入任意 React 组件，并可选添加 CTA\"],\"i\":12,\"t\":\"li\"},{\"c\":[\"• \",{\"c\":\"响应式行为：\",\"i\":15,\"t\":\"strong\"},\"针对不同屏幕尺寸自动调整布局\"],\"i\":14,\"t\":\"li\"},{\"c\":[\"• \",{\"c\":\"动画支持：\",\"i\":17,\"t\":\"strong\"},\"交错入场动画与流畅交互\"],\"i\":16,\"t\":\"li\"}],\"i\":3,\"t\":\"ul\"},{\"c\":\"布局预设\",\"i\":18,\"t\":\"h3\"},{\"c\":[{\"c\":[{\"c\":\"Slack + Mobile\",\"i\":21,\"t\":\"h4\"},{\"c\":\"显示 Slack 集成和移动端演示，非常适合展示跨平台能力。\",\"i\":22,\"t\":\"p\"}],\"i\":20,\"t\":\"div\"},{\"c\":[{\"c\":\"双移动端\",\"i\":24,\"t\":\"h4\"},{\"c\":\"并排显示两个移动设备，适合展示不同配置或平台。\",\"i\":25,\"t\":\"p\"}],\"i\":23,\"t\":\"div\"},{\"c\":[{\"c\":\"三重视图\",\"i\":27,\"t\":\"h4\"},{\"c\":\"包含多个集成和一个移动设备的复杂布局，适合进行全面演示。\",\"i\":28,\"t\":\"p\"}],\"i\":26,\"t\":\"div\"}],\"i\":19,\"t\":\"div\"},{\"c\":\"技术实现\",\"i\":29,\"t\":\"h3\"},{\"c\":\"DemoMultiWindow 构建于 DemoDesktop 之上，提供了类型安全且灵活的 API，用于组合多个演示组件。它支持三种项目类型：\",\"i\":30,\"t\":\"p\"},{\"c\":[{\"c\":[\"• \",{\"c\":\"type: \\\"mobile\\\"\",\"i\":33,\"t\":\"code\"},\" - 渲染设置了 asWindowContent=true 的 DemoMobile\"],\"i\":32,\"t\":\"li\"},{\"c\":[\"• \",{\"c\":\"type: \\\"desktop\\\"\",\"i\":35,\"t\":\"code\"},\" - 渲染嵌套的 DemoDesktop 组件\"],\"i\":34,\"t\":\"li\"},{\"c\":[\"• \",{\"c\":\"type: \\\"custom\\\"\",\"i\":37,\"t\":\"code\"},\" - 渲染任意自定义 React 内容，并可选择是否显示窗口装饰\"],\"i\":36,\"t\":\"li\"}],\"i\":31,\"t\":\"ul\"},{\"c\":\"每个项目都可以独立定位、调整大小和配置，因此能够轻松创建复杂的演示布局，在单个视图中展示 Cursor 功能的多个方面。\",\"i\":38,\"t\":\"p\"}],\"i\":1,\"t\":\"div\"},\"544b5660bbe73707\":\"城市\",\"546a5aaa4b6a6315\":\"读取 lib/redis.ts\",\"54a1ba52b6d0c1c0\":\"我看到问题了！这个缺陷出在 `applyBugbotPRReview.ts` 中的 PR 评论获取逻辑。\",\"54ae60affb7e7b63\":\"Bugbot 会审查每个 PR，指出真实问题，并推送修复。\",\"54c234f7ca2e3355\":{\"c\":[{\"c\":[{\"i\":3,\"t\":\"input\"},{\"c\":\"自动播放\",\"i\":4,\"t\":\"span\"}],\"i\":2,\"t\":\"label\"},{\"c\":[{\"i\":6,\"t\":\"input\"},{\"c\":\"毫秒\",\"i\":7,\"t\":\"span\"}],\"i\":5,\"t\":\"label\"},{\"c\":[{\"i\":9,\"t\":\"input\"},{\"c\":\"智能体\",\"i\":10,\"t\":\"span\"}],\"i\":8,\"t\":\"label\"},{\"c\":[{\"i\":12,\"t\":\"input\"},{\"c\":\"侧边栏\",\"i\":13,\"t\":\"span\"}],\"i\":11,\"t\":\"label\"},{\"c\":[{\"i\":15,\"t\":\"input\"},{\"c\":\"编辑器\",\"i\":16,\"t\":\"span\"}],\"i\":14,\"t\":\"label\"},{\"c\":[{\"i\":18,\"t\":\"input\"},{\"c\":\"聊天\",\"i\":19,\"t\":\"span\"}],\"i\":17,\"t\":\"label\"},{\"c\":[{\"i\":21,\"t\":\"input\"},{\"c\":\"反转布局\",\"i\":22,\"t\":\"span\"}],\"i\":20,\"t\":\"label\"}],\"i\":1,\"t\":\"div\"},\"54f240bfd8ca9a71\":\"技术支持\",\"552446d2cc5de877\":\"添加速率限制\",\"552a69d249e6009b\":\"包含团队版的所有功能，另加：\",\"55347fc1691fb431\":\"为我的序列比对工具添加仿射缺口比对\",\"558f07f5acdcb178\":\"在某些情况下，我们看到有些功能一天内就能构建完成，而如果没有它，做出原型原本可能需要数周。它能帮助团队在不熟悉的代码库上更快上手，生成有实际价值的代码，并以更高的速度和信心调试复杂问题。\",\"5595f09d69a30513\":\"已读取 ContextMenu.tsx\",\"559bc560878cd6b5\":\"工作坊\",\"55b2a8717b21db57\":\"模型\",\"55c3e2bba5118549\":\"团队工作的所有场景\",\"55d75d21ba16b8c1\":\"iPhone 和 Web\",\"560e21a44751d219\":\"如何将 Cafe Cursor 带到您所在的城市？\",\"561b4c7518978d47\":\"已通过 SOC 2 Type II 认证，并每年接受渗透测试。\",\"5625c64a1afa7226\":\"浏览文档\",\"566cae838b1fbbfc\":\"将创意转化为功能。\",\"5686f8bd6143bea9\":\"将 Cursor 连接到您的 Jira 工作区。\",\"56a57898a47124e6\":\"购买前可以先试用 Bugbot 吗？\",\"56c4a46396130793\":\"汇总\",\"56d98fe9bd08751c\":\"会议已预约\",\"56da7b94d807ba6a\":\"试用 Cursor\",\"56db4d333852aadd\":\"app/api/chat/route.ts +42 -18\",\"56deb8c79c0c8b99\":\"发现缺陷了。要我修复吗？\",\"5702840ab4824bfe\":\"那些原本需要您花上数小时亲自完成的任务，现在都可以委派给智能体。我们正在大幅减少人工操作。\",\"57247042c5c625e9\":\"用共享规则、技能和工作流提升团队协作。\",\"57823993c63da8bd\":\"获取 Slack 版 Cursor\",\"5792ba1e30a05ad3\":[{\"c\":\"缩放：\",\"i\":1,\"t\":\"label\"},{\"i\":2,\"t\":\"Select\"}],\"57ad296814efc2c6\":\"构建您的第一个智能体\",\"57d136fd6f519e2b\":\"请输入您的州/省\",\"57d5a88e2591967a\":{\"c\":[{\"i\":2,\"t\":\"input\"},{\"c\":\"禁用交互\",\"i\":3,\"t\":\"span\"}],\"i\":1,\"t\":\"label\"},\"57f7ea0d5df3d6af\":\"看起来像\",\"57fc7295bbf941cb\":\"完成！`/dashboard` 现在可在一个视图中显示健康状态、部署情况和事故。每个面板都会通过 SSE 自动更新。\",\"582c0e77ee078fe0\":\"模型访问限制\",\"5834b6317e825251\":\"配置频道\",\"585a5bdf759861f4\":[\"您可以在设置中启用隐私模式，也可以由团队管理员启用。启用后，我们保证我们及我们的模型提供商都不会将代码数据用于训练。您可以在我们的\",{\"c\":{\"i\":2,\"k\":\"_gt_value_2\",\"v\":\"v\"},\"i\":1,\"t\":\"a\"},\"页面了解更多。\"],\"589eae8e23ae0a93\":\"我们是什么时候修复身份验证缺陷的？\",\"58af479f6ebe4540\":\"借助常久在线的智能体节省时间\",\"58ca6c02f1be14d8\":\"构建程序化智能体\",\"58de1535915fe2de\":\"立即试用 Tab。\",\"58fd5c68a088796a\":\"发现了一个竞态条件——两笔同时进行的购买都可能在任一方扣减库存之前通过库存检查。这很可能就是你的缺陷。我会修复它并添加测试：\",\"590c7c3444726976\":\"高级支持\",\"591a0510c8e84a5a\":\"为什么选择团队版，而不是个人席位？\",\"59263684ffcfebeb\":\"待审查\",\"5929b8a359c1d45e\":\"Cursor 或 LLM 提供商不会使用您的数据进行训练。\",\"595795566bbf229f\":\"更高的 Grok Bot 用量上限\",\"597cc4cb8fd97eb6\":\"最早访问所有产品与模型\",\"5997ca37e732f2ee\":\"提供可视化反馈\",\"59b3c4b4a2d7555b\":\"通过 Live Activities 查看实时状态，并在智能体完成任务或需要您处理时收到通知。\",\"59b5eaffac43a7b6\":\"AI 前\",\"59be625b4381dadb\":\"Cursor 拥有哪些安全认证？\",\"59ddacbac263566c\":\"能发现真实缺陷的代码审查\",\"5a2177748764b857\":\"规划 Mission Control\",\"5a31376bd6bd8b20\":\"查看可用模型\",\"5aa27f8a189a4e05\":\"SpaceXSI 订阅条款\",\"5aca37ac0570da8b\":\"远程桌面控制\",\"5ae799701994cc08\":\"未来\",\"5aec9fe3970b5540\":\"展开菜单\",\"5b40681410b7b70d\":\"Dwarkesh Flashcards\",\"5bde1d77d95d1fb6\":\"必要 Cookie 用于维持网站正常运行，始终保持启用。可选 Cookie 有助于提升网站性能和支持广告投放，您可以选择接受、拒绝或管理这些 Cookie。\",\"5c505a049167caa8\":\"团队能明显感受到差异。\",\"5c51ebc639a5b935\":\"您团队的质量标准，落实到每一个 PR\",\"5c601c64f2265a9c\":\"评估 PR 风险 → 分配审查者\",\"5c78a8ae7b71af1d\":\"终端\",\"5c86f7896183300b\":{\"c\":\"演示布局\",\"i\":1,\"t\":\"span\"},\"5c8eb4b649a680d6\":\"我们相信，大多数软件将由运行在云端的自主智能体编写，而不是由受限于开发者本地机器的智能体来编写。\",\"5d271f902333345f\":\"独立运行\",\"5d69c6065c9873c3\":\"几分钟即可完成首个自动化流程设置，或联系我们，了解如何在整个工程团队中部署自主智能体。\",\"5db6ccfea6848fc3\":\"Cursor CLI — 在终端、GitHub Actions 以及自动化和脚本中运行智能体\",\"5db9f8f4eb703589\":\"电话号码\",\"5dcd8acc2a837bac\":\"通过插件、MCP 服务器、钩子和技能扩展 Cursor，满足您的工作流所需。\",\"5e0c0b6b2b44da44\":\"Cursor 会先研究你的代码库、提出澄清性问题，并在修改代码前制定方案。\",\"5e0f121994a0f158\":\"我跟 Cursor 争了 10 分钟，因为它一直像个机器人老师一样给我解释一段其实是我自己去年写的代码。结果证明它是对的，是我记错了。我得去喝口茶冷静一下。\",\"5e20918433c77a83\":\"Cursor Blame\",\"5e26bd9b3023376d\":\"Hobby 的所有功能，另加：\",\"5e76c777459b2d9f\":\"工程投入都流向了哪里\",\"5e8411721bc1ed59\":\"不只是公开基准中的问题\",\"5e92aea16a239c0f\":\"Pro\",\"5ea62c5c0804d267\":\"OpenAI 客户端已经支持流式传输。我会用适当的编码将其流直接传给响应：\",\"5edcd1e637d20e74\":\"成为 Cursor Ambassador\",\"5ef0c02463435106\":\"Cursor 会为你的代码添加日志埋点，并使用真实执行数据精准定位修复点。\",\"5ef48d1658af9402\":\"选择团队版\",\"5efe9b4b79a79d7d\":\"用更低成本，借助 Cursor 完成更多工作\",\"5f03a5bbfcc946cb\":\"随时随地构建\",\"5f0ac6b8c11f81ea\":\"修复缺陷\",\"5f26db1b9c910040\":\"在 menu-styles.css 中找到\",\"5f27e2592946864b\":\"从过往运行中学习\",\"5f4e946e848fd5f0\":\"代码仓库屏蔽列表\",\"5f56dc9ce71aa076\":\"Cursor 已经成为我在构建 startup 过程中不可或缺的工具，让我们无需扩大团队规模，就能快速迭代产品。对于专注的团队来说，它绝对能带来 5–10 倍的生产力提升。\",\"5f5e12e06f054efb\":\"Ultra\",\"5f9560370763d8c2\":\"以智能体原生的方式构建卓越的软件。\",\"5fdddebbeca595cb\":\"缩短合并时间\",\"601ade82daae260c\":\"Bugbot 能以较低的误报率发现最棘手的逻辑缺陷。\",\"604aebf53a0b3931\":\"强大、灵活且可定制\",\"60a1b8fe0560d298\":\"智能体更高额度\",\"60cd691ed7ce3383\":\"试用自主智能体\",\"61177715de03fd9b\":\"方向、模型和标准，始终由您掌控。其余交给 Cursor——利用那些本来就不可能属于您的时间。\",\"61190a98bcf09569\":\"自主工作，并行运行\",\"613349402649dc3a\":\"src/hooks/useSSE.ts +38\",\"6149ca317ba7b036\":\"分类：\",\"616c33712c146e9a\":\"构建一个包含订单管理、数据分析和客户支持聊天的电商仪表盘界面\",\"61720f23c489d3c4\":\"下载 Grok Bot\",\"617d43cff7d6092d\":\"缺乏组织范围的安全控制\",\"618ebaa5d5ac0cb1\":\"按年\",\"61955bff0372f8d0\":\"Jira 和 Linear\",\"61aa956fd3a00ad9\":\"感谢您与我们联系。我们的团队将与您确认详细信息，并寄送您的定制 Cursor 键盘。\",\"61f31b906ecf3d59\":\"CursorBench 会评估智能体质量的多个维度，但此排行榜展示的是解决方案正确性。我们使用智能体评分器，因此对于规格定义不够明确的任务，也能接受有效的替代实现。\",\"61f916226974b2d2\":\"Cursor 会读取问题和您的代码仓库设置，因此您只需分配工作即可。\",\"61fa128481d262a3\":\"添加后续消息...\",\"62133479b954e75b\":\"所有测试均已通过\",\"624a7252f9a5e126\":\"构建 Mission Control\",\"62570d4bfe4ab517\":\"手动\",\"6280f9263cd88d6d\":[\"对于符合我们标准的黑客松，我们有时会提供 Cursor 额度。请\",{\"c\":\"在这里提交您的请求\",\"i\":1,\"t\":\"a\"},\"，我们会在接下来的几周内回复您。\"],\"6291b4e80c73a7b3\":\"感谢您联系我们的销售团队。我们会尽快与您联系。\",\"62b386144cf35db7\":\"思考 5 秒\",\"62b6942afdad57c8\":\"正在搜索 {rest}\",\"62dc4d3a19ff7ca0\":\"关闭选项卡\",\"633926c145eff731\":\"在您的编辑器中规划和构建\",\"635528e4c624bf02\":\"已在 `feature-prd.md` 中草拟实现步骤。在我开始构建前，有几个简短问题：\",\"636955d79a0bc853\":\"现在该通过一个整合关键指标的报告辅助工具把所有内容串起来了：\",\"639376e4fb044acd\":\"我们能力最强的模型，适合处理长时间运行的编程任务和知识工作。\",\"63b583aaf3e44b2b\":\"金融科技平台规则\",\"63b5cb0e41524f5d\":\"创建自动化\",\"63cc8fe72a5ec5af\":\"Cursor iOS 版\",\"6410cc6de8e2a3b6\":\"套餐类型\",\"641b13858fd83e89\":\"包含团队版的所有功能，以及：\",\"64204b0fe8a50884\":\"构建软件的全新方式。\",\"644dd6127638b431\":\"关闭导航\",\"6486c2110656e680\":{\"c\":\"Blog\",\"i\":1,\"t\":\"Link\"},\"64884882dbe6dbee\":\"将问题指派给 Cursor，由它将其转成 PR。\",\"649218047e34e4d9\":\"获取 Pro+\",\"6492da17ee3f2c2b\":\"已创建 run_experiment.py，+29 行\",\"64a2b59b27c2b0a8\":\"让智能体规划变更、实现变更、运行测试，并提交 PR 供审查。将耗时较长的工作发送到云端，把复杂任务拆分并分派给并行智能体，然后回来审查实际产出，而无须监督每一步。\",\"64be49a152b32bc7\":\"Cursor 对加快我们的开发进度至关重要，原本需要四个 sprint 才能完成的工作，现在一个 sprint 就能做完。\",\"64e34ec7ead4eebe\":\"浅色主题\",\"651036b1b1880a50\":\"请使用您的工作邮箱\",\"6511b271e0dcd737\":\"查看公告\",\"6538e13fa1053ff9\":\"Grok Bot\",\"653f7b909b1a405e\":\"根据附加文档制作一个介绍我们业务的落地页\",\"65813a1f6e1cdc0f\":\"下一篇文章\",\"6583da71b762f1a4\":\"Start 采用印度卢比按月计费。您可以使用 UPI、信用卡或借记卡付款。使用 UPI 时，您需要在结账时在 UPI 应用中批准每月自动扣款授权，之后将自动续费。Start 规划不提供按年计费。\",\"65925f5108751b86\":[\"自助式规划支持所有主流信用卡和借记卡。如需基于发票的计费和电汇付款，请\",{\"c\":\"联系我们\",\"i\":1,\"t\":\"a\"},\"，了解企业规划。\"],\"65b1343ed8c56865\":\"Cursor 是一支致力于构建软件开发未来的应用研究团队。\",\"65bf7ebd592c53ba\":\"企业级安全保障\",\"65d950515c310953\":\"Cursor 如何处理我的数据？\",\"6619b56eb214db5c\":\"随时掌握进展\",\"66677b62ad9bbb69\":\"*第三方模型在 Cursor 中可用\",\"666902f3ed17c142\":\"一个智能体，覆盖您的所有工作场景\",\"6669e11e1b22308c\":\"也只有 Cursor 团队才能将这些模型的潜力发挥到极致。GPT-5.2 本身已经是个能力惊人的模型了，但能让它高效工作整整一周，简直不可思议。更夸张的是，竟然还能构建出一个完整的浏览器！\",\"6680965bdf517368\":\"正在前往 /docs/app/building-your-application\",\"668e68f4f1b00344\":\"Grok 4.7 模型卡\",\"6690e79ebc9ba13f\":\"不包含\",\"66b84e2701e67402\":\"无法加载 Cookie 类别。请点击“接受所有”或“全部拒绝”，也可以重试。\",\"672601bd4119cac6\":\"Redis 已经配置用于 session。我会实现一个滑动窗口速率限制器——它比固定窗口更准确，也更适合处理突发流量。\\n\\n实现方式：\\n• 为每个用户在有序集合中存储请求时间戳\\n• 每次请求时清理掉早于时间窗口的条目\\n• 统计剩余条目数以检查是否超出限制\",\"6747d1c9977e2a91\":\"Pro+\",\"67733c48eaaec73a\":\"规划\",\"67b696d5dc50e764\":\"已部署模型的能力基准测试和安全保障评估。\",\"67bf005f6c1f3ec1\":\"博客分类\",\"67cc618a82f1a3f7\":\"与其他基于 LLM 的编码工作流不同，Cursor 是对我自身能力的增强，而不是替代；它将编程中繁琐的研究工作自动化，同时保留足够的“human in the loop”参与度，让我能够理解并掌控输出结果。\",\"67d3f5f955663cc4\":\"分析\",\"67f7439638ec898d\":\"社区\",\"67fdd25f3a50d9c6\":\"SAML/OIDC 单点登录\",\"6802e20cf6994a43\":\"升级至 Start\",\"681a011b5c46e2aa\":\"通过浏览器或手机运行云端智能体。\",\"6839eb71a8146557\":\"借助 Cursor，一条指令即可让自主智能体在你的代码库中执行任务。联系团队，规划首批智能体工作流，并领取 Cursor 实地工具包。\",\"684e516076de81fe\":\"标准版\",\"685a4c950d019905\":\"通过选择元素，直接在任意页面上进行可视化编辑，立即重写、调整大小或移动它。\",\"68997fcfb77eaa96\":\"修复 ProductCard.tsx 中隐藏的按钮\",\"689c4d5a9520887f\":\"已规划后续步骤\",\"68a602ee5acceb85\":\"架构\",\"68ab695fd3d18bc5\":\"优先看解决方案正确性\",\"68cea978c3104994\":\"在 Cursor 中使用 Grok 4.7\",\"68d9afbfcea22ac0\":\"立即见效\",\"68e3c67285692780\":\"团队应用市场\",\"68eafc1bca6329e1\":\"Bugbot 在个人套餐和团队版套餐中按用量计费，无需单独订阅。在个人套餐中，审查会优先消耗内含用量；用完后，如果你已启用按需用量，则会使用按需用量。在团队版套餐中，审查按需用量计费。每次审查的平均费用为 1.00–1.50 美元，具体取决于 PR 的规模和复杂度。企业团队可以联系其客户经理团队安排 Bugbot 试用。\",\"69130b0b7f5bf765\":\"未找到\",\"691357f3177f0a6c\":\"将方案从本地智能体交给云端，在您离线时继续运行。\",\"6936f102acb1972f\":\"读取 middleware.ts\",\"6940b5aec80f1b06\":\"Bugbot 直接在 GitHub 中发现缺陷。它会自动审查 PR、对潜在问题发表评论，并直接在您的 Cursor 编辑器中或通过我们的后台智能体提供修复建议。\",\"6942f2815416399b\":\"已搜索使用 react-query 获取消息的模式\",\"6943190979ec7aac\":\"并行启动常驻在线的智能体。每个智能体都会获得独立隔离的 VM，并配备完整的开发环境，用于测试和迭代 PR。\",\"6989a781d5b88ddb\":\"无限团队应用市场\",\"698aa4905bab4d5f\":\"什么是 Cursor Datadog 插件？\",\"6999c832625010c4\":\"您可以让 Cursor 修复缺陷、添加功能、更新测试，或调查工单中描述的问题。\",\"69a327815dc1270a\":\"Cookie 政策\",\"69dcc85af3063c07\":\"正在搜索\",\"69f558e8d4f54c2a\":\"hooks/useChat.ts +58 -14\",\"6a4b835091e7669d\":\"Cursor 智能体\",\"6a526fef0d1fb8f8\":\"安全地审查与回滚\",\"6aa008ea818928e0\":\"雄心勃勃的工程团队的选择。\",\"6ab96e26bda35288\":\"思考中\",\"6abe47cf0d31d4ec\":\"适合每天都在构建的人\",\"6aee18605f269ea8\":\"我会添加测试，使用上周导出中的代表性样本来固定这一行为：\",\"6af8b62a57d98729\":{\"c\":[{\"i\":2,\"t\":\"AtIcon\"},{\"c\":\"添加上下文\",\"i\":3,\"t\":\"span\"}],\"i\":1,\"t\":\"button\"},\"6b1cd09f8906c320\":{\"c\":[{\"i\":2,\"t\":\"input\"},{\"c\":\"禁用调整大小\",\"i\":3,\"t\":\"span\"}],\"i\":1,\"t\":\"label\"},\"6b45c1bffe5a627e\":\"对于复杂任务，Cursor 会先提出澄清问题、制定规划，然后在后台执行。\",\"6b5df4c9a7f3dd66\":\"技能和命令\",\"6b6a9701dc74e475\":\"轻松创建、更新和移除用户及用户组。\",\"6c17bffb516d1ffa\":\"启用后，Bugbot 会在新的 PR 上于后台自动运行。\",\"6c2a55cf90318bde\":\"如何查找即将举行的 Cursor 活动？\",\"6c2e1f34724f9009\":\"比较 Cursor 评估的各模型在公开 CursorBench 3.1 上的解题正确性结果。\",\"6c398a0cef55c4a5\":\"开始使用 Bugbot。\",\"6c5c72e09401b58d\":\"请输入有效的工作邮箱地址\",\"6c6c0307c8e69417\":\"用 Cursor 修复你的第一个缺陷。\",\"6c9af66581c87112\":\"正在解锁...\",\"6cb657bb30e1daf2\":\"始终启用\",\"6cd9c48cb0e8210b\":\"覆盖开发各阶段\",\"6cdc6d614b45b04b\":\"智能体限额提升\",\"6ce0571df6302f34\":\"Discord、论坛和 Reddit 有什么区别？\",\"6cefc359fa9ccc2e\":\"将 Cursor 扩展到更多工作流中\",\"6d0431d37ac24158\":\"正在 grep\",\"6d34597e0b51de2c\":\"Mac (x64) 版本 {versionNumber}\",\"6d5722699e8e3f2d\":\"Cursor Linear 集成\",\"6d5cf02de91c91f7\":\"智能体（同步）\",\"6e1e0db867df111d\":\"得分来自 Grok 4.7 发布公告。Grok 4.7 的 DeepSWE 成绩是在高投入级别下取得的。\",\"6e28de0630c48b33\":\"智能体会在你的代码库中并行处理，更新重构涉及的每一处引用。\",\"6e4544b7aefc7c5e\":\"创新 / 突破性项目\",\"6ea79290f0f8aa44\":\"前往 localhost:3000/cart\",\"6ebe4a3699481598\":\"我会构建一个分析工具包，突出展示 Tab 与智能体的采纳情况及切换行为：\",\"6ec8a0333a52c1b8\":\"适合想尝试智能体的人\",\"6f02a5ab8c9e794a\":\"功能\",\"6f07332b007c7909\":\"AI 功能\",\"6f1cde7615768859\":\"规划、搜索、构建一切……\",\"6f2deaf7b2dd0d95\":\"了解自动化\",\"6f40239bd22786e7\":\"获取 BugBot\",\"6f4fdb12ba78f5d4\":\"作为 CTO，我从未收到过这么多员工发来的短信或 Slack 消息，内容只是简单一句：“感谢您把这项技术带给我们。”\",\"6f82b4195c3d7d3d\":\"应用市场编辑权限\",\"6f9b579b62a6d682\":{\"c\":[{\"i\":2,\"t\":\"input\"},{\"c\":\"自动播放\",\"i\":3,\"t\":\"span\"}],\"i\":1,\"t\":\"label\"},\"6fa70f7860512e61\":\"Grok Bot 访问权限\",\"6fbe806b279996b9\":\"Cursor 在 Stripe 内部很快就从数百名用户增长到数千名高度认可它的员工。我们在研发和软件构建上的投入超过其他任何事务，而让这一流程更高效、更具生产力，将带来显著的经济效益。\",\"6fd9c0d2eb6a1f1f\":\"next.js、postgres，可能还会用 redis 做缓存。@cursor 您能搭建一下这个项目吗？\",\"6fda86558c416f14\":\"高峰时段优先访问模型\",\"6fffd817251576ba\":\"有限\",\"701964090d7b3438\":\"清除搜索内容\",\"7053c5ede3a89e26\":{\"c\":\"主题\",\"i\":1,\"t\":\"option\"},\"70b184a24c4106b9\":\"在 Cursor 仪表盘的集成页面连接您的 Linear 工作区。\",\"70b48b8825e6e9d8\":\"我会先拟定方案：挂载 ThemeProvider、重构 shell，并整理主题 API 文档。您批准后我就可以 commit 并 push。\",\"70dba5fb5c2a3777\":\"立即试用 Cursor。\",\"70f3836f99ce19f3\":\"您已经设置好了健康检查端点和 PagerDuty，但还无法一次性总览所有内容。我会创建一个带实时更新面板的统一仪表盘：\",\"71096d5462856a59\":\"已搜索：model picker UI 是在哪里实现的？\",\"712052f01a2654c8\":\"太好了！我已经为你的仪表盘创建了一份全面的 Cursor 规则文件：\\n\\n**仪表盘规则**（`.cursor/rules/next.mdc`）\\n• 通过 glob 模式应用于所有仪表盘文件\\n• 强制执行 Next.js App Router 最佳实践\\n• 定义组件结构和命名约定\\n• 包含 UI 组件、状态管理和性能方面的说明\\n\\n该规则使用 frontmatter 元数据来：\\n- **说明**：让 AI 助手可以检索到它\\n- **Globs**：自动应用于 `apps/dashboard/**/*` 文件\\n- **@file references**：链接到重要的配置文件\\n\\nCursor AI 现在会在处理你的仪表盘代码时自动遵循这些标准！\",\"7138f388aefd2a09\":\"Cursor Blog RSS 订阅源\",\"7152ef648bf20a6a\":\"支持与法务\",\"71538fd96a57001d\":\"截图 localhost:3000/checkout\",\"7171514de1821c31\":\"同步\",\"730fd07682250204\":\"从创意到生产环境\",\"7342bfc328008926\":\"运行中\",\"734ef43acd7655fa\":\"lib/rate-limit.ts +67\",\"735fa8731e0670ae\":\"提交\",\"73ba7c25c8007b83\":\"团队管理\",\"73ca2b64ead55f7d\":\"AI 软件\",\"73ce10939f1e86a7\":\"构建 Mission Control 界面\",\"740d6686b16eef09\":\"查看 PR\",\"7411b7a914433315\":\"申请演示\",\"7457b7011adecc2a\":\"帮我了解一下，在我们的各个工作区中，团队如何在 Tab 视图和智能体面板之间分配注意力。\",\"74d12aadd81fd7c0\":\"最大上下文窗口\",\"74ea0b114eed9d18\":\"Slack 版 Cursor 支持隐私模式吗？\",\"74ea8815860f94f1\":\"启动一项任务后，它就能在几分钟内完成原本需要几天的工作。而且您可以同时运行任意多个，彼此并行。这就是未来 AI 智能体在所有知识工作中的形态。\",\"7501101978e3cad3\":\"可以说，Cursor 彻底改变了我们开发者使用工具提升产品质量的方式，这种变化堪称从 0 到 1 的飞跃。\",\"753721b541f3482e\":\"浏览应用市场\",\"75391337fbb86c25\":\"视频生成\",\"754ed87f9a933aa5\":\"包含个人的全部功能，另加：\",\"7563c56006fe718f\":\"我会创建一个三栏式电商仪表盘界面。先从负责管理订单和整体布局的主 Dashboard 组件开始：\",\"75733188cc3348f6\":\"专为 Cursor 构建，并使用最大规模的真实世界场景样本进行 RL 训练。\",\"7587b6c9ba9c7b77\":\"Cursor 可以支持我的 YouTube 频道或课程吗？\",\"758d4e14d8f1d4d3\":\"将 Cursor 引入您的 Slack 工作区。\",\"75c696a5f7384dcd\":\"书签文件夹\",\"763d007aefa19566\":\"团队版\",\"7654c1c4192cfc7c\":\"X\",\"766719286ea5bbfa\":\"智能体可按计划运行，也可由来自 GitHub、Slack、Linear、webhooks 等的事件触发。\",\"76a91fecfd68186c\":\"让我们构建一个 Mission Control 界面，类似 macOS 中 Exposé 风格的窗口管理器\",\"7722bb6b6d24ef63\":\"通过手机启动新的智能体，并继续向现有智能体发送提示。\",\"77247cbe41ea6108\":{\"c\":\"全部撤销\",\"i\":1,\"t\":\"button\"},\"772bc141807eb7fa\":[\"在您的仪表盘中的 Cursor integrations 里安装此集成。您需要具备 Cursor 管理员权限，并使用已启用 Rovo 的 Jira Commercial Cloud。完整操作指南请参见 \",{\"c\":\"Jira integration docs\",\"i\":1,\"t\":\"ResolvedLink\"},\"。\"],\"772f0cd0824116fb\":\"呈现方：\",\"7778a6d897d7a3e9\":\"请描述该工作。Cursor 会规划、编写代码、运行测试并创建 PR。\",\"779d9c0232dccbc0\":\"已搜索：UI 中的 model 标签是如何着色的？\",\"77d5b06bb2fc5c6d\":\"定价\",\"77dc9718c66b4f30\":\"如何跟踪整个组织中的 AI 采用情况？\",\"7828ebc1954d3e8a\":[\"所示价格不包含适用税费（如增值税）。所示月费不包含在 Cursor 中使用第三方模型的费用，相关模型使用量需另行购买。查看\",{\"c\":\"用量费用\",\"i\":1,\"t\":\"a\"},\"。\",{\"c\":\"可以随时取消\",\"i\":2,\"t\":\"a\"},\"，但请至少在续订前 24 小时取消，以免产生额外费用。价格可能会更改。\"],\"782dcae905208761\":{\"c\":\"高度\",\"i\":1,\"t\":\"label\"},\"78333632f052c10d\":\"阅读客户案例\",\"7868f0a038046185\":\"暂无指南。\",\"788003d322d483de\":\"将 Cursor 引入你的校园。\",\"789dae69d16dc33d\":\"常见疑问解答\",\"78b2789c0b700951\":\"包含 Pro+ 的所有功能，另加：\",\"78bad7a7fdcb1449\":\"获取应用\",\"78cad73ee1513261\":\"作为一名创始人，Cursor 让我能够以惊人的速度把创意变成现实；过去需要一周的事情，现在只需几个小时。它帮助我更快学习，也坦白说，让我觉得自己几乎什么都能构建。\",\"78d3176ab322441c\":\"标准版智能体限额的 5 倍\",\"78fec244cccd87db\":\"@Cursor 会读取线程内容、接手任务，并交付一个 PR。\",\"7905928d59208450\":\"已读取\",\"79569fc7f3a3b4ed\":\"Grok Bot 用量上限最高\",\"795854feef8d2f52\":\"浏览器\",\"7974447363bafbd5\":\"现代工程组织的首选工具。\",\"799f1fd382b4f27f\":\"团队如何让智能体投入工作\",\"79add38665b84798\":\"连接后，您可以向智能体询问任何有关 Datadog 数据的问题，它会将答案带入与代码相同的上下文中。\",\"79c74159e46ee4d6\":\"Composer 访问权限\",\"7a049313b1978b9b\":\"@cursor 您能试着处理一下吗？\",\"7a13661eef47cba8\":\"访问前沿模型\",\"7a4e5e17bc86fd03\":\"Start\",\"7a77b4685015f0ab\":[\"管理员可通过\",{\"c\":\"管理员仪表盘\",\"i\":1,\"t\":\"a\"},\"查看用量信息和关键指标。\"],\"7a8b26dda4f3ece3\":\"将某个工作项分配给 Cursor，或在该问题的评论中提及 @Cursor，即可启动云端智能体。\",\"7aafea0f7a64eaed\":\"个人席位让每位工程师各自拥有自己的 Cursor；团队版则让整个团队共享一个 Cursor。\",\"7ac52df3f6b0a072\":\"{minutes} 分钟\",\"7ad5c06a0b165b95\":\"适用于长时间运行的编程任务和知识工作的前沿模型。\",\"7b044bdd153b5c77\":\"已搜索“User 类型在哪里定义？”\",\"7b2189dac4265501\":\"Cursor 会根据工作项的标题、描述、评论以及您团队的代码仓库设置来界定任务范围。\",\"7b35307650df5523\":\"已搜索适用于仪表盘界面的 React 组件模式\",\"7b651f892fd43e72\":\"用量与支出控制\",\"7b6ccfad90fe4621\":\"将您最优秀工程师的实践沉淀为团队规则、技能和工作流——让团队中的每个智能体都遵循统一标准。\",\"7bc202c0168c7ac4\":\"智能体请求次数有限\",\"7bcc1d5eb19fc4e3\":[\"团队版适合最多 25 人、希望自助完成设置并使用信用卡计费的工程团队。当您需要在整个组织内汇总用量、发票或 PO 计费、SCIM 席位管理、用于 HIPAA 的 BAA、采购支持、高级安全功能和管理控制，或专属支持时，就值得考虑企业。可在\"],\"7bd88547ffae1300\":\"开始使用 Cursor 进行构建。\",\"7bed7d3fbf638c3e\":\"规划中\",\"7c0a362901b5515e\":\"使用 AI 调试并重构代码\",\"7c1428be141f499a\":\"读取 types/api.ts\",\"7c29c439735d5414\":\"集中式团队计费\",\"7c2d80510fcf7db3\":\"联系销售\",\"7c30089151187108\":\"将大型问题分派给专业智能体。让每个智能体调研、构建或确认解决方案的一部分。\",\"7c529dec44f1bfb7\":\"查看预览\",\"7c72a8f6a36b1702\":\"了解 Cursor 的最新动态\",\"7ca3a87ea715ce25\":\".\",\"7ce3b98918b0c551\":\"读取 lib/auth.ts\",\"7ce9522cb92397e0\":\"从一开始就以安全与合规为核心构建。\",\"7cedcc44c91d1879\":\"覆盖您的所有工作场景\",\"7cf03f60ce4e9d01\":\"我们使用 Cursor Blame 获取任务来源，它会将已提交的代码追溯到生成这些代码的智能体请求。这样，每个评测条目都对应一个真实的开发者提示和一个明确的目标结果。\",\"7d0335baaa53251d\":\"evaluation.py +24 -6\",\"7d05dfe189273205\":\"您可以从 Cursor 应用市场添加 Datadog 插件，也可以在“设置”的“插件”中添加。它内置预配置的 MCP 服务器，以及智能体使用它所需的技能。\",\"7d090723d2df68f4\":\"联系我们的团队，获取价值 50 美元的 Grok Bot 额度\",\"7d12ffb07d73a9ab\":\"智能体限额为 Pro 套餐的 20 倍\",\"7d8bfc5d6fed8359\":\"谢谢！您的下载即将开始。\",\"7dbdb1264311f728\":\"任何人都可以免费开始使用 Cursor。如需升级访问权限，请关注今年秋季起我们在线上和校园活动中推出的优惠活动。我们很期待看到您用 Cursor 打造出什么。\",\"7df262caf36b5d9c\":\"已 grep：Choose a model\",\"7e0c1a1e41ca9876\":\"创建一个自动化，审查每个新的 commit，并为高风险逻辑添加测试，以提高测试覆盖率。\",\"7e11f80cf6c79485\":\"自动化让我能轻松把工作中重复性的部分交出去。通过创建自动化来归拢任务、处理文档更新和回复 Slack 消息，我可以专注于真正重要的事情。任何事情都可以实现自动化！\",\"7e17ee2036494d32\":\"支持远程控制的 Cursor iOS 版\",\"7e1fe1f70fff87ef\":\"第三方安全认证\",\"7e5bd87a71f6763d\":\"感谢您——您的实地工具包正在寄送中。\",\"7eae52129b2ba04b\":\"Cursor 支持所有主流编程语言，包括 JavaScript、TypeScript、Python、Java、Go、Rust 和 C++。智能体会在所有这些语言中采用相同的调试工作流。\",\"7eea7753290c7fb2\":\"请分享更多关于您需求的信息\",\"7f34a4c659c74ed0\":\"Cursor 会从 Linear 问题中使用哪些上下文？\",\"7f46ab7102155b95\":\"开始构建\",\"7f4858c42094647d\":\"Bugbot 发现的问题非常可靠，不仅能找出 PR 直接改动的文件或代码行中的问题，还能识别这些变更与现有组件及代码其他部分中的既有假设相互作用所引发的问题。\",\"7f5639b21b1fd244\":\"管理员仪表盘控制项和详细的用量分析\",\"7f620780c2d1f640\":\"即将举行的活动\",\"7f8cb8174c6d288f\":\"下一页\",\"7f9e35745e53d2e4\":\"测试需要模拟对象，以避免实际调用 Stripe 和 Resend：\",\"7fc97d3d7a46f621\":\"了解该模型\",\"7fd911253db0a766\":\"复习并记住播客中的关键观点。\",\"7fe9c23121e552a8\":\"全团队适用的规则、技能和自动化\",\"8001fdc31d80a036\":\"一款适用于长时间运行的编程任务和知识工作的前沿模型，价格和速度与 Grok 4.6 相同。\",\"808a06e881ffcce9\":\"如果把 Cursor 和 Bugbot 从我们工程团队中拿走，大家肯定会“哗变”。\",\"808fc5c2e1951427\":\"我会将 Gotoh 仿射缺口算法添加到你的比对模块中，并修复 FASTA 解析器。先从比对代码开始：\",\"80a806b037678633\":\"读取 lib/monitoring.ts\",\"80fceba1ab22c9b6\":\"在 Cursor 中打开\",\"811527ff5e5ed442\":\"查看文档\",\"8119d39895e10587\":\"试用 Cursor iOS 版。\",\"8124114f7b0b125b\":\"将 GitHub 和 Figma 等外部工具及数据源直接连接到 Cursor。\",\"81b43540e0acb194\":\"AI 编程实用指南：模型路由、智能体 MCP、代码审查等。\",\"81caf91814c2c124\":\"Cursor 会在终端中运行脚本和测试，读取回溯信息，并修复报错的代码行。\",\"81d2ef8da717447c\":\"云端智能体\",\"8246d621ea8ec52c\":\"研究\",\"827e68aff643799c\":\"Cursor 自动化会持续监测并改进你的代码库。\",\"828bab5fbfcfbcde\":\"消息草稿\",\"829ec3f51de6ced0\":\"覆盖完整开发生命周期\",\"82a2380bbf4918b0\":\"精选标签页\",\"830144b812bfc2d1\":\"Tab 会查看你当前的任务、最近的更改和相关文件，从而提供结合上下文的建议。\",\"8301a06d17659846\":\"立即下载\",\"8309c65d02f2083f\":\"正在运行命令：\",\"831fcd2ad04d4a75\":\"将工作项分配给 Cursor，或在评论中提及 @Cursor，云端智能体就会将工单转成 PR。\",\"832aadfa1252289a\":\"评估\",\"83441e88bde6609b\":\"客户\",\"835bcde4c8ee212c\":\"Cursor 如何调试我的代码？\",\"8362e40ccaebe65f\":\"自动化车队调度\",\"836e9a957ec01920\":\"运行我的测试套件并修复所有失败项\",\"8395fc05fa56bee3\":{\"c\":\"跳至内容\",\"i\":1,\"t\":\"a\"},\"83a8e254b4219e3b\":\"消除重复性任务，节省时间。\",\"83ca4e63fd8915ad\":\"看起来没问题，推到生产环境吧\",\"83ced9c979128f72\":\"做程序员这件事，确实正变得更有乐趣。它不再只是埋头翻找一页页资料，而是更多地围绕您希望发生什么。我们目前只触及了可能性的 1%，而像 Cursor 这样的交互式体验，正是 GPT-5 这类模型最能大放异彩的地方。\",\"841cad15ee2276fc\":\"资源\",\"844ba724a674a3f7\":\"我们使用 Cursor 自动化、Runlayer MCP 和插件打造了自己的软件工厂。我们的速度比规模大五倍的团队还快，因为我们的智能体拥有合适的工具、充分的上下文，以及恰当的防护机制。\",\"84b84f6720f45e19\":\"查看更新日志\",\"84d4b50eae09c2db\":\"让智能体把创意变成代码\",\"84d76c90046e2537\":\"专为极大提升您的生产力而打造，Cursor 是最佳编程智能体。\",\"84f4a204ee39666b\":\"一切就绪！我们现在可以跟踪注意力占比、切换率和滚动参与度，让 PM 能在几秒钟内比较 Tab 优先和智能体优先的工作流。\",\"850f5bac44dcdd21\":\"Composer\",\"85488606bda60c1b\":\"Slack 中的缺陷 → 生成修复 PR\",\"854e17c7839be3c0\":\"Web\",\"8566c5cf94f996a5\":\"已检查控制台是否有错误\",\"861a990cdd05e8c7\":\"当用户加入团队后，其个人订阅将自动取消，我们将退还当前计费周期内未使用的包含用量。\",\"862d87a9d02f5bcc\":\"AI 开发\",\"866c18da04e0a390\":\"您可以通过 \",\"8686297d8ead4c4a\":\"公司\",\"8687b3dcdd699b08\":\"Cursor Token Rate\",\"86adfe970b92df99\":\"如何邀请团队成员？\",\"86bb51fb0e267b1c\":\"SOC 2 | ISO27001 | ISO42001 | 已获 AIUC-1 认证\",\"86d287aa1993a091\":\"关闭\",\"873f59e14145d3d9\":\"修复 PR 评论获取问题\",\"8771ef0850df133a\":[\"Ambassadors 会举办线下聚会、黑客松和工作坊，并帮助社区空间保持高效且友好。如果您对 AI 驱动的开发充满热情，也喜欢把大家聚在一起，欢迎访问我们的\",{\"c\":\"Ambassadors 页面\",\"i\":1,\"t\":\"a\"},\"了解更多并申请。\"],\"8778fa07b645c96d\":\"Cursor 会为数千个问题起草 PR——修复紧急缺陷、落实设计变更，以及跟进用户反馈。它往往一次就能解决整个问题。\",\"877a3e293ba7a890\":\"深受全球企业信赖\",\"8780f6ef15afe6f7\":\"成为 Ambassador\",\"879f913430ddbc5b\":\"选择您方便的时间\",\"87aa37e5f754a7ec\":\"Cursor 会读取您的消息，选择合适的代码仓库，并在合适的模型上启动智能体。您也可以在提示中指定代码仓库或模型，以覆盖默认设置。\",\"87e76db64ce85576\":\"可直接从 Slack 触发云端智能体，并返回查看已完成的 PR。\",\"87ed900d4b740609\":\"通过手机贯穿整个开发生命周期，完成端到端工作。\",\"88242b3b67bc5ac7\":\"助您直接在终端中完成交付。同样的命令，适用于任何环境。\",\"883ed4d139068ec8\":\"Cursor 与您协作完成规划、编写、审查并交付代码。\",\"884a87414509ad3e\":\"请选择请求类型\",\"8850154060edce4d\":\"提升回复曝光度\",\"887be83f180b104e\":\"CLI\",\"888772b76ddcb869\":\"企业之所以选择 Cursor 来构建产品。\",\"88908fbd8dad9761\":\"高速\",\"88bd94cd50693d81\":\"完成，现已提供支持 AMP 和报告的可配置 MNIST 实验框架。\\n\\n• **训练**：AMP、训练/验证集划分、余弦调度、梯度裁剪、检查点\\n• **实验**：YAML 配置、保存的历史记录、混淆矩阵 + 分类报告、CLI 运行器\",\"8913e9f7a4d141db\":\"调试\",\"8945a13a53677a89\":\"选择 Start\",\"895fd2de08368dbf\":[\"请先\",{\"c\":\"在这里\",\"i\":1,\"t\":\"a\"},\"查看 Cafe Cursor 是否已在您所在的城市开放预订。如果没有，请填写\",{\"c\":\"此表单\",\"i\":2,\"t\":\"a\"},\"，我们会尽快回复您并告知后续步骤。\"],\"896546fbcd66d576\":\"正在搜索 Next.js 文档\",\"8968b621e644f208\":\"加入我们\",\"89ef4555d0d66241\":\"Cursor 会找出缺陷、解释根本原因，并应用修复。\",\"8a0e906f013175d4\":\"成为 Campus Lead\",\"8a2d5a723b8f5fb0\":\"企业每天使用 Cursor 编写的代码行数。\",\"8a96c72d8f239c35\":\"联系团队\",\"8b1d3212790265c2\":\"编写强大的脚本和自动化\",\"8b53362d263ac815\":\"文件资源管理器\",\"8b6880413d26e5d0\":\"带入问题上下文\",\"8ba2b077d3eb79aa\":\"（异步）\",\"8bb5d472774cfc64\":\"深受打造世界一流软件的团队日常信赖。\",\"8bc4be782f2e3c23\":\"访问 r/cursor\",\"8bfa9fe085653bc6\":\"JavaScript 和 React\",\"8c212c2aaaeefe9b\":\"计费组\",\"8c464a152cd04831\":\"不错，已合并。@cursor 您能把图表加上吗？主要指标需要折线图、柱状图和饼图。\",\"8cf875ff0aa11885\":\"您需要一个 Datadog 账户，以及 Cursor v2.6.0 或更高版本。如果您已经注册了独立的 Datadog MCP 服务器，请先将其禁用或移除，以避免冲突。\",\"8d088a9a26ac644e\":\"定价\",\"8d23b79cf6944120\":\"安装 Cursor、设置编辑器，并运行您的第一个智能体。\",\"8d2caa648104ef99\":\"借助 Cursor，您的访问权限能推动什么\",\"8d35a5ee65935b96\":{\"c\":{\"c\":[{\"c\":\"GitHub 集成\",\"i\":3,\"t\":\"h3\"},{\"c\":\"即将推出...\",\"i\":4,\"t\":\"p\"}],\"i\":2,\"t\":\"div\"},\"i\":1,\"t\":\"div\"},\"8d4f6f77e9573e90\":\"阅读 Grok 4.7 发布公告\",\"8d7fb6debe02ed5a\":\"领取您的免费企业试用\",\"8d8555364510a069\":\"已规划\",\"8d9f890b1ae1d287\":\"返回主导航\",\"8d9ff8d11ae284b7\":\"移动端\",\"8df7349e3c5ce6c0\":\"许多任务来自内部代码库和受控来源，从而降低模型已从公开训练数据中记住任务或标准补丁的风险。\",\"8e14d23733a9b556\":\"包括：\",\"8e2e77f02272f961\":\"Bugbot 的缺陷检测准确性如何？\",\"8e887f9fc0f8fd9b\":\"看板\",\"8ea580d96890d405\":\"后续步骤\",\"8eab8f6e2f56800a\":\"添加流式传输\",\"8eb0698bfa3c23fa\":\"根据工单界定任务范围\",\"8f4391b3890e0382\":\"访问 Discord\",\"8f47ef68ede5adb2\":\"高级分析\",\"8f82edca9b9c6355\":\"搜索日志和链路追踪\",\"8f8bba581607e76d\":\"`Object.assign` 会直接原地修改共享的 `DEFAULT_ROUTE_OPTIONS` 对象。\\n某位乘客的路线偏好会泄露到之后的所有行程中。\",\"8fafe24c366ae433\":\"调试 Checkout 问题\",\"8fbb46623287dc68\":\"前往 Cursor 仪表盘，然后点击 Slack 旁边的“连接”。在 Slack 中完成安装后，您将返回 Cursor，连接 GitHub、选择默认代码仓库，并确认隐私设置。完整操作指南请参阅 Slack 集成文档。\",\"8fbe66d494e1c22a\":\"集成到中间件中。已认证用户按其 ID 处理，匿名用户则按 IP 进行速率限制：\",\"8fdd59301522c5e0\":\"您的团队版试用包括：\",\"8fdf1dc2b15283f1\":\"是什么导致身份验证失效？\",\"90570fab6adb8045\":\"隐私选项\",\"90585f4150afc7b3\":\"已归档\",\"909cae41434f9a86\":\"Cursor 可以测试其构建的软件，以验证并演示其工作成果。\",\"90f46dbf8782cfde\":\"连接\",\"910c6213b6a6f4ab\":\"访问项目\",\"91197455d9b1e273\":\"将 Datadog 接入 Cursor。\",\"91387fa5c758d731\":\"随着自主智能体接手维护工作，工程投入正从维持系统运转和代码重构，转向创新与大胆探索。\",\"914a85ef0edb8c8f\":\"探索代码库\",\"915a0904dbdd87ab\":\"获取 Super\",\"9172d902fae27780\":\"Grok 和 Composer 的充足使用额度\",\"918295d34336a9a9\":\"随着您定义并不断迭代自定义规则和最佳实践，Bugbot 也会持续改进。\",\"91a52f5f194b7bdb\":\"已搜索 PyTorch 混合精度训练最佳实践\",\"91b5bfebc960138b\":\"公司人员数量\",\"92132f6335aff800\":[\"详情请参阅我们的\",{\"c\":\"Cookie 政策\",\"i\":1,\"t\":\"Link\"},\"、\",{\"c\":\"隐私政策\",\"i\":2,\"t\":\"Link\"},\"和\",{\"c\":\"服务条款\",\"i\":3,\"t\":\"Link\"},\"。\"],\"92222a39d8cbc921\":\"联系我们的销售团队，深入了解适合贵组织的 Cursor。\",\"9230c2f18cec12a6\":\"保存偏好设置\",\"92530800449393a9\":\"联系我们的团队，了解更多详情。\",\"9267d02879c5ac0b\":\"正在读取 {rest}\",\"9284e84e5487ac79\":\"让\",\"929a2e57623f8ce8\":\"AI 开发成熟度曲线从 AI 辅助和同步智能体，演进到自主异步智能体和 AI 软件工厂，工作方式也从手动走向自动化。\",\"92bff2e5e0c6a1c1\":\"专为由数千名开发者共同构建的复杂代码库而打造。\",\"931675186c5cd005\":\"我们的很多工作都来自 Slack 中的想法和讨论。您可以查看消息，在同一上下文中发起 @cursor，几分钟后就能收到一个 PR。这帮助我避免在智能体处理工作的同时，在不同工具和上下文之间来回切换。\",\"931770504774b4f7\":\"始终保持前沿\",\"93366d1265a1b0ae\":\"请选择您的国家/地区\",\"93377d7ef658ff3b\":\"按席位档位\",\"936ca5fb1a34c02a\":\"添加到 Cursor\",\"936ec164b44447a7\":\"调试\",\"937a2cd07a4ca8a3\":\"将问题转换为查询。智能体会读取结果，并继续结合您的代码库开展工作。\",\"93fb479619083043\":\"上一篇文章\",\"94028b3f8926f7a9\":\"借助语义搜索，Cursor 能轻松处理大型 Java 代码库，从 Spring 服务到传统单体应用都不在话下。\",\"940c0c3ed43f3938\":\"Grok 4.7\",\"94295f52f4d8e080\":\"路由规则\",\"942b948fe72808d5\":\"查询指标和监控项\",\"9456d58f31a61f2b\":\"研讨会\",\"94648db68d24f4d4\":\"当不必在各种工具之间来回切换时，我们的工程团队交付速度最快。Cursor SDK 让我们能够将 Notion 中的工作——规格说明、规划和缺陷——交给可靠的云端智能体，并为每项任务选用合适的模型，而不中断工作流。工程师可以在 Notion 中记录一个缺陷，交给 Cursor 处理，无需离开页面就能拿到完成审查的 PR。\",\"94681fde3cf2829d\":\"使用运行时数据调试\",\"947bf72a307ef819\":\"获取 {tier}\",\"94a278c1ca3918c5\":\"在事件发生时触发一个智能体，让它从 Datadog 拉取相关日志，检查代码库中的近期变更，并在 PR 中提出修复建议。\",\"94a3d104ef537bbd\":\"企业\",\"94bf3117127178f6\":\"更新和 PR 链接\",\"94d9e09f6bd61d4c\":\"生物信息学工具\",\"95038f652b6e3b39\":\"正在读取 nextjs.org/docs 的页面内容\",\"9553ee62153a1fa2\":\"自主智能体\",\"956ca5d3267e7b5e\":\"联系\",\"9588289bb956e0d6\":\"文档\",\"9593aa46ec2b74ae\":\"Next.js App Router 指南\",\"95c42e77f99f0822\":\"可在 OpenAI、Anthropic、Gemini 和 SpaceXAI 的前沿模型中进行选择。\",\"95c9ce9a6a720d22\":\"有哪些可用的管理员控制？\",\"9658ddb99c4505d5\":\"包含团队版的所有功能，另加：\",\"9667fe4dd48a4bce\":\"Cursor 会拉取问题详情、评论和关联引用，让智能体一开始就拥有所需的上下文。\",\"966caa22e541fa16\":\"Grok 的充足使用额度\",\"9678325a2e6bc9c4\":\"请选择一项\",\"968b9bc9d6c9fa6d\":\"云端智能体与自动化\",\"968df33294ec46aa\":\"利用 AI 编程智能体进行开发的实用教程和手册。\",\"969046148f147d48\":\"通过 Cursor iOS 版启动智能体或控制现有智能体，然后回到桌面端继续工作。\",\"96c419e0b4da1cba\":\"Lenny \u0026 Friends Summit 专享免费 Grok Bot 企业试用\",\"96d464f31b046784\":\"如何从个人订阅迁移？\",\"9703841fae471b04\":\"在 cookbook 中查看\",\"97578b2fa664ce1e\":\"CursorBench 3.1 排行榜\",\"9771f37d703e9537\":\"未找到文章\",\"98033961decc844e\":\"更快推进复杂项目\",\"980dae566249a797\":[{\"c\":\"布局预设：\",\"i\":1,\"t\":\"label\"},{\"i\":2,\"t\":\"Select\"}],\"9811c1145e7615a0\":\"邮箱为必填项\",\"9829c80e91cb2943\":\"已搜索 Cursor 规则文档和 .mdc 文件格式\",\"9831463670a2e674\":{\"c\":\"点击下载\",\"i\":1,\"t\":\"div\"},\"9842270db9996454\":\"正在下载 Grok Bot\",\"985449c386648dd3\":\"一组组自主智能体，可为你的代码库进行规划、构建、测试、监控和维护。阅读其背后的创意、案例研究和模板。\",\"986f42699d31459d\":\"指派给 @Cursor 或提及 @Cursor\",\"98ed7fb60802d031\":\"我们应将您的键盘寄往何处？\",\"9911c798f2ba1ab0\":\"Cursor 智能体\",\"99280e9a41f063aa\":\"思考 8 秒\",\"9973e017d74e1948\":\"Cursor 不仅帮助我变得更高效，也让我更有好奇心和信心去探索新的问题领域。它确实已经成为我日常工作流中不可或缺的工具。\",\"99b857df6714bacf\":\"前沿模型用量提升至 20 倍\",\"99e75a92f44cc2f3\":\"像 Cursor 这样的编程智能体，已经成为 AI 的杀手级应用。编程智能体不仅提升了代码创建的速度，也改善了代码质量。\",\"99f5c8d4f2297bb4\":\"胜任真实工程任务\",\"99f816cde64fc226\":\"通过 Bugbot 进行 AI 代码审查\",\"9a475bc5672ca803\":\"我会创建一个极简、以衬线字体为主的落地页，契合你的品牌调性。\",\"9afec9bb808aa78a\":\"已搜索 Next.js App Router 动态路由文档\",\"9b1864d49dc0fd59\":\"委派整个任务\",\"9b31372968411130\":\"已通过认证并定期接受渗透测试。所有提供商均支持零数据保留。\",\"9b773be101f7422b\":\"我可以控制 Cursor 使用哪个代码仓库吗？\",\"9b7742d0831b6688\":\"由 Cursor 驱动的现代工程团队。\",\"9b7c0dd8df3dd7f7\":[\"请先在 \"],\"9b7fcea6e013312c\":\"大多数 AI 能帮您完成大部分工作，但其余工作仍散落在您的工具、应用和收件箱中。Bot 可以登录您的工具，像您一样使用它们，并带着完成的工作回来。\",\"9b82d0dc6dfb7c2f\":\"预约会议，梳理你团队的工作流，找出 Cursor 和 Grok Bot for Engineering 最能发挥价值的环节。\",\"9b8377aaecac5bed\":\"申请实地工具包\",\"9b92d718d24ad170\":\"__tests__/checkout.test.ts +156\",\"9bb17547a090d32b\":\"现代工程团队正在实现 SDLC 自动化。\",\"9bc6b7d6efe1b086\":\"Bugbot 会审查 PR，并在合并前标记缺陷。本页介绍的工作流则在 Cursor 编辑器中运行，您编写代码时，智能体会与您一起调试和重构代码。许多团队会同时使用这两者。\",\"9c7d8855f08a2b88\":\"回退到它之前是这个样子的时候\",\"9c8a5eb7ffd2fe3f\":\"社区插件导入\",\"9c9835d1b34dd65a\":\"优先使用高级容量\",\"9cab1ff57012c90f\":\"dispatch_tests.rs +62 -0\",\"9cdab1d4cab60f7c\":\"什么是 Cursor Start 规划？\",\"9d13c1e0774f64c6\":\"集中式安全控制\",\"9d2fc1003e82feb1\":\"用量\",\"9d5e659b321220d0\":\"启动一整队智能体，并行处理高难度任务，持续数小时甚至数天。\",\"9d9f3c9ba3807dfc\":\"请输入您的城市\",\"9da235c0cfb1cc77\":\"版本\",\"9da953cc3d9bf314\":\"通过 Origin 托管代码\",\"9ddbeefd5d3a230d\":\"集中式智能体管控\",\"9de6e9882ad20a96\":\"获取团队版\",\"9e0f529b75653f6c\":\"开始使用 Cursor。\",\"9e2fad835dfc8663\":\"安全代码审查智能体\",\"9e3fb413eac4ade2\":\"借助专业能力，大规模部署 AI\",\"9e82296a329ca813\":\"检查点会为每一步创建快照，因此您可以检查每一处更改，并恢复到任意先前状态。\",\"9e8730ae5c37e2ea\":\"已审查\",\"9e9498bfe0c11194\":\" 或 \",\"9ea887b1c95b3fe4\":\"Cursor 可在您的终端中运行、在 Slack 中协作，并在 GitHub 中审查 PR。\",\"9ec19db95be868b7\":\"行业专题场次\",\"9ed0fb84dadbfde1\":\"我们的团队将尽快联系您，确认将您的 Cursor 实地工具包寄送至何处。在此期间，您可以下载 Cursor 或查阅文档。\",\"9f015d8d56164f3b\":\"无论智能体在哪里运行，你都可以在移动端统一管理所有智能体。\",\"9f25d3a5565f0f54\":\"推荐资源\",\"9f4ee692873ef82f\":\"自测\",\"9f54a5b4ca1ab493\":\"了解集成\",\"9f721fbca4c5d664\":\"支持哪些模型？\",\"9f8029cea7d6af10\":\"我们看到，我们投资组合中的工程团队以及 Carlyle 的团队都在使用 Cursor 来加快产品路线图的推进、更快交付功能，并应对需求高峰，同时仍然保持质量与专注。它的 AI 功能和 Tab 补全表现非常出色，而能够从小规模开始、再随着时间逐步扩大用量，也成了一个真正的差异化优势。\",\"9f9f85f5089153da\":\"Cursor 为学生提供折扣吗？\",\"9fa2a817f1e9b55b\":\"姓\",\"9face82f219f0791\":\"离线视频\",\"9fba28cee94f01bc\":\"相比 Plus 增加的用量\",\"9feb3d6e394f3fc1\":\"checkout 在生产环境中出问题了，添加测试\",\"a056d172653f43f0\":\"代码托管与 AI 代码审查\",\"a06043249ed2506b\":\"发现真实缺陷的 AI 代码审查\",\"a071d77d73d5f68d\":\"用测试验证修复\",\"a07500afc2e2006b\":\"专有模型\",\"a08a6f2a93c09efa\":{\"c\":{\"c\":\"定价表数据缺失\",\"i\":2,\"t\":\"p\"},\"i\":1,\"t\":\"div\"},\"a09d8f784d34befc\":\"随着智能体承担越来越多这类工作，平衡也会随之改变。团队花在维护现有成果上的时间会更少，把更多精力投入到新产品，以及那些一直积压在待办事项列表中的大胆尝试上。\",\"a0c17a129691de17\":\"搜索中\",\"a0f1b2c2227d91e9\":\"获取 Plus\",\"a0fc3a25401cbeb0\":\"MDM 与服务器端分发\",\"a107c6903c6015a0\":\"Cursor CLI\",\"a148183cb15e18e7\":\"为您的团队试用 Cursor。\",\"a155da360d43f3aa\":\"并行推进工作\",\"a15f6cafc84a14b9\":\"从“编写这个函数”转向“修复这个问题”。智能体可以规划、实现、测试并打包工作成果，供审查使用。\",\"a174122ff9c667b8\":\"已审查工作区用量导出数据和历史参与记录\",\"a179d2e7de33172e\":\"我会通过检查浏览器状态并查看控制台来排查 checkout 问题。\",\"a18988aaa07e4ea4\":\"调查生产环境错误\",\"a1cb4e5aac4d46b8\":\"污染控制\",\"a1faffad19d20143\":\"读取 hooks/useChat.ts\",\"a20047c215feb9bf\":\"调试 JavaScript、Python、Java 等多种语言\",\"a229586f3d6973bb\":[\"每个套餐都包含一定额度的模型用量。按需用量可让您在包含额度用尽后继续使用模型，费用将按后付费方式结算。更多详情请参阅\",{\"c\":\"我们的文档\",\"i\":1,\"t\":\"a\"},\"。\"],\"a22dcc340a18c6d0\":\"Grok Bot 条款\",\"a2430c580f65dd90\":\"Dashboard.tsx +28 -15\",\"a25ea10b87bbba6e\":\"没有打开的面板\",\"a264ae99feea7308\":\"*第三方模型在 Cursor 中可用，按用量单独计费\",\"a2688a31195c5229\":\"集成\",\"a2c7090ead0dc7c5\":\"拉取仪表盘和事件\",\"a3088c52c611f5c4\":\"覆盖 SDLC 各阶段的智能体\",\"a37521d26ba8659c\":\"灵活搭配席位类型\",\"a3e5f3e7d2de53c7\":\"从示例项目开始\",\"a3fa0033caffeaea\":\"Plus 的 15 倍\",\"a40ab1f598b39ca4\":\"有限的智能体请求\",\"a4349c702b053243\":\"团队限制\",\"a4463041bbf7ee74\":\"数千个团队必备的合并前检查\",\"a44c9173d1e4340b\":\"下载 Cursor\",\"a44e6b82a3fee3f1\":\"身份管理\",\"a45f2d93eeb063c0\":\"读取 app/api/chat/route.ts\",\"a460d42a873de745\":\"无限量选项卡补全\",\"a4b1391dc80bb0ff\":\"已修复，一切就绪。\",\"a4c765993e9ac7e4\":\"最新 Grok 模型\",\"a4ecc2d52fb9c50b\":\"隐私政策\",\"a518e05139c46029\":{\"c\":\"应用名称：\",\"i\":1,\"t\":\"label\"},\"a553be36e93303cd\":\"就绪\",\"a55fb5a799f5e9f2\":\"同样的命令，适用于任何环境。\",\"a568f4362a3775f7\":\"原型开发工具\",\"a56a472a291d0334\":\"较新的文章\",\"a59795f426aee1ee\":\"你的雄心从来不是瓶颈。\",\"a5b4c4e8b679fb09\":\"请描述工作内容。Cursor 会规划、编写代码、测试，并创建 PR。\",\"a5b91c2d2961ccf4\":\"包含\",\"a5c76138e51bc273\":\"加深对代码库的理解\",\"a6124639e2ef2e8c\":\"你的工程知识库\",\"a6265b7ba3b1cafe\":\"检查控制台错误\",\"a6297f4ce85519b3\":\"规划 Web 导航策略\",\"a64a0be52b4fc0f2\":\"并匹配\",\"a67444eda60dfcd7\":\"以下是 Next.js 的最新功能：\\n\\n**App Router** - 基于文件的路由，并结合 React Server Components\\n\\n**Server Actions** - 可直接从客户端组件发起服务器端操作\\n\\n**Partial Prerendering** - 结合静态与动态内容\\n\\n**Turbopack** - 基于 Rust 的打包器，带来更快的构建速度\",\"a680925fd5a5c23d\":\"首选 @用户名\",\"a696489b19285300\":\"限制可通过 CLI 访问智能体的用户\",\"a6b85a2b047862e7\":\"先规划重构方案\",\"a70e077c69953ffe\":{\"c\":\"变体\",\"i\":1,\"t\":\"span\"},\"a712033e3d67958c\":\"工作区功能采纳洞察\",\"a753785b933b994d\":\"获取工作成果演示\",\"a75d820c2bed5d59\":\"新闻\",\"a76c6ac6d2f27870\":\"已添加带响应式封装的 Recharts。已创建支持深色模式的 LineChart、BarChart 和 PieChart 组件。\",\"a7a6f6e342ca4342\":{\"c\":\"目录\",\"i\":1,\"t\":\"h3\"},\"a7ae3444a29fdfd8\":\"智能体完成后，Jira 会显示完成进度更新，并附上可打开 PR 的链接。\",\"a80a35888b3af7df\":\"提问\",\"a846358d18b49fb7\":\"在终端中运行代码\",\"a84f38c646301a14\":\"会话上下文\",\"a85212462f1062fe\":\"使用为 Cursor 提供支持的同一运行时、harness 和模型来构建程序化智能体。只需几行 TypeScript 代码，即可在本地、云端或自托管工作节点上运行智能体。\",\"a86511fdeb38143c\":\"SCIM 预配\",\"a86ac1ad8677bb2b\":\"Grok Bot 是 SpaceXAI 的产品，现已推出企业方案。\",\"a87c5bf26de05fc6\":\"浏览并安装由社区构建的插件，为 Cursor 扩展新功能。\",\"a927f5d7884e1f6b\":\"资源管理器\",\"a92f1c55e3ad85ac\":{\"c\":\"窗口位置\",\"i\":1,\"t\":\"label\"},\"a952ce58214fcca1\":\"帮助\",\"a963f820a5b650f9\":\"包含 Hobby 的全部内容，外加：\",\"a97a224d1d10b45a\":\"可强制执行 + 可选\",\"a9999562d20cd7e3\":\"正在整合成最终测试文件，并覆盖并发购买的边界情况：\",\"a9cb255c1f094dcf\":\"Cursor 徽标动画\",\"a9db8d565687dca6\":\"客户\",\"aa17ce34f1ae7e13\":\"找到了 2 天前的修复记录。\",\"aa1d335571e3735a\":\"限制可创建云端智能体的用户\",\"aa3697a2b9a83638\":\"我最喜欢的企业 AI 产品是 Cursor。我们约 40,000 名工程师现在都在 AI 的辅助下工作，生产力得到了惊人的提升。\",\"aa55f8ba50526d48\":\"赋能新一代创造者。\",\"aa75a6e82ca765a0\":\"代码库索引\",\"aa765f8baa7c4c67\":\"Bugbot 可帮助节省 40% 的代码审查时间。\",\"aa979f92fa8d2070\":\"当前实现会等收到完整响应后再渲染。我会将其改为 Server-Sent Events，这样 token 就会在生成时即时显示。这涉及三个部分：\\n\\n• API 路由返回 ReadableStream 而不是 JSON\\n• 客户端钩子以增量方式处理数据块\\n• 消息组件能优雅地处理部分内容\",\"aac88e43e9edb059\":\"返回工作坊\",\"ab04b75ed948df39\":\"Cursor 如何处理大规模代码库和 monorepo？\",\"ab425e33e1220ce4\":\"聊天请求次数有限\",\"ab47f58386924b4f\":\"上一页\",\"ab90e01358061b3c\":\"工作邮箱\",\"abed88531c506ad2\":\"打开 Flashcards\",\"abf85b3f032ec626\":\"联系团队，了解面向企业的 Grok Bot\",\"ac10e1327c89c4f5\":\"使用 Cursor Start，持续构建\",\"ac288ee29724bcaa\":\"加入全球 Cursor 社区。\",\"ac2b8c939e6cb51b\":\"在浏览器中打开\",\"ac43176daeea3281\":\"每个产品缺陷和每一条反馈一进入系统，就会自动分配给 Cursor，并标记上对应的代码仓库。\",\"ac5270d537548ee8\":\"Cursor 会读取问题，启动云端智能体，并在完成后返回结果。\",\"ace69d9094a43db2\":\"Cursor 需要以下权限：读取提及、频道和线程历史记录作为上下文，以及发布状态更新、完成通知和表情回应。每项权限及其用途说明均列在 Slack 集成文档中。\",\"ad1d9f6a9ef79185\":\"我们使用 Cookie 和类似技术提供服务、衡量性能并支持广告投放。必要 Cookie 是网站正常运行所必需的，无法关闭。您可以在下方选择允许或拒绝可选 Cookie。\",\"ad31dc60e52abff9\":\"用于日志记录、审计等的钩子\",\"ad4c6bf8cc1bc124\":\"可自主构建和维护软件的智能体。\",\"ad70bae411b9ad94\":\"真实 Cursor 会话\",\"ad84a37c533dc579\":\"更少的时间线广告\",\"ad8a1fd315a54572\":\"思考 10 秒\",\"ad8db1b4c443d154\":\"Cursor 改变了我们工程团队编写和交付代码的方式，采用人数在短短几周内就从 150 名工程师增长到 500 多名（约占我们组织的 60%！）。\",\"adac2a012a7c8893\":[{\"c\":{\"c\":[{\"i\":3,\"t\":\"input\"},{\"c\":\"智能体\",\"i\":4,\"t\":\"span\"}],\"i\":2,\"t\":\"label\"},\"i\":1,\"t\":\"li\"},{\"c\":{\"c\":[{\"i\":7,\"t\":\"input\"},{\"c\":\"侧边栏\",\"i\":8,\"t\":\"span\"}],\"i\":6,\"t\":\"label\"},\"i\":5,\"t\":\"li\"},{\"c\":{\"c\":[{\"i\":11,\"t\":\"input\"},{\"c\":\"编辑器\",\"i\":12,\"t\":\"span\"}],\"i\":10,\"t\":\"label\"},\"i\":9,\"t\":\"li\"},{\"c\":{\"c\":[{\"i\":15,\"t\":\"input\"},{\"c\":\"聊天\",\"i\":16,\"t\":\"span\"}],\"i\":14,\"t\":\"label\"},\"i\":13,\"t\":\"li\"},{\"c\":{\"c\":[{\"i\":19,\"t\":\"input\"},{\"c\":\"布局反转\",\"i\":20,\"t\":\"span\"}],\"i\":18,\"t\":\"label\"},\"i\":17,\"t\":\"li\"}],\"adb224316b8a2caa\":\"最受欢迎\",\"add06af2d143a34e\":\"components/ChatMessage.tsx +12 -3\",\"adf0d5e3197377e4\":\"下载 macOS 版 Cursor\",\"ae2924b72ec33ad9\":\"团队版和企业版\",\"ae3c5f5e93a12ae8\":\"申请您的实地工具包\",\"ae50a174ba97f253\":\"现在 checkout 应该可以正常工作了。修复内容：\\n\\n• 已将 GET 请求改为 POST 请求\\n• 已添加正确的 `Content-Type` header\\n• 已在请求 body 中包含购物车商品\\n\\n请再次点击 checkout 按钮试试！\",\"ae615e576a663d66\":\"了解更多\",\"ae796995c557b522\":\"创建您的自驱代码库\",\"aea8ee8859eadffe\":\"现在处理客户端钩子。使用 AbortController 做清理，并用 TextDecoder 处理数据块：\",\"aec19b4fb8b91e4f\":\"相关指南\",\"aee25390e68bb61f\":\"无需离开 Cursor，即可查询您的技术栈。\",\"af04c1387ba5d2c3\":{\"c\":[{\"c\":\"多窗口演示\",\"i\":2,\"t\":\"h1\"},{\"c\":\"这个交互式演示展示了如何在桌面环境中组合多个 Cursor 组件。您可以自由搭配移动端演示、桌面窗口和自定义内容。\",\"i\":3,\"t\":\"p\"}],\"i\":1,\"t\":\"div\"},\"af06607db5c632d8\":\"访问我们的信任中心\",\"af1c46d4350f9053\":\"按 API 标价提供第三方模型\",\"af29df4481e686b0\":\"在 GDPval 上，Grok 4.7 以超高投入级别取得 1,695 Elo 分；Grok 4.6、Fable 5.1 和 GPT-6 Astra 则分别取得 1,605、1,735 和 1,542 Elo 分。\",\"af3f3a46a83346ce\":\"购买 Start 规划即表示您同意\",\"af5aa97562703b46\":\"隐私模式\",\"af7c94aa6d4477e6\":\"构建经久耐用、可扩展至大规模的软件\",\"af86df4a43b53a29\":\"零数据保留\",\"afcdf02c13e7443a\":\"深受以下公司的工程团队信赖\",\"afda415d2d75a5d3\":\"聊天\",\"b00810b23b68854e\":\"下载 {os} 版 Cursor\",\"b01bc33ad1e15d8e\":\"开始使用适用于 Linear 的 Cursor。\",\"b027166e406df396\":\"深入了解 Bugbot\",\"b03676d812682019\":\"了解云端智能体\",\"b04a2a5264fa4d89\":\"介绍 Grok 4.7\",\"b062be83d929593a\":\"来自 Cursor 团队的最新动态与洞察。了解 AI 赋能的编程、产品更新和开发技巧。\",\"b06de44ea396fdf6\":\"跟踪智能体的进度，审查其 diff，并直接从 Linear 打开已完成的 PR。\",\"b073e2bd8e6fe0b0\":\"添加响应头，方便客户端跟踪其用量：\",\"b0b2a3cd11daa9bf\":\"我会使用 Rust 的 Result 类型并结合 thiserror，实现异步 dispatcher 模式，以提供更便捷的错误处理和流式构建器 API。让我先查看现有结构并实现该 dispatcher：\",\"b0e84e35de44a0c3\":\"终端\",\"b12c1e9c8c0e77a4\":\"设计模式\",\"b17fc287892e692b\":\"可进行规划、构建、测试和审查的智能体——覆盖完整开发生命周期，让您的团队像一个系统一样协同交付。\",\"b1a54abc5aef15dd\":\"添加后续消息\",\"b1ee67f45ae39ff4\":\"云端智能体可异步运行耗时较长的多步骤任务，因此即使您关闭编辑器，工作进度也不会停滞。\",\"b21c966887740c17\":\"始终在线，一切由您掌控\",\"b22a23fb121b158f\":\"查看所有媒体报道\",\"b29a0de18fb0ea9e\":\"更多前沿模型访问权限\",\"b2c56256a18749ed\":\"我会为你的仪表盘设置 Cursor 规则，以确保模式保持一致。先创建一个包含所有必要指南的规则文件：\",\"b2d07219f5a2c023\":[\"The X Subscription 的任何付费规划订阅者，以及订阅高级版或 Premium+ 档位的旧版 X Premium 订阅者，使用 𝕏 Card 进行符合条件的消费时，可获得最高 \",{\"i\":1,\"k\":\"_gt_value_1\",\"v\":\"v\"},\" 的返现。所有其他用户在满足合格直接存款要求后，可能有资格享受最高 \",{\"i\":2,\"k\":\"_gt_value_2\",\"v\":\"v\"},\" 的加码返现。部分交易不符合返现条件。有关详情，请参见\",{\"c\":\"返现奖励条款\",\"i\":3,\"t\":\"a\"},\"。\"],\"b3138d592dc7c058\":\"Cursor 可使用记忆工具，从过往运行中学习，并在反复执行中持续改进。\",\"b344e5f77420a8d8\":\"相比高级版提供更多用量\",\"b376dcbaddbfa05c\":\"@cursor 您能审查这个 PR 吗？\",\"b389719e28a5d0f6\":\"正在提交\",\"b3eeba383e059465\":\"𝕏 Money 年化收益率\",\"b3f8141fb274de52\":\"让 chat 响应以流式方式返回，而不是先缓冲再返回\",\"b40708d7919c99b0\":\"专业指导\",\"b44741ffcaf51adc\":\"用手机交付代码\",\"b448c513d2454013\":\"已修复 token 初始化。所有测试均已通过。\",\"b483797ce356f199\":\"立即开通，最高可省 3,000 美元。\",\"b496ada4642fe600\":\"联系我们的销售团队\",\"b4abd218a594a51c\":\"前沿模型用量提升至 3 倍\",\"b4dfaa60acf1a1e4\":\"添加上下文\",\"b4e857df6610f770\":\"Cursor 指南\",\"b4ebefd70f6793fd\":[\"所有价格均不含任何适用税费。更多信息请参阅我们的\",{\"c\":\"Terms of Service\",\"i\":1,\"t\":\"Link\"},\"。\"],\"b50c41465e5408b3\":\"邮箱\",\"b50d4ac14baf1cd4\":\"从团队代码库中学习的智能体\",\"b50f6b7fa11a8fa7\":\"更高的用量上限\",\"b5702d0b64866b08\":\"定制版\",\"b5de14cdb2237156\":\"适合协作构建的团队：\",\"b5fbe6f7bd4d22e1\":\"数据使用\",\"b5fe879e69879e16\":\"不错，@eric 您能审查一下吗？\",\"b65d2ada28b71b8a\":\"选择您的 Datadog 域名，并在浏览器中通过 OAuth 登录。您的连接详情会经过加密并存储在 Cursor 中。\",\"b65ecd55d74e8cff\":\"已提交修复\",\"b708abf0cf94875f\":\"运行测试并修复失败项\",\"b70b0fb5ba61a225\":\"可从您已在使用的工具中直接启动智能体。\",\"b70cb9a5f3747659\":{\"c\":\"正在提交表单，请稍候。\",\"i\":1,\"t\":\"span\"},\"b70e056a6e5000f2\":\"全球合规标准\",\"b713e4542ff836e0\":\"下载 macOS 版本\",\"b740c7a7b992767c\":\"已创建 .cursor/rules/next.mdc\",\"b743d00d47a74370\":\"构建完成，所有测试均已通过。要推送到 main 吗？\",\"b77971d5b41a89c4\":[{\"i\":1,\"t\":\"input\"},{\"c\":\"入场动画\",\"i\":2,\"t\":\"span\"}],\"b7a6dad0b998ac98\":\"一键安装\",\"b81efb131f3b1a9c\":\"为流式传输期间的部分消息添加优雅处理：\",\"b83ee8a3132c338f\":\"在浏览器中通过指点、绘制或口述 UI 变更，同时由智能体编辑代码。\",\"b848773fd942cc02\":\"安装\",\"b8572691f57650fb\":{\"c\":{\"d\":{\"b\":{\"one\":{\"c\":[{\"i\":4,\"k\":\"_gt_n_4\",\"v\":\"n\"},\" 条回复\"],\"i\":3,\"t\":\"C3\"},\"other\":{\"c\":[{\"i\":4,\"k\":\"_gt_n_4\",\"v\":\"n\"},\" 条回复\"],\"i\":3,\"t\":\"C3\"}},\"t\":\"p\"},\"i\":2,\"t\":\"Plural\"},\"i\":1,\"t\":\"span\"},\"b8a9c56b13cc7334\":\"1 小时前\",\"b8f2fc82fa9222a0\":[{\"c\":\"功能卡片沙箱\",\"i\":1,\"t\":\"h1\"},{\"c\":\"按实际尺寸并在不同窗口位置预览功能卡片。\",\"i\":2,\"t\":\"p\"}],\"b9274324a46d2a6f\":\"我们的 Campus Lead 通过分享 Cursor、传授最佳实践和组织活动，在各自的学校代表 Cursor。名额有限。\",\"b99a869ed5a95927\":\"注册\",\"ba1b6da6e505857f\":\"隐私详情\",\"ba489956424ad525\":\"大多数界面\",\"ba6b93068d235846\":\"深受全球领先企业信赖。\",\"ba9d949e33fdea7f\":\"在现有线程中提及 @Cursor，智能体就会将整个对话作为上下文读取。缺陷报告、设计稿、错误追踪；无需重复粘贴。\",\"baa153273faba830\":\"读取 feature-prd.md\",\"baba8cd4370efe6f\":\"如今，我们超过 70% 的工程师都在使用 Cursor，而且我们已经看到它在日常开发中带来了显著提升：大规模迁移推进得更快、调试效率更高，甚至新成员上手也更迅速。\",\"babbb7909517dd08\":\"Bugbot 专注于发现那些最终会被修复的缺陷。超过 70% 的标记问题会在合并前得到解决。\",\"bac1e2a546cd9bd0\":\"审计日志\",\"bac7bdbb8c5e4a12\":\"收听最新一期节目\",\"bacc356ce87576cb\":\"更多客户案例\",\"bad782215f2ac0ba\":\"让 Datadog 在您休息时也照常工作。\",\"bafca95256932bd5\":\"通过 SCIM 管理席位\",\"bb0544eee6926456\":\"移动端智能体\",\"bb68b417e40730a3\":\"购买 Start 套餐即表示您同意我们的\",\"bba6b1acf453eda3\":{\"c\":[{\"i\":2,\"t\":\"input\"},{\"c\":\"卡片容器\",\"i\":3,\"t\":\"span\"}],\"i\":1,\"t\":\"label\"},\"bbb0c81a7e6ce4ce\":\"感谢您与我们联系。我们的团队将与您确认详细信息，并寄送您的 Cursor 实地工具包。\",\"bc12743440008736\":\"前沿级速度\",\"bc28eea24eec82f8\":\"在 CursorBench 4.0 上，Grok 4.7 以超高投入级别取得 46.3% 的得分。\",\"bc2fb5b3283ed1cc\":\"读取中\",\"bc3408284caf7f79\":\"如何联系社区团队？\",\"bc39ef905b0fa1c2\":\"设置可根据预定时间或事件触发器自动运行的智能体。\",\"bc4b74fef3a4c713\":\"法律\",\"bc4d22efb7ac2897\":\"合作伙伴\",\"bc4eef54a8ea9c4b\":\"将智能体路由到 Cursor 支持的任意模型。只需更改一个字段，即可切换模型，并为每个工作流平衡成本与能力。\",\"bc57bdd97fb093c0\":\"包含 Super 的全部功能与权益，以及：\",\"bca77b31c7b7224b\":\"Bugbot：PR 评论获取缺陷\",\"bcba58b1ad13d002\":\"制作精美的 AI 图像与视频\",\"bcc9a4b1c42d2680\":\"Start\",\"bccce2af8879fb6f\":\"已搜索 Exposé 模式\",\"bd3deac54c2c3113\":\"邮箱地址\",\"bd58e914505ad4cb\":\"文件已更改\",\"bd71636896c7dd02\":\"从亲手输入每一步，到让工作运转起来——您的键盘可以专注于更重要、更有价值的工作。\",\"bda5af471ef547e0\":\"更多\",\"bdbc36019f053a20\":\"用量限额如何运作？\",\"bdbd9f7f0f5d5a0c\":\"在 Web 中打开\",\"bdc297dd5dbf6abb\":\"Plus\",\"bdf67e083afe3bdd\":\"切换模型\",\"bdf8bfcd167eaf5f\":\"将重复性工作委派给始终在线的智能体。设置按计划或事件触发运行的 Cursor 自动化，用于构建、维护和修复软件。\",\"be3c1d1560fed876\":\"试用团队版\",\"be96622f3f612ca8\":\"完成——已使用 App Router 搭建好 Next.js 14，通过 Prisma 连接 Postgres，并完成了基础的 Redis 配置。还添加了 Tailwind + shadcn/ui 组件。\",\"be9eac62bb2f0b61\":\"团队用量分析\",\"beaee8f6e098452f\":\"Cursor Jira 集成\",\"bf0e2dd170bdde17\":\"构建项目并确保所有测试均通过\",\"bf13f94cf8c927f0\":\"迈向自驱式代码库\",\"bf1b49c6b5d12a4b\":\"Cursor 能够深入理解你的代码库，并学习团队的开发模式。\",\"bf2671224a24b47c\":\"Cursor 如何使用我的数据？\",\"bf2d8bf90e9090f1\":\"键盘会议详情表单\",\"bf3339c9049610e7\":\"如何及时了解 Cursor 的校园计划和活动？\",\"bf51ac36e3f4b08e\":\"较早的文章\",\"bf8c72e0da476ad4\":\"𝕏 Money 返现\",\"bfbfa5b2574fa37b\":\"控制台输出：\",\"bfcb1220e57b6ca7\":\"了解我们如何使用它\",\"bff944189ba9c100\":\"下载\",\"c023d867365b64ba\":\"评分\",\"c03778e76b42c497\":\"编辑器\",\"c048cd4528499c2c\":\"我们基于真实 Cursor 会话构建的标准离线评测套件中的正确性结果。\",\"c060492bcd86f2d9\":\"智能体旨在大幅提升您的工作效率，将创意变成代码。把任务交给 Cursor，加速开发。\",\"c0891a46027ffdb8\":\"。Start 规划仅支持按月计费。个人版和团队版规划的价格按当前汇率估算。\",\"c09408a8e9ceda27\":\"为有专项需求的团队提供量身定制的支持。\",\"c0c67d1670fc2a90\":{\"c\":\"演示选项\",\"i\":1,\"t\":\"div\"},\"c0c8dc428a2c17db\":\"Cursor 自动化正在帮助我们消除客户与工程师之间的隔阂。我们能够更快响应客户需求，并提供更好的解决方案。\",\"c0d8bf1724955526\":\"了解 Bugbot\",\"c138b6b944d866a3\":\"Cookie 偏好设置\",\"c176f43f50a1f1e1\":\"我们很乐意邀请您参与 Cursor 的抢先体验计划。请联系 community@cursor.com\",\"c199131a6d9fb4a0\":\"把堆积的工作交给 Cursor。\",\"c1fc0d9d4bd55d16\":\"适应您的标准\",\"c22400eee0435e76\":\"您将学到的内容：\",\"c22992f97d274976\":\"经过我们自家待办事项积压的实战检验。\",\"c2310ac48c0f36f3\":\"同样的雄心，不同的视角。您的实地工具包自会说明一切。\",\"c246fcc6a412571c\":\"借助 Cursor，只需一条指令，即可让自主智能体并行工作——让雄心勃勃的项目所需的时间不再挤占您一天中的其他安排。\",\"c287dd16bad2c81d\":\"补充说明\",\"c2aa694dac7eafca\":\"正在启动新的分析仪表盘。目标是将加载时间控制在 500 毫秒以内、支持实时更新，并适配移动端。\",\"c2c97471eca90e89\":\"个人\",\"c2fbf910c301aafd\":\"让 Cursor 处理待办列表中积压的工单，由智能体先完成第一轮处理。\",\"c30cf1cad3d6d524\":\"个人方案\",\"c31955b6041916e1\":\"从 Cursor cookbook fork 入门项目，并按您的使用场景进行扩展。\",\"c32c304745e718cf\":\"Cursor 可以支持我的黑客松活动吗？\",\"c33a2b9d68ef2d9c\":\"永不休眠的智能体\",\"c342f2c79b5e9cf0\":\"自动化测试覆盖率\",\"c34d7f6170836f7c\":\"论坛\",\"c3563163564cb1b8\":\"搜索智能体\",\"c37237fc8d425018\":\"集成\",\"c3a2274a4becba39\":\"查看更多内容\",\"c3a9a621efe6a3f4\":\"规划：在现有 CSS 变量基础上，使用 next-themes 添加可持久保存、由用户控制的主题（浅色/深色/系统）。\",\"c3ab42123011b612\":\"过去一个月发布的内容。\",\"c3b015989eb2fe70\":\"试用移动端智能体\",\"c3bbd7411a2dc811\":\"云端\",\"c3c344022dccf7a7\":\"感谢您联系我们！\",\"c3cc983b6deb30a4\":\"适用于内部规则、技能和插件的团队应用市场\",\"c3e27539e74fc120\":\"支持共享团队上下文的云端智能体\",\"c3e4349eed98e2f5\":\"联系销售\",\"c3eeeebc1a198efd\":{\"c\":\"Changelog\",\"i\":1,\"t\":\"Link\"},\"c3f14d11667ad36f\":\"Pro 的所有功能，另加：\",\"c40b1cfd56fa0de6\":\"首次人工响应：严重问题 8 小时，标准问题 24 小时\",\"c45fa7210be5f8b3\":\"在同一线程中提及 @Cursor，即可向您拥有的智能体添加后续消息指令。若要在线程中为已存在智能体的讨论单独启动一个新的智能体，请使用“@Cursor agent [提示]”。对于多智能体线程，请在特定智能体的消息上打开上下文菜单，然后选择 Add follow-up。\",\"c4ac61ee0ac2ae64\":\"可直接从 Cursor 运行 shell 命令，用于构建、测试和安装，默认在沙箱中运行。\",\"c4cc188e1e3acd9e\":\"不限量 Tab 补全\",\"c5103f332c203408\":\"SSO (SAML/OIDC)\",\"c523f5f211a98427\":\"如何订阅 Cursor Start？\",\"c54113c3306875ad\":\"社区\",\"c54481fddbfd9119\":\"一张发票，仅对活跃成员计费。您可以随时添加或移除团队成员。\",\"c553a5395b3b1cfa\":\"使用动态路由和布局设置 Next.js App Router\",\"c58205207164a9fe\":\"访问 Composer\",\"c59720248f69d5aa\":\"推荐\",\"c59cb66ccfac36dd\":\"键盘申请表\",\"c59f831dd66e869d\":\"如何安装？\",\"c59f9901d8af49c4\":\"联系我们的团队，规划您的首批智能体工作流。沟通后，我们会向您寄送一套实地工具包——其中有一张卡片，换个光线看，会呈现更多内容。\",\"c621fea1e3da965f\":\"点播课程\",\"c632de0fdd2a3624\":\"已同步子智能体输出\",\"c646cb09e81e28fa\":\"下载 {os} 版本\",\"c6811cd62c77886e\":\"每天都深受构建世界级软件的团队信赖\",\"c688bc97d01d01f7\":\"自动处理重复性工作\",\"c698ef0ef81c6232\":\"请告诉我们要在哪里设置，我们将为您开通 Lenny \u0026 Friends Summit 试用。\",\"c6b638f2f333fa76\":\"自动调查事件\",\"c710cd0d66d03745\":\"集中式团队计费与管理\",\"c71c3c8676153c8a\":\"团队插件应用市场\",\"c733121ed141a208\":\"代码审查\",\"c79562e6c2903fbb\":\"CursorBench 的工作原理\",\"c7a95db7bcc748df\":\"{price}（按年付费）\",\"c7aa0e169164a191\":\"应用市场\",\"c7d1e9c9bd97d52d\":\"按月\",\"c7d820912ab20613\":\"Tab 可预测您接下来要进行的编辑，支持跨文件操作，从多行修改到整个代码库范围的重构。\",\"c7dbb9a113841ea2\":\"如何查看和管理我所在组织中的 Cursor 用量？\",\"c7f1e0f6ef354f4d\":\"主街 123 号，4 号公寓\",\"c7fd97ce275e8bb0\":\"哪种规划适合我？\",\"c80e2a896074cd21\":\"列出仪表盘，审查 SLO，并深入分析事件，检查服务的健康状况、错误和依赖关系。\",\"c824fe025739bbbf\":\"感谢您的订阅！\",\"c85837d615bc9a4b\":\"读取 about-acme.md\",\"c87b8879fc8333e2\":\"feature-prd.md +21 -8\",\"c8834fdd4008efde\":\"我来向您展示如何在 Next.js App Router 中创建动态路由。动态路由在文件名中使用方括号 `[param]`：\",\"c8d4d071f5e23d00\":\"已启动 3 个子智能体\",\"c8fdd5860c4d0a9f\":\"直到今天，我仍会为自己能一边骑着 Peloton，一边合并 PR 而惊叹。我再也不用碰笔记本电脑了。\",\"c9181067d46a985d\":\"智能体可独立分析 PR 风险、分类处理并修复 CVE，并通过提交修复来回应代码审查意见。\",\"c9860107768e93bb\":\"自主能力的下一层级\",\"c9fe5615291162cf\":\"异步\",\"ca01963e0a927b89\":\"分析仪表盘、AI Code Tracking API、对话洞察\",\"ca14db5237251099\":\"能够发现真实缺陷的 AI 代码审查。Bugbot 以较低的误报率发现最棘手的逻辑缺陷。\",\"ca2b83c52caed098\":\"让 Cursor 调查工单中描述的问题，并总结调查结果。\",\"ca8db86b02f0bde1\":\"添加混合精度训练、学习率调度和适当的验证流程。同时创建一个实验配置系统，方便我轻松运行不同的超参数设置。\",\"ca97d558587e12a5\":\"Cursor 团队版立省 $3,000\",\"ca9eb952a9ebc539\":\"Cookie 通知\",\"cb203d390c97f5ca\":\"新建智能体\",\"cb31ff4c01353706\":\"Bugbot 甚至能在人工批准后发现真实缺陷。只要避免一次 sev 级事故，它就能回本。\",\"cb35cd9b294c3d02\":\"跳过\",\"cb79ed591a0700e5\":\"BYOK\",\"cb84cf959e0c595d\":\"自定义您的使用体验\",\"cb96d2ca669800f2\":\"自动化\",\"cbb7e35d36bf4bff\":\"创建一个自动化来审查代码变更，确定风险评级的影响范围，分配审查者，并自动批准低风险 PR。\",\"cbd32dfae0aad5c1\":\"智能体团队\",\"cbd3cf419f4ff821\":\"点击一个智能体或使用 + 打开面板\",\"cbd9f9d847eae52c\":\"Cursor 在写下任何代码之前，就会深入理解你的代码库。\",\"cbda139c4ec48d5c\":\"设置路由\",\"cbf066b267ce2f52\":\"mod.rs +24 -0\",\"cc0129818ccf310f\":\"新闻\",\"cc110e16dd62fafb\":\"Grok\",\"cc2b7a706cfc39b4\":[{\"c\":\"Discord\",\"i\":1,\"t\":\"strong\"},\" 最适合实时聊天以及与其他用户交流。\",{\"c\":\"论坛\",\"i\":2,\"t\":\"strong\"},\"则适合提出更详细的问题，并从团队和社区获得解答。\",{\"c\":\"Reddit\",\"i\":3,\"t\":\"strong\"},\"（r/cursor）则是您分享正在构建的内容并获取最新动态的地方。\"],\"cc451211b7e9ab84\":\"更多界面\",\"cc72692f67054c02\":\"图表效果很棒。现在我们需要数据层——按日/周/月聚合指标。\",\"cc7d0cf027253a70\":\"在它们编写测试时，我会修复根本原因。将库存检查和扣减放进同一个事务中：\",\"cca404e55f855627\":\"代码审查\",\"ccad79b4d6990332\":\"MCP\",\"ccdb4d48002fef71\":\"获取高级版\",\"ccf2f18675e90654\":{\"c\":\"入场动画\",\"i\":1,\"t\":\"span\"},\"cd03eb1b84271c02\":\"智能体\",\"cd11a7f45eb151a5\":\"选择 Ultra\",\"cd3c661632950c98\":\"Cursor 支持从规划、编码到代码审查的每个阶段。\",\"cd3f7b352f68b3db\":\"blog/[slug]/page.tsx +25 -0\",\"cd5d058abc9ab09d\":\"访问云端智能体\",\"cda832b2f71c04dc\":\"完成！我已经使用符合 Rust 惯用模式的方式实现了一个健壮的乘车调度器：\\n\\n**关键特性：**\\n\\n• **thiserror**：用于派生宏，以更便捷的方式创建实现了 Display 的自定义错误类型\\n• **async/await**：由 Tokio 驱动的异步调度，用于非阻塞的车辆匹配\\n• **Builder Pattern**：流畅 API，并返回 Result 以便及早验证\\n• **#[must_use]**：对未使用的 Result 给出编译器警告，防止静默失败\\n• **Haversine**：用于 geofence 验证的精确大圆距离计算\\n• **sqlx**：结合 PostGIS 提供编译时检查的 SQL 查询，用于空间检索\\n\\n该 dispatcher 会在 builder 的每一步验证所有地理空间约束，因此在您的车队系统中无法创建无效的乘车请求。\",\"cdc78b8eecdc6bbc\":\"包含 Plus 的所有内容，以及：\",\"cdc95aad781dc0dd\":\"会议已预约！\",\"cdd8f9dd35ffff35\":\"适配团队现有的工作方式\",\"cde882ca09bb7257\":\"如何成为 Cursor Campus Lead？\",\"cdf59bb37eb11976\":\"SAML / OIDC 单点登录\",\"ce1710e11b6649f2\":\"构建已成功完成，且 9 项测试全部通过。生产包经 gzip 压缩后大小为 46.8 kB。\",\"ce34020f9f3dd95d\":\"规划已更新。准备开始构建！\",\"ce70fb481823713d\":\"配置模型访问权限、MCP 和智能体规则。\",\"ce87bcc078568281\":\"论坛\",\"ce8aeb2933c740af\":\"如何向正在运行的智能体添加后续消息？\",\"cea3baa4412a9f92\":\"读取 app/api/health/route.ts\",\"ceb0ceb98405d4d6\":\"Anthropic、OpenAI、Gemini、Cursor 等提供的前沿模型，触手可及。\",\"cf3d6d34fc8b1c99\":\"可以。创建分流规则，自动将匹配的任务分配给 Cursor Agent，让反馈和缺陷能够立即进入编码工作流。\",\"cf58467cf70606b8\":\"成熟度曲线\",\"cf5f77538fd5de2f\":\"能够端到端完成任务的智能体。\",\"cf6af51e409061ac\":\"企业管理员可访问全面的分析仪表盘，查看采用率、按团队和个人划分的用量模式、AI 辅助编码指标以及生产力洞察。数据还可通过我们的 API 导出，并与您现有的分析平台集成。\",\"cf76727fdd0bfde9\":\"app\",\"cf98712c1bceaba6\":\"让智能体处理规划、编程、测试和审查各环节之间的工作，更快将想法转化为上线产品。预约会面，梳理您团队的工作流，即可获赠定制 Keychron 键盘。\",\"cff3c341aeb285ba\":\"现在，您可以通过手机启动和管理常驻智能体，现已开启公开测试。\",\"d01b68c182a7737b\":\"Start 套餐附录\",\"d056a3b0213d082c\":\"下一步操作预测\",\"d0cbe2c6d93702ca\":\"可以。Cursor 会按以下顺序选择代码仓库：消息内容、最近的智能体活动、路由规则、频道默认设置，以及您的个人默认设置。您可以在消息中提及代码仓库（例如，“@Cursor in cursor-app，修复登录缺陷”），以强制指定某个代码仓库。\",\"d0e30cb381c025d3\":\"审阅规划\",\"d1191ec1563c08ce\":\"探索云端智能体\",\"d143eea360aa5a1a\":\"商务邮箱\",\"d150868de26bdd30\":\"企业方案按席位计费，并包含一定额度的用量配额。对于高用量团队，组织可以预先承诺额外用量；同时，管理员还可在团队和个人用户两个层级通过可配置的限制全面掌控成本。\",\"d155a64226532555\":\"会话结束后，您将收到一把定制款 Keychron 键盘，助您构建最雄心勃勃的软件。\",\"d16440b24b5c925b\":{\"c\":\"未打开任何文件\",\"i\":1,\"t\":\"div\"},\"d19878e6971baff2\":\"智能体会在自己的沙箱中测试更改，并持续迭代，直到验证输出结果。\",\"d1bc057a1662b78e\":\"Grok Bot 是一支始终在线的 AI 队友团队。他们拥有自己的计算机，像您一样操作它，而且永不下线。\",\"d202d9d961032e2a\":\"使用热门模板开始构建。\",\"d211e74d3ef3307f\":\"使用自然语言提问\",\"d2152bfef4b32699\":\"产品\",\"d22617ca60c7b71d\":\"添加 Checkout 测试\",\"d22ce6d6e74fdcd3\":\"Cursor for Jira\",\"d243c1cd3d8d88bb\":\"添加速率限制：每位用户每分钟 100 个请求\",\"d26972c4d2156054\":\"企业版 SpaceXSI\",\"d282125b7cbac365\":\"成为 Cursor Ambassador 需要什么条件？\",\"d2c162aae8f3f771\":\"荣誉赞助\",\"d2dcc2542eeaf207\":\"设置一个智能体来调查来自 Datadog 的生产环境错误，找出根本原因，并在 PR 中提出修复方案。\",\"d2e2563331fe1e6d\":\"自动化智能体会遵循您定义的指令，并通过 MCP 使用您的工具。\",\"d39a28cd876dad92\":\"流式传输现已启用。token 现在会实时显示，并会在网络出现问题时自动重连。整体体验应该会流畅得多。\",\"d3c9a8e3bef73b11\":\"+1 555 000 0000\",\"d4148ec565c4743c\":\"搜索博客文章\",\"d447c8e2046c15a7\":\"在脚本和自动化工作流中使用 Cursor CLI。\",\"d44e0ff9cf36888d\":\"现代工程团队正在基于 Cursor SDK 构建智能体\",\"d46005d215db9ccc\":\"Cursor 会使用问题的详细信息、评论和关联的参考内容，为智能体提供所需的上下文。\",\"d46511d1b8b667a3\":\"无需在本地检出分支，您即可通过智能体的远程桌面与软件交互。\",\"d482983c601bfdaf\":\"Git 和检查点\",\"d4849622efb65017\":\"使用您现有的身份提供商，为团队成员提供安全访问。\",\"d4ece5c971d4b3e8\":\"在新选项卡中打开\",\"d565e3bf107114e3\":[{\"i\":1,\"k\":\"slash\",\"v\":\"v\"},\" 用于命令，\",{\"i\":2,\"k\":\"at\",\"v\":\"v\"},\" 用于文件\"],\"d568c6114a797c78\":\"国家/地区\",\"d58296305243cc4a\":\"让智能体处理规划、编程、测试和审查各环节之间的工作，加快从创意到产品上线的进程。\",\"d5aa34226d734ebe\":\"更快的聊天响应\",\"d5f28b98ab6a896b\":[\"付费规划包含 Grok API 访问权限。API 使用量按标准模型费率单独计费，不会占用你的规划用量池。参见\",{\"c\":\"模型定价\",\"i\":1,\"t\":\"a\"},\"。\"],\"d5fce9ca8c6a85cb\":\"读取 lib/openai.ts\",\"d5ffb71cec1fe086\":\"我们已将 Cursor 推广给 800 多名工程师，并看到团队在规划和执行代码变更方面的产出显著提升。无论您是在构建新应用，还是重构遗留系统，我都非常愿意向其他 CTO 推荐 Cursor。\",\"d60a71be316b5515\":\"MSA 与 DPA\",\"d615595b81508619\":\"包含标准版的所有功能，另加：\",\"d617eab55e035d7c\":\"设计\",\"d634cde58351a321\":\"分配问题或提及 @Cursor，云端智能体就会打开该 PR。\",\"d64ec6c40d9314d0\":\"请输入有效的邮箱地址\",\"d6a374682501678c\":\"社区支持与标准支持\",\"d6a747b43090d597\":\"输入您的邮箱以解锁完整项目。\",\"d6cd33283cb76d2b\":\"Cursor 规则配置\",\"d703d3a3a0a5a8f4\":\"Cursor 帮助我清洗数据集、调试流程管道并编写复杂查询，同时不会打断我的工作流；它每周都能帮我节省数小时，让我能更专注于自己的研究。\",\"d70563a2020aee36\":\"访问云端智能体\",\"d750c1e7860d9b43\":\"一个智能体，贯穿所有界面。\",\"d76d2aac794beef3\":\"借助 Bugbot 实现智能体驱动的代码审查\",\"d774680531a1b70f\":\"已编辑\",\"d7c69eceae08e719\":\"随时随地为您工作的智能体\",\"d7d4e8b1697d3913\":\"集中式团队计费\",\"d7d89b9598c035a3\":\"跳转到此处\",\"d82f1f95eb17aba6\":\"将工作项分配给 Cursor，或在评论中提及 @Cursor，即可直接从该问题启动云端智能体。\",\"d8361e2bee18e806\":\"Cursor 为全球最受欢迎的 IDE 增添了强大能力。它非常擅长调试问题，并精准追溯到历史代码变更；文档编写能力也很出色，而且在帮助新成员快速上手方面尤其有效。\",\"d8617264edf1ed2f\":\"借助专为移动端设计的聚焦 diff 和源代码管理功能，审查并合并 PR。\",\"d894f6cb29f7a3ea\":\"返回\",\"d8b8be1cc9af2f61\":\"订阅我们的新闻简报\",\"d8bb00d20ecb6410\":\"编辑帖子\",\"d8dde29142d8de66\":\"设置一个智能体，发布每日摘要，汇总代码仓库中的重要变更以及新引入的风险。\",\"d8fa33bff8ed141e\":\"添加后续消息……\",\"d9043f5143fe0fd9\":\"Slack、GitHub 等\",\"d9a95b0eae99b198\":\"创作者订阅\",\"d9ac95e72cf59bc9\":\"我为更新日志条目添加了直接链接，并更新了整个项目中的 Node.js 版本约束，以提高可维护性。\",\"d9b026641f63be2f\":\"大多数界面支持无广告滚动浏览\",\"d9b367f3140f6dcb\":\"全面管控\",\"d9fc0cd5456bb762\":\"对于复杂任务，Cursor 会先提出澄清问题、制定计划，然后执行计划。\",\"da07d7e88d7f5444\":{\"c\":\"您很快就会收到日历邀请。我们期待与您交流。\",\"i\":1,\"t\":\"p\"},\"da133351cf557e0e\":\"常见问题解答\",\"da2b5bd26b3f097e\":\"按整个代码库的规模进行重构\",\"da4ce32ad64318fc\":\"它在审查 AI 生成的代码方面表现尤为出色。\",\"da52bbeb7342cffc\":\"选择 Pro\",\"da6050141f2cedef\":\"什么情况下适合选择企业？\",\"da625103ce5f5208\":\"该集成会处理路由和上下文，因此您只需编写提示。\",\"da64003062513e88\":\"智能体沙箱模式\",\"da774db072d07883\":\"了解您的团队如何使用智能体，以及哪些团队成员需要进一步提升技能。\",\"da7df39a216a4314\":\"已收到团队版试用请求\",\"da81805383cfdb2e\":\"引领社区\",\"da941f717ffca8ac\":\"我的设计团队对 Cursor 的采用率达到了 100%。每个人都已经证明自己能够做出简单原型，且超过 75% 的人分享过复杂原型。如此之快就取得这样的成果，真的令人惊叹。\",\"dada2fbf148d3125\":\"已搜索 PR 评论获取模式和 GitHub API 分页\",\"db194680a1da126d\":\"创建更长的帖子\",\"db338428991783aa\":\"详细用量分析\",\"db4007b7f91b44fd\":\"Radar 搜索\",\"db5182b21c81f098\":\"开始使用\",\"dbc1e153e3d2399e\":\"{minutes} 分钟阅读\",\"dbdca9058b743bce\":\"探索全球各地的 Cursor 线下聚会、咖啡馆活动、黑客松和工作坊。\",\"dbe531d9aec59f74\":\"调查并反馈结果\",\"dbed376c4f432c47\":\"已修复单位不匹配问题。\",\"dc1259d0cdfcaee6\":\"如何安装 Cursor Slack 应用？\",\"dc5725515daf9834\":\"需要满足哪些条件？\",\"dc576ae3388e7292\":\"使用完整的 Cursor harness\",\"dc5a4bcf8bbf4cb7\":\"Cursor 是您的编程智能体，助您构建雄心勃勃的软件。\",\"dc6676383915f53d\":\"PyTorch MNIST 实验\",\"dc66ec0fed447677\":\"添加到 Slack\",\"dc9196f13649cb21\":\"Git\",\"dca36542a45d7a93\":\"我们建议日常使用智能体的用户选择 Pro+，智能体重度用户选择 Ultra。对于需要与他人协作的专业人士，推荐选择团队版规划；而需要发票、汇总用量或高级安全功能的大型组织则应选择企业。\",\"dcba56b25ec8644f\":\"3 分钟前\",\"dcc0af95caa59d76\":\"Pro 版智能体限额的 3 倍\",\"dce930d99de233a7\":\"条款\",\"dcea416021972768\":\"自动获取线程上下文\",\"dd083da4e62444a8\":{\"c\":\"卡片宽度\",\"i\":1,\"t\":\"label\"},\"dd323f90079381e9\":\"将任务委派给自主智能体\",\"dd3e295073f02342\":\"读取 lib/inventory.ts\",\"dd3f019dd4a099fb\":\"疑问\",\"dd4e4b92fc330d69\":\"集中计费\",\"dd620c45d6a6fde7\":\"JetBrains 始终以将行业中最优秀的成果带给用户为使命。我非常期待 Cursor 成为 JetBrains IDEs 中 ACP 合规智能体家族的特别一员。这次合作对 Cursor、对 JetBrains，尤其是对开发者而言，都是一次多赢。\",\"ddd91f2619f1220a\":\"一个分流规则搞定路由\",\"dde99db10eb3c1f2\":\"阅读案例 →\",\"de1ce41c16badd28\":\"发票/采购订单结算\",\"de49a77511672927\":\"分配或提及即可开始\",\"deb2f452357db348\":\"从模板创建\",\"ded910843df0c0cb\":\"AI 软件成熟度曲线\",\"df3362ac6fa20009\":\"使用 Grok 和 Composer 模型，满足日常开发、设计和调试需求。\",\"df416e575ae3c124\":\"jane@acme.co\",\"df472b7ae9714a96\":\"返回 Cursor\",\"df5290bd49600596\":\"如今，单个工程师只需几天，而不是几个月，就能重构、升级或构建新的代码库。\",\"df6982216300db8d\":\"₹1,800/月\",\"dfa70d17bade6472\":{\"c\":\"循环\",\"i\":1,\"t\":\"span\"},\"dfb8cd201dcc6d68\":\"安装 Datadog 插件，用自然语言向 Cursor 询问你的日志、指标、链路追踪和仪表盘。\",\"dfc253b2f22cb782\":\"快速将智能体部署到生产环境\",\"dfdf8995987a08d1\":\"开始使用：\",\"dff469ee86a5de60\":\"条款\",\"e0045695f2f03c81\":\"仅限管理员编辑\",\"e0202dc6ef1f6f8e\":\"新建智能体\",\"e0a8df328f8796ee\":\"探索企业版\",\"e0d0bb8437084aa1\":\"拖动卡片后，智能体就会接手任务、发起 PR，并将结果作为附件回传。\",\"e0ed46d595d326c1\":\"随时随地直接用手机启动云端智能体。\",\"e1210e1b48f58252\":\"在任何终端、脚本或编辑器中运行智能体。\",\"e1249e65543554d8\":\"很好，我已经添加了完整的 Gotoh 实现，并支持正确的回溯。现在我来修复 FASTA 解析器：\",\"e14f00f7b7b490b4\":\"开始使用需要什么？\",\"e15216b29ef5d468\":\"请更正高亮显示的字段，然后重试。\",\"e158e382ee031b7b\":\"专为大型代码库打造，Cursor 使用即时 grep，可在几毫秒内搜索数百万个文件。\",\"e1bf27e3016f4949\":\"构建并运行测试\",\"e1d2bb567ce52134\":\"具备共享团队上下文的云端智能体和自动化\",\"e21c6dc14a57e24a\":\"任务来源\",\"e245c43046f4f5a7\":\"适合爱折腾的人\",\"e262829bfce3b46d\":\"企业的用量限制如何运作？\",\"e27e0cd858beb063\":\"我们在做什么。\",\"e28d6f2096add037\":\"我可以在哪里提出更多疑问？\",\"e28e5eb8f878f074\":\"you@example.com\",\"e2ad836f588f1f40\":\"Shell 模式\",\"e2ed52e5a0741f36\":\"按用量计费的 Bugbot\",\"e31e1c79fa70deff\":\"汇总用量 + 仅限管理员的控制选项\",\"e38e7ff2f1bb0df5\":\"先在编辑器中开始，然后在终端、浏览器、手机，或您团队已经在使用的工具中继续。\",\"e39a57514be028e9\":\"代码审查\",\"e3c4afe46159eb16\":\"有限的选项卡补全\",\"e3d53f8ce2a3ebe9\":\"优先支持\",\"e3ffbb156b9e1e20\":\"资源\",\"e42c0dd24820d068\":\"如何将 Cursor 连接到 Linear？\",\"e43601ee1c8f4c36\":\"MCP 工具\",\"e4375af23f5f90ca\":\"Cursor 会生成视频、截图和日志等产物，方便您快速验证其工作成果。\",\"e43940661828200a\":\"拉取某个服务的错误日志，跟踪链路追踪，并检查 APM span，以了解请求流并诊断延迟问题。\",\"e454d627088c49e0\":\"如今，每天看着十几个智能体分支完成合并，已经成了常态，而由此释放出的开发速度提升体现在方方面面，从发布节奏到缺陷积压的清理。Cursor 不是一个只是提升便利性的附加工具；它是整个组织的规模放大器。\",\"e499a07130a5a421\":\"使用与驱动 Cursor 相同的运行时、harness 和模型，降低复杂性。\",\"e4b78751b6e276a0\":\"今天就免费开始使用。\",\"e4f4e1f68c0729a2\":\"CursorBench 旨在衡量开发者实际会让 Cursor 处理的那些模糊、跨多文件的智能体任务，而不只是范围狭窄的公开缺陷修复任务。\",\"e52b2074849ae4cb\":\"为仪表盘设置 Cursor 规则\",\"e56874cf2fdffdbe\":\"__tests__/mocks/resend.ts +28\",\"e59c4271f1a0fb21\":\"通过手机控制电脑上运行的智能体。您也可以选择在连接期间让电脑保持唤醒状态。\",\"e5a2af21e8173c8f\":\"我可以向 Cursor 提问哪些有关 Datadog 数据的问题？\",\"e5b33a09567e059a\":\"已修复并完成测试。该事务可确保库存更新的原子性，而新的测试套件能捕获回归问题。\",\"e5fdeca2c3a66393\":\"发布、回复和关注\",\"e6186bebb241556c\":\"价格是否已包含税费？\",\"e645246d0be2cb62\":\"关闭 Cookie 通知\",\"e659bf5bc74bb01b\":\"Cursor 更新日志 RSS 订阅源\",\"e6901ab4dc3ca09a\":\"技能\",\"e698e61f5dbb414f\":\"基础\",\"e6c71ebd238296f3\":\"在布局更改前，于 4 小时前找到。\",\"e6ea3da9a4c2a6c3\":\"代码仓库变更每日摘要\",\"e6f80a59e20084dc\":\"相关文章\",\"e7003c9b1fc702b2\":\"请选择公司人员数量\",\"e7029fc6453b712a\":\"群组级设置与支出限额\",\"e7234f3d11527c02\":\"可在任何地方接入您现有的设置。\",\"e74e00ec84ad4b54\":\"{memberCount} 位成员\",\"e7d5c770b5d8ba0f\":\"注册即可获取\",\"e7de8326b9e1b5f7\":\"lib/rate-limit.ts +18 -2\",\"e7e800d82d26fbcd\":\"状态更新和 PR 交接\",\"e8224b67064685c9\":\"这些菜单标签颜色是在哪里定义的？\",\"e8254589dbb12140\":\"收起菜单\",\"e827c9fb04b06774\":\"开始使用 Cursor SDK 进行构建\",\"e837ce0913423839\":\"申请演示\",\"e867dc28193b8e5c\":\"联系表单\",\"e8840d9ae13abdc9\":\"Cursor 在您的编辑器中编写代码、审查您的 PR，并自主监控部署。\",\"e88c9d8769544731\":\"自动\",\"e8a8372561ffed39\":\"Cursor 专为企业级规模打造，能够高效为包含数十万个文件、数百万行代码的代码库建立索引并进行导航。我们的代码库智能会学习你团队的模式、约定和架构，确保 AI 建议符合你的编码标准，并理解你的系统特有的上下文。\",\"e8b3620507ec4cf1\":\"创意\",\"e8d74103a74d5dd7\":\"获取 Pro\",\"e8da529b567f533e\":\"一次设置，整个团队都能用。\",\"e8daabf4acad6d5b\":\"选择要比较的方案\",\"e8e13d1d25f3f575\":\"工业 AI 协会 (AI²)\",\"e90657f9c23fc9a7\":\"截取 localhost:3000/product 的截图\",\"e917a086df24ee7a\":\"如何从 Linear 启动 Cursor 智能体？\",\"e9457e7daec6b0f2\":\"公司名称\",\"e959db8e14b36498\":\"Cursor 目前运行在符合 SOC 2 Type II 标准的 AWS 基础设施上。虽然我们目前不提供本地部署，但我们的云架构可提供企业级安全控制、数据隔离和性能保障。\",\"e992b8b59e75d97b\":\"我有哪些付款方式？\",\"e9b3c1b561200fa7\":{\"c\":[{\"c\":\"演示功能\",\"i\":2,\"t\":\"h2\"},{\"c\":[{\"c\":\"• 针对移动端优化的界面，配有原生 iOS 风格状态栏\",\"i\":4,\"t\":\"li\"},{\"c\":\"• 支持模型选择的交互式聊天编辑区（GPT-5.6 Sol High）\",\"i\":5,\"t\":\"li\"},{\"c\":\"• 实时智能体侧边栏，显示“进行中”和“待审查”项目\",\"i\":6,\"t\":\"li\"},{\"c\":\"• 动态加载状态和进度指示器\",\"i\":7,\"t\":\"li\"},{\"c\":\"• 适合触控的控件和合理的移动端间距\",\"i\":8,\"t\":\"li\"},{\"c\":\"• 与现有 Cursor 组件（AgentsSidebar、ChatComposer）集成\",\"i\":9,\"t\":\"li\"},{\"c\":\"• 自适应缩放和设备边框展示\",\"i\":10,\"t\":\"li\"}],\"i\":3,\"t\":\"ul\"},{\"c\":\"技术实现\",\"i\":11,\"t\":\"h3\"},{\"c\":\"该组件沿用 DemoDesktop.tsx 的实现模式构建，在移动设备边框中复用现有的 Cursor IDE 组件。它包含逼真的移动端 UI 元素和恰当的状态栏模拟，并展示了 Cursor 的 AI 助手如何适配移动设备形态。\",\"i\":12,\"t\":\"p\"}],\"i\":1,\"t\":\"div\"},\"e9e38aa502a0348c\":[\"欢迎您加入\",{\"c\":\"我们的论坛\",\"i\":1,\"t\":\"a\"},\"并分享您的想法！如果您希望私下交流，也欢迎直接发送邮件至\",{\"c\":{\"i\":3,\"k\":\"_gt_value_3\",\"v\":\"v\"},\"i\":2,\"t\":\"a\"},\"联系我们。\"],\"ea5bc02928318780\":[\"每个席位每人每月至少包含价值 20 美元的智能体用量，并在每个计费周期重置。超出包含额度的模型用量将按公开 API 标价按需计费。\"],\"ea736db226800977\":\"了解 Java 版 Cursor\",\"ea8f0e9faa058b3e\":\"团队规则\",\"ea9cfa1f03baeda7\":\"大多数工程时间仍然花在维持现有系统运转上：重构、迁移、依赖项升级，以及不稳定的测试。自主智能体恰恰擅长这类稳定、范围明确的工作。\",\"eaab8d13c547fd41\":\"精细化支出控制\",\"eabb0a29f04aa957\":\"将 Linear 问题转化为 PR。\",\"eaed1d11d77e8131\":\"我们建议 AI 新用户选择高级版，每天使用智能体的用户选择 Super，重度用户选择 Ultra。AI 用量较少的社交平台内容创作者适合选择 Plus。需要与他人协作的专业人士适合选择团队版套餐，而需要发票结算、汇总用量或高级安全功能的大型组织则应选择企业。\",\"eb11c91c9e8479c6\":\"将 Cursor 指向出问题的页面。它会在内置浏览器中打开您的应用，检查控制台错误和网络请求，找出出错的代码，并以可审查的 diff 形式应用修复。\",\"eb25badfd751ea2d\":\"Linear 分流规则可以将工作分配给 Cursor 吗？\",\"eb7fe031b6c3dc7d\":\"找到了——有 3 个串行执行的 DB 查询，而且没有缓存。已改为并行，添加了 Redis，并对图表进行了懒加载。现在降到了 380ms。\",\"ebb17c012d7a20c8\":\"试用云端智能体\",\"ebf33274ee2bbd52\":\"插件\",\"ec01dfc66018c238\":\"。Start 套餐仅支持按月计费。\",\"ec091877b8b8c844\":\"订阅\",\"ec188e4afcfdfe0b\":\"Graphite 已加入 Cursor。\",\"ec1f00564fa7d883\":\"Stripe checkout 已可供测试。\",\"ec21b232e0eacd4a\":\"登录\",\"ec3c000f3baa9f3c\":\"__tests__/mocks/stripe.ts +42\",\"ec9b4f5f7da067ca\":\"SCIM 分发与访问控制\",\"ecc06b99e5d02a25\":\"符合 GDPR 和 CCPA 要求。\",\"ece9487cd852e389\":[{\"c\":\"每个档位都包含一个供 Cursor 和 Grok 共享的 AI 用量池。在 Grok 中，该用量池涵盖聊天、Imagine、语音和机器人。档位越高，用量池越大，使用费用因产品而异。你的额度每周刷新，因此即使某一天用量很大，也不会耗尽整个月的额度。\",\"i\":1,\"t\":\"p\"},{\"c\":[\"用完内含用量后，你可以充值继续使用，也可以等待额度刷新。你随时可以在设置中查看剩余用量。更多详情请参见\",{\"c\":\"我们的文档\",\"i\":3,\"t\":\"a\"},\"。\"],\"i\":2,\"t\":\"p\"}],\"ecef1a8abe486bcc\":\"直接用自然语言查询您的日志、指标、链路追踪和仪表盘。\",\"ecef7238470a9acd\":\"设置一个智能体来监控 Slack 中的缺陷报告、开展调查，并为简单修复生成 PR。\",\"ed5ba20d4ce3aa10\":\"Plus 的 50 倍\",\"ed98d8f6883bf80d\":\"身份验证会在您的浏览器中通过 OAuth 完成。您的连接详情会加密后存储在 Cursor 中，且不会向 AI 模型提供商发送任何凭证。\",\"edf6e1778ec264ee\":\"审计日志和服务账户\",\"ee17d80657353e09\":{\"c\":\"所有文章\",\"i\":1,\"t\":\"Link\"},\"ee3244aedb5dd281\":\"直接从您团队日常使用的界面中启动智能体。\",\"ee3e8bd8b7918aec\":\"搜索\",\"ee78d9dee79f587f\":\"Cursor 早已不再只是写代码。它更在于像指挥队友一样调度成批的自主智能体：您为它们配备可独立工作的工具，再审查它们交回的成果。\",\"ee9fa4bdf02f6ae3\":\"为每项任务使用最佳模型\",\"eec49a41f4b73c3a\":\"面包屑导航\",\"eeeaa9f0b87c5523\":\"设置分流规则\",\"ef0842bd49c23734\":\"从报错到修复\",\"ef3f000bf3a44462\":\"没有符合此筛选条件的点播课程。\",\"ef4b39040c5612bc\":\"创建社群\",\"ef530a2570e55063\":\"分析 Tab 与智能体的使用模式\",\"ef58f1705a77fc03\":\"从轻松的咖啡聚会到周末构建活动，来看看世界各地的 Cursor 活动都是什么样。\",\"ef602e821403f70f\":\"Bot 可以登录您的工具，像您一样使用这些工具，并带回完成的工作。\",\"ef6b646a293e47ca\":\"服务账户\",\"ef9f9e858b9d8404\":\"有把握地交付\",\"f0039cc1c1042a53\":\"一个智能体，贯穿从规划到生产的全过程\",\"f057f51e79bab310\":[\"如果您有疑问或创意，请发送邮件至 \",{\"c\":\"community@cursor.com\",\"i\":1,\"t\":\"a\"},\"。\"],\"f0596985588e37c7\":\"会面前，请先提供一些信息\",\"f061c0a9ed4c8f67\":\"Bugbot 会根据您团队的规则审查每一个 PR，在合并前发现逻辑缺陷、安全问题和性能问题。\",\"f06b2a51c6af5db7\":\"智能体使用各自的计算机端到端完成功能构建、测试和演示，供您审查。\",\"f0744968f0e3d9fc\":\"grep 中\",\"f0b148dccfe70cae\":\"Next.js App Router\",\"f0ceaf1bfdd24178\":\"选择公司人员数量\",\"f0e83d4dfaf0ae08\":\"和\",\"f0fefb1ef1dad2de\":[\"所有价格均不含适用税费。更多信息请参阅我们的\",{\"c\":\"订阅条款\",\"i\":1,\"t\":\"a\"},\"。\"],\"f11c8516add083db\":\"已读取 menu-styles.css\",\"f12065a15c48bf72\":\"完成。字体会在 head 中预加载，关键 CSS 已内联，我还添加了 color-scheme meta 标签，这样深色模式就能立即渲染而不会闪烁。首次绘制时间为 280ms。\",\"f12fe5d9110cf56f\":\"试用 Cursor CLI。\",\"f1673f149dbcccae\":\"基于任意模型构建\",\"f190c495bd59583b\":\"始终使用最新模型\",\"f1a4060a4ab9e7e5\":\"与我们的团队会面\",\"f1a768ffa4a2fa7b\":\"让 Cursor 为您规划或构建一切\",\"f1b0bef65ca23bf2\":\"智能体可使用同一套为 Cursor 桌面端、CLI 和 Web 提供支持的 harness。使用智能上下文管理、MCPs、技能、钩子和子智能体。\",\"f1da0030cc8db163\":\"如何安装 Cursor for Jira？\",\"f1fac792b5d8c321\":\"请告诉我们您的 Cursor 实地工具包寄送地址，我们将跟进并协助您规划首批智能体工作流。\",\"f2105001d47b1c0a\":\"了解那些依靠 Cursor 运转的团队。\",\"f276f248408ec30e\":\"Cursor 最新动态\",\"f2891db360b8b967\":\"借助工具和知识进行扩展\",\"f297838c28765506\":\"试用自主智能体。\",\"f29ca02fdb652591\":\"团队工作的地方\",\"f2a0d4040c7bb0f1\":\"不同批次之间的差异简直天壤之别，采用率从个位数一路提升到 80% 以上。它像野火般迅速蔓延，所有最优秀的开发者都在使用 Cursor。\",\"f2aac01bc95e3e6a\":\"已运行\",\"f2e393e1419f8c99\":\"文档\",\"f2e833d0c1a1a972\":\"app/globals.css +18 -0\",\"f3080a7959d8d22c\":\"等待开始\",\"f30c2ccb13af3fae\":\"Grok 和 Composer 的充足额度\",\"f332bd7ada621635\":\"做程序员这件事肯定正变得越来越有趣。我们现在只处在可能性的 1%，而像 Cursor 这样的交互式体验，正是 GPT-5 这类模型最能大放异彩的地方。\",\"f333d3950450c1bf\":[{\"c\":\"Tab\",\"i\":1,\"t\":\"span\"},\"切换到 \",{\"i\":2,\"k\":\"nextFileLabel\",\"v\":\"v\"}],\"f33830641975e3ed\":\"自定义聊天数据保留策略\",\"f3561881f6a0cf3c\":\"谢谢您！\",\"f3643918072a00dd\":\"可通过手机启动并监控智能体。\",\"f3716356b723ea30\":\"5 分钟前\",\"f3da4072ef887099\":\"可直接从 CI/CD 流水线调用智能体，为端到端工作流创建自动化，并将智能体嵌入到产品中。\",\"f3dada4a22809ca7\":\"试用云端智能体。\",\"f3e58db3d7717614\":\"智能体起草 PR\",\"f4051250e5b9e7b7\":\"一个 Web 应用，可在沙箱化云环境中快速启动智能体，为新项目生成脚手架并迭代创意。\",\"f4141a2262f87f7b\":\"工程师可以直接在对话发生的地方完成交付。\",\"f4318b0970e298ba\":\"我们将很快与您联系，告知后续步骤。\",\"f437eec258228f2c\":[{\"c\":\"GitHub 浅色\",\"i\":1,\"t\":\"option\"},{\"c\":\"浅色+ (VS Code)\",\"i\":2,\"t\":\"option\"},{\"c\":\"Vitesse 浅色\",\"i\":3,\"t\":\"option\"},{\"c\":\"Min 浅色\",\"i\":4,\"t\":\"option\"},{\"c\":\"Solarized 浅色\",\"i\":5,\"t\":\"option\"}],\"f448a89d9f6c02d0\":\"更高的智能体限额\",\"f4a7c922bf1398be\":\"收听 The Dwarkesh Podcast\",\"f4a843c64fff263e\":\"一个智能体，覆盖所有界面和全部上下文。\",\"f510f4ffad9d090b\":\"进一步了解 Grok 4.7\",\"f561bd2b332347ce\":{\"c\":[{\"c\":\"智能体演示\",\"i\":2,\"t\":\"option\"},{\"c\":\"Tab 演示\",\"i\":3,\"t\":\"option\"},{\"c\":\"Cmd+K 演示\",\"i\":4,\"t\":\"option\"},{\"c\":\"差异审查\",\"i\":5,\"t\":\"option\"}],\"i\":1,\"t\":\"select\"},\"f580c09f38888227\":\"太好了！现在我再为 translate 模块添加 ORF 查找功能，因为这通常也很需要：\",\"f589e1eef1cf5b37\":\"新建聊天\",\"f58c843c19d80fa9\":\"一个轻量级命令行界面，让您可以从终端启动 Cursor 智能体。\",\"f5a0bb607155e019\":\"了解 CursorBench\",\"f5c28ee4e3af909a\":\"Cursor 团队版\",\"f5d896bc365390ca\":\"Tab 会预测你的下一步并建议更改。\",\"f601393cbb00b3f5\":\"跨产品共享的用量池\",\"f6518abf8a6e65a5\":\"查看所有案例\",\"f678dd4cd15a09b1\":\"学生\",\"f67a333b8a82aac7\":\"将 Cursor 分配到相关问题，将问题转为 PR。\",\"f6d020a752923cb5\":\"修复这个缺陷...\\n\\n用户头像图片的 `src`（`marketing-static/icon-192x192.png`）缺少前导斜杠。这个相对路径在组件用于不同 URL 上下文时，可能会导致图片加载失败，因为它会相对于当前页面而不是站点根目录进行解析。\",\"f6d2240b69255017\":\"查看提交\",\"f6d9a9996e1cd228\":\"计费方式是怎样的？\",\"f7083587ff8ae886\":\"这些信息有助于我们安排合适的人员参与交流。\",\"f721fba3a8e760ca\":\"在我的应用中实现 Stripe checkout\",\"f7af969cf8fe7d3c\":\"启用后，Bugbot 会自动在后台对新的 PR 进行 AI 代码审查。\",\"f7e8de45ab83de3b\":\"联系销售\",\"f7ff9265a69905f1\":\"招聘\",\"f80a5c3e306f98ff\":\"安全、合规，且可随业务扩展。\",\"f81f4cd03b75c2cc\":\"工作流 · 自主智能体\",\"f83fc50fb704ec9c\":\"/年\",\"f84267cd34a42d65\":\"速率限制现已生效。客户端会收到 X-RateLimit-Remaining 请求头，429 响应则包含 Retry-After。滑动窗口可确保一分钟内的分配更加公平。\",\"f87dc6d18bc4e7dc\":\"refresh token 的更改导致会话过期失效。\",\"f896036cb00833a9\":\"通过 OAuth 连接\",\"f8a3d2556c844acb\":\"如何在 Next.js App Router 中设置动态路由？\",\"f8a4c6fa50b5f7d8\":\"读取模型卡\",\"f8c41d231095cdec\":\"Grok 聊天、语音、Imagine 和构建\",\"f8d19e80a7da9a2a\":\"已启动一个智能体，完成后我会在这里通知。\",\"f8da380ed7bf92c0\":\"The Dwarkesh Podcast\",\"f8dd1fdb74b46530\":\"联系我们的团队\",\"f91e23b992de82fd\":\"在 Web 中修复\",\"f94a7ced703a6e6b\":\"*此规划仅有 Grok 模型可用\",\"f983189266f2e26a\":\"客户案例\",\"f99897eb62688025\":\"默认开启\",\"f9a992bbdd19a827\":\"Cursor 专为大幅提升您的生产力而打造，是最出色的编程智能体。\",\"f9b05cd47d2b0daa\":\"直接在 Slack 中触发云端智能体，然后返回一个已完成的 PR。\",\"f9e9b0275cd246cb\":\"已找到文档页面。让我从最新版本说明中提取关键新功能。\",\"fa02a22577dbe632\":\"功能\",\"fa4ce7816e5c163f\":\"团队版采用信用卡计费。您按活跃成员付费，而不是按预先分配的席位付费。新成员加入时会按比例收费。按需智能体用量将在您的计费周期结束时按月结算。如果按需支出超过滚动支出阈值，您可能会在月底前看到增量扣费。\",\"fa5915c3fa01046d\":\"让每个人都用上您最优秀工程师的设置\",\"fa68c4d454ce5343\":\"Python\",\"faa3f67be31bfeca\":\"深色主题\",\"fadbe70d1a0d32ef\":\"插件、MCP 服务器、钩子和技能\",\"fae786aaae936b98\":{\"c\":\"应用更改\",\"i\":1,\"t\":\"button\"},\"faeaba62492a9912\":\"关于 {feature}\",\"fb397fb9df1383c3\":\"通过共享技能、规则和自动化，放大核心用户的能力\",\"fb5b2d30e359d2e3\":\"SupportChat.tsx +48 -20\",\"fb7719f86187de4f\":\"请输入你所在公司的名称\",\"fbad88e70550b379\":\"在熟悉的编辑器中，从手动编码到智能体编程。\",\"fbbc79deccf4dfcd\":\"团队统一隐私设置\",\"fbdd56c6ffb1eb6e\":\"The Dwarkesh Podcast 探索未来。Cursor 是帮助您构建未来的编程智能体。\",\"fbf935c6777301fc\":\"Start 方案提供更多权限和更多工作方式选择。\",\"fbfb8da118182e3f\":[\" 或直接在桌面应用或 Web 版 Cursor 中操作。只需登录您的账户，选择 Start 规划，即可开始编码。\"],\"fc5116615b6a8101\":\"可在任何终端、脚本或 CI 流水线中运行智能体。\",\"fc9224baa03d82b3\":\"该插件内置预配置的 Datadog MCP 服务器，因此您一连接后，智能体就能立即访问您的遥测数据。\",\"fcbbb9d5845278c8\":\"按月付费为 ₹2,273\",\"fcc675dbe55a5611\":\"作者\",\"fce467a1bcfa492a\":\"实现一个用于行程匹配的 dispatcher 模式，包含 geofence 验证、基于 Result 的错误处理以及流式构建器 API\",\"fd000d6a450ba41b\":\"适合大型组织\",\"fd53bfc89be11e26\":\"Plus 仅包含 Grok 模型。高级版及以上套餐包含充裕的 Grok 模型用量，但不包含第三方模型的使用额度。第三方模型仍可在 Cursor 中按 API 标价使用。你只需按实际用量付费，还可以设置支出上限来管理成本。\",\"fd5f046f0f70edbc\":\"前往 {site} 阅读 ↗\",\"fd761a4786b2cfa9\":\"正在读取 App Router 文档\",\"fd8064990b8c1858\":\"Cursor 团队在 Linear 中跟踪着数千个缺陷、功能需求和客户反馈问题。以下是我们如何让智能体处理这些工作的。\",\"fda1543fcba5a5fe\":\"Cursor 活动是轻松、协作的交流空间。带上您的笔记本电脑，以及您正在做的项目。您会结识其他开发者，喝点咖啡、领取一些 Cursor 额度，并一起动手构建。无需演讲，也不设正式议程。\",\"fe535642bfd93c53\":\"获取 Cursor\",\"fe8a2b90c775ad88\":\"建议\",\"fe93303d61391b32\":\"将工作交给 AI 队友\",\"ff0427c4b3b3d0ae\":\"GitHub Actions\",\"ff545ba23dc2c350\":\"正在读取\"},\"locale\":\"cn\",\"locales\":[\"en-US\",\"cn\",\"ja\",\"zh-Hant\",\"es\",\"fr\",\"pt-BR\",\"ko\",\"de\",\"hi\"],\"defaultLocale\":\"en-US\",\"translationRequired\":true,\"dialectTranslationRequired\":false,\"region\":\"$undefined\",\"environment\":\"production\",\"gtServicesEnabled\":true,\"projectId\":\"prj_jdh3imw75wenlfdi2jf1n41k\",\"translationEnabled\":true,\"runtimeUrl\":\"https://runtime2.gtx.dev\",\"devApiKey\":\"$undefined\",\"dictionaryEnabled\":true,\"renderSettings\":{\"method\":\"default\",\"timeout\":12000},\"developmentApiEnabled\":false,\"localeRoutingEnabledCookieName\":\"generaltranslation.locale-routing-enabled\",\"referrerLocaleCookieName\":\"generaltranslation.referrer-locale\",\"localeCookieName\":\"generaltranslation.locale\",\"resetLocaleCookieName\":\"generaltranslation.locale-reset\",\"customMapping\":{\"cn\":{\"code\":\"zh\"}},\"_versionId\":\"6e0e20850b101f6845cf15ed1bfb286191e4fc902b