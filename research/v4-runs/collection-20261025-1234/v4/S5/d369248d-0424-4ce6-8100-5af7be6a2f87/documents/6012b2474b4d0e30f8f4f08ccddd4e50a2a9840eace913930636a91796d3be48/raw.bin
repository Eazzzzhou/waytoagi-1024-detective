\"\\n(function(){\\n  try {\\n    var nav = window.navigator || {};\\n    var ua = (nav.userAgent || '').toLowerCase();\\n    var platform = (nav.platform || '').toLowerCase();\\n    var isIOS = /ipad|iphone|ipod/.test(ua) || (platform === 'macintel' \u0026\u0026 nav.maxTouchPoints \u003e 1);\\n    var os = 'mac';\\n    if (/windows/.test(ua)) {\\n      os = 'windows';\\n    } else if (!/android/.test(ua) \u0026\u0026 /linux/.test(ua)) {\\n      os = 'linux';\\n    } else if (isIOS) {\\n      os = 'mac';\\n    } else if (/mac/.test(ua) || platform === 'macintel') {\\n      os = 'mac';\\n    }\\n    document.documentElement.dataset.os = os;\\n    document.documentElement.dataset.device = isIOS ? 'ios' : 'default';\\n  } catch (error) {\\n    if (!document.documentElement.dataset.os) {\\n      document.documentElement.dataset.os = 'mac';\\n    }\\n  }\\n})();\\n          \"}}],\"$L1f\",\"$L20\",\"$L21\",\"$L22\"]}]]}]\n"])</script><script nonce="45ZmkHxO1PJ9TIi/okDw7g==">self.__next_f.push([1,"23:I[760850,[\"/marketing-static/_next/static/immutable/chunks/16n01jo8q9i3r.js\",\"/marketing-static/_next/static/immutable/chunks/2bgqd3nyf2poa.js\",\"/marketing-static/_next/static/immutable/chunks/1jwg6g97ujn-5.js\",\"/marketing-static/_next/static/immutable/chunks/2qrpjzi1rhnwc.js\",\"/marketing-static/_next/static/immutable/chunks/39y6i3sb4_a9h.js\",\"/marketing-static/_next/static/immutable/chunks/1w14ox4_yw7md.js\",\"/marketing-static/_next/static/immutable/chunks/1liqif1phdqy-.js\"],\"GA4PageView\"]\n24:I[610600,[\"/marketing-static/_next/static/immutable/chunks/16n01jo8q9i3r.js\",\"/marketing-static/_next/static/immutable/chunks/2bgqd3nyf2poa.js\",\"/marketing-static/_next/static/immutable/chunks/1jwg6g97ujn-5.js\",\"/marketing-static/_next/static/immutable/chunks/2qrpjzi1rhnwc.js\",\"/marketing-static/_next/static/immutable/chunks/39y6i3sb4_a9h.js\",\"/marketing-static/_next/static/immutable/chunks/1w14ox4_yw7md.js\",\"/marketing-static/_next/static/immutable/chunks/1