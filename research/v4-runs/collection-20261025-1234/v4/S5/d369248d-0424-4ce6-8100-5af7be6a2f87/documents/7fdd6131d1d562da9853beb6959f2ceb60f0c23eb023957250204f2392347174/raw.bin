<!DOCTYPE html><html lang="zh-CN"><head>    <base href="/" >    <meta charset="UTF-8">    <meta name="viewport" content="width=device-width, initial-scale=1.0">    <title>Cursor 配 TaoToken：Blender-MCP 生成 3D 模型配置与验证-北京尧图网络科技有限公司</title>    <meta name="keywords" content="Cursor 配 TaoToken：Blender-MCP 生成 3D 模型配置与验证" />    <meta name="description" content="/* MD / 富文本中的 .toc（含博客园搬家等嵌套结构）；.toc-box 在侧栏，不受影响 */#content_views .toc,/* 编辑器常在目录前后插入空 p（:empty 仍占 20px），一并去掉避免顶空隙 */#content_views.markdown_views &gt; p:empty:has(+ .toc),#content_views.markdown_views …" />    <link rel="stylesheet" href="/css/style.css">    <link rel="stylesheet" href="/css/home.css">    <link rel="stylesheet" href="/css/v2.css">    <style>        /* 文章详情页专属样式 - 长文阅读 + 编辑型版式 */        .article-hero{position:relative;padding:140px 0 60px;background:linear-gradient(180deg,var(--color-beige) 0%,var(--color-cream) 100%);overflow:hidden}        .article-hero::before{content:'';position:absolute;top:0;left:0;width:100%;height:6px;background:linear-gradient(90deg,var(--color-brown-dark),var(--color-brown-light),var(--color-yellow),var(--color-brown),var(--color-brown-dark))}        .article-hero-inner{max-width:880px;margin:0 auto;padding:0 40px}        .article-breadcrumb{font-size:13px;color:var(--color-text-light);letter-spacing:1px;margin-bottom:30px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}        .article-breadcrumb a{color:var(--color-brown)}        .article-breadcrumb .sep{color:var(--color-brown-light)}        .article-cat{display:inline-block;padding:6px 16px;background:var(--color-brown-dark);color:var(--color-yellow);font-size:12px;letter-spacing:2px;border-radius:20px;margin-bottom:24px}        .article-hero h1{font-size:46px;line-height:1.25;color:var(--color-brown-dark);font-weight:800;margin-bottom:28px;letter-spacing:-0.5px}        .article-meta{display:flex;align-items:center;gap:30px;padding:24px 0;border-top:1px solid var(--color-beige);border-bottom:1px solid var(--color-beige);flex-wrap:wrap}        .article-meta .m-item{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--color-text-light)}        .article-meta .m-item .m-ico{width:36px;height:36px;border-radius:50%;background:var(--color-brown-light);color:var(--color-cream);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}        .article-meta .m-item strong{color:var(--color-brown-dark);font-weight:600}        .article-meta .m-share{margin-left:auto;display:flex;gap:10px}        .article-meta .m-share span{width:36px;height:36px;border-radius:50%;background:var(--color-beige);color:var(--color-brown-dark);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:var(--transition-fast);font-size:14px}        .article-meta .m-share span:hover{background:var(--color-brown-dark);color:var(--color-yellow);transform:translateY(-2px)}        /* 主体 - 长文阅读 */        .article-body{padding:80px 0 60px;background:var(--color-cream)}        .article-container{max-width:880px;margin:0 auto;padding:0 40px}        .article-cover{width:100%;height:480px;object-fit:cover;border-radius:var(--radius-large);box-shadow:var(--shadow-strong);margin-bottom:50px}        .article-content{font-size:17px;line-height:2;color:var(--color-text)}        .article-content p{margin-bottom:24px}        .article-content h2{font-size:32px;color:var(--color-brown-dark);margin:50px 0 20px;padding-left:18px;border-left:6px solid var(--color-brown)}        .article-content h3{font-size:24px;color:var(--color-brown);margin:36px 0 16px}        .article-content blockquote{margin:30px 0;padding:24px 30px;background:var(--color-beige);border-left:4px solid var(--color-brown);border-radius:0 var(--radius-medium) var(--radius-medium) 0;font-style:italic;color:var(--color-brown-dark);line-height:1.9}        .article-content ul,.article-content ol{margin:20px 0 24px 24px}        .article-content li{margin-bottom:10px;line-height:1.9}        .article-content img{width:100%;border-radius:var(--radius-medium);margin:24px 0;box-shadow:var(--shadow-soft)}        /* 文章底部 */        .article-footer{max-width:880px;margin:60px auto 0;padding:40px 40px;background:var(--color-beige);border-radius:var(--radius-large);display:flex;align-items:center;justify-content:space-between;gap:30px;flex-wrap:wrap}        .article-tags{display:flex;gap:10px;flex-wrap:wrap}        .article-tag{padding:6px 14px;background:var(--color-cream);color:var(--color-brown-dark);border-radius:20px;font-size:13px;border:1px solid var(--color-brown-light)}        .article-author{display:flex;align-items:center;gap:14px}        .article-author .a-avatar{width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,var(--color-brown),var(--color-brown-dark));color:var(--color-yellow);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px;font-family:'Georgia',serif}        .article-author .a-info strong{display:block;color:var(--color-brown-dark);font-size:15px}        .article-author .a-info span{font-size:13px;color:var(--color-text-light)}        /* 相关资讯区 */        .related-section{padding:80px 0;background:var(--color-cream)}        .related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;max-width:1400px;margin:0 auto;padding:0 40px}        .related-card{background:var(--color-cream);border-radius:var(--radius-large);overflow:hidden;box-shadow:var(--shadow-soft);transition:var(--transition-medium);display:flex;flex-direction:column}        .related-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-strong)}        .related-card-img{position:relative;height:180px;overflow:hidden}        .related-card-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.6s ease}        .related-card:hover .related-card-img img{transform:scale(1.06)}        .related-card-img::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(139,90,43,.4) 100%)}        .related-card-body{padding:22px;flex:1;display:flex;flex-direction:column}        .related-card-body h4{font-size:16px;line-height:1.5;color:var(--color-brown-dark);margin-bottom:10px;font-weight:600}        .related-card-body h4 a{color:inherit}        .related-card-body h4 a:hover{color:var(--color-brown)}        .related-card-body .r-date{margin-top:auto;font-size:12px;color:var(--color-text-light);letter-spacing:1px}        /* 侧栏小列表（用于日/周/月新闻） */        .side-news-section{padding:60px 0;background:var(--color-beige)}        .side-news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;max-width:1400px;margin:0 auto;padding:0 40px}        .side-news-col h3{font-size:22px;color:var(--color-brown-dark);margin-bottom:24px;padding-bottom:14px;border-bottom:2px solid var(--color-brown-light);position:relative;display:flex;align-items:center;gap:10px}        .side-news-col h3::before{content:'';width:6px;height:24px;background:var(--color-brown-dark);border-radius:3px}        .side-news-col h3 .s-tag{margin-left:auto;font-family:'Georgia',serif;font-size:13px;color:var(--color-text-light);font-weight:400}        .side-news-item{display:flex;gap:14px;padding:14px 0;border-bottom:1px dashed var(--color-brown-light);transition:var(--transition-fast)}        .side-news-item:last-child{border-bottom:none}        .side-news-item:hover{transform:translateX(4px)}        .side-news-item img{width:80px;height:80px;object-fit:cover;border-radius:var(--radius-small);flex-shrink:0}        .side-news-item .s-body{flex:1}        .side-news-item .s-body h4{font-size:14px;line-height:1.5;color:var(--color-brown-dark);margin-bottom:6px;font-weight:600}        .side-news-item .s-body h4 a{color:inherit}        .side-news-item .s-body h4 a:hover{color:var(--color-brown)}        .side-news-item .s-body span{font-size:12px;color:var(--color-text-light);letter-spacing:1px}        /* CTA */        .article-cta{padding:80px 0;background:var(--color-brown-dark);color:var(--color-cream);text-align:center;position:relative;overflow:hidden}        .article-cta::before{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(255,232,168,.06) 1.5px,transparent 1.5px);background-size:28px 28px}        .article-cta-inner{position:relative;max-width:700px;margin:0 auto;padding:0 40px}        .article-cta h2{font-size:36px;color:var(--color-yellow);margin-bottom:18px}        .article-cta p{font-size:17px;color:var(--color-beige);line-height:1.8;margin-bottom:30px}        .article-cta .btn{background:var(--color-yellow);color:var(--color-brown-dark)}        .article-cta .btn:hover{background:var(--color-cream)}        @media (max-width: 1024px){            .related-grid{grid-template-columns:repeat(2,1fr)}            .side-news-grid{grid-template-columns:1fr 1fr;gap:30px}        }        @media (max-width: 768px){            .article-hero{padding:120px 0 40px}            .article-hero h1{font-size:28px}            .article-hero-inner{padding:0 20px}            .article-container{padding:0 20px}            .article-cover{height:240px;margin-bottom:30px}            .article-content{font-size:16px;line-height:1.9}            .article-content h2{font-size:24px}            .article-footer{padding:24px}            .related-grid{grid-template-columns:1fr}            .side-news-grid{grid-template-columns:1fr}            .article-cta h2{font-size:26px}        }    </style></head><body>    <!--NAV-BEGIN-->    <header class="header">      <div class="nav-v2">        <div class="nav-v2-inner">          <a class="brand" href="/index.html">            <span class="brand-mark"><img src="images/logo.png" alt="尧图网络科技Logo"></span>            <span class="brand-name">尧图网络科技<span class="brand-sub">北京尧图网络科技有限公司</span></span>          </a>          <nav class="mega">            <ul style="display:flex;align-items:center;gap:2px;list-style:none;margin:0;padding:0;"><li class="mega-item"><a class="mega-link" href="/index.html">首页</a></li><li c