		<script>
			// Restore dismissal and the session's random starting message before first paint.
			(function () {
				var banner = document.currentScript.previousElementSibling;
				if (!banner) {
					return;
				}
		
				var version = banner.getAttribute('data-announcement-version');
				try {
					if (localStorage.getItem('dismissedAnnouncementVersion') === version) {
						banner.classList.add('js-hidden');
					}
				} catch (error) {
					console.warn('Unable to restore banner dismissal state.', error);
				}
		
				var messages = banner.querySelectorAll('[data-banner-message]');
				if (messages.length < 2) {
					return;
				}
		
				var storageKey = 'initialAnnouncementMessage:' + version;
				var activeIndex;
				try {
					var storedIndex = sessionStorage.getItem(storageKey);
					if (storedIndex !== null) {
						activeIndex = Number(storedIndex);
					}
				} catch (error) {
					console.warn('Unable to restore the initial banner message.', error);
				}
				if (!Number.isInteger(activeIndex) || activeIndex < 0 || activeIndex >= messages.length) {
					activeIndex = Math.floor(Math.random() * messages.length);
					try {
						sessionStorage.setItem(storageKey, String(activeIndex));
					} catch (error) {
						console.warn('Unable to remember the initial banner message.', error);
					}
				}
		
				for (var index = 0; index < messages.length; index++) {
					var isActive = index === activeIndex;
					messages[index].classList.toggle('active', isActive);
					messages[index].setAttribute('aria-hidden', String(!isActive));
					messages[index].toggleAttribute('inert', !isActive);
				}
				banner.setAttribute('data-active-message-index', String(activeIndex));
			})();
		</script>
