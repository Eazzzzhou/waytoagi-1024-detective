            <main class="docs-main-content body" data-reading-content>
                
                <h1>Use chat in VS Code</h1>
                
                




<div class="docs-markdown-actions" data-vscode-installation-info="both">
	<div class="docs-markdown-dropdown" data-markdown-url="/docs/chat/chat-overview.md">
		<button type="button" class="docs-markdown-btn-main" data-action="copy-markdown" aria-label="Copy as Markdown">
			<span class="codicon codicon-copy" aria-hidden="true"></span>
			<span>Copy as Markdown</span>
		</button>
		<button type="button" class="docs-markdown-btn-trigger" aria-haspopup="menu" aria-expanded="false" aria-label="More page actions">
			<span class="codicon codicon-chevron-down docs-markdown-chevron" aria-hidden="true"></span>
		</button>
		<ul class="docs-markdown-menu" role="menu" aria-label="Page actions">
			<li role="none">
				<button type="button" role="menuitem" data-action="copy-markdown">
					<span class="codicon codicon-copy" aria-hidden="true"></span>
					<span>Copy as Markdown</span>
				</button>
			</li>
			<li role="none">
				<a role="menuitem" data-action="view-markdown" href="/docs/chat/chat-overview.md" target="_blank" rel="noopener noreferrer">
					<span class="codicon codicon-file" aria-hidden="true"></span>
