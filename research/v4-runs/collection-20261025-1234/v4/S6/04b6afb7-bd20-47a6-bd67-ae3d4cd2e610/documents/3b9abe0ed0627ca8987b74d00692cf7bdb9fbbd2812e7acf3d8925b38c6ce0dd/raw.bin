				</a>
			</li>
			<li class="docs-markdown-menu-separator" role="separator"></li>
			<li role="none">
				<a role="menuitem" data-action="ask-vscode" data-version="stable" href="vscode://GitHub.Copilot-Chat/chat?prompt=Read%20https%3A%2F%2Fcode.visualstudio.com%2Fdocs%2Fchat%2Fchat-overview%20and%20answer%20questions%20about%20the%20content.&amp;windowId=_blank">
					<span class="codicon codicon-chat-sparkle" aria-hidden="true"></span>
					<span>Ask in VS Code</span>
				</a>
			</li>
			<li role="none">
				<a role="menuitem" data-action="ask-vscode" data-version="insiders" href="vscode-insiders://GitHub.Copilot-Chat/chat?prompt=Read%20https%3A%2F%2Fcode.visualstudio.com%2Fdocs%2Fchat%2Fchat-overview%20and%20answer%20questions%20about%20the%20content.&amp;windowId=_blank">
