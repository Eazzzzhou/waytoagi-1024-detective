cta-stacked" data-component-id="4614c556acf463c6e76f21682bcf877b"> <div class="cta-stacked"> <div class="container-md cta-stacked--horizontal-cards"> <div ocr-component-name="card-horizontal" data-component-id="4c1cd7430d40510896066658982a2351" class="card-horizontal-container animation animation--effect-1-scroll"> <div class="row"> <div class="col"> <div class="card-horizontal"> <div class="row"> <div class="card-horizontal__media col-lg-12 col-md-6"> <div ocr-component-name="media" data-component-id="9b002e252846bf14b532f40bd58c2fca" class="media"> <div ocr-component-name="image" class="ocr-img media__asset" data-component-id="9b002e252846bf14b532f40bd58c2fca"> <img src="https://cdn-dynmedia-1.microsoft.com/is/image/microsoftcorp/223150-faeture-stack-image-01?resMode=sharp2&op_usm=1.5,0.65,15,0&wid=1000&hei=562&qlt=100&fit=constrain" class=" " alt=" Person in a pottery studio using a laptop and writing on a notepad at a desk." loading="lazy" data-oc="occf62" id="image-occf62"/> </div> </div> </div> <div class="card-horizontal__spacer"></div> <div class="card-horizontal__content col-lg-12 col-md-6"> <div ocr-component-name="block-slim" class="block-slim" data-component-id="b5cd651a36e54e9fc71a183b4ad18be8"> </div> <div ocr-component-name="block-feature" class="block-feature d-flex align-items-start block-feature--2xs" data-component-id="9290bbb697f35c37e989109584e9d258"> <div class="block-feature__top d-flex flex-row align-items-start" data-en-title="&lt;h3>Explore Copilot for individual use&lt;/h3> "> <div class="block-feature__headings d-flex flex-column align-items-start"> <div class="block-feature__eyebrow"> </div> <div class=" block-feature__title"> <div data-oc-token-text> <h3>Explore Copilot for individual use</h3> </div> </div> </div> </div> <div class="block-feature__body d-flex flex-column align-items-start"> <div class=" base block-feature__paragraph"> <div data-oc-token-text> Make your day even easier with Microsoft Copilot in Word, Excel, PowerPoint, OneNote and Outlook. </div> </div> </div> </div> <div ocr-component-name="block-slim" class="block-slim" data-component-id="b5cd651a36e54e9fc71a183b4ad18be8"> <div ocr-component-name="action" data-component-id="467e35e809075d121962a1d239c316b2" class="action d-contents"> <a class="btn " data-bi-ecn="Learn more" data-bi-ehn="Explore Copilot for individual use" data-bi-tags="{}" tabindex="0" data-bi-hn="Explore Copilot for individual use" data-bi-bhvr="231" data-bi-cn="Learn more" data-bi-compnm="Cta Stacked" target="_self" data-oc="oc4fb1" data-bi-ct="Card Button" id="action-oc4fb2" href="https://www.microsoft.com/en-nz/copilot/solutions/individuals" data-bi-sn="1" aria-label="Learn more about Copilot in Microsoft 365 for personal use" data-bi-view="Additional resources" data-isenvauthor="false"> <span class="btn__text">Learn more</span> </a> </div> </div> </div> </div> </div> </div> </div></div> </div> <div class="cta-stacked--vertical-cards three-up-cards layout layout--cols-2 mt-xl"> <div class="three-up-cards__card layout__col"> <div ocr-component-name="card" class="card animation animation--effect-2-scroll" data-component-id="2da121e2913e674ad2851c7c98030a80"> <div class="card__media"> <div ocr-component-name="media" data-component-id="9b002e252846bf14b532f40bd58c2fca" class="media rounded-m img-fluid"> <div ocr-component-name="image" class="ocr-img media__asset" data-component-id="9b002e252846bf14b532f40bd58c2fca"> <img src="https://cdn-dynmedia-1.microsoft.com/is/image/microsoftcorp/223150-faeture-stack-image-02?resMode=sharp2&op_usm=1.5,0.65,15,0&wid=1000&hei=429&qlt=100&fit=constrain" class=" " alt="Microsoft Copilot interface with suggested AI prompts." loading="lazy" data-oc="oc0021" id="image-oc0021"/> </div> </div> </div> <div class="card__content"> <div ocr-component-name="block-feature" class="block-feature d-flex align-items-start block-feature--2xs" data-component-id="9290bbb697f35c37e989109584e9d258"> <div class="block-feature__top d-flex flex-row align-items-start" data-en-title="&lt;h4>Jump-start your AI transformation at work&lt;/h4> "> <div class="block-feature__headings d-flex flex-column align-items-start"> <div class="block-feature__eyebrow"> </div> <div class=" block-feature__title"> <div data-oc-token-text> <h4><span class="d-block h5">Jump-start your AI transformation at work</span></h4> </div> </div> </div> </div> <div class="block-feature__body d-flex flex-column align-items-start"> <div class=" base block-feature__paragraph"> <div data-oc-token-text> Tap into expert guidance—inspired by companies leading the way—to empower everyone in your organization with Microsoft Copilot.  </div> </div> </div> </div> <div ocr-component-name="block-slim" class="block-slim" data-component-id="b5cd651a36e54e9fc71a183b4ad18be8"> <div ocr-component-name="action" data-component-id="467e35e809075d121962a1d239c316b2" class="action d-contents"> <a class="link " data-bi-ecn="Learn more" data-bi-ehn="Jump-start your AI transformation at work" data-bi-tags="{}" tabindex="0" data-bi-hn="Jump-start your AI transformation at work" data-bi-bhvr="231" data-bi-cn="Learn more" data-bi-compnm="Cta Stacked" target="_blank" data-oc="ocfffd" data-bi-ct="Card Link" id="action-ocfffd" href="https://www.microsoft.com/en-nz/copilot" data-bi-sn="2" aria-label="Learn more about jump-starting your AI transformation at work with product overview" data-bi-view="Additional resources"> <span class="btn btn--icon-only btn--sm "> <span class="glyph-prepend" aria-hidden="true"></span> </span> <span class="link__text">Learn more</span> </a> </div> </div> </div> </div> </div> <div class="three-up-cards__card layout__col"> <div ocr-component-name="card" class="card animation animation--effect-2-scroll" data-component-id="2da121e2913e674ad2851c7c98030a80"> <div class="card__media"> <div ocr-component-name="media" data-component-id="9b002e252846bf14b532f40bd58c2fca" class="media rounded-m img-fluid"> <div ocr-component-name="image" class="ocr-img media__asset" data-component-id="9b002e252846bf14b532f40bd58c2fca"> <img src="https://cdn-dynmedia-1.microsoft.com/is/image/microsoftcorp/Copilot-prompt-gallery?resMode=sharp2&op_usm=1.5,0.65,15,0&wid=1000&hei=429&qlt=100&fit=constrain" class=" " alt loading="lazy" data-oc="ocb82d" id="image-ocb82d"/> </div> </div> </div> <div class="card__content"> <div ocr-component-name="block-feature" class="block-feature d-flex align-items-start block-feature--2xs" data-component-id="9290bbb697f35c37e989109584e9d258"> <div class="block-feature__top d-flex flex-row align-items-start" data-en-title="&lt;h4>Copilot Prompt Gallery&lt;/h4> "> <div class="block-feature__headings d-flex flex-column align-items-start"> <div class="block-feature__eyebrow"> </div> <div class=" block-feature__title"> <div data-oc-token-text> <h4><span class="d-block h5">Copilot Prompt Gallery</span></h4> </div> </div> </div> </div> <div class="block-feature__body d-flex flex-column align-items-start"> <div class=" base block-feature__paragraph"> <div data-oc-token-text> Learn tips, tricks, and the art of better prompting across your everyday apps. </div> </div> </div> </div> <div ocr-component-name="block-slim" class="block-slim" data-component-id="b5cd651a36e54e9fc71a183b4ad18be8"> <div ocr-component-name="action" data-component-id="467e35e809075d121962a1d239c316b2" class="action d-contents"> <a class="link " data-bi-ecn="Learn more" data-bi-ehn="Copilot Prompt Gallery" data-bi-tags="{&#34;BiLinkName&#34;:&#34;learnmore6&#34;}" tabindex="0" data-bi-hn="Copilot Prompt Gallery" data-bi-bhvr="231" data-bi-cn="Learn more" data-bi-compnm="Cta Stacked" data-regenerate-fwlink="true" target="_blank" data-oc="oc4387" data-bi-ct="Card Link" id="action-oc4387" href="https://go.microsoft.com/fwlink/?LinkId=2379564&clcid=0x1409&culture=en-nz&country=nz" data-bi-sn="3" aria-label="Learn more about Copilot Prompt Gallery" data-bi-view="Additional resources"> <span class="btn btn--icon-only btn--sm "> <span class="glyph-prepend" aria-hidden="true"></span> </span> <span class="link__text">Learn more</span> </a> </div> </div> </div> </div> </div> </div> </div></div> </div> </div> </div> </div> <div ocr-component-name="section-master" data-component-id="2b9a710ec7952a9e39aaccb62b93dcee" class="section-master section-master--breadth-comfortable section-master--density-none aem-GridColumn aem-GridColumn--default--12"> <div class="section-master__image "> <div class="ocr-img media__asset"> <img src="https://cdn-dynmedia-1.microsoft.com/is/image/microsoftcorp/1076422-FAQ-1600x837?resMode=sharp2&op_usm=1.5,0.65,15,0&wid=2000&hei=1047&qlt=100&fit=constrain" class=" " alt loading="lazy"/> </div> </div> <div class="container" data-oc="ocb448" id="faq"> <div class="row"> <div class="col"> <div class="layout section-master__layout"> <div class="layout__col"> <div class="section-master__layout-header"> <div ocr-component-name="block-heading" class="block-heading" data-component-id="6ead05f340b941df5109567514e89a43"> </div> </div> </div> </div> </div> </div> <div class="row section-master__slot"> <div class="col"> <div ocr-component-name="faqs" class="ocr-faq" data-component-id="7a5662a0a645373b24d242c6ee1a0d39"> <script src="/golf/etc.clientlibs/onecloud/components/content/reimagine/blade/faqs/v2/faqs/clientlib/faqs.ACSHASH3e2bbf17b5bf77ae832449b6e06073ab.min.js"></script> <div class="ocr-faq__header"> <div class="ocr-faq__title"> <h2> <div data-oc-token-text> Frequently asked questions </div> </h2> </div> <div role="group" class="ocr-faq__controls" data-mount="ocr-collapse-controls" data-target="#accordion-container-accordion-inpage-oc684e"> <div class="button-group"> <button class="btn btn--secondary" type="button" data-action="expand" aria-disabled="false" aria-label="Expand all" data-bi-ecn="Expand all" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand all"> <div class="btn__text"> <div>Expand all</div> </div> </button> <button class="btn btn--secondary" type="button" data-action="collapse" aria-disabled="false" aria-label="Collapse all" data-bi-ecn="Collapse all" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Reduce" data-bi-hn="Frequently asked questions" data-bi-bhvr="8" data-bi-compnm="Faqs" data-bi-cn="Collapse all"> <div class="btn__text"> <div>Collapse all</div> </div> </button> </div> </div> </div> <ul id="accordion-container-accordion-inpage-oc684e" class="accordion "> <li class="ocr-faq-item "> <div class="ocr-faq-item__content"> <div class="button-group button-group--stacked"> <button class="col ocr-faq-item__header faq-collapse" data-target="#accordion-inpage-oc684e-item_default" aria-expanded="false" aria-controls="accordion-inpage-oc684e-item_default" data-mount="ocr-collapse" data-collapse="Collapse icon" data-encollapse="Collapse icon" data-collapsebhvr="8" data-collapsetemplatename="FAQ Reduce" data-expand="Expand icon" data-enexpand="Expand icon" data-expandbhvr="7" data-expandtemplatename="FAQ Expand" data-bi-ecn="Expand icon" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand icon"> <div class="ocr-faq-item__header--label"> <div class="small fg--base-highlight"> <div data-oc-token-text> <span class="d-block h6">01/</span> </div> </div> </div> <div class="ocr-faq-item__header--title"> <div class="lead "> <div data-oc-token-text> <h3><span class="d-block h5">Is Copilot free?</span></h3> </div> </div> </div> </button> </div> <div class="ocr-faq-item__body-wrapper collapse " id="accordion-inpage-oc684e-item_default"> <div class="ocr-faq-item__empty-div"></div> <div class="ocr-faq-item__body"> <div> <div data-oc-token-text> Yes. Microsoft offers a limited free version of Copilot subject to available capacity and limits. When you hit a limit, you can choose to upgrade to a paid option or come back later. For deeper integration across Microsoft 365 apps like Word, Excel, PowerPoint, and Outlook, Copilot is included with eligible Microsoft 365 subscriptions, which provide additional features and expanded AI usage allowances.<br/> <br/> Microsoft offers a one-month trial of Microsoft 365 Personal, Family, and Premium subscriptions. Trial availability, duration, eligibility requirements, and whether payment information is required vary by offer and region. Refer to the current Microsoft offer page for the latest details. To cancel your free trial at any time visit <a class="ms-rte-link" href="https://go.microsoft.com/fwlink/?LinkId&#61;2381945">Cancel your free trial of Microsoft 365 | Microsoft Support.</a> Features, availability, and usage limits vary by plan and region. Features and usage limits vary by subscription, and some AI benefits may be limited to the subscription owner. <a class="ms-rte-link" href="https://www.microsoft.com/en-nz/copilot/solutions/individuals">Learn more here</a>. </div> </div> </div> </div> </div> </li> <li class="ocr-faq-item "> <div class="ocr-faq-item__content"> <div class="button-group button-group--stacked"> <button class="col ocr-faq-item__header faq-collapse" data-target="#accordion-inpage-oc684e-item_1689841628574" aria-expanded="false" aria-controls="accordion-inpage-oc684e-item_1689841628574" data-mount="ocr-collapse" data-collapse="Collapse icon" data-encollapse="Collapse icon" data-collapsebhvr="8" data-collapsetemplatename="FAQ Reduce" data-expand="Expand icon" data-enexpand="Expand icon" data-expandbhvr="7" data-expandtemplatename="FAQ Expand" data-bi-ecn="Expand icon" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand icon"> <div class="ocr-faq-item__header--label"> <div class="small fg--base-highlight"> <div data-oc-token-text> <span class="d-block h6">02/</span> </div> </div> </div> <div class="ocr-faq-item__header--title"> <div class="lead "> <div data-oc-token-text> <h3><span class="d-block h5">Is Copilot included in Microsoft 365 plans?</span></h3> </div> </div> </div> </button> </div> <div class="ocr-faq-item__body-wrapper collapse " id="accordion-inpage-oc684e-item_1689841628574"> <div class="ocr-faq-item__empty-div"></div> <div class="ocr-faq-item__body"> <div> <div data-oc-token-text> Yes. Copilot capabilities are included with select Microsoft 365 subscriptions. Features, availability, and usage limits vary by plan and region. Features and usage limits vary by subscription, and some AI benefits may be limited to the subscription owner. <a href="https://www.microsoft.com/en-nz/copilot/solutions/individuals" class="ms-rte-link">Learn more here</a>. </div> </div> </div> </div> </div> </li> <li class="ocr-faq-item "> <div class="ocr-faq-item__content"> <div class="button-group button-group--stacked"> <button class="col ocr-faq-item__header faq-collapse" data-target="#accordion-inpage-oc684e-item_1689841629837" aria-expanded="false" aria-controls="accordion-inpage-oc684e-item_1689841629837" data-mount="ocr-collapse" data-collapse="Collapse icon" data-encollapse="Collapse icon" data-collapsebhvr="8" data-collapsetemplatename="FAQ Reduce" data-expand="Expand icon" data-enexpand="Expand icon" data-expandbhvr="7" data-expandtemplatename="FAQ Expand" data-bi-ecn="Expand icon" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand icon"> <div class="ocr-faq-item__header--label"> <div class="small fg--base-highlight"> <div data-oc-token-text> <span class="d-block h6">03/</span> </div> </div> </div> <div class="ocr-faq-item__header--title"> <div class="lead "> <div data-oc-token-text> <h3><span class="d-block h5">What is the difference between the Copilot mobile app and the Copilot experience within the Microsoft 365 apps?</span></h3> </div> </div> </div> </button> </div> <div class="ocr-faq-item__body-wrapper collapse " id="accordion-inpage-oc684e-item_1689841629837"> <div class="ocr-faq-item__empty-div"></div> <div class="ocr-faq-item__body"> <div> <div data-oc-token-text> The Copilot mobile app is a standalone AI assistant for everyday tasks like asking questions, brainstorming ideas, gathering information, and creating content on the go. Copilot within Microsoft 365 apps is built directly into apps like Word, Excel, PowerPoint, and Outlook, where it can help you draft documents, analyze data, create presentations, and summarize emails while you work. </div> </div> </div> </div> </div> </li> <li class="ocr-faq-item "> <div class="ocr-faq-item__content"> <div class="button-group button-group--stacked"> <button class="col ocr-faq-item__header faq-collapse" data-target="#accordion-inpage-oc684e-item_1689841632654" aria-expanded="false" aria-controls="accordion-inpage-oc684e-item_1689841632654" data-mount="ocr-collapse" data-collapse="Collapse icon" data-encollapse="Collapse icon" data-collapsebhvr="8" data-collapsetemplatename="FAQ Reduce" data-expand="Expand icon" data-enexpand="Expand icon" data-expandbhvr="7" data-expandtemplatename="FAQ Expand" data-bi-ecn="Expand icon" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand icon"> <div class="ocr-faq-item__header--label"> <div class="small fg--base-highlight"> <div data-oc-token-text> <span class="d-block h6">04/</span> </div> </div> </div> <div class="ocr-faq-item__header--title"> <div class="lead "> <div data-oc-token-text> <h3><span class="d-block h5">Does Copilot work across Microsoft 365 apps (e.g.: Outlook to Word, Word to PowerPoint, etc.)?</span></h3> </div> </div> </div> </button> </div> <div class="ocr-faq-item__body-wrapper collapse " id="accordion-inpage-oc684e-item_1689841632654"> <div class="ocr-faq-item__empty-div"></div> <div class="ocr-faq-item__body"> <div> <div data-oc-token-text> Yes. Copilot works across Microsoft 365 apps like Word, Excel, PowerPoint, and Outlook, helping you draft content, analyze data, create presentations, summarize emails, and more. Because Copilot is built directly into the apps you use every day, it can help you stay in your workflow and get things done faster without switching between tools. </div> </div> </div> </div> </div> </li> <li class="ocr-faq-item "> <div class="ocr-faq-item__content"> <div class="button-group button-group--stacked"> <button class="col ocr-faq-item__header faq-collapse" data-target="#accordion-inpage-oc684e-item_1693237296692_c_300732714" aria-expanded="false" aria-controls="accordion-inpage-oc684e-item_1693237296692_c_300732714" data-mount="ocr-collapse" data-collapse="Collapse icon" data-encollapse="Collapse icon" data-collapsebhvr="8" data-collapsetemplatename="FAQ Reduce" data-expand="Expand icon" data-enexpand="Expand icon" data-expandbhvr="7" data-expandtemplatename="FAQ Expand" data-bi-ecn="Expand icon" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand icon"> <div class="ocr-faq-item__header--label"> <div class="small fg--base-highlight"> <div data-oc-token-text> <span class="d-block h6">05/</span> </div> </div> </div> <div class="ocr-faq-item__header--title"> <div class="lead "> <div data-oc-token-text> <h3><span class="d-block h5">How is Microsoft 365 Premium different from Personal? Can I use it for work?</span></h3> </div> </div> </div> </button> </div> <div class="ocr-faq-item__body-wrapper collapse " id="accordion-inpage-oc684e-item_1693237296692_c_300732714"> <div class="ocr-faq-item__empty-div"></div> <div class="ocr-faq-item__body"> <div> <div data-oc-token-text> Microsoft 365 Personal is designed for one person and includes Microsoft 365 apps, cloud storage, security features, and Copilot. Microsoft 365 Premium is a subscription for 1 to 6 people that includes extensive AI usage and Copilot features, and plus 2 TB of shared cloud storage.<br/> <br/> If your organization has multi account access enabled, you may be able to sign in to Copilot with your personal Microsoft account while using your work account for organizational data. In that scenario, access to company content is still governed by your organization&#39;s permissions and policies, so you only see information you&#39;re authorized to access. <a href="https://go.microsoft.com/fwlink/?LinkId&#61;2382160" class="ms-rte-link">Learn more here</a>. </div> </div> </div> </div> </div> </li> <li class="ocr-faq-item "> <div class="ocr-faq-item__content"> <div class="button-group button-group--stacked"> <button class="col ocr-faq-item__header faq-collapse" data-target="#accordion-inpage-oc684e-item_1693237296692_c" aria-expanded="false" aria-controls="accordion-inpage-oc684e-item_1693237296692_c" data-mount="ocr-collapse" data-collapse="Collapse icon" data-encollapse="Collapse icon" data-collapsebhvr="8" data-collapsetemplatename="FAQ Reduce" data-expand="Expand icon" data-enexpand="Expand icon" data-expandbhvr="7" data-expandtemplatename="FAQ Expand" data-bi-ecn="Expand icon" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand icon"> <div class="ocr-faq-item__header--label"> <div class="small fg--base-highlight"> <div data-oc-token-text> <span class="d-block h6">06/</span> </div> </div> </div> <div class="ocr-faq-item__header--title"> <div class="lead "> <div data-oc-token-text> <h3><span class="d-block h5">I&#39;m a Microsoft 365 Family subscriber. Does my family get access to Copilot as a part of our plan now?</span></h3> </div> </div> </div> </button> </div> <div class="ocr-faq-item__body-wrapper collapse " id="accordion-inpage-oc684e-item_1693237296692_c"> <div class="ocr-faq-item__empty-div"></div> <div class="ocr-faq-item__body"> <div> <div data-oc-token-text> Microsoft 365 Family benefits, including Microsoft 365 apps and OneDrive storage, can be shared with up to 5 people. However, Copilot features in apps like Word, Excel, PowerPoint, and Outlook are available only to the subscription owner and can&#39;t be shared with other family members. Family members who want access to Copilot features will need their own eligible Microsoft 365 subscription. <a class="ms-rte-link" href="https://go.microsoft.com/fwlink/?LinkId&#61;2158137">Learn more here</a>.  </div> </div> </div> </div> </div> </li> <li class="ocr-faq-item "> <div class="ocr-faq-item__content"> <div class="button-group button-group--stacked"> <button class="col ocr-faq-item__header faq-collapse" data-target="#accordion-inpage-oc684e-item_1693237296692_c_1730646990" aria-expanded="false" aria-controls="accordion-inpage-oc684e-item_1693237296692_c_1730646990" data-mount="ocr-collapse" data-collapse="Collapse icon" data-encollapse="Collapse icon" data-collapsebhvr="8" data-collapsetemplatename="FAQ Reduce" data-expand="Expand icon" data-enexpand="Expand icon" data-expandbhvr="7" data-expandtemplatename="FAQ Expand" data-bi-ecn="Expand icon" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand icon"> <div class="ocr-faq-item__header--label"> <div class="small fg--base-highlight"> <div data-oc-token-text> <span class="d-block h6">07/</span> </div> </div> </div> <div class="ocr-faq-item__header--title"> <div class="lead "> <div data-oc-token-text> <h3><span class="d-block h5">What are the usage limits on each plan, and what happens when I hit them?</span></h3> </div> </div> </div> </button> </div> <div class="ocr-faq-item__body-wrapper collapse " id="accordion-inpage-oc684e-item_1693237296692_c_1730646990"> <div class="ocr-faq-item__empty-div"></div> <div class="ocr-faq-item__body"> <div> <div data-oc-token-text> AI usage limits vary by plan. Microsoft 365 Personal and Family include AI credits and feature limits, while Microsoft 365 Premium includes higher limits, and Microsoft 365 Pro offers the highest limits. In addition to more extensive usage, Microsoft 365 Premium and Microsoft 365 Pro also include access to advanced AI features. <a class="ms-rte-link" href="https://go.microsoft.com/fwlink/?LinkId&#61;2382161">Learn more here</a>.<br/> <br/> If you reach a feature limit or use all of your AI credits, that feature may be unavailable until your allowance resets. You can check your remaining credits and limits in your Microsoft account under Services &amp; subscriptions.  </div> </div> </div> </div> </div> </li> <li class="ocr-faq-item "> <div class="ocr-faq-item__content"> <div class="button-group button-group--stacked"> <button class="col ocr-faq-item__header faq-collapse" data-target="#accordion-inpage-oc684e-item_1693237296692_c_435134378" aria-expanded="false" aria-controls="accordion-inpage-oc684e-item_1693237296692_c_435134378" data-mount="ocr-collapse" data-collapse="Collapse icon" data-encollapse="Collapse icon" data-collapsebhvr="8" data-collapsetemplatename="FAQ Reduce" data-expand="Expand icon" data-enexpand="Expand icon" data-expandbhvr="7" data-expandtemplatename="FAQ Expand" data-bi-ecn="Expand icon" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand icon"> <div class="ocr-faq-item__header--label"> <div class="small fg--base-highlight"> <div data-oc-token-text> <span class="d-block h6">08/</span> </div> </div> </div> <div class="ocr-faq-item__header--title"> <div class="lead "> <div data-oc-token-text> <h3><span class="d-block h5">How do I transfer my context and memory from other tools to Copilot?</span></h3> </div> </div> </div> </button> </div> <div class="ocr-faq-item__body-wrapper collapse " id="accordion-inpage-oc684e-item_1693237296692_c_435134378"> <div class="ocr-faq-item__empty-div"></div> <div class="ocr-faq-item__body"> <div> <div data-oc-token-text> While Copilot can&#39;t automatically import chat history, memory, or saved preferences from other AI tools, you can bring over the information that matters most to you. To get started:<br/>   • Export important conversations, notes, or documents from your previous tools.<br/>   • Upload those files to Copilot or save them in Microsoft 365 apps and services such as OneDrive, Word, or OneNote.<br/>   • Ask Copilot to summarize the content, identify key preferences, and create a personal profile or project overview based on the information you provide.<br/> <br/> For the best experience, create a document that includes details such as your role, ongoing projects, writing preferences, and important context. Keeping this information in Microsoft 365 makes it easier for Copilot to help you work more efficiently across your files, emails, meetings, and documents. Keep in mind that saved memory, custom instructions, and account settings from other AI tools don&#39;t transfer automatically and will need to be recreated in Copilot. </div> </div> </div> </div> </div> </li> <li class="ocr-faq-item "> <div class="ocr-faq-item__content"> <div class="button-group button-group--stacked"> <button class="col ocr-faq-item__header faq-collapse" data-target="#accordion-inpage-oc684e-item_1693237296692_c_343728527" aria-expanded="false" aria-controls="accordion-inpage-oc684e-item_1693237296692_c_343728527" data-mount="ocr-collapse" data-collapse="Collapse icon" data-encollapse="Collapse icon" data-collapsebhvr="8" data-collapsetemplatename="FAQ Reduce" data-expand="Expand icon" data-enexpand="Expand icon" data-expandbhvr="7" data-expandtemplatename="FAQ Expand" data-bi-ecn="Expand icon" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand icon"> <div class="ocr-faq-item__header--label"> <div class="small fg--base-highlight"> <div data-oc-token-text> <span class="d-block h6">09/</span> </div> </div> </div> <div class="ocr-faq-item__header--title"> <div class="lead "> <div data-oc-token-text> <h3><span class="d-block h5">Does Microsoft offer a student, educator, or academic discount on individual Copilot plans?</span></h3> </div> </div> </div> </button> </div> <div class="ocr-faq-item__body-wrapper collapse " id="accordion-inpage-oc684e-item_1693237296692_c_343728527"> <div class="ocr-faq-item__empty-div"></div> <div class="ocr-faq-item__body"> <div> <div data-oc-token-text> Yes. Eligible students may qualify for special Microsoft education offers and discounts, including discounted Microsoft 365 subscriptions, and some schools provide Microsoft 365 access at no additional cost. Availability, eligibility, and pricing may vary by school and region. <a href="https://go.microsoft.com/fwlink/?LinkId&#61;2360805" class="ms-rte-link">Learn more here</a>.  </div> </div> </div> </div> </div> </li> <li class="ocr-faq-item "> <div class="ocr-faq-item__content"> <div class="button-group button-group--stacked"> <button class="col ocr-faq-item__header faq-collapse" data-target="#accordion-inpage-oc684e-item_1693237296692_c_1562513990" aria-expanded="false" aria-controls="accordion-inpage-oc684e-item_1693237296692_c_1562513990" data-mount="ocr-collapse" data-collapse="Collapse icon" data-encollapse="Collapse icon" data-collapsebhvr="8" data-collapsetemplatename="FAQ Reduce" data-expand="Expand icon" data-enexpand="Expand icon" data-expandbhvr="7" data-expandtemplatename="FAQ Expand" data-bi-ecn="Expand icon" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand icon"> <div class="ocr-faq-item__header--label"> <div class="small fg--base-highlight"> <div data-oc-token-text> <span class="d-block h6">10/</span> </div> </div> </div> <div class="ocr-faq-item__header--title"> <div class="lead "> <div data-oc-token-text> <h3><span class="d-block h5">What is the Microsoft Frontier program and how can I get involved?</span></h3> </div> </div> </div> </button> </div> <div class="ocr-faq-item__body-wrapper collapse " id="accordion-inpage-oc684e-item_1693237296692_c_1562513990"> <div class="ocr-faq-item__empty-div"></div> <div class="ocr-faq-item__body"> <div> <div data-oc-token-text> The Microsoft Frontier Program gives you early access to experimental AI features and Copilot experiences before they become generally available. You can try new capabilities, provide feedback, and help shape future product development. Features in Frontier may change, evolve, or be removed as Microsoft continues to learn and iterate. To learn more or get started, visit the <a class="ms-rte-link" href="https://go.microsoft.com/fwlink/?LinkId&#61;2381946">Microsoft Frontier Program page</a>. </div> </div> </div> </div> </div> </li> <li class="ocr-faq-item "> <div class="ocr-faq-item__content"> <div class="button-group button-group--stacked"> <button class="col ocr-faq-item__header faq-collapse" data-target="#accordion-inpage-oc684e-item_1693237296692_c_1473325252" aria-expanded="false" aria-controls="accordion-inpage-oc684e-item_1693237296692_c_1473325252" data-mount="ocr-collapse" data-collapse="Collapse icon" data-encollapse="Collapse icon" data-collapsebhvr="8" data-collapsetemplatename="FAQ Reduce" data-expand="Expand icon" data-enexpand="Expand icon" data-expandbhvr="7" data-expandtemplatename="FAQ Expand" data-bi-ecn="Expand icon" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand icon"> <div class="ocr-faq-item__header--label"> <div class="small fg--base-highlight"> <div data-oc-token-text> <span class="d-block h6">11/</span> </div> </div> </div> <div class="ocr-faq-item__header--title"> <div class="lead "> <div data-oc-token-text> <h3><span class="d-block h5">How does Copilot in Microsoft 365 compare to other AI tools?</span></h3> </div> </div> </div> </button> </div> <div class="ocr-faq-item__body-wrapper collapse " id="accordion-inpage-oc684e-item_1693237296692_c_1473325252"> <div class="ocr-faq-item__empty-div"></div> <div class="ocr-faq-item__body"> <div> <div data-oc-token-text> Microsoft 365 Copilot brings together AI capabilities from AI models selected by Microsoft within a single experience. This gives you flexibility to use advanced AI capabilities without switching between multiple tools. Unlike standalone AI assistants, Copilot is built directly into Microsoft 365 apps like Word, Excel, PowerPoint, and Outlook, so you can create content, analyze data, build presentations, and manage communications where your work already lives. </div> </div> </div> </div> </div> </li> <li class="ocr-faq-item "> <div class="ocr-faq-item__content"> <div class="button-group button-group--stacked"> <button class="col ocr-faq-item__header faq-collapse" data-target="#accordion-inpage-oc684e-item_1693237296692" aria-expanded="false" aria-controls="accordion-inpage-oc684e-item_1693237296692" data-mount="ocr-collapse" data-collapse="Collapse icon" data-encollapse="Collapse icon" data-collapsebhvr="8" data-collapsetemplatename="FAQ Reduce" data-expand="Expand icon" data-enexpand="Expand icon" data-expandbhvr="7" data-expandtemplatename="FAQ Expand" data-bi-ecn="Expand icon" data-bi-ehn="Frequently asked questions" data-bi-ct="FAQ Expand" data-bi-hn="Frequently asked questions" data-bi-bhvr="7" data-bi-compnm="Faqs" data-bi-cn="Expand icon"> <div class="ocr-faq-item__header--label"> <div class="small fg--base-highlight"> <div data-oc-token-text> <span class="d-block h6">12/</span> </div> </div> </div> <div class="ocr-faq-item__header--title"> <div class="lead "> <div data-oc-token-text> <h3><span class="d-block h5">How does Microsoft use my data and protect my privacy?</span></h3> </div> </div> </div> </button> </div> <div class="ocr-faq-item__body-wrapper collapse " id="accordion-inpage-oc684e-item_1693237296692"> <div class="ocr-faq-item__empty-div"></div> <div class="ocr-faq-item__body"> <div> <div data-oc-token-text> Copilot is built on Microsoft&#39;s existing security, privacy, compliance, and Responsible AI commitments. <a class="ms-rte-link" href="https://go.microsoft.com/fwlink/?LinkId&#61;2382162">Learn more here</a>.  </div> </div> </div> </div> </div> </li> </ul> </div> </div> </div> </div> </div> <div ocr-component-name="section-master" data-component-id="2b9a710ec7952a9e39aaccb62b93dcee" class="section-master section-master--breadth-none section-master--density-none aem-GridColumn aem-GridColumn--default--12"> <div class="section-master__image "> <div class="ocr-img media__asset"> <img src="https://cdn-dynmedia-1.microsoft.com/is/image/microsoftcorp/1076422-Footnotes-1600x563?resMode=sharp2&op_usm=1.5,0.65,15,0&wid=2000&hei=704&qlt=100&fit=constrain" class=" " alt loading="lazy"/> </div> </div> <div class="container" data-oc="oc8d60" id="section-master-oc8d60"> <div class="row"> <div class="col"> <div class="layout section-master__layout"> <div class="layout__col"> <div class="section-master__layout-header"> <div ocr-component-name="block-heading" class="block-heading" data-component-id="6ead05f340b941df5109567514e89a43"> </div> </div> </div> </div> </div> </div> <div class="row section-master__slot"> <div class="col"> <div class="footnote" data-component-id="90f410e46dab75f685faffe8f751000c"><div class="footnote" role="region" aria-label="Footnotes"> <div class="footnote__divider"> <div ocr-component-name="divider" data-component-id="467e35e809075d121962a1d239c316b5" class="ocr-divider ocr-divider--size-xs"> </div> </div> <ol class="footnote-list tabs panelcontainer" data-component-id="90f410e46dab75f685faffe8f751000c" role="list"> <li> <div class="footnote-item tabs panelcontainer" data-component-id="140c44720ac487f8182e5e266b9acf96"> <div class="footnote__item"> <a id="footnote-1" href="#footnote-1" class="footnote__item-number fg--accent-subtle-normal label-eyebrow" aria-label="Back to Footnote 1"> [1] </a> <div class="footnote__item-text fg--base-subtle small "> AI features only available to subscription owner and cannot be shared; usage limits apply. <a class="ms-rte-link" target="_blank" href="https://go.microsoft.com/fwlink/?linkid&#61;2280151" aria-label="Learn more about AI credits and limits for Microsoft 365 subscriptions" rel="noopener noreferrer">Learn more</a>. </div> </div></div> </li> <li> <div class="footnote-item tabs panelcontainer" data-component-id="140c44720ac487f8182e5e266b9acf96"> <div class="footnote__item"> <a id="footnote-2" href="#footnote-2" class="footnote__item-number fg--accent-subtle-normal label-eyebrow" aria-label="Back to footnote2"> [2] </a> <div class="footnote__item-text fg--base-subtle small "> App availability varies by device/language. Features vary by platform. Minimum age limits may apply to use of AI features. <a class="ms-rte-link" target="_blank" href="https://go.microsoft.com/fwlink/?linkid&#61;2280902" aria-label="See details about Copilot in Microsoft 365 subscriptions frequently asked questions" rel="noopener noreferrer">Details</a>. </div> </div></div> </li> </ol> <script src="/golf/etc.clientlibs/onecloud/components/content/reimagine/atomic/footnote/v2/footnote/clientlibs/site.ACSHASHd1da57737f7587d5304532e6afd0b53c.min.js"></script> </div></div> </div> </div> </div> </div> <div ocr-component-name="section-master" data-component-id="2b9a710ec7952a9e39aaccb62b93dcee" class="section-master section-master--breadth-none section-master--density-compact aem-GridColumn aem-GridColumn--default--12"> <div class="container" data-oc="oc2cb1" id="section-master-oc2cb1"> <div class="row"> <div class="col"> <div class="layout section-master__layout"> <div class="layout__col"> <div class="section-master__layout-header"> <div ocr-component-name="block-heading" class="block-heading