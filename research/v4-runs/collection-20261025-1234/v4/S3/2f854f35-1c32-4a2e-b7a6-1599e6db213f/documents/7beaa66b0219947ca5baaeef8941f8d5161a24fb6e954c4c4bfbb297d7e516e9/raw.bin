allery-features-label,\n[data-theme=\"dark\"] .gallery-features-label {\n  color: #71717a;\n}\n\n/* Category filter chips */\n.gallery-chip {\n  display: inline-block;\n  padding: 6px 14px;\n  border-radius: 20px;\n  border: 1px solid #e2e8f0;\n  background: transparent;\n  color: #64748b;\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s;\n  white-space: nowrap;\n  user-select: none;\n}\n.dark .gallery-chip,\n[data-theme=\"dark\"] .gallery-chip {\n  border-color: #3f3f46;\n  color: #a1a1aa;\n}\n.gallery-chip:hover {\n  border-color: #94a3b8;\n  color: #334155;\n}\n.dark .gallery-chip:hover,\n[data-theme=\"dark\"] .gallery-chip:hover {\n  border-color: #71717a;\n  color: #d4d4d8;\n}\n.gallery-chip.active {\n  background: #317CFF;\n  border-color: #317CFF;\n  color: #fff;\n}\n\n/* Feature filter chips */\n.gallery-feature-chip {\n  display: inline-block;\n  padding: 4px 12px;\n  border-radius: 16px;\n  border: 1px solid #e2e8f0;\n  background: transparent;\n  color: #64748b;\n  font-size: 11px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s;\n  white-space: nowrap;\n  user-select: none;\n}\n.dark .gallery-feature-chip,\n[data-theme=\"dark\"] .gallery-feature-chip {\n  border-color: #3f3f46;\n  color: #a1a1aa;\n}\n.gallery-feature-chip:hover {\n  border-color: #317CFF;\n  color: #317CFF;\n}\n.gallery-feature-chip.active {\n  background: rgba(49, 124, 255, 0.1);\n  border-color: #317CFF;\n  color: #317CFF;\n}\n\n/* Mobile: horizontal scroll for filter chips */\n@media (max-width: 640px) {\n  #category-filters {\n    flex-wrap: nowrap !important;\n    overflow-x: auto !important;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n    padding-bottom: 4px;\n  }\n  #category-filters::-webkit-scrollbar {\n    display: none;\n  }\n  #feature-filters {\n    flex-wrap: nowrap !important;\n    overflow-x: auto !important;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n    padding-bottom: 4px;\n  }\n  #feature-filters::-webkit-scrollbar {\n    display: none;\n  }\n}\n\n/* Tablet: 3 columns */\n@media (max-width: 900px) {\n  #gallery-grid {\n    grid-template-columns: repeat(3, 1fr) !important;\n  }\n}\n\n/* Mobile: single column card grid + left-align filters */\n@media (max-width: 480px) {\n  #gallery-grid {\n    grid-template-columns: 1fr !important;\n  }\n  #category-filters,\n  #feature-filters {\n    justify-content: flex-start !important;\n    overflow-x: auto;\n    flex-wrap: nowrap !important;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n  }\n  #category-filters::-webkit-scrollbar,\n  #feature-filters::-webkit-scrollbar {\n    display: none;\n  }\n}\n\n/* Gallery cards */\n.gallery-card {\n  display: block;\n  text-decoration: none !important;\n  color: inherit !important;\n  height: 100%;\n}\n.gallery-card-inner {\n  display: flex;\n  flex-direction: column;\n  height: 180px;\n  padding: 18px;\n  border-radius: 10px;\n  border: 1px solid #e2e8f0;\n  background: #fff;\n  transition: all 0.2s;\n  overflow: hidden;\n  position: relative;\n}\n.dark .gallery-card-inner,\n[data-theme=\"dark\"] .gallery-card-inner {\n  border-color: #27272a;\n  background: #18181b;\n}\n.gallery-card:hover .gallery-card-inner {\n  border-color: #94a3b8;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);\n  transform: translateY(-1px);\n}\n.dark .gallery-card:hover .gallery-card-inner,\n[data-theme=\"dark\"] .gallery-card:hover .gallery-card-inner {\n  border-color: #52525b;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);\n}\n\n/* Card content */\n.gallery-card-cat {\n  display: block;\n  font-size: 10px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: #317CFF;\n  margin-bottom: 6px;\n}\n.gallery-card-cat[data-cat=\"project-management\"]   { color: #818cf8; }\n.gallery-card-cat[data-cat=\"automations\"]          { color: #f59e0b; }\n.gallery-card-cat[data-cat=\"incident-response\"]     { color: #f87171; }\n.gallery-card-cat[data-cat=\"code-quality\"]         { color: #a78bfa; }\n.gallery-card-cat[data-cat=\"migrations\"]           { color: #317CFF; }\n.gallery-card-cat[data-cat=\"data-analytics\"]       { color: #22d3ee; }\n.gallery-card-cat[data-cat=\"feature-development\"]  { color: #60a5fa; }\n.gallery-card-cat[data-cat=\"devin-optimization\"]   { color: #2dd4bf; }\n.gallery-card-title {\n  display: block;\n  font-size: 14px;\n  font-weight: 600;\n  color: #18181b;\n  line-height: 1.3;\n  margin-bottom: 6px;\n}\n.dark .gallery-card-title,\n[data-theme=\"dark\"] .gallery-card-title {\n  color: #f4f4f5;\n}\n.gallery-card-desc {\n  font-size: 12px;\n  color: #64748b;\n  line-height: 1.45;\n  flex: 1;\n  min-height: 0;\n  overflow: hidden;\n  position: relative;\n}\n.gallery-card-desc::after {\n  content: '';\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  height: 1.45em;\n  background: linear-gradient(to bottom, transparent, #fff);\n  pointer-events: none;\n}\n.dark .gallery-card-desc::after,\n[data-theme=\"dark\"] .gallery-card-desc::after {\n  background: linear-gradient(to bottom, transparent, #18181b);\n}\n.dark .gallery-card-desc,\n[data-theme=\"dark\"] .gallery-card-desc {\n  color: #a1a1aa;\n}\n.gallery-card-tags {\n  display: flex;\n  gap: 4px;\n  flex-wrap: wrap;\n  margin-top: auto;\n  padding-top: 8px;\n}\n.gallery-tag {\n  font-size: 9px;\n  padding: 1px 6px;\n  border-radius: 10px;\n  background: #f1f5f9;\n  color: #94a3b8;\n  font-weight: 500;\n}\n.dark .gallery-tag,\n[data-theme=\"dark\"] .gallery-tag {\n  background: #27272a;\n  color: #71717a;\n}\n\n/* Popular star badge on gallery cards */\n.gallery-popular {\n  position: absolute;\n  top: 8px;\n  right: 8px;\n  color: #f59e0b;\n  font-size: 16px;\n  line-height: 1;\n  cursor: default;\n  z-index: 2;\n}\n\n/* Use Case Detail Page: center content on mode:\"custom\" pages */\n.uc-detail-wrapper {\n  max-width: 960px;\n  margin: 0 auto;\n  padding: 0 24px;\n  box-sizing: border-box;\n}\n\n/* Use Case Hero Section */\n.uc-hero {\n  background: transparent;\n  padding: 64px 0 40px 0;\n  border-bottom: 1px solid #e2e8f0;\n}\n.dark .uc-hero,\n[data-theme=\"dark\"] .uc-hero {\n  border-bottom-color: #27272a;\n}\n.uc-hero-inner {\n  max-width: 960px;\n  margin: 0 auto;\n  padding: 0 24px;\n  box-sizing: border-box;\n  width: 100%;\n  display: grid;\n  grid-template-columns: 1fr 240px;\n  gap: 48px;\n  align-items: start;\n}\n.uc-hero-title {\n  font-size: 36px;\n  font-weight: 700;\n  color: #18181b;\n  line-height: 1.15;\n  margin: 0 0 16px 0;\n  letter-spacing: -0.02em;\n}\n.dark .uc-hero-title,\n[data-theme=\"dark\"] .uc-hero-title {\n  color: #f4f4f5;\n}\n.uc-hero-desc {\n  font-size: 16px;\n  color: #64748b;\n  line-height: 1.6;\n  margin: 0;\n}\n.dark .uc-hero-desc,\n[data-theme=\"dark\"] .uc-hero-desc {\n  color: #a1a1aa;\n}\n.uc-hero-meta {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  padding-top: 8px;\n}\n.uc-meta-item {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.uc-meta-label {\n  font-size: 11px;\n  font-weight: 500;\n  color: #94a3b8;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n.dark .uc-meta-label,\n[data-theme=\"dark\"] .uc-meta-label {\n  color: #71717a;\n}\n.uc-meta-value {\n  font-size: 14px;\n  font-weight: 500;\n  color: #334155;\n}\n.dark .uc-meta-value,\n[data-theme=\"dark\"] .uc-meta-value {\n  color: #e4e4e7;\n}\n@media (max-width: 768px) {\n  .uc-hero {\n    padding: 32px 0;\n  }\n  .uc-hero-inner {\n    grid-template-columns: 1fr;\n    gap: 24px;\n    padding: 0 16px;\n  }\n  .uc-hero-title {\n    font-size: 28px;\n  }\n  .uc-hero-meta {\n    flex-direction: row;\n    flex-wrap: wrap;\n    gap: 20px;\n  }\n}\n@media (max-width: 480px) {\n  .uc-hero-title {\n    font-size: 24px;\n  }\n  .uc-hero-desc {\n    font-size: 14px;\n  }\n  .uc-hero-meta {\n    flex-direction: column;\n    gap: 16px;\n  }\n}\n\n/* Try in Devin button in hero section — larger standalone style */\n.uc-hero .try-in-devin-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 20px;\n  background: #317CFF;\n  color: #fff !important;\n  border-radius: 8px;\n  font-size: 14px;\n  font-weight: 500;\n  text-decoration: none !important;\n  transition: background 0.2s;\n  border: none;\n  cursor: pointer;\n  margin-top: 24px;\n  opacity: 1;\n}\n.uc-hero .try-in-devin-btn:hover {\n  background: #2968D9;\n  color: #fff !important;\n}\n.uc-hero .try-in-devin-logo {\n  width: 20px;\n  height: 20px;\n}\n\n/* ===== Federal docs =====\n   The Federal section is a standalone area that is intentionally NOT linked from\n   the commercial docs. It lives as a normal tab so its pages keep a full sidebar;\n   we hide the Federal tab from the desktop and mobile navigation so commercial\n   readers never see it. Federal users reach the section by direct URL and\n   navigate via the sidebar.\n\n   Mintlify renders these tabs as anchors whose desktop and mobile classes are\n   nav-tabs-item and mobile-nav-tabs-item, respectively. */\na.nav-tabs-item[href*=\"/federal\"],\na.mobile-nav-tabs-item[href*=\"/federal\"] {\n  display: none !important;\n}\n\n/* ===== SDK docs =====\n   The SDK tab is unlisted while the SDK is in beta: `hidden: true` in docs.json\n   keeps it out of search, the sitemap, and AI context, and this rule removes the\n   tab from the navbar for readers on older renderers. Pages stay reachable by\n   direct URL (/sdk) with their full sidebar. */\na.nav-tabs-item[href$=\"/sdk\"],\na.nav-tabs-item[href*=\"/sdk/\"],\na.mobile-nav-tabs-item[href$=\"/sdk\"],\na.mobile-nav-tabs-item[href*=\"/sdk/\"] {\n  display: none !important;\n}\n\n/* ===== Custom integration sidebar icons =====\n   Mintlify draws its built-in sidebar icons as CSS masks filled with the theme\n   color (gray-400 / gray-500, primary when active), but renders a file-path\n   `icon` as a plain \u003cimg\u003e, which keeps the SVG's own fill in both themes. Hide\n   that image and draw the same SVG as a mask so it matches the other icons. */\n#sidebar-content a[href$=\"/integrations/databricks\"] img,\n#sidebar-content a[href$=\"/integrations/mongodb\"] img,\n#sidebar-content a[href$=\"/integrations/pylon\"] img,\n#sidebar-content a[href$=\"/integrations/linear\"] img {\n  display: none;\n}\n#sidebar-content a[href$=\"/integrations/databricks\"] \u003e div:first-child::before,\n#sidebar-content a[href$=\"/integrations/mongodb\"] \u003e div:first-child::before,\n#sidebar-content a[href$=\"/integrations/pylon\"] \u003e div:first-child::before,\n#sidebar-content a[href$=\"/integrations/linear\"] \u003e div:first-child::before {\n  content: \"\";\n  display: block;\n  width: 1rem;\n  height: 1rem;\n  background-color: #9ca3af;\n}\n#sidebar-content a[href$=\"/integrations/databricks\"] \u003e div:first-child::before {\n  -webkit-mask: url(\"/images/databricks.svg\") center / contain no-repeat;\n  mask: url(\"/images/databricks.svg\") center / contain no-repeat;\n}\n#sidebar-content a[href$=\"/integrations/mongodb\"] \u003e div:first-child::before {\n  -webkit-mask: url(\"/images/mongodb.svg\") center / contain no-repeat;\n  mask: url(\"/images/mongodb.svg\") center / contain no-repeat;\n}\n#sidebar-content a[href$=\"/integrations/pylon\"] \u003e div:first-child::before {\n  -webkit-mask: url(\"/images/pylon.svg\") center / contain no-repeat;\n  mask: url(\"/images/pylon.svg\") center / contain no-repeat;\n}\n#sidebar-content a[href$=\"/integrations/linear\"] \u003e div:first-child::before {\n  -webkit-mask: url(\"/images/linear.svg\") center / contain no-repeat;\n  mask: url(\"/images/linear.svg\") center / contain no-repeat;\n}\n.dark #sidebar-content a[href$=\"/integrations/databricks\"] \u003e div:first-child::before,\n[data-theme=\"dark\"] #sidebar-content a[href$=\"/integrations/databricks\"] \u003e div:first-child::before,\n.dark #sidebar-content a[href$=\"/integrations/mongodb\"] \u003e div:first-child::before,\n[data-theme=\"dark\"] #sidebar-content a[href$=\"/integrations/mongodb\"] \u003e div:first-child::before,\n.dark #sidebar-content a[href$=\"/integrations/pylon\"] \u003e div:first-child::before,\n.dark #sidebar-content a[href$=\"/integrations/linear\"] \u003e div:first-child::before,\n[data-theme=\"dark\"] #sidebar-content a[href$=\"/integrations/pylon\"] \u003e div:first-child::before,\n[data-theme=\"dark\"] #sidebar-content a[href$=\"/integrations/linear\"] \u003e div:first-child::before {\n  background-color: #6b7280;\n}\n#sidebar-content li[data-active] \u003e a[href$=\"/integrations/databricks\"] \u003e div:first-child::before,\n.dark #sidebar-content li[data-active] \u003e a[href$=\"/integrations/databricks\"] \u003e div:first-child::before,\n[data-theme=\"dark\"] #sidebar-content li[data-active] \u003e a[href$=\"/integrations/databricks\"] \u003e div:first-child::before,\n#sidebar-content li[data-active] \u003e a[href$=\"/integrations/mongodb\"] \u003e div:first-child::before,\n.dark #sidebar-content li[data-active] \u003e a[href$=\"/integrations/mongodb\"] \u003e div:first-child::before,\n[data-theme=\"dark\"] #sidebar-content li[data-active] \u003e a[href$=\"/integrations/mongodb\"] \u003e div:first-child::before,\n#sidebar-content li[data-active] \u003e a[href$=\"/integrations/pylon\"] \u003e div:first-child::before,\n#sidebar-content li[data-active] \u003e a[href$=\"/integrations/linear\"] \u003e div:first-child::before,\n.dark #sidebar-content li[data-active] \u003e a[href$=\"/integrations/pylon\"] \u003e div:first-child::before,\n.dark #sidebar-content li[data-active] \u003e a[href$=\"/integrations/linear\"] \u003e div:first-child::before,\n[data-theme=\"dark\"] #sidebar-content li[data-active] \u003e a[href$=\"/integrations/pylon\"] \u003e div:first-child::before,\n[data-theme=\"dark\"] #sidebar-content li[data-active] \u003e a[href$=\"/integrations/linear\"] \u003e div:first-child::before {\n  background-color: #317CFF;\n}\n\n/* Keep the first column visible while scrolling wide tables horizontally */\n.sticky-first-col table th:first-child,\n.sticky-first-col table td:first-child {\n  position: sticky;\n  left: 0;\n  z-index: 1;\n  background: #FCFCFC;\n}\n\n.dark .sticky-first-col table th:first-child,\n.dark .sticky-first-col table td:first-child,\n[data-theme=\"dark\"] .sticky-first-col table th:first-child,\n[data-theme=\"dark\"] .sticky-first-col table td:first-child {\n  background: #141414;\n}\n"])</script><script>self.__next_f.push([1,"48:[\"$\",\"$L61\",null,{\"cssFiles\":[{\"_id\":\"699ca3283a1020f95be8e7fa\",\"subdomain\":\"cognitionai\",\"filePath\":\"custom.css\",\"__v\":0,\"content\":\"$62\"},{\"filePath\":\"dynamic-tailwind.css\",\"content\":\".mint-max-w-full {\\n    max-width: 100%\\n}\"}]}]\n64:Tc07,"])</script><script>self.__next_f.push([1,"/**\n * Checks that all the links in the docs are valid. Handrolled because the Mintlify link checker has too many false positives. Run `npm run check` or `node check_links.js` to run this script.\n *\n * Right now, we only verify that internal links (links that point to other docs pages) are valid.\n *\n * Including \"lint:no-link-check\" or \"lint:no-link-check-next-line\" anywhere in a line will disable link checking for that line or the subsequent line, respetively.\n *\n * We currently don't account for redirects. Our internal links shouldn't need a layer of redirection anyways, and we should instead just update them if we move pages around.\n *\n * Feel free to ping me (Ryan) if this script stops working.\n */\n\nconst fs = require(\"node:fs\");\nconst path = require(\"node:path\");\nconst process = require(\"node:process\");\nconst config = require(\"./docs.json\");\n\nconst DISABLE_LINK_CHECK = \"lint:no-link-check\";\nconst DISABLE_LINK_CHECK_NEXT_LINE = \"lint:no-link-check-next-line\";\n\nfunction extractPages(pages) {\n  const result = [];\n  for (const page of pages) {\n    if (typeof page === 'string') {\n      result.push(page);\n    } else if (page \u0026\u0026 typeof page === 'object' \u0026\u0026 page.pages) {\n      result.push(...extractPages(page.pages));\n    }\n  }\n  return result;\n}\n\nfunction extractGroups(tab) {\n  return tab.groups ?? tab.versions.flatMap((version) =\u003e version.groups);\n}\n\nconst pages = config.navigation.languages.flatMap((lang) =\u003e\n  lang.tabs.flatMap((tab) =\u003e\n    extractGroups(tab).flatMap((group) =\u003e extractPages(group.pages))\n  )\n);\n\nfunction isBadLink(pagePath, link) {\n  const url = new URL(link, `https://docs.devin.ai/${pagePath}`);\n\n  if (link.includes(\"docs.devin.ai\")) {\n    return { error: \"Links shouldn't include docs.devin.ai\" };\n  }\n  if (url.hostname !== \"docs.devin.ai\") {\n    return false;\n  }\n\n  return (\n    !fs.existsSync(path.join(__dirname, url.pathname)) \u0026\u0026\n    !fs.existsSync(path.join(__dirname, url.pathname + \".mdx\"))\n  );\n}\n\nfunction scrapeLinks(pageMdx) {\n  const linkRegex = /\\[([^\\]]+)\\]\\(([^)]+)\\)/g;\n  const links = [];\n  let match;\n\n  const lines = pageMdx.split(\"\\n\");\n  for (let i = 0; i \u003c lines.length; i++) {\n    if (lines[i].includes(DISABLE_LINK_CHECK) || (i \u0026\u0026 lines[i - 1].includes(DISABLE_LINK_CHECK_NEXT_LINE))) {\n      continue;\n    }\n\n    while ((match = linkRegex.exec(lines[i])) !== null) {\n      links.push(match[2]);\n    }\n  }\n\n  return links;\n}\n\nfunction readPage(page) {\n  return fs.readFileSync(path.join(__dirname, page + \".mdx\"), \"utf8\");\n}\n\nlet hasErrors = false;\n\nfor (const page of pages) {\n  const pageMdx = readPage(page);\n  const links = scrapeLinks(pageMdx);\n\n  const badLinks = links.map((link) =\u003e ({link, error: isBadLink(page, link)})).filter(({error}) =\u003e error);\n\n  if (badLinks.length \u003e 0) {\n    console.log(page + \".mdx\");\n    for (const {link, error} of badLinks) {\n      if (Object.hasOwn(error, \"error\")) {\n        console.log(`  ${link}: ${error.error}`);\n      } else {\n        console.log(`  ${link}`);\n      }\n    }\n    console.log();\n    hasErrors = true;\n  }\n}\n\nif (hasErrors) {\n  process.exit(1);\n}\n"])</script><script>self.__next_f.push([1,"65:T9a2,"])</script><script>self.__next_f.push([1,"(function() {\n  var activeCat = 'all';\n  var activeFeatures = [];\n\n  function applyFilters() {\n    var cards = document.querySelectorAll('.gallery-card');\n    if (!cards.length) return;\n    var visible = 0;\n    cards.forEach(function(card) {\n      var cat = (card.getAttribute('data-category') || '').trim().toLowerCase();\n      var feats = card.getAttribute('data-features') || '';\n      var catMatch = activeCat === 'all' || cat === activeCat;\n      var featMatch = activeFeatures.length === 0 || activeFeatures.some(function(f) {\n        return feats.split(',').indexOf(f) !== -1;\n      });\n      if (catMatch \u0026\u0026 featMatch) {\n        card.style.display = '';\n        visible++;\n      } else {\n        card.style.display = 'none';\n      }\n    });\n    var empty = document.getElementById('gallery-empty');\n    if (empty) {\n      empty.style.display = visible === 0 ? 'block' : 'none';\n      empty.classList.toggle('hidden', visible \u003e 0);\n    }\n  }\n\n  function init() {\n    document.addEventListener('click', function(e) {\n      var chip = e.target.closest('.gallery-chip');\n      if (chip) {\n        e.preventDefault();\n        var clickedCat = (chip.getAttribute('data-category') || 'all').trim().toLowerCase();\n        if (clickedCat === activeCat \u0026\u0026 clickedCat !== 'all') {\n          activeCat = 'all';\n          document.querySelectorAll('.gallery-chip').forEach(function(c) {\n            c.classList.remove('active');\n          });\n          var allChip = document.querySelector('.gallery-chip[data-category=\"all\"]');\n          if (allChip) allChip.classList.add('active');\n        } else {\n          activeCat = clickedCat;\n          document.querySelectorAll('.gallery-chip').forEach(function(c) {\n            c.classList.remove('active');\n          });\n          chip.classList.add('active');\n        }\n        applyFilters();\n        return;\n      }\n      var fchip = e.target.closest('.gallery-feature-chip');\n      if (fchip) {\n        e.preventDefault();\n        var feat = fchip.getAttribute('data-feature');\n        var idx = activeFeatures.indexOf(feat);\n        if (idx === -1) {\n          activeFeatures.push(feat);\n          fchip.classList.add('active');\n        } else {\n          activeFeatures.splice(idx, 1);\n          fchip.classList.remove('active');\n        }\n        applyFilters();\n      }\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n\n})();\n"])</script><script>self.__next_f.push([1,"66:T47dd,"])</script><script>self.__next_f.push([1,"/**\n * Generates the Devin Desktop (Windsurf) changelog and releases pages from the\n * public release feeds.\n *\n * It fetches the list of available versions from the updater's `/api/versions`\n * endpoint for each release channel (stable and next) and emits two Mintlify\n * changelog pages (https://www.mintlify.com/docs/create/changelogs) per channel,\n * each with one `\u003cUpdate\u003e` block per version:\n *\n *   - changelog page: release notes (text) plus a collapsible per-OS download\n *     block per version, wrapped in `\u003cAccordion title=\"Download \u003cversion\u003e\"\u003e`.\n *     The newest version additionally gets an open-by-default accordion so it\n *     stands out. When a note exists at\n *     `desktop/releases/\u003cchannel\u003e/\u003cversion\u003e.md` it is imported (relative path)\n *     and rendered; otherwise a placeholder line is used.\n *   - releases page: per-OS download buttons only, rendered by the `\u003cRelease\u003e`\n *     component fed the download URLs from the API manifest.\n *\n * It also emits a changelog page for the Windsurf JetBrains plugin pre-release\n * channel. The JetBrains plugin has no updater API or per-OS downloads, so its\n * versions, dates and notes all come from the changelog index published to the\n * exafunction.github.io CDN (one `release-notes.mdx` per version, carrying the\n * version and release date in its frontmatter).\n *\n * Outputs:\n *   - stable: desktop/changelog.mdx + desktop/releases.mdx\n *   - next:   desktop/changelog-next.mdx + desktop/releases-next.mdx\n *   - jetbrains (next): windsurf/plugins/changelog-next.mdx\n *\n * Usage:\n *   node scripts/generate_desktop_changelog.js\n *   npm run generate-changelog\n *\n * The desktop source endpoints can be overridden with the VERSIONS_API_URL\n * (stable) and VERSIONS_API_URL_NEXT (next) env vars. The JetBrains pre-release\n * source can be overridden with JETBRAINS_NEXT_INDEX_URL, or read from a local\n * checkout of exafunction.github.io via JETBRAINS_NEXT_SOURCE_DIR (pointing at\n * its `public/changelog` directory).\n */\n\nconst fs = require(\"node:fs\");\nconst path = require(\"node:path\");\nconst process = require(\"node:process\");\n\nconst ROOT = path.join(__dirname, \"..\");\nconst DESKTOP_DIR = path.join(ROOT, \"desktop\");\nconst PLUGINS_DIR = path.join(ROOT, \"windsurf\", \"plugins\");\n\n// Import for the \u003cRelease\u003e component. Mintlify only resolves reusable component\n// exports from the top-level /snippets dir (imported by absolute path), so the\n// component lives there rather than alongside the generated pages.\nconst RELEASE_COMPONENT_IMPORT =\n  'import { Release } from \"/snippets/Release.mdx\";';\n\nconst CHANNELS = [\n  {\n    name: \"stable\",\n    apiUrl:\n      process.env.VERSIONS_API_URL ||\n      \"https://windsurf-stable.codeium.com/api/versions\",\n    notesDir: path.join(DESKTOP_DIR, \"releases\", \"stable\"),\n    notesImportBase: \"./releases/stable\",\n    changelogPath: path.join(DESKTOP_DIR, \"changelog.mdx\"),\n    releasesPath: path.join(DESKTOP_DIR, \"releases.mdx\"),\n    changelogTitle: \"Devin Desktop changelog\",\n    changelogSidebarTitle: \"Changelog\",\n    changelogDescription:\n      \"Release notes for every Devin Desktop (Windsurf) stable release: new features, improvements, and fixes in each version of the agent-native editor.\",\n    changelogKeywords: [\n      \"Devin Desktop\",\n      \"Windsurf\",\n      \"changelog\",\n      \"release notes\",\n      \"stable channel\",\n    ],\n    releasesTitle: \"Releases\",\n    releasesDescription:\n      \"Download Devin Desktop (Windsurf) stable releases for macOS, Windows, and Linux, with direct installer links for every published version.\",\n    releasesKeywords: [\n      \"Devin Desktop\",\n      \"Windsurf\",\n      \"download\",\n      \"releases\",\n      \"installer\",\n      \"stable channel\",\n    ],\n  },\n  {\n    name: \"next\",\n    apiUrl:\n      process.env.VERSIONS_API_URL_NEXT ||\n      \"https://windsurf-next.codeium.com/api/versions\",\n    notesDir: path.join(DESKTOP_DIR, \"releases\", \"next\"),\n    notesImportBase: \"./releases/next\",\n    changelogPath: path.join(DESKTOP_DIR, \"changelog-next.mdx\"),\n    releasesPath: path.join(DESKTOP_DIR, \"releases-next.mdx\"),\n    changelogTitle: \"Changelog (Next)\",\n    changelogDescription:\n      \"Release notes for Devin Desktop (Windsurf) Next builds: preview features, improvements, and fixes shipped to the beta channel ahead of stable releases.\",\n    changelogKeywords: [\n      \"Devin Desktop\",\n      \"Windsurf Next\",\n      \"changelog\",\n      \"release notes\",\n      \"beta builds\",\n    ],\n    changelogIntro:\n      \"Download Next builds from the [Releases (Next)](/desktop/releases-next) page.\",\n    releasesTitle: \"Releases (Next)\",\n    releasesDescription:\n      \"Download Devin Desktop (Windsurf) Next builds for macOS, Windows, and Linux: beta releases with early access to upcoming editor features.\",\n    releasesKeywords: [\n      \"Devin Desktop\",\n      \"Windsurf Next\",\n      \"download\",\n      \"beta releases\",\n      \"early access\",\n    ],\n    releasesIntro:\n      \"The Next edition of Devin Desktop is a beta build that includes previews of upcoming features. It gives early access to new features and releases more frequently than the stable build, but also may have bugs.\",\n  },\n];\n\n// Windsurf JetBrains plugin changelogs. Sourced from the CDN changelog indexes\n// (or a local checkout), not the updater API. When JETBRAINS_SOURCE_DIR is set\n// it is used as the `public/changelog` directory for both channels.\nconst JETBRAINS_SOURCE_DIR =\n  process.env.JETBRAINS_SOURCE_DIR ||\n  process.env.JETBRAINS_NEXT_SOURCE_DIR ||\n  null;\n\nconst JETBRAINS_CHANNELS = [\n  {\n    name: \"jetbrains-stable\",\n    indexUrl:\n      process.env.JETBRAINS_INDEX_URL ||\n      \"https://exafunction.github.io/public/changelog/jetbrains/jetbrains_changelogs.json\",\n    sourceDir: JETBRAINS_SOURCE_DIR,\n    notesDir: path.join(PLUGINS_DIR, \"releases\", \"jetbrains-stable\"),\n    notesImportBase: \"./releases/jetbrains-stable\",\n    changelogPath: path.join(PLUGINS_DIR, \"changelog.mdx\"),\n    changelogTitle: \"Changelog\",\n    changelogDescription:\n      \"Release notes for the Windsurf JetBrains plugin.\",\n  },\n  {\n    name: \"jetbrains-next\",\n    indexUrl:\n      process.env.JETBRAINS_NEXT_INDEX_URL ||\n      \"https://exafunction.github.io/public/changelog/jetbrains-prerelease/jetbrains-prerelease_changelogs.json\",\n    sourceDir: JETBRAINS_SOURCE_DIR,\n    notesDir: path.join(PLUGINS_DIR, \"releases\", \"jetbrains-next\"),\n    notesImportBase: \"./releases/jetbrains-next\",\n    changelogPath: path.join(PLUGINS_DIR, \"changelog-next.mdx\"),\n    changelogTitle: \"Changelog (Pre-release)\",\n    changelogDescription:\n      \"Preview release notes for the Windsurf JetBrains plugin, including Cascade updates, bug fixes, and improvements for upcoming builds.\",\n    changelogKeywords: [\n      \"Windsurf JetBrains plugin\",\n      \"Cascade\",\n      \"pre-release notes\",\n    ],\n  },\n];\n\nfunction frontmatter(\n  title,\n  description,\n  icon,\n  { rss = false, sidebarTitle = null, keywords = null } = {}\n) {\n  const sidebarTitleLine = sidebarTitle ? `sidebarTitle: \"${sidebarTitle}\"\\n` : \"\";\n  const keywordsLine = keywords\n    ? `keywords: [${keywords.map((keyword) =\u003e JSON.stringify(keyword)).join(\", \")}]\\n`\n    : \"\";\n  const rssLine = rss ? \"rss: true\\n\" : \"\";\n  return `---\ntitle: \"${title}\"\n${sidebarTitleLine}description: \"${description}\"\n${keywordsLine}icon: \"${icon}\"\npublic: true\n${rssLine}---\n`;\n}\n\n// Next versions look like \"2.3.1015+next.c46c49e94b\"; strip the channel suffix\n// to get the displayable, sortable version (e.g. \"2.3.1015\").\nfunction cleanVersion(version) {\n  return version.split(/-next|\\+next/)[0];\n}\n\n// Converts an API platform key (e.g. \"darwin-arm64-dmg\") into the camelCase prop\n// name passed to \u003cRelease\u003e (e.g. \"darwinArm64Dmg\").\nfunction platformProp(platformKey) {\n  return platformKey.replace(/-([a-z0-9])/g, (_, char) =\u003e char.toUpperCase());\n}\n\n// Builds the per-OS download attributes (e.g. ` darwinArm64=\"https://...\"`) for a\n// version from its manifest, one per platform that exposes a download URL.\nfunction renderDownloadAttributes(manifest) {\n  return Object.entries(manifest || {})\n    .filter(([, entry]) =\u003e entry \u0026\u0026 typeof entry.url === \"string\")\n    .map(([platformKey, entry]) =\u003e `${platformProp(platformKey)}=\"${entry.url}\"`)\n    .map((attribute) =\u003e ` ${attribute}`)\n    .join(\"\");\n}\n\n/**\n * Picks a representative release date for a version from its per-platform\n * manifests. Each platform entry carries a millisecond epoch `timestamp`; we\n * use the most recent one as the version's release date.\n */\nfunction releaseDateFor(manifest) {\n  const timestamps = Object.values(manifest || {})\n    .map((entry) =\u003e entry \u0026\u0026 entry.timestamp)\n    .filter((ts) =\u003e typeof ts === \"number\" \u0026\u0026 ts \u003e 0);\n\n  if (timestamps.length === 0) {\n    return null;\n  }\n\n  return new Date(Math.max(...timestamps));\n}\n\nfunction formatDate(date) {\n  return date.toLocaleDateString(\"en-US\", {\n    year: \"numeric\",\n    month: \"long\",\n    day: \"numeric\",\n    timeZone: \"UTC\",\n  });\n}\n\nfunction updateOpen(version, manifest) {\n  const date = releaseDateFor(manifest);\n  const description = date ? ` description=\"${formatDate(date)}\"` : \"\";\n  return `\u003cUpdate label=\"v${version}\"${description}\u003e`;\n}\n\n// A version such as \"2.3.15\" maps to a valid MDX/JS component identifier like\n// \"Release_2_3_15\". Returns null when no release note exists for the version.\nfunction snippetComponentName(channel, version) {\n  if (!fs.existsSync(path.join(channel.notesDir, `${version}.md`))) {\n    return null;\n  }\n  return `Release_${version.replace(/[^a-zA-Z0-9]+/g, \"_\")}`;\n}\n\n// Changelog entry: release note text plus a collapsible per-OS download block.\n// The newest release (isLatest) gets an open-by-default accordion so it stands\n// out from the rest of the history.\nfunction renderChangelogUpdate(channel, version, manifest, isLatest) {\n  const componentName = snippetComponentName(channel, version);\n  const note = componentName ? `\u003c${componentName} /\u003e` : \"A release was made.\";\n  const lines = [updateOpen(version, manifest), note];\n  const downloads = renderDownloadAttributes(manifest);\n  if (downloads) {\n    const accordionOpen = isLatest ? \" defaultOpen\" : \"\";\n    lines.push(\n      `\u003cAccordion title=\"Download ${version}\"${accordionOpen}\u003e`,\n      `\u003cRelease${downloads} /\u003e`,\n      `\u003c/Accordion\u003e`\n    );\n  }\n  lines.push(`\u003c/Update\u003e`);\n  return lines.join(\"\\n\");\n}\n\n// Releases entry: per-OS download buttons only.\nfunction renderReleaseUpdate(version, manifest) {\n  const downloads = renderDownloadAttributes(manifest);\n  return [\n    updateOpen(version, manifest),\n    `\u003cRelease${downloads} /\u003e`,\n    `\u003c/Update\u003e`,\n  ].join(\"\\n\");\n}\n\n// Compares two dotted numeric versions (e.g. \"2.3.15\" vs \"1.9600.41\") so they\n// can be sorted newest-first. Each segment is compared numerically; shorter\n// versions sort before longer ones when otherwise equal.\nfunction compareVersionsDesc(a, b) {\n  const segmentsA = a.split(\".\").map(Number);\n  const segmentsB = b.split(\".\").map(Number);\n  const length = Math.max(segmentsA.length, segmentsB.length);\n  for (let i = 0; i \u003c length; i++) {\n    const diff = (segmentsB[i] || 0) - (segmentsA[i] || 0);\n    if (diff !== 0) {\n      return diff;\n    }\n  }\n  return 0;\n}\n\nfunction renderImport(channel, version) {\n  const componentName = snippetComponentName(channel, version);\n  if (!componentName) {\n    return null;\n  }\n  return `import ${componentName} from \"${channel.notesImportBase}/${version}.md\";`;\n}\n\nasync function fetchVersions(apiUrl) {\n  const res = await fetch(apiUrl);\n  if (!res.ok) {\n    throw new Error(`Failed to fetch ${apiUrl}: ${res.status} ${res.statusText}`);\n  }\n  const versions = await res.json();\n  if (!Array.isArray(versions)) {\n    throw new Error(\n      `Unexpected response from ${apiUrl}: expected an array of versions`\n    );\n  }\n  return versions;\n}\n\nasync function generateChannel(channel) {\n  const versions = await fetchVersions(channel.apiUrl);\n\n  // Collapse to one entry per displayable version (newest build wins), then sort\n  // newest-first by numeric semver.\n  const byVersion = new Map();\n  for (const entry of versions) {\n    const version = cleanVersion(entry.version);\n    if (!byVersion.has(version)) {\n      byVersion.set(version, { version, manifest: entry.manifest });\n    }\n  }\n  const entries = [...byVersion.values()].sort((a, b) =\u003e\n    compareVersionsDesc(a.version, b.version)\n  );\n\n  const noteImports = entries\n    .map((entry) =\u003e renderImport(channel, entry.version))\n    .filter(Boolean);\n\n  const changelogUpdates = entries.map((entry, index) =\u003e\n    renderChangelogUpdate(channel, entry.version, entry.manifest, index === 0)\n  );\n  const releaseUpdates = entries.map((entry) =\u003e\n    renderReleaseUpdate(entry.version, entry.manifest)\n  );\n\n  const changelogIntro = channel.changelogIntro\n    ? `${channel.changelogIntro}\\n\\n`\n    : \"\";\n  const releasesIntro = channel.releasesIntro\n    ? `${channel.releasesIntro}\\n\\n`\n    : \"\";\n\n  const changelogBody = `${frontmatter(\n    channel.changelogTitle,\n    channel.changelogDescription,\n    \"clock-rotate-left\",\n    {\n      rss: true,\n      sidebarTitle: channel.changelogSidebarTitle,\n      keywords: channel.changelogKeywords,\n    }\n  )}\\n${RELEASE_COMPONENT_IMPORT}\\n${noteImports.join(\"\\n\")}\\n\\n${changelogIntro}${changelogUpdates.join(\n    \"\\n\\n\"\n  )}\\n`;\n\n  const releasesBody = `${frontmatter(\n    channel.releasesTitle,\n    channel.releasesDescription,\n    \"download\",\n    { keywords: channel.releasesKeywords }\n  )}\\n${RELEASE_COMPONENT_IMPORT}\\n\\n${releasesIntro}${releaseUpdates.join(\"\\n\\n\")}\\n`;\n\n  fs.writeFileSync(channel.changelogPath, changelogBody, \"utf8\");\n  fs.writeFileSync(channel.releasesPath, releasesBody, \"utf8\");\n\n  console.log(\n    `[${channel.name}] wrote ${entries.length} releases to ${path.relative(\n      ROOT,\n      channel.changelogPath\n    )} and ${path.relative(ROOT, channel.releasesPath)}`\n  );\n}\n\n// Minimal YAML frontmatter parser for the changelog notes (keys are simple\n// `key: \"value\"` / `key: 'value'` pairs). Returns the parsed fields and the\n// remaining markdown body.\nfunction parseFrontmatter(source) {\n  const match = source.match(/^---\\n([\\s\\S]*?)\\n---\\n?/);\n  if (!match) {\n    return { data: {}, body: source };\n  }\n  const data = {};\n  for (const line of match[1].split(\"\\n\")) {\n    const pair = line.match(/^([A-Za-z0-9_]+):\\s*(.*)$/);\n    if (pair) {\n      data[pair[1]] = pair[2].trim().replace(/^['\"]|['\"]$/g, \"\");\n    }\n  }\n  return { data, body: source.slice(match[0].length) };\n}\n\n// Resolves a CDN note URL to either its local checkout path (when sourceDir is\n// set) or returns the URL to be fetched.\nasync function readNoteSource(channel, noteUrl) {\n  if (channel.sourceDir) {\n    const relative = noteUrl.split(\"/public/changelog/\")[1];\n    return fs.readFileSync(path.join(channel.sourceDir, relative), \"utf8\");\n  }\n  const res = await fetch(noteUrl);\n  if (!res.ok) {\n    throw new Error(`Failed to fetch ${noteUrl}: ${res.status} ${res.statusText}`);\n  }\n  return res.text();\n}\n\nasync function readJetbrainsIndex(channel) {\n  if (channel.sourceDir) {\n    const relative = channel.indexUrl.split(\"/public/changelog/\")[1];\n    return JSON.parse(\n      fs.readFileSync(path.join(channel.sourceDir, relative), \"utf8\")\n    );\n  }\n  const res = await fetch(channel.indexUrl);\n  if (!res.ok) {\n    throw new Error(\n      `Failed to fetch ${channel.indexUrl}: ${res.status} ${res.statusText}`\n    );\n  }\n  return res.json();\n}\n\n// Derives a version from a note URL when its frontmatter omits one. Handles\n// both layouts in the indexes: `.../\u003cversion\u003e/release-notes.mdx` and the older\n// flat `.../\u003cversion\u003e.mdx`.\nfunction versionFromNoteUrl(noteUrl) {\n  const last = noteUrl.split(\"/\").pop();\n  if (last === \"release-notes.mdx\") {\n    return noteUrl.split(\"/\").slice(-2)[0];\n  }\n  return last.replace(/\\.mdx$/, \"\");\n}\n\n// Generates a JetBrains plugin changelog page. Unlike the desktop channels, the\n// version, release date and notes all come from each version's release-notes\n// frontmatter + body; the stripped body is written next to the page and\n// imported per `\u003cUpdate\u003e` block.\nasync function generateJetbrains(channel) {\n  const noteUrls = await readJetbrainsIndex(channel);\n  if (!Array.isArray(noteUrls)) {\n    throw new Error(`Unexpected JetBrains index: expected an array of note URLs`);\n  }\n\n  const byVersion = new Map();\n  for (const noteUrl of noteUrls) {\n    const source = await readNoteSource(channel, noteUrl);\n    const { data, body } = parseFrontmatter(source);\n    const version = data.version || versionFromNoteUrl(noteUrl);\n    byVersion.set(version, { version, releaseDate: data.releaseDate, body });\n  }\n\n  const entries = [...byVersion.values()].sort((a, b) =\u003e\n    compareVersionsDesc(a.version, b.version)\n  );\n\n  // Recreate the notes dir so removed versions don't linger.\n  fs.rmSync(channel.notesDir, { recursive: true, force: true });\n  fs.mkdirSync(channel.notesDir, { recursive: true });\n\n  const imports = [];\n  const updates = [];\n  for (const entry of entries) {\n    const componentName = `Release_${entry.version.replace(/[^a-zA-Z0-9]+/g, \"_\")}`;\n    fs.writeFileSync(\n      path.join(channel.notesDir, `${entry.version}.md`),\n      `${entry.body.trim()}\\n`,\n      \"utf8\"\n    );\n    imports.push(\n      `import ${componentName} from \"${channel.notesImportBase}/${entry.version}.md\";`\n    );\n    const date = entry.releaseDate ? new Date(entry.releaseDate) : null;\n    const description =\n      date \u0026\u0026 !Number.isNaN(date.getTime())\n        ? ` description=\"${formatDate(date)}\"`\n        : \"\";\n    updates.push(\n      [\n        `\u003cUpdate label=\"v${entry.version}\"${description}\u003e`,\n        `\u003c${componentName} /\u003e`,\n        `\u003c/Update\u003e`,\n      ].join(\"\\n\")\n    );\n  }\n\n  const body = `${frontmatter(\n    channel.changelogTitle,\n    channel.changelogDescription,\n    \"clock-rotate-left\",\n    { keywords: channel.changelogKeywords }\n  )}\\n${imports.join(\"\\n\")}\\n\\n${updates.join(\"\\n\\n\")}\\n`;\n\n  fs.mkdirSync(path.dirname(channel.changelogPath), { recursive: true });\n  fs.writeFileSync(channel.changelogPath, body, \"utf8\");\n\n  console.log(\n    `[${channel.name}] wrote ${entries.length} releases to ${path.relative(\n      ROOT,\n      channel.changelogPath\n    )}`\n  );\n}\n\nasync function main() {\n  for (const channel of CHANNELS) {\n    await generateChannel(channel);\n  }\n  for (const channel of JETBRAINS_CHANNELS) {\n    await generateJetbrains(channel);\n  }\n}\n\nmain().catch((err) =\u003e {\n  console.error(err);\n  process.exit(1);\n});\n"])</script><script>self.__next_f.push([1,"67:T1e07,"])</script><script>self.__next_f.push([1,"/**\n * Checks SEO frontmatter on changed English docs pages.\n *\n * The repository contains historical pages that predate these requirements,\n * so only files added or modified relative to the PR base fail the check.\n * Run `npm run check-seo` to run this script.\n */\n\nconst fs = require(\"node:fs\");\nconst path = require(\"node:path\");\nconst process = require(\"node:process\");\nconst childProcess = require(\"node:child_process\");\n\nconst ROOT = __dirname;\nconst LOCALE_DIRS = new Set([\"ja\", \"zh\", \"es\", \"fr\", \"de\", \"it\", \"pt-BR\"]);\n\nfunction isExcluded(relativePath) {\n  const parts = relativePath.split(path.sep);\n  return (\n    LOCALE_DIRS.has(parts[0]) ||\n    parts.includes(\"snippets\") ||\n    parts.includes(\"api-reference\") ||\n    parts.includes(\"node_modules\")\n  );\n}\n\nfunction collectMdxFiles(directory = ROOT) {\n  const files = [];\n  for (const entry of fs.readdirSync(directory, {withFileTypes: true})) {\n    const absolutePath = path.join(directory, entry.name);\n    const relativePath = path.relative(ROOT, absolutePath);\n    if (entry.isDirectory()) {\n      if (!isExcluded(relativePath) \u0026\u0026 !entry.name.startsWith(\".\")) {\n        files.push(...collectMdxFiles(absolutePath));\n      }\n    } else if (entry.isFile() \u0026\u0026 entry.name.endsWith(\".mdx\") \u0026\u0026 !isExcluded(relativePath)) {\n      files.push(relativePath);\n    }\n  }\n  return files;\n}\n\nfunction parseFrontmatter(relativePath) {\n  const content = fs.readFileSync(path.join(ROOT, relativePath), \"utf8\");\n  const match = content.match(/^---\\s*\\n([\\s\\S]*?)\\n---\\s*(?:\\n|$)/);\n  const fields = {};\n  if (!match) return fields;\n\n  const lines = match[1].split(\"\\n\");\n  for (let index = 0; index \u003c lines.length; index++) {\n    const line = lines[index];\n    const field = line.match(/^([A-Za-z][\\w-]*):\\s*(.*?)\\s*$/);\n    if (!field) continue;\n\n    if (field[1] === \"keywords\" \u0026\u0026 !field[2]) {\n      const block = [];\n      let next = index + 1;\n      while (next \u003c lines.length \u0026\u0026 (!lines[next].trim() || /^\\s+/.test(lines[next]))) {\n        block.push(lines[next]);\n        next++;\n      }\n      fields.keywords = block.join(\"\\n\");\n      index = next - 1;\n    } else {\n      fields[field[1]] = field[2];\n    }\n  }\n  return fields;\n}\n\nfunction unquote(value) {\n  if (!value) return \"\";\n  if ((value.startsWith('\"') \u0026\u0026 value.endsWith('\"')) ||\n      (value.startsWith(\"'\") \u0026\u0026 value.endsWith(\"'\"))) {\n    return value.slice(1, -1);\n  }\n  return value;\n}\n\nfunction parsePage(relativePath) {\n  const fields = parseFrontmatter(relativePath);\n  const title = unquote(fields.title);\n  const description = unquote(fields.description);\n  const keywords = fields.keywords?.trim();\n  const hasInlineKeywords = Boolean(keywords \u0026\u0026 keywords.startsWith(\"[\") \u0026\u0026 keywords.endsWith(\"]\"));\n  const hasBlockKeywords = Boolean(keywords \u0026\u0026 keywords.split(\"\\n\").some((line) =\u003e /^\\s*-\\s+\\S/.test(line)));\n  return {\n    path: relativePath,\n    title,\n    description,\n    hasKeywords: hasInlineKeywords || hasBlockKeywords,\n  };\n}\n\nfunction gitRefExists(ref) {\n  try {\n    childProcess.execFileSync(\"git\", [\"rev-parse\", \"--verify\", `${ref}^{commit}`], {\n      cwd: ROOT,\n      stdio: \"ignore\",\n    });\n    return true;\n  } catch {\n    return false;\n  }\n}\n\nfunction getBaseRef() {\n  const isPullRequest = Boolean(process.env.GITHUB_BASE_REF);\n  const requested = process.env.SEO_BASE_REF ||\n    (isPullRequest ? `origin/${process.env.GITHUB_BASE_REF}` : \"\");\n  if (!requested) return null;\n  if (gitRefExists(requested)) return requested;\n  if (isPullRequest) {\n    console.error(`Unable to resolve pull request base ref: ${requested}`);\n    process.exit(1);\n  }\n  return null;\n}\n\nfunction changedPages(ref) {\n  if (!ref) return new Set();\n  try {\n    const committed = childProcess.execFileSync(\n      \"git\",\n      [\"diff\", \"--name-only\", \"--diff-filter=AMRT\", `${ref}...HEAD`, \"--\", \"*.mdx\"],\n      {cwd: ROOT, encoding: \"utf8\"},\n    );\n    const workingTree = childProcess.execFileSync(\n      \"git\",\n      [\"diff\", \"--name-only\", \"--diff-filter=AMRT\", \"--\", \"*.mdx\"],\n      {cwd: ROOT, encoding: \"utf8\"},\n    );\n    const staged = childProcess.execFileSync(\n      \"git\",\n      [\"diff\", \"--cached\", \"--name-only\", \"--diff-filter=AMRT\", \"--\", \"*.mdx\"],\n      {cwd: ROOT, encoding: \"utf8\"},\n    );\n    const untracked = childProcess.execFileSync(\n      \"git\",\n      [\"ls-files\", \"--others\", \"--exclude-standard\", \"--\", \"*.mdx\"],\n      {cwd: ROOT, encoding: \"utf8\"},\n    );\n    return new Set(\n      `${committed}\\n${workingTree}\\n${staged}\\n${untracked}`\n        .trim()\n        .split(\"\\n\")\n        .filter(Boolean)\n        .filter((file) =\u003e file.endsWith(\".mdx\") \u0026\u0026 !isExcluded(file)),\n    );\n  } catch {\n    return new Set();\n  }\n}\n\nfunction violations(page, allPagesByTitle) {\n  const result = [];\n  if (!page.title) result.push(\"missing title\");\n  if (!page.description) {\n    result.push(\"missing description\");\n  } else if (page.description.length \u003c 90 || page.description.length \u003e 160) {\n    result.push(`description length ${page.description.length} (expected 90–160)`);\n  }\n  if (page.title \u0026\u0026 `${page.title} - Devin Docs`.length \u003e 60) {\n    result.push(`rendered title length ${`${page.title} - Devin Docs`.length} (maximum 60)`);\n  }\n  if (!page.hasKeywords) result.push(\"missing keywords array\");\n  if (page.title \u0026\u0026 allPagesByTitle.get(page.title)?.length \u003e 1) {\n    result.push(\"duplicate title\");\n  }\n  return result;\n}\n\nconst files = collectMdxFiles().sort();\nconst pages = files.map(parsePage);\nconst pagesByTitle = new Map();\nfor (const page of pages) {\n  if (!page.title) continue;\n  const matches = pagesByTitle.get(page.title) || [];\n  matches.push(page.path);\n  pagesByTitle.set(page.title, matches);\n}\n\nconst repositoryViolations = new Map();\nfor (const page of pages) {\n  const issues = violations(page, pagesByTitle);\n  if (issues.length) repositoryViolations.set(page.path, issues);\n}\n\nconst counts = {\n  \"missing description\": 0,\n  \"description out of range\": 0,\n  \"rendered title over 60\": 0,\n  \"missing keywords\": 0,\n  \"duplicate title\": 0,\n};\nfor (const issues of repositoryViolations.values()) {\n  for (const issue of issues) {\n    if (issue === \"missing description\") counts[\"missing description\"]++;\n    else if (issue.startsWith(\"description length\")) counts[\"description out of range\"]++;\n    else if (issue.startsWith(\"rendered title length\")) counts[\"rendered title over 60\"]++;\n    else if (issue === \"missing keywords array\") counts[\"missing keywords\"]++;\n    else if (issue === \"duplicate title\") counts[\"duplicate title\"]++;\n  }\n}\n\nconsole.log(`Checked ${pages.length} English MDX pages.`);\nconsole.log(\n  `Repository-wide informational violations: ${repositoryViolations.size} pages ` +\n  `(missing description: ${counts[\"missing description\"]}, ` +\n  `description out of range: ${counts[\"description out of range\"]}, ` +\n  `rendered title over 60: ${counts[\"rendered title over 60\"]}, ` +\n  `missing keywords: ${counts[\"missing keywords\"]}, ` +\n  `duplicate title: ${counts[\"duplicate title\"]}).`,\n);\n\nconst ref = getBaseRef();\nif (!ref) {\n  console.log(\"No base ref available; changed-file enforcement skipped.\");\n  process.exit(0);\n}\n\nconst changed = changedPages(ref);\nconsole.log(`Base ref: ${ref}`);\nconsole.log(`Changed English MDX files checked: ${changed.size}`);\n\nlet hasErrors = false;\nfor (const relativePath of [...changed].sort()) {\n  const page = pages.find((candidate) =\u003e candidate.path === relativePath);\n  if (!page) continue;\n  const issues = violations(page, pagesByTitle);\n  if (!issues.length) continue;\n  hasErrors = true;\n  console.log(relativePath);\n  for (const issue of issues) console.log(`  ${issue}`);\n}\n\nif (hasErrors) process.exit(1);\nconsole.log(\"Changed-file SEO check passed.\");\n"])</script><script>self.__next_f.push([1,"68:T5bc,"])</script><script>self.__next_f.push([1,"// Mintlify's RSS feed slugs \u003cUpdate\u003e labels to ASCII (e.g. \"2026年10月14日\" -\u003e \"2026-10-14\"),\n// but the page keeps the raw label as the anchor id. Remap the RSS hash to the real id.\n(() =\u003e {\n  const RELEASE_NOTES_PATH = /^(\\/[a-z]{2}(-[A-Z]{2})?)?\\/release-notes(\\/|$)/;\n  const toRssSlug = (value) =\u003e\n    value\n      .toLowerCase()\n      .replace(/[^a-z0-9]+/g, \"-\")\n      .replace(/^-+|-+$/g, \"\");\n\n  const findTarget = (hash) =\u003e {\n    if (document.getElementById(hash)) return null;\n    const matches = [...document.querySelectorAll(\"[id]\")].filter(\n      (el) =\u003e toRssSlug(el.id) === hash\n    );\n    return matches.length === 1 ? matches[0] : null;\n  };\n\n  const resolve = () =\u003e {\n    if (!RELEASE_NOTES_PATH.test(window.location.pathname)) return true;\n    let hash;\n    try {\n      hash = decodeURIComponent(window.location.hash.slice(1));\n    } catch {\n      return true;\n    }\n    if (!hash || document.getElementById(hash)) return true;\n    const target = findTarget(hash);\n    if (!target) return false;\n    history.replaceState(history.state, \"\", `#${encodeURIComponent(target.id)}`);\n    target.scrollIntoView();\n    return true;\n  };\n\n  const resolveWithRetry = () =\u003e {\n    [0, 100, 500, 1500, 3000].forEach((delay) =\u003e\n      setTimeout(() =\u003e requestAnimationFrame(resolve), delay)\n    );\n  };\n\n  resolveWithRetry();\n  window.addEventListener(\"hashchange\", resolveWithRetry);\n  window.addEventListener(\"load\", resolveWithRetry, { once: true });\n})();\n"])</script><script>self.__next_f.push([1,"49:[\"$\",\"$L63\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"6801447d257941041d1c61d8\",\"filePath\":\"check_links.js\",\"subdomain\":\"cognitionai\",\"__v\":0,\"content\":\"$64\"},{\"_id\":\"699ca3283a1020f95be8e819\",\"subdomain\":\"cognitionai\",\"filePath\":\"gallery-filters.js\",\"__v\":0,\"content\":\"$65\"},{\"_id\":\"6a1f15238ed5dd7dc6ef7ddc\",\"subdomain\":\"cognitionai\",\"filePath\":\"scripts/generate_desktop_changelog.js\",\"__v\":0,\"content\":\"$66\"},{\"_id\":\"6a3e9863436d2197be1727ab\",\"filePath\":\"anchor-scroll-fix.js\",\"subdomain\":\"cognitionai\",\"__v\":0,\"content\":\"(() =\u003e {\\n  const PATH = \\\"/onboard-devin/environment/blueprint-reference\\\";\\n  const HASH = \\\"#cross-step-environment-variables-%24envrc\\\";\\n  const TARGET_ID = \\\"cross-step-environment-variables-$envrc\\\";\\n\\n  if (window.location.pathname !== PATH) return;\\n\\n  const scrollToTarget = () =\u003e {\\n    const target = document.getElementById(TARGET_ID);\\n    if (!target) return;\\n    target.scrollIntoView();\\n  };\\n\\n  const restoreAnchor = () =\u003e {\\n    if (window.location.hash !== HASH) return;\\n\\n    requestAnimationFrame(scrollToTarget);\\n    setTimeout(scrollToTarget, 100);\\n    setTimeout(scrollToTarget, 500);\\n  };\\n\\n  restoreAnchor();\\n  window.addEventListener(\\\"hashchange\\\", restoreAnchor);\\n  window.addEventListener(\\\"load\\\", restoreAnchor, { once: true });\\n})();\\n\"},{\"_id\":\"6a7b7cd0f5b36d40d303056a\",\"filePath\":\"check_seo.js\",\"subdomain\":\"cognitionai\",\"__v\":0,\"content\":\"$67\"},{\"_id\":\"6adab89bd241dc79151ca0e3\",\"subdomain\":\"cognitionai\",\"filePath\":\"release-notes-anchor-fix.js\",\"__v\":0,\"content\":\"$68\"}]}]\n"])</script><script>self.__next_f.push([1,"6b:T30e8,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,ol:`ol`,p:`p`,pre:`pre`,span:`span`,strong:`strong`,ul:`ul`,..._provideComponents(),...props.components},{Card,CardGroup,CodeBlock,Frame,Heading,Note,OptimizedFrame,OptimizedImage,Tip}=_components;if(!Card)_missingMdxReference(`Card`,true);if(!CardGroup)_missingMdxReference(`CardGroup`,true);if(!CodeBlock)_missingMdxReference(`CodeBlock`,true);if(!Frame)_missingMdxReference(`Frame`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!Note)_missingMdxReference(`Note`,true);if(!OptimizedFrame)_missingMdxReference(`OptimizedFrame`,true);if(!OptimizedImage)_missingMdxReference(`OptimizedImage`,true);if(!Tip)_missingMdxReference(`Tip`,true);return _jsxs(_Fragment,{children:[_jsx(Frame,{caption:`Devin 快速导览`,children:_jsx(`video`,{controls:true,width:`100%`,playsInline:true,children:_jsx(`source`,{src:`https://mintcdn.com/cognitionai/iH03e_G1Q4XPL5Ez/images/get-started/devin-docs-new-intro.mp4?fit=max\u0026auto=format\u0026n=iH03e_G1Q4XPL5Ez\u0026q=85\u0026s=5d6a80bf423c79699ac737faa89d9942`,type:`video/mp4`,\"data-path\":`images/get-started/devin-docs-new-intro.mp4`})})}),`\n`,_jsx(_components.p,{children:`Devin 是一名自主工作的 AI 软件工程师，能够编写、运行和测试代码。Devin 可以处理大多数任务 (极其困难的任务除外) 。一个经验法则是：如果你能在三小时内完成某件事情，Devin 大概率也能完成。可以让 Devin 处理 Linear/Jira 工单，实现全新的功能，复现并修复 bug，构建内部工具等！`}),`\n`,_jsx(Tip,{children:_jsxs(_components.p,{children:[`在我们的`,_jsx(_components.a,{href:`/zh/release-notes/overview`,children:`发布说明`}),`中了解 Devin 的最新动态！`]})}),`\n`,_jsx(Note,{children:_jsx(_components.p,{children:`在某些情况下，Devin 的实际表现可能与本文所述并不完全一致，或者文档内容可能已过时。`})}),`\n`,_jsx(Heading,{level:`2`,id:`already-signed-up-get-started-now`,children:`已注册？立即开始：`}),`\n`,_jsx(Tip,{children:_jsx(_components.p,{children:_jsx(_components.a,{href:`/zh/use-cases/gallery/index`,children:`浏览使用场景`})})}),`\n`,_jsx(Heading,{level:`2`,id:`what-are-devins-strengths`,children:`Devin 的优势是什么？`}),`\n`,_jsx(_components.p,{children:`以下是 Devin 擅长处理的任务类型：`}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`并行处理大量任务，在它们进入你的 待办列表 之前完成`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Linear / Jira 工单`}),`\n`,_jsx(_components.li,{children:`从零开始实现完整功能`}),`\n`,_jsx(_components.li,{children:`Bug 报告`}),`\n`,_jsx(_components.li,{children:`应用测试`}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`代码迁移、重构和现代化改造`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`语言迁移 (例如：JavaScript 到 TypeScript)`}),`\n`,_jsx(_components.li,{children:`框架升级 (例如：Angular 16 -\u003e 18)`}),`\n`,_jsx(_components.li,{children:`从 monorepo 转换为 submodule`}),`\n`,_jsx(_components.li,{children:`移除未使用的 feature flag`}),`\n`,_jsx(_components.li,{children:`将通用代码抽取为公共库`}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`常见且重复的工程任务`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`PR Review`}),`\n`,_jsx(_components.li,{children:`代码库问答`}),`\n`,_jsx(_components.li,{children:`复现并修复 bug`}),`\n`,_jsx(_components.li,{children:`编写单元测试`}),`\n`,_jsx(_components.li,{children:`维护文档`}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`客户工程支持`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`构建新集成并对接不熟悉的 API`}),`\n`,_jsx(_components.li,{children:`创建自定义演示`}),`\n`,_jsx(_components.li,{children:`方案原型设计 / 快速原型开发`}),`\n`,_jsx(_components.li,{children:`构建内部工具`}),`\n`]}),`\n`]}),`\n`]}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`要从 Devin 获得最佳效果：`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`编写清晰的提示，并明确完成标准——任务越清晰，成功率越高，尤其是对复杂工作。`}),`\n`,_jsx(_components.li,{children:`让任务易于验证——例如检查 CI 是否通过，或测试一次自动部署。`}),`\n`,_jsx(_components.li,{children:`对于更难的任务，将其拆分为边界清晰的步骤，并提供相关上下文或示例。`}),`\n`,_jsxs(_components.li,{children:[`遵循我们的`,_jsx(_components.a,{href:`/zh/essential-guidelines/when-to-use-devin`,children:`最佳实践和任务前检查清单`}),`。`]}),`\n`]}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`最有效的工作流程通常包括：`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`在你和同事在 `,_jsx(_components.a,{href:`/zh/integrations/slack`,children:`Slack`}),` 或 `,_jsx(_components.a,{href:`/zh/integrations/microsoft-teams`,children:`Teams`}),` 讨论某个 bug 的会话线程中 @Devin`]}),`\n`,_jsx(_components.li,{children:`通过 Web 应用程序委派一个更复杂的任务，并在 Devin 的 IDE 给出不错的初稿后接手`}),`\n`,_jsxs(_components.li,{children:[`在本地环境中运行 `,_jsx(_components.a,{href:`https://cli.devin.ai`,children:`终端版 Devin`}),`，直接在命令行中进行快速修复、代码探索和交互式编码——然后使用 `,_jsx(_components.a,{href:`/zh/cli/handoff`,children:_jsx(_components.code,{children:`/handoff`})}),` 将耗时更长的任务交给云端 Devin。`]}),`\n`,_jsx(_components.li,{children:`在一天开始时从待办清单中拆分出适合的任务交给 Devin，之后再回来查看等待你审核的草稿 PR`}),`\n`]}),`\n`,_jsx(_components.p,{children:`当你把 Devin 融入团队和现有工作流程时，它的效果最佳。`}),`\n`,_jsx(Frame,{caption:`Slack 中的 Devin`,children:_jsx(OptimizedImage,{src:`https://mintcdn.com/cognitionai/a0js040y87FuBerW/images/SlackGIF.gif?s=f1120b81fda6946dfdb28734362212e3`,style:{width:`100%`,height:`auto`},\"data-og-width\":`852`,width:`852`,\"data-og-height\":`480`,height:`480`,\"data-path\":`images/SlackGIF.gif`,\"data-optimize\":`true`,\"data-opv\":`3`})}),`\n`,_jsx(`div`,{id:`general-product-features`,children:_jsx(Heading,{level:`2`,id:`general-product-features`,children:`产品通用功能`})}),`\n`,_jsx(Heading,{level:`3`,id:`the-devin-interface`,children:`Devin 界面`}),`\n`,_jsxs(_components.p,{children:[`Devin 被设计为一个对话式用户界面，你可以在内嵌的 IDE 中实时查看并接管 Devin 的开发过程。Devin 也可以通过 `,_jsx(_components.a,{href:`/zh/api-reference/overview`,children:`Devin API`}),` 使用。`]}),`\n`,_jsxs(_components.p,{children:[`在 Devin 的 Workspace 中，你会看到 Devin 为你完成任务时使用的`,_jsx(_components.a,{href:`/zh/work-with-devin/devin-session-tools`,children:`开发者工具`}),`。`]}),`\n`,_jsxs(CardGroup,{cols:3,children:[_jsx(Card,{title:`Shell`,icon:`rectangle-terminal`,children:_jsx(_components.p,{children:`Devin 的终端，你可以在这里观察命令的执行情况并查看输出日志。你也可以复制 Shell 输出用于调试。如果你想直接运行命令，请使用 IDE 的 Shell。`})}),_jsx(Card,{title:`IDE`,icon:`code`,children:_jsx(_components.p,{children:`Devin 内嵌的代码编辑器，配备你熟悉的所有 IDE 工具和快捷键。你可以实时跟踪 Devin 的工作，并在需要时接管来运行命令、直接修改代码或测试 Devin 的代码。`})}),_jsx(Card,{title:`Browser`,icon:`browser`,children:_jsx(_components.p,{children:`你可以看到 Devin 如何浏览文档、测试其构建的 Web 应用程序、下载/上传信息等更多内容。你也可以通过 Interactive Browser 随时介入，帮助 Devin 完成浏览相关任务。`})})]}),`\n`,_jsx(Frame,{caption:`你可以在侧边栏或通过点击会话中的任意进度步骤来找到 Devin 的工具`,children:_jsx(`video`,{controls:true,width:`100%`,playsInline:true,children:_jsx(`source`,{src:`https://mintcdn.com/cognitionai/IDtCf_RaYAXtqaVv/images/get-started/devintoolsnew.mp4?fit=max\u0026auto=format\u0026n=IDtCf_RaYAXtqaVv\u0026q=85\u0026s=217ee85538ed624e0f737520d262ea26`,type:`video/mp4`,\"data-path\":`images/get-started/devintoolsnew.mp4`})})}),`\n`,_jsx(Heading,{level:`2`,id:`getting-access`,children:`获取访问权限`}),`\n`,_jsxs(_components.p,{children:[`要访问 Devin，请在 `,_jsx(_components.a,{href:`https://app.devin.ai`,children:`app.devin.ai`}),` 注册。提供个人和 Teams 套餐。`]}),`\n`,_jsxs(_components.p,{children:[`你也可以安装 `,_jsx(_components.a,{href:`/zh/cli`,children:`Devin CLI`}),`，通过命令行直接使用 Devin：`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backg