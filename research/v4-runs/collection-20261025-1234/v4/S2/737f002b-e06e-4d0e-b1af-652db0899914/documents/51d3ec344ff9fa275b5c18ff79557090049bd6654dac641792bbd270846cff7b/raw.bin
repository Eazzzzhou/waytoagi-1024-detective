ons/issue-manager","title":"议题管理器","childPages":[]},{"href":"/zh/copilot/tutorials/customization-library/custom-instructions/accessibility-auditor","title":"辅助功能审核者","childPages":[]},{"href":"/zh/copilot/tutorials/customization-library/custom-instructions/testing-automation","title":"测试自动化","childPages":[]}]},{"href":"/zh/copilot/tutorials/customization-library/prompt-files","title":"提示文件","childPages":[{"href":"/zh/copilot/tutorials/customization-library/prompt-files/your-first-prompt-file","title":"第一个提示文件","childPages":[]},{"href":"/zh/copilot/tutorials/customization-library/prompt-files/create-readme","title":"创建 README","childPages":[]},{"href":"/zh/copilot/tutorials/customization-library/prompt-files/onboarding-plan","title":"入职计划","childPages":[]},{"href":"/zh/copilot/tutorials/customization-library/prompt-files/document-api","title":"文档 API","childPages":[]},{"href":"/zh/copilot/tutorials/customization-library/prompt-files/review-code","title":"查看代码","childPages":[]},{"href":"/zh/copilot/tutorials/customization-library/prompt-files/generate-unit-tests","title":"生成单元测试","childPages":[]}]},{"href":"/zh/copilot/tutorials/customization-library/custom-agents","title":"自定义智能体","childPages":[{"href":"/zh/copilot/tutorials/customization-library/custom-agents/your-first-custom-agent","title":"你的第一个自定义代理","childPages":[]},{"href":"/zh/copilot/tutorials/customization-library/custom-agents/implementation-planner","title":"实施计划工具","childPages":[]},{"href":"/zh/copilot/tutorials/customization-library/custom-agents/bug-fix-teammate","title":"Bug 修复队友","childPages":[]},{"href":"/zh/copilot/tutorials/customization-library/custom-agents/cleanup-specialist","title":"清理专家","childPages":[]}]}],"sidebarLink":{"text":"All customizations","href":"/zh/copilot/tutorials/customization-library"},"layout":"category-landing"},{"href":"/zh/copilot/tutorials/cloud-agent","title":"云代理","childPages":[{"href":"/zh/copilot/tutorials/cloud-agent/get-the-best-results","title":"获得最优结果","childPage