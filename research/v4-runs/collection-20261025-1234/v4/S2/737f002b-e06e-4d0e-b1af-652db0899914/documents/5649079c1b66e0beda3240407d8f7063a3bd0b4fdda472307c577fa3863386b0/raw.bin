oonshot-ai"},"children":[{"type":"element","tagName":"thead","properties":{},"children":[{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[{"type":"text","value":"型号"}]},{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[{"type":"text","value":"版本状态"}]},{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[{"type":"text","value":"类别"}]},{"type":"element","tagName":"th","properties":{"align":"right","scope":"col"},"children":[{"type":"text","value":"Input"}]},{"type":"element","tagName":"th","properties":{"align":"right","scope":"col"},"children":[{"type":"text","value":"缓存输入"}]},{"type":"element","tagName":"th","properties":{"align":"right","scope":"col"},"children":[{"type":"text","value":"输出"}]}]}]},{"type":"element","tagName":"tbody","properties":{},"children":[{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Kimi K3"}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"GA"}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Powerful"}]},{"type":"element","tagName":"td","properties":{"align":"right"},"children":[{"type":"text","value":"$3.00"}]},{"type":"element","tagName":"td","properties":{"align":"right"},"children":[{"type":"text","value":"$0.30"}]},{"type":"element","tagName":"td","properties":{"align":"right"},"children":[{"type":"text","value":"$15.00"}]}]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"code-completions","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#code-completions"},"children":[{"type":"text","value":"代码补全"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"代码完成和next edit suggestions不在AI credits中计费。 对于所有付费 Copilot 计划，它们仍然不受限制，并继续使用其现有的计数机制。"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"pricing-and-usage-cost-considerations-for-copilot-code-review","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#pricing-and-usage-cost-considerations-for-copilot-code-review"},"children":[{"type":"text","value":"Copilot code review 的定价方式与使用成本注意事项"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"对于大多数 Copilot 功能，用于每个交互的模型是可见的，因此可以参考上述定价表来估算成本。\nCopilot code review 是一个例外 - 模型是自动选择的，不会透露，因此每令牌成本在评审之间可能会有所不同。"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"每次代码评审采用两项计费规则：词元消耗量按 AI credits 计费，支撑评审运行的智能体基础设施会消耗 GitHub Actions 分钟时长。"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"GitHub Actions 分钟先归入存储库，然后在适用的情况下再归入企业或成本中心。 对于与具有付费 Copilot 许可证的组织成员关联的请求，AI credits 将按成员或组织收费，具体取决于 "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"选择如何为具有付费 Copilot 许可证的成员计费"}]},{"type":"text","value":" 策略的配置方式。"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"如果与评审关联的人员没有 Copilot 席位，则使用情况将改为向企业或成本中心计费。 对于由 Copilot cloud agent 创建的拉取请求，使用量会优先归属于与该更改关联的人类共同作者。 如果无法向共同作者计费，则使用情况将直接计费给组织。 对于由其他机器人创建的拉取请求，或者当机器人发起评审请求时，相关用量也会直接计入组织账单。 这些拉取请求可进行智能体评审。"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"可以通过以下方式查看 GitHub Actions 当前在 Copilot code review 上的使用情况："}]},{"type":"text",