3e类别\u003c/th\u003e\u003cth align=\"right\" scope=\"col\"\u003eInput\u003c/th\u003e\u003cth align=\"right\" scope=\"col\"\u003e缓存输入\u003c/th\u003e\u003cth align=\"right\" scope=\"col\"\u003e输出\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003eMAI-Code-1.1-Flash\u003c/td\u003e\u003ctd\u003eGA\u003c/td\u003e\u003ctd\u003eLightweight\u003c/td\u003e\u003ctd align=\"right\"\u003e$0.20\u003c/td\u003e\u003ctd align=\"right\"\u003e$0.02\u003c/td\u003e\u003ctd align=\"right\"\u003e$1.20\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\n\u003ch3 id=\"xai\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#xai\"\u003exAI（可解释的人工智能）\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cdiv class=\"ghd-alert ghd-alert-accent\" data-container=\"alert\"\u003e\u003cp class=\"ghd-alert-title\"\u003e\u003csvg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon mr-2\" aria-hidden\u003e\u003cpath d=\"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z\"\u003e\u003c/path\u003e\u003c/svg\u003e注意\u003c/p\u003e\n\u003cp\u003e Models with a \u003cstrong\u003eLong context\u003c/strong\u003e tier, offer extended capabilities and longer context windows. See \u003ca href=\"/zh/copilot/reference/ai-models/supported-models#models-with-extended-capabilities\"\u003eGitHub Copilot中支持的 AI 模型\u003c/a\u003e\u003c/p\u003e\n\u003c/div\u003e\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003ctable aria-labelledby=\"xai\"\u003e\u003cthead\u003e\u003ctr\u003e\u003cth scope=\"col\"\u003e型号\u003c/th\u003e\u003cth scope=\"col\"\u003e版本状态\u003c/th\u003e\u003cth scope=\"col\"\u003e类别\u003c/th\u003e\u003cth scope=\"col\"\u003e层\u003c/th\u003e\u003cth scope=\"col\"\u003e阈值（输入令牌）\u003c/th\u003e\u003cth align=\"right\" scope=\"col\"\u003eInput\u003c/th\u003e\u003cth align=\"right\" scope=\"col\"\u003e缓存输入\u003c/th\u003e\u003cth align=\"right\" scope=\"col\"\u003e输出\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003eGrok 4.5\u003c/td\u003e\u003ctd\u003eGA\u003c/td\u003e\u003ctd\u003eVersatile\u003c/td\u003e\u003ctd\u003eDefault\u003c/td\u003e\u003ctd\u003e≤ 200K\u003c/td\u003e\u003ctd align=\"right\"\u003e$2.00\u003c/td\u003e\u003ctd align=\"right\"\u003e$0.50\u003c/td\u003e\u003ctd align=\"right\"\u003e$6.00\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eGrok 4.5\u003c/td\u003e\u003ctd\u003eGA\u003c/td\u003e\u003ctd\u003eVersatile\u003c/td\u003e\u003ctd\u003eLong context\u003c/td\u003e\u003ctd\u003e\u003e 200K\u003c/td\u003e\u003ctd align=\"right\"\u003e$4.00\u003c/td\u003e\u003ctd align=\"right\"\u003e$1.00\u003c/td\u003e\u003ctd align=\"right\"\u003e$12.00\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eGrok 4.6\u003c/td\u003e\u003ctd\u003eGA\u003c/td\u003e\u003ctd\u003eVersatile\u003c/td\u003e\u003ctd\u003eDefault\u003c/td\u003e\u003ctd\u003e≤ 200K\u003c/td\u003e\u003ctd align=\"right\"\u003e$2.00\u003c/td\u003e\u003ctd align=\"right\"\u003e$0.50\u003c/td\u003e\u003ctd align=\"right\"\u003e$6.00\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eGrok 4.6\u003c/td\u003e\u003ctd\u003eGA\u003c/td\u003e\u003ctd\u003eVersatile\u003c/td\u003e\u003ctd\u003eLong context\u003c/td\u003e\u003ctd\u003e\u003e 200K\u003c/td\u003e\u003ctd align=\"right\"\u003e$4.00\u003c/td\u003e\u003ctd align=\"right\"\u003e$1.00\u003c/td\u003e\u003ctd align=\"right\"\u003e$12.00\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eGrok 4.7\u003c/td\u003e\u003ctd\u003eGA\u003c/td\u003e\u003ctd\u003eVersatile\u003c/td\u003e\u003ctd\u003eDefault\u003c/td\u003e\u003ctd\u003e≤ 200K\u003c/td\u003e\u003ctd align=\"right\"\u003e$2.00\u003c/td\u003e\u003ctd align=\"right\"\u003e$0.50\u003c/td\u003e\u003ctd align=\"right\"\u003e$6.00\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eGrok 4.7\u003c/td\u003e\u003ctd\u003eGA\u003c/td\u003e\u003ctd\u003eVersatile\u003c/td\u003e\u003ctd\u003eLong context\u003c/td\u003e\u003ctd\u003e\u003e 200K\u003c/td\u003e\u003ctd align=\"right\"\u003e$4.00\u003c/td\u003e\u003ctd align=\"right\"\u003e$1.00\u003c/td\u003e\u003ctd align=\"right\"\u003e$12.00\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\n\u003ch3 id=\"moonshot-ai\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#moonshot-ai\"\u003eMoonshot AI\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003ctable aria-labelledby=\"moonshot-ai\"\u003e\u003cthead\u003e\u003ctr\u003e\u003cth scope=\"col\"\u003e型号\u003c/th\u003e\u003cth scope=\"col\"\u003e版本状态\u003c/th\u003e\u003cth scope=\"col\"\u003e类别\u003c/th\u003e\u003cth align=\"right\" scope=\"col\"\u003eInput\u003c/th\u003e\u003cth align=\"right\" scope=\"col\"\u003e缓存输入\u003c/th\u003e\u003cth align=\"right\" scope=\"col\"\u003e输出\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003eKimi K3\u003c/td\u003e\u003ctd\u003eGA\u003c/td\u003e\u003ctd\u003ePowerful\u003c/td\u003e\u003ctd align=\"right\"\u003e$3.00\u003c/td\u003e\u003ctd align=\"right\"\u003e$0.30\u003c/td\u003e\u003ctd align=\"right\"\u003e$15.00\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\n\u003ch2 id=\"code-completions\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#code-completions\"\u003e代码补全\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003e代码完成和next edit suggestions不在AI credits中计费。 对于所有付费 Copilot 计划，它们仍然不受限制，并继续使用其现有的计数机制。\u003c/p\u003e\n\u003ch2 id=\"pricing-and-usage-cost-considerations-for-copilot-code-review\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#pricing-and-usage-cost-considerations-for-copilot-code-review\"\u003eCopilot code review 的定价方式与使用成本注意事项\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003e对于大多数 Copilot 功能，用于每个交互的模型是可见的，因此可以参考上述定价表来估算成本。\nCopilot code review 是一个例外 - 模型是自动选择的，不会透露，因此每令牌成本在评审之间可能会有所不同。\u003c/p\u003e\n\u003cp\u003e每次代码评审采用两项计费规则：词元消耗量按 AI credits 计费，支撑评审运行的智能体基础设施会消耗 GitHub Actions 分钟时长。\u003c/p\u003e\n\u003cp\u003eGitHub Actions 分钟先归入存储库，然后在适用的情况下再归入企业或成本中心。 对于与具有付费 Copilot 许可证的组织成员关联的请求，AI credits 将按成员或组织收费，具体取决于 \u003cstrong\u003e选择如何为具有付费 Copilot 许可证的成员计费\u003c/strong\u003e 策略的配置方式。\u003c/p\u003e\n\u003cp\u003e如果与评审关联的人员没有 Copilot 席位，则使用情况将改为向企业或成本中心计费。 对于由 Copilot cloud agent 创建的拉取请求，使用量会优先归属于与该更改关联的人类共同作者。 如果无法向共同作者计费，则使用情况将直接计费给组织。 对于由其他机器人创建的拉取请求，或者当机器人发起评审请求时，相关用量也会直接计入组织账单。 这些拉取请求可进行智能体评审。\u003c/p\u003e\n\u003cp\u003e可以通过以下方式查看 GitHub Actions 当前在 Copilot code review 上的使用情况：\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eGitHub Actions 指标\u003c/strong\u003e：按 \u003ccode\u003ecopilot-pull-request-reviewer\u003c/code\u003e 工作流进行筛选。 请参阅“\u003ca href=\"/zh/organizations/collaborating-with-groups-in-organizations/viewing-github-actions-metrics-for-your-organization\"\u003e查看组织的 GitHub Actions 指标\u003c/a\u003e”。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e计费使用情况报告\u003c/strong\u003e：使用值 \u003ccode\u003eworkflow_path\u003c/code\u003e，按照 \u003ccode\u003edynamic/agents/copilot-pull-request-reviewer\u003c/code\u003e 进行筛选。 请参阅“\u003ca href=\"/zh/billing/reference/billing-reports\"\u003e账单报告参考资料\u003c/a\u003e”。\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2 id=\"model-multipliers-for-annual-copilot-pro-and-copilot-pro-subscribers\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#model-multipliers-for-annual-copilot-pro-and-copilot-pro-subscribers\"\u003e年度 Copilot Pro 和 Copilot Pro+ 订阅者的模型乘数\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003e采用Copilot Pro模式的Copilot Pro+中的**** 和**** 订阅者具有不同的模型乘数。 请参阅“\u003ca href=\"/zh/copilot/reference/copilot-billing/request-based-billing-legacy/model-multipliers-for-annual-plans\"\u003e按请求计费的年度套餐模型乘数（旧版）\u003c/a\u003e”。\u003c/p\u003e\n\u003csection data-footnotes=\"\" class=\"footnotes\"\u003e\u003ch2 class=\"sr-only\" id=\"footnote-label\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#footnote-label\"\u003eFootnotes\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003col\u003e\n\u003cli id=\"user-content-fn-gemini-flash-promo\"\u003e\n\u003cp\u003eGemini 3.8 Flash is available at the promotional pricing of $0.75 per 1M input tokens, $0.075 per 1M cached input tokens, and $3.75 per 1M output tokens through December 31, 2026. \u003ca href=\"#user-content-fnref-gemini-flash-promo\" data-footnote-backref=\"\" aria-label=\"Back to reference 1\" class=\"data-footnote-backref\"\u003e↩\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli id=\"user-content-fn-gemini-4-argon-promo\"\u003e\n\u003cp\u003eGemini 4 Argon is available at the promotional pricing of $2.00 per 1M input tokens, $0.10 per 1M cached input tokens, and $10.00 per 1M output tokens until December 1, 2026. \u003ca href=\"#user-content-fnref-gemini-4-argon-promo\" data-footnote-backref=\"\" aria-label=\"Back to reference 2\" class=\"data-footnote-backref\"\u003e↩\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003c/section\u003e","renderedPageHast":{"type":"root","children":[{"type":"element","tagName":"h2","properties":{"id":"how-model-pricing-works","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#how-model-pricing-works"},"children":[{"type":"text","value":"模型定价的工作原理"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"使用 Copilot时，交互使用令牌：输入令牌（发送到模型的内容）、输出令牌（模型生成的内容）和缓存令牌（模型重用或存储上下文）。 每个令牌都基于所使用的模型定价，总价格转换为 AI credits1 AI credit = $0.01 USD。"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"交互的成本取决于两个事项：模型和使用的令牌数。"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"如何跟踪和计费Copilot的使用情况取决于您的计划类型："}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"个人计划（Copilot Free、Copilot Pro和Copilot Pro+Copilot Max）包括GitHub AI Credits按计划而异的津贴。 有关详细信息，请参阅 "},{"type":"element","tagName":"a","properties":{"href":"/zh/copilot/concepts/billing-and-usage/individuals/billing"},"children":[{"type":"text","value":"个人基于使用情况的计费"}]},{"type":"text","value":"。"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Copilot Business 与 Copilot Enterprise 包含可在计费实体层面汇总的按用户 GitHub AI Credits 额度。 有关详细信息，请参阅 "},{"type":"element","tagName":"a","properties":{"href":"/zh/copilot/concepts/billing-and-usage/organizations-and-enterprises/billing"},"children":[{"type":"text","value":"组织和企业的基于使用情况的计费"}]},{"type":"text","value":"。"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"当使用量超出任何Copilot计划包含的津贴时，超出的使用量将以GitHub AI Credits为单位，按照以下定价表中显示的每个令牌费率进行计费（1AI credit = $0.01 USD）。"}]},{"type":"text","value":"\n"},{"typ