<script>
function pagetop(e){
    if(e.type == 'touchstart'){
		e.preventDefault();
    }
    if(e.type == 'touchmove'){
		e.preventDefault();
    }
    if(e.type == 'touchend' || e.type == 'click'){
		smoothScroll('#headerstyle_fixed');
		return false;
    }
};
touch2click(document.getElementById('pagetop'),pagetop);
</script>
