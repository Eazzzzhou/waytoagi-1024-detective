  <script type="application/json" data-target="react-app.embeddedData">{"payload":{"codeViewBlobRoute":{"csv":null,"csvError":null,"headerInfo":{"toc":[{"level":1,"text":"FAQ","anchor":"faq","htmlText":"FAQ"},{"level":2,"text":"How can I upgrade Ollama?","anchor":"how-can-i-upgrade-ollama","htmlText":"How can I upgrade Ollama?"},{"level":2,"text":"How can I view the logs?","anchor":"how-can-i-view-the-logs","htmlText":"How can I view the logs?"},{"level":2,"text":"How do I configure Ollama server?","anchor":"how-do-i-configure-ollama-server","htmlText":"How do I configure Ollama server?"},{"level":3,"text":"Setting environment variables on Mac","anchor":"setting-environment-variables-on-mac","htmlText":"Setting environment variables on Mac"},{"level":3,"text":"Setting environment variables on Linux","anchor":"setting-environment-variables-on-linux","htmlText":"Setting environment variables on Linux"},{"level":3,"text":"Setting environment variables on Windows","anchor":"setting-environment-variables-on-windows","htmlText":"Setting environment variables on Windows"},{"level":2,"text":"How can I expose Ollama on my network?","anchor":"how-can-i-expose-ollama-on-my-network","htmlText":"How can I expose Ollama on my network?"},{"level":2,"text":"How can I allow additional web origins to access Ollama?","anchor":"how-can-i-allow-additional-web-origins-to-access-ollama","htmlText":"How can I allow additional web origins to access Ollama?"},{"level":2,"text":"Where are models stored?","anchor":"where-are-models-stored","htmlText":"Where are models stored?"},{"level":3,"text":"How do I set them to a different location?","anchor":"how-do-i-set-them-to-a-different-location","htmlText":"How do I set them to a different location?"},{"level":2,"text":"Does Ollama send my prompts and answers back to Ollama.ai to use in any way?","anchor":"does-ollama-send-my-prompts-and-answers-back-to-ollamaai-to-use-in-any-way","htmlText":"Does Ollama send my prompts and answers back to Ollama.