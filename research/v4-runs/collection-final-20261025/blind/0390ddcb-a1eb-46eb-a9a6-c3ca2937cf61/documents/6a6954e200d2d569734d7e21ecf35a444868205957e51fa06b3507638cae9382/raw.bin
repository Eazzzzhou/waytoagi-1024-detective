<style id="ym-phase3-server-css">
html:not(.ym-p3-browser-ok) body:not(.ym-p3-browser-ok) .ym-p3-server-gate { display: none !important; }
/* ym-p3-top-reveal-20261015: top sticky units wait for the title; sidebar creatives keep their own ratio */
.ym-p3-top-wait { visibility: hidden !important; opacity: 0 !important; pointer-events: none !important; }
html body .dyn-wsoezg-sidebar-image-widget img { aspect-ratio: auto !important; height: auto !important; max-height: none !important; object-fit: contain !important; }
html.ym-p3-browser-ok body, body.ym-p3-browser-ok { padding-bottom: 104px !important; }
.dyn-wsoezg-wide-rail { position: fixed; left: 50%; transform: translateX(-50%); z-index: 9998; background: transparent; }
.dyn-wsoezg-wide-rail.dyn-wsoezg-top { top: var(--ym-p3-top-offset, var(--rk-top-offset, 0px)) !important; width: 728px; height: 90px; }
.dyn-wsoezg-wide-rail.dyn-wsoezg-bottom { bottom: 0; width: 728px; height: 90px; }
.dyn-wsoezg-context-rail { position: fixed; left: 50%; transform: translateX(-50%); z-index: 9998; background: transparent; }
.dyn-wsoezg-context-rail.dyn-wsoezg-top { top: var(--ym-p3-top-offset, var(--rk-top-offset, 0px)) !important; width: 728px; height: 90px; }
.dyn-wsoezg-context-rail.dyn-wsoezg-bottom { bottom: 0; width: 728px; height: 90px; }
.dyn-wsoezg-wide-rail .dyn-wsoezg-close-btn, .dyn-wsoezg-context-rail .dyn-wsoezg-close-btn, .dyn-wsoezg-commerce-panel .dyn-wsoezg-close-btn, .dyn-wsoezg-context-fallback .dyn-wsoezg-close-btn { top: 6px !important; right: 6px !important; display: flex !important; align-items: center !important; justify-content: center !important; line-height: 1 !important; z-index: 2147483647 !important; }
.dyn-wsoezg-context-fallback { box-sizing: border-box; overflow: visible; background: transparent; border: 0; box-shadow: none; }
.dyn-wsoezg-center-media { display: block; width: 728px; height: 90px; max-width: 100%; text-decoration: none !important; }
.dyn-wsoezg-center-media img { display: block; width: 728px; height: 90px; max-width: 100%; object-fit: contain; border: 0; border-radius: 0; }
.dyn-wsoezg-corner-panel { position: fixed; width: 300px; z-index: 9990; }
.dyn-wsoezg-corner-panel.dyn-wsoezg-top-right { top: var(--ym-p3-top-offset, var(--rk-top-offset, 0px)) !important; right: 2px; }
.dyn-wsoezg-corner-panel.dyn-wsoezg-bottom-right { bottom: 5px; right: 2px; }
.dyn-wsoezg-corner-panel .dyn-wsoezg-universal-cta { height: 90px; padding: 10px 15px; border-radius: var(--ymp3-r-lg, 8px); }
.dyn-wsoezg-corner-panel .dyn-wsoezg-cta-text { font-size: 1rem; line-height: 1.4; }
.dyn-wsoezg-corner-panel .dyn-wsoezg-close-btn { top: -8px; right: -8px; }
.dyn-wsoezg-close-btn { position: absolute; box-sizing: border-box; width: 26px; height: 26px; min-width: 26px; min-height: 26px; padding: 0; background-color: rgba(5, 5, 5, 0.92); color: #ffffff; border: 2px solid #ffffff; border-radius: 50%; cursor: pointer; font-family: Arial, sans-serif; font-size: 18px; font-weight: bold; line-height: 1; text-align: center; z-index: 2147483647; box-shadow: 0 2px 7px rgba(0,0,0,0.35); transition: transform 0.2s ease, background-color 0.2s ease; }
.dyn-wsoezg-close-btn:hover { background-color: #000000; transform: scale(1.1); }
.dyn-wsoezg-universal-card .dyn-wsoezg-close-btn, .dyn-wsoezg-sidebar-image-widget .dyn-wsoezg-close-btn { top: -10px; right: -10px; }
.dyn-wsoezg-universal-card, .dyn-wsoezg-sidebar-image-widget { position: relative; }
.dyn-wsoezg-universal-card { box-sizing: border-box; background: var(--ymp3-panel); border: 1px solid var(--ymp3-rule); border-top: 3px double var(--ymp3-rule-dark); border-radius: var(--ymp3-r, 4px); box-shadow: 0 1px 2px rgba(19,19,22,0.04), 0 14px 30px rgba(19,19,22,0.07); overflow: visible; font-family: var(--ymp3-text); color: var(--ymp3-ink); }
.ym-p3-server-gate { --ymp3-display: var(--pm-font-display, inherit); --ymp3-text: var(--pm-font-body, inherit); --ymp3-panel: var(--pm-surface, #ffffff); --ymp3-paper: var(--pm-surface-2, #ecf0f4); --ymp3-ink: var(--pm-ink, #1a222c); --ymp3-muted: var(--pm-ink-faint, #5f6c79); --ymp3-rule: var(--pm-line, #dde3ea); --ymp3-rule-dark: var(--pm-ink, #1a222c); --ymp3-label: var(--pm-dawn-deep, #a04d12); --ymp3-blue: #0b57d0; --ymp3-amber: var(--pm-dawn-deep, #a04d12); --ymp3-violet: var(--pm-dusk-deep, #55439e); --ymp3-teal: #0f766e; --ymp3-r: var(--pm-r-s, 10px); --ymp3-r-lg: var(--pm-r-m, 14px); }
[data-theme="dark"] .ym-p3-server-gate, html.rw-dark .ym-p3-server-gate { --ymp3-blue: #6ca4ff; --ymp3-teal: #65d6c7; }
.dyn-wsoezg-pc-fix { --ymp3-a: var(--ymp3-blue); }
.dyn-wsoezg-driver-update { --ymp3-a: var(--ymp3-amber); }
.dyn-wsoezg-kicker { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; font-family: var(--ymp3-display); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ymp3-label); }
.dyn-wsoezg-kicker::after { content: ""; flex: 1 1 auto; height: 1px; background: var(--ymp3-rule); }
.dyn-wsoezg-tile { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 9px; flex-shrink: 0; color: var(--ymp3-a, var(--ymp3-ink)); background: color-mix(in srgb, var(--ymp3-a, var(--ymp3-ink)) 11%, transparent); }
.dyn-wsoezg-chip { display: inline-block; padding: 3px 9px; border-radius: 3px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.03em; background: var(--ymp3-paper); border: 1px solid var(--ymp3-rule); color: var(--ymp3-muted); white-space: nowrap; }
.dyn-wsoezg-pill { display: inline-flex; align-items: center; padding: 9px 16px; border-radius: var(--ymp3-r, 4px); color: var(--ymp3-paper, #fff) !important; background: var(--ymp3-a, var(--ymp3-ink)); font-family: var(--ymp3-display); font-weight: 800; font-size: 0.82rem; letter-spacing: 0.01em; white-space: nowrap; flex-shrink: 0; transition: filter 0.15s ease, transform 0.15s ease; }
a:hover .dyn-wsoezg-pill { filter: brightness(0.9); transform: translateY(-1px); }
.dyn-wsoezg-go { font-weight: 900; color: var(--ymp3-a, var(--ymp3-ink)); flex-shrink: 0; display: inline-flex; transition: transform 0.15s ease; }
a:hover .dyn-wsoezg-go { transform: translateX(4px); }
.dyn-wsoezg-inline-style1 { width: 728px; max-width: 100%; margin: 32px auto 24px; padding: 20px 24px 22px; display: block; }
.dyn-wsoezg-style1-grid { display: flex; align-items: stretch; gap: 0; }
a.dyn-wsoezg-promo-column { flex: 1; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; padding: 6px 16px 0; text-decoration: none; }
a.dyn-wsoezg-promo-column:hover .dyn-wsoezg-promo-title { text-decoration: underline; text-decoration-color: var(--ymp3-a); text-underline-offset: 3px; }
.dyn-wsoezg-promo-divider { width: 1px; background: var(--ymp3-rule); }
.dyn-wsoezg-promo-title { font-family: var(--ymp3-display); font-size: 1.02rem; font-weight: 800; letter-spacing: -0.01em; line-height: 1.3; color: var(--ymp3-ink); margin: 0; flex-grow: 1; }
.dyn-wsoezg-promo-button { display: block; width: 100%; padding: 11px 10px; border-radius: var(--ymp3-r, 4px); background: var(--ymp3-a); color: var(--ymp3-paper, #fff) !important; font-family: var(--ymp3-display); font-weight: 800; font-size: 0.85rem; transition: filter 0.15s ease; }
a.dyn-wsoezg-promo-column:hover .dyn-wsoezg-promo-button { filter: brightness(0.9); }
.dyn-wsoezg-inline-style2 { width: 728px; max-width: 100%; margin: 32px auto 24px; padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; }
a.dyn-wsoezg-bulletin { display: flex; align-items: center; gap: 14px; padding: 12px 16px 12px 14px; background: var(--ymp3-paper); border: 1px solid var(--ymp3-rule); border-left: 3px solid var(--ymp3-a); border-radius: var(--ymp3-r, 4px); text-decoration: none; transition: background-color 0.15s ease; }
a.dyn-wsoezg-bulletin:hover { background: var(--ymp3-panel); }
.dyn-wsoezg-bulletin-main { flex: 1 1 auto; min-width: 0; }
.dyn-wsoezg-bulletin-line { display: block; font-family: var(--ymp3-display); font-size: 0.98rem; font-weight: 700; letter-spacing: -0.005em; line-height: 1.35; color: var(--ymp3-ink); }
.dyn-wsoezg-bulletin-meta { display: block; font-size: 0.75rem; color: var(--ymp3-muted); margin-top: 3px; }
.dyn-wsoezg-inline-style3 { width: 728px; max-width: 100%; margin: 32px auto 24px; padding: 6px 24px; }
a.dyn-wsoezg-feature-section { display: flex; align-items: center; gap: 18px; padding: 18px 0; text-decoration: none; }
a.dyn-wsoezg-feature-section + a.dyn-wsoezg-feature-section { border-top: 1px solid var(--ymp3-rule); }
.dyn-wsoezg-feature-text-content { flex-grow: 1; min-width: 0; }
.dyn-wsoezg-feature-title { font-family: var(--ymp3-display); font-size: 1.08rem; font-weight: 800; letter-spacing: -0.01em; color: var(--ymp3-ink); margin: 0 0 4px; }
a.dyn-wsoezg-feature-section:hover .dyn-wsoezg-feature-title { text-decoration: underline; text-decoration-color: var(--ymp3-a); text-underline-offset: 3px; }
.dyn-wsoezg-feature-description { display: block; font-size: 0.9rem; color: var(--ymp3-muted); line-height: 1.55; margin: 0 0 7px; }
.dyn-wsoezg-feature-button-area { flex-shrink: 0; }
.dyn-wsoezg-inline-style4 { width: 728px; max-width: 100%; margin: 32px auto 24px; padding: 18px 24px; }
a.dyn-wsoezg-pick-row { display: flex; align-items: center; gap: 14px; padding: 12px 2px; text-decoration: none; }
a.dyn-wsoezg-pick-row + a.dyn-wsoezg-pick-row { border-top: 1px dashed var(--ymp3-rule); }
a.dyn-wsoezg-pick-row:hover { background: var(--ymp3-paper); }
.dyn-wsoezg-pick-text { flex-grow: 1; min-width: 0; }
.dyn-wsoezg-pick-name { display: flex; align-items: center; gap: 8px; font-family: var(--ymp3-display); font-size: 0.95rem; font-weight: 800; color: var(--ymp3-ink); }
.dyn-wsoezg-free-flag { display: inline-block; padding: 1px 6px; border: 1px solid var(--ymp3-a); border-radius: 3px; color: var(--ymp3-a); font-size: 0.62rem; font-weight: 800; letter-spacing: 0.08em; }
.dyn-wsoezg-pick-benefit { display: block; font-size: 0.85rem; color: var(--ymp3-muted); margin-top: 3px; line-height: 1.45; }
.dyn-wsoezg-inline-style5 { width: 728px; max-width: 100%; margin: 32px auto 24px; padding: 18px 24px 20px; }
.dyn-wsoezg-check-head { font-family: var(--ymp3-display); font-size: 1.05rem; font-weight: 800; letter-spacing: -0.01em; color: var(--ymp3-ink); margin: 0 0 12px; }
a.dyn-wsoezg-check-row { display: flex; align-items: center; gap: 12px; padding: 11px 14px; margin: 7px 0; background: var(--ymp3-paper); border: 1px solid var(--ymp3-rule); border-radius: var(--ymp3-r, 4px); text-decoration: none; transition: transform 0.15s ease, border-color 0.15s ease; }
a.dyn-wsoezg-check-row:hover { transform: translateX(4px); border-color: var(--ymp3-a); }
.dyn-wsoezg-check-mark { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; color: var(--ymp3-paper, #fff); background: var(--ymp3-a); flex-shrink: 0; }
.dyn-wsoezg-check-text { flex-grow: 1; font-size: 0.93rem; color: var(--ymp3-ink); font-weight: 600; }
.dyn-wsoezg-inline-style6 { width: 728px; max-width: 100%; margin: 32px auto 24px; padding: 14px 18px; display: flex; flex-direction: column; gap: 9px; }
a.dyn-wsoezg-strip-row { display: flex; align-items: center; gap: 13px; padding: 11px 14px; border: 1px solid var(--ymp3-rule); border-left: 3px solid var(--ymp3-a); border-radius: var(--ymp3-r, 4px); background: var(--ymp3-panel); text-decoration: none; transition: background-color 0.15s ease, box-shadow 0.15s ease; }
a.dyn-wsoezg-strip-row:hover { background: var(--ymp3-paper); box-shadow: 0 4px 14px rgba(19,19,22,0.07); }
.dyn-wsoezg-strip-tag { font-family: var(--ymp3-display); font-size: 0.62rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ymp3-a); flex-shrink: 0; min-width: 86px; }
.dyn-wsoezg-strip-text { flex-grow: 1; font-family: var(--ymp3-display); font-size: 0.95rem; font-weight: 700; letter-spacing: -0.005em; color: var(--ymp3-ink); }
.dyn-wsoezg-inline-style7 { width: 728px; max-width: 100%; margin: 32px auto 24px; padding: 0; }
a.dyn-wsoezg-hero-main { display: block; padding: 24px 28px 22px; background: var(--ymp3-paper); border-radius: var(--ymp3-r, 3px) var(--ymp3-r, 3px) 0 0; text-decoration: none; }
.dyn-wsoezg-hero-kicker { display: block; font-family: var(--ymp3-display); font-size: 0.66rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ymp3-a); margin: 0 0 10px; }
.dyn-wsoezg-hero-title { font-family: var(--ymp3-display); font-size: 1.55rem; font-weight: 900; letter-spacing: -0.015em; line-height: 1.18; color: var(--ymp3-ink); margin: 0 0 8px; }
.dyn-wsoezg-hero-benefit { font-size: 0.95rem; color: var(--ymp3-muted); margin: 0 0 16px; line-height: 1.55; max-width: 56ch; }
.dyn-wsoezg-hero-cta-row { display: flex; align-items: center; gap: 12px; }
.dyn-wsoezg-hero-btn { display: inline-flex; padding: 11px 22px; border-radius: var(--ymp3-r, 4px); background: var(--ymp3-a); color: var(--ymp3-paper, #fff) !important; font-family: var(--ymp3-display); font-weight: 800; font-size: 0.9rem; transition: filter 0.15s ease, transform 0.15s ease; }
a.dyn-wsoezg-hero-main:hover .dyn-wsoezg-hero-btn { filter: brightness(0.9); transform: translateY(-1px); }
.dyn-wsoezg-hero-minis { display: flex; border-top: 1px solid var(--ymp3-rule); }
a.dyn-wsoezg-hero-mini { flex: 1; display: flex; align-items: center; justify-content: center; gap: 9px; padding: 13px 10px; background: var(--ymp3-panel); text-decoration: none; font-family: var(--ymp3-display); font-weight: 700; font-size: 0.88rem; color: var(--ymp3-ink) !important; }
a.dyn-wsoezg-hero-mini + a.dyn-wsoezg-hero-mini { border-left: 1px solid var(--ymp3-rule); }
a.dyn-wsoezg-hero-mini:hover { background: var(--ymp3-paper); }
a.dyn-wsoezg-hero-mini svg { color: var(--ymp3-a); }
.dyn-wsoezg-inline-style8 { width: 728px; max-width: 100%; margin: 32px auto 24px; padding: 18px 24px; }
.dyn-wsoezg-steps-head { font-family: var(--ymp3-display); font-size: 1.05rem; font-weight: 800; letter-spacing: -0.01em; color: var(--ymp3-ink); margin: 0 0 6px; }
a.dyn-wsoezg-step-row { display: flex; align-items: center; gap: 16px; padding: 12px 2px; text-decoration: none; }
a.dyn-wsoezg-step-row + a.dyn-wsoezg-step-row { border-top: 1px solid var(--ymp3-rule); }
.dyn-wsoezg-step-num { flex-shrink: 0; width: 34px; font-family: var(--ymp3-display); font-size: 1.7rem; font-weight: 900; line-height: 1; color: var(--ymp3-a); text-align: center; }
.dyn-wsoezg-step-text { flex-grow: 1; font-size: 0.94rem; color: var(--ymp3-ink); font-weight: 600; line-height: 1.45; }
.dyn-wsoezg-inline-style9 { width: 728px; max-width: 100%; margin: 32px auto 24px; padding: 20px 24px 22px; background: var(--ymp3-paper); }
.dyn-wsoezg-qa-q { font-family: var(--ymp3-display); font-size: 1.25rem; font-weight: 900; letter-spacing: -0.01em; color: var(--ymp3-ink); margin: 0 0 4px; }
.dyn-wsoezg-qa-sub { font-size: 0.85rem; color: var(--ymp3-muted); margin: 0 0 14px; }
.dyn-wsoezg-qa-options { display: flex; flex-wrap: wrap; gap: 10px; }
a.dyn-wsoezg-qa-opt { flex: 1 1 44%; min-width: 260px; display: flex; align-items: center; gap: 12px; padding: 13px 14px; background: var(--ymp3-panel); border: 1px solid var(--ymp3-rule); border-radius: var(--ymp3-r, 4px); text-decoration: none; transition: border-color 0.15s ease, transform 0.15s ease; }
a.dyn-wsoezg-qa-opt:hover { border-color: var(--ymp3-a); transform: translateY(-2px); }
.dyn-wsoezg-qa-opt .dyn-wsoezg-tile { width: 36px; height: 36px; border-radius: 7px; }
.dyn-wsoezg-qa-opt-text { flex-grow: 1; min-width: 0; }
.dyn-wsoezg-qa-opt-label { display: block; font-family: var(--ymp3-display); font-size: 0.93rem; font-weight: 800; color: var(--ymp3-ink); }
.dyn-wsoezg-qa-opt-hint { display: block; font-size: 0.75rem; font-weight: 700; color: var(--ymp3-a); margin-top: 2px; }
.dyn-wsoezg-inline-style10 { width: 728px; max-width: 100%; margin: 32px auto 24px; padding: 20px 24px 22px; background: #131316; border: 1px solid rgba(255,255,255,0.12); border-top: 3px double rgba(242,240,234,0.4); --ymp3-blue: #0b57d0; --ymp3-amber: #b45309; --ymp3-violet: #6d28d9; --ymp3-teal: #0f766e; }
.dyn-wsoezg-dark-head { font-family: var(--ymp3-display); color: #ffffff; font-size: 1.15rem; font-weight: 900; letter-spacing: -0.01em; margin: 0 0 3px; }
.dyn-wsoezg-dark-sub { color: rgba(255,255,255,0.68); font-size: 0.83rem; margin: 0 0 14px; }
.dyn-wsoezg-dark-btns { display: flex; gap: 10px; }
a.dyn-wsoezg-dark-btn { flex: 1; display: flex; align-items: center; justify-content: center; gap: 9px; padding: 13px 10px; border-radius: var(--ymp3-r, 4px); color: #fdfdfb !important; background: var(--ymp3-a); text-decoration: none; font-family: var(--ymp3-display); font-weight: 800; font-size: 0.9rem; transition: filter 0.15s ease, transform 0.15s ease; }
a.dyn-wsoezg-dark-btn:hover { filter: brightness(0.9); transform: translateY(-2px); }
.dyn-wsoezg-inline-style11 { width: 728px; max-width: 100%; margin: 32px auto 24px; padding: 20px 24px 22px; }
a.dyn-wsoezg-spot { display: flex; align-items: center; gap: 18px; text-decoration: none; }
.dyn-wsoezg-spot-body { flex-grow: 1; min-width: 0; }
.dyn-wsoezg-spot-title { font-family: var(--ymp3-display); font-size: 1.25rem; font-weight: 900; letter-spacing: -0.012em; color: var(--ymp3-ink); margin: 0 0 5px; line-height: 1.22; }
a.dyn-wsoezg-spot:hover .dyn-wsoezg-spot-title { text-decoration: underline; text-decoration-color: var(--ymp3-a); text-underline-offset: 3px; }
.dyn-wsoezg-spot-benefit { display: block; font-size: 0.9rem; color: var(--ymp3-muted); line-height: 1.5; margin: 0 0 9px; }
.dyn-wsoezg-spot-meta { display: flex; gap: 7px; flex-wrap: wrap; }
.dyn-wsoezg-spot .dyn-wsoezg-tile { width: 54px; height: 54px; }
.dyn-wsoezg-flag { position: absolute; top: -13px; left: 18px; background: var(--ymp3-label); color: var(--ymp3-paper, #fff); font-family: var(--ymp3-display); font-size: 0.64rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; padding: 5px 14px 5px 12px; border-radius: 2px; clip-path: polygon(0 0, 100% 0, calc(100% - 8px) 50%, 100% 100%, 0 100%); }
.dyn-wsoezg-inline-style11 { padding-top: 26px; }
.dyn-wsoezg-spot-name { display: block; font-size: 0.85rem; font-weight: 600; color: var(--ymp3-muted); margin: 0 0 7px; }
a.dyn-wsoezg-corner-card { display: flex; align-items: center; gap: 10px; background: var(--ymp3-panel); border: 1px solid var(--ymp3-rule); border-top: 3px double var(--ymp3-rule-dark); border-left: 3px solid var(--ymp3-a); border-radius: var(--ymp3-r, 4px); padding: 11px 12px; box-shadow: 0 10px 30px rgba(19,19,22,0.16); text-decoration: none; font-family: var(--ymp3-text); }
a.dyn-wsoezg-corner-card:hover { box-shadow: 0 14px 36px rgba(19,19,22,0.24); }
.dyn-wsoezg-corner-card .dyn-wsoezg-tile { width: 36px; height: 36px; border-radius: 7px; }
.dyn-wsoezg-corner-text { flex-grow: 1; min-width: 0; }
.dyn-wsoezg-corner-head { display: block; font-family: var(--ymp3-display); font-size: 0.86rem; font-weight: 800; letter-spacing: -0.005em; color: var(--ymp3-ink); line-height: 1.25; }
.dyn-wsoezg-corner-sub { display: block; font-size: 0.72rem; color: var(--ymp3-muted); line-height: 1.3; margin-top: 2px; }
a.dyn-wsoezg-modal-row { display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: var(--ymp3-paper); border: 1px solid var(--ymp3-rule); border-radius: var(--ymp3-r, 4px); text-decoration: none; transition: border-color 0.15s ease; }
a.dyn-wsoezg-modal-row:hover { border-color: var(--ymp3-a); }
.dyn-wsoezg-modal-row .dyn-wsoezg-tile { width: 38px; height: 38px; border-radius: 8px; }
.dyn-wsoezg-modal-row-text { flex-grow: 1; min-width: 0; }
.dyn-wsoezg-modal-row-name { display: block; font-family: var(--ymp3-display); font-size: 0.9rem; font-weight: 800; color: var(--ymp3-ink); }
.dyn-wsoezg-modal-row-benefit { display: block; font-size: 0.78rem; color: var(--ymp3-muted); margin-top: 1px; }
.dyn-wsoezg-sidebar-image-widget { margin: 24px auto; max-width: 100%; width: 300px; }
.dyn-wsoezg-sidebar-image-widget a { display: block; text-decoration: none; }
.dyn-wsoezg-sidebar-image-widget img { display: block; width: 100%; height: auto; border-radius: 8px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
#dyn-wsoezg-exit-modal { display: none; flex-direction: row; align-items: stretch; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); box-sizing: border-box; width: 680px; max-width: 90%; background: var(--ymp3-panel); font-family: var(--ymp3-text); border-radius: var(--ymp3-r-lg, 8px); box-shadow: 0 10px 40px rgba(0,0,0,0.25); padding: 0; z-index: 10000; overflow: hidden; }
#dyn-wsoezg-exit-modal .dyn-wsoezg-modal-graphic-panel { flex: 0 0 220px; background: var(--ymp3-ink); display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
#dyn-wsoezg-exit-modal .dyn-wsoezg-modal-tilegrid { display: grid; grid-template-columns: 58px 58px; gap: 14px; justify-content: center; }
#dyn-wsoezg-exit-modal .dyn-wsoezg-modal-tilegrid .dyn-wsoezg-tile { width: 58px; height: 58px; border-radius: 12px; background: color-mix(in srgb, var(--ymp3-a) 22%, transparent); }
#dyn-wsoezg-exit-modal .dyn-wsoezg-modal-panel-note { margin: 14px 0 0; text-align: center; font-family: var(--ymp3-display); font-size: 0.62rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ymp3-paper); opacity: 0.55; }
#dyn-wsoezg-exit-modal .dyn-wsoezg-modal-content-panel { padding: 32px; flex-grow: 1; }
#dyn-wsoezg-exit-modal h2 { margin: 0 0 12px; font-family: var(--ymp3-display); font-size: 1.5rem; letter-spacing: -0.01em; color: var(--ymp3-ink); font-weight: 900; }
#dyn-wsoezg-exit-modal .dyn-wsoezg-modal-description { font-size: 0.95rem; color: var(--ymp3-muted); line-height: 1.6; margin: 0 0 24px; }
#dyn-wsoezg-exit-modal .dyn-wsoezg-modal-offers { display: flex; flex-direction: column; gap: 10px; }
.dyn-wsoezg-modal-offer-item { flex: 1; text-align: center; }
.dyn-wsoezg-modal-offer-item .dyn-wsoezg-offer-title { font-size: 1rem; font-weight: 600; color: #333; margin-bottom: 8px; }
.dyn-wsoezg-modal-offer-item .dyn-wsoezg-offer-button { display: block; text-decoration: none; color: #fff !important; padding: 12px; border-radius: var(--ymp3-r, 8px); font-weight: 600; font-size: 0.9rem; transition: transform 0.2s, box-shadow 0.2s; }
.dyn-wsoezg-modal-offer-item .dyn-wsoezg-offer-button:hover { transform: translateY(-3px); box-shadow: 0 6px 15px rgba(0,0,0,0.2); }
.dyn-wsoezg-modal-offer-item .dyn-wsoezg-offer-button.dyn-wsoezg-pc-fix { background: #0073aa; }
.dyn-wsoezg-modal-offer-item .dyn-wsoezg-offer-button.dyn-wsoezg-driver-update { background: #ff6600; }
#dyn-wsoezg-modal-close { background: none; border: none; cursor: pointer; display: block; font-size: 0.9rem; color: #999; text-decoration: none; margin: 24px auto 0; }
#dyn-wsoezg-modal-close:hover { text-decoration: underline; }
#dyn-wsoezg-exit-modal .dyn-wsoezg-compliance-note { font-size: 0.7rem; color: #aaa; margin-top: 16px; text-align: left;}
#dyn-wsoezg-exit-modal .dyn-wsoezg-compliance-note a { color: #999; }
#dyn-wsoezg-exit-modal-bg { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(20, 37, 51, 0.6); z-index: 9999; }
.dyn-wsoezg-compliance-note { font-size: 0.72rem; color: var(--ymp3-muted, #666); text-align: center; margin: 12px auto 24px; max-width: 100%; }
.dyn-wsoezg-compliance-note a { color: #0073aa; text-decoration: underline; }
</style>
