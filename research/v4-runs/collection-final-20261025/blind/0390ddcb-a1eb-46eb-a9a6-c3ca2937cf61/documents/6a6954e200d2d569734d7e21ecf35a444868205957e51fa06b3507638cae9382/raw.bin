<script id="ym-donation-scope-kofi-behavior-js-after">
(function () {
            var storageKey = "ymDonationKofiQuickHiddenUntil";
            var hideMs = 7 * 24 * 60 * 60 * 1000;

            function getHiddenUntil() {
                try {
                    return Number(window.localStorage.getItem(storageKey) || 0);
                } catch (error) {
                    return 0;
                }
            }

            function isHidden() {
                return getHiddenUntil() > Date.now();
            }

            if (isHidden()) {
                document.documentElement.classList.add("ym-donation-kofi-quick-dismissed");
            }

            function ready(callback) {
                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", callback);
                    return;
                }
                callback();
            }

            // Ads own this corner on several sites (Mediavine floating player, network
            // bottom container) and a few themes park a back-to-top button here. Ad
            // containers sit far above us in z-order, so a blocked button is an
            // invisible button. Rather than fight for the spot, step upwards until the
            // point belongs to us. Runs after ads have had time to settle, twice,
            // because some of them lazy-load on the first scroll.
            function clearOfFurniture(wrap) {
                var tries = 0;

                function attempt() {
                    var rect = wrap.getBoundingClientRect();
                    if (!rect.width || wrap.hidden) {
                        return;
                    }
                    var el = document.elementFromPoint(rect.left + rect.width / 2, rect.top + rect.height / 2);
                    if (!el || wrap.contains(el) || tries >= 4) {
                        return;
                    }
                    var current = parseInt(window.getComputedStyle(wrap).bottom, 10);
                    if (!current) {
                        current = 104;
                    }
                    // Stop climbing before the button reaches the middle of the screen:
                    // on a phone three steps would put it over the article itself, which
                    // is worse than losing the corner to an ad.
                    if (current + 96 > window.innerHeight * 0.45) {
                        return;
                    }
                    tries++;
                    wrap.style.setProperty("--ym-kofi-bottom", (current + 96) + "px");
                    window.setTimeout(attempt, 300);
                }

                // Several ad slots only fill after the first scroll, well past the two
                // early checks, so keep looking for a while and once more on scroll.
                window.setTimeout(attempt, 2500);
                window.setTimeout(attempt, 6500);
                window.setTimeout(attempt, 12000);
                window.setTimeout(attempt, 20000);
                window.addEventListener("scroll", function () {
                    window.setTimeout(attempt, 1200);
                }, { passive: true, once: true });
            }

            ready(function () {
                var wraps = document.querySelectorAll("[data-ym-kofi-quick]");
                if (!wraps.length) {
                    return;
                }

                if (isHidden()) {
                    wraps.forEach(function (wrap) {
                        wrap.hidden = true;
                    });
                    return;
                }

                wraps.forEach(function (wrap) {
                    clearOfFurniture(wrap);

                    var close = wrap.querySelector("[data-ym-kofi-dismiss]");
                    if (!close) {
                        return;
                    }

                    close.addEventListener("click", function (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        wrap.hidden = true;
                        document.documentElement.classList.add("ym-donation-kofi-quick-dismissed");
                        try {
                            window.localStorage.setItem(storageKey, String(Date.now() + hideMs));
                        } catch (error) {}
                    });
                });
            });
        })();
    
//# sourceURL=ym-donation-scope-kofi-behavior-js-after
</script>
