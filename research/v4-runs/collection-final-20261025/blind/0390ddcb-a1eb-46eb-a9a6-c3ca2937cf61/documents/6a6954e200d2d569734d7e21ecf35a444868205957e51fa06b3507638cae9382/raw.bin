        .ym-donation-kofi,
        .ym-donation-kofi * {
            box-sizing: border-box;
        }
        .ym-donation-kofi {
            clear: both;
            display: grid !important;
            grid-template-columns: 1fr;
            justify-items: center;
            align-items: center;
            gap: 20px;
            width: min(100%, 900px);
            min-height: 128px;
            margin: 46px auto 40px;
            padding: 34px 38px;
            border: 1px solid #eef2f7;
            border-radius: 8px;
            background: linear-gradient(180deg, #ffffff 0%, #fffafa 100%);
            box-shadow: 0 16px 36px rgba(15, 23, 42, 0.07);
            color: #1f2937;
            font-family: inherit;
            text-decoration: none !important;
            position: relative;
            z-index: 1;
            overflow: hidden;
            transition: border-color 180ms ease, background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
        }
        .ym-donation-kofi:hover,
        .ym-donation-kofi:focus {
            border-color: #ffc9c9;
            background: linear-gradient(180deg, #ffffff 0%, #fff5f5 100%);
            color: #1f2937;
            text-decoration: none !important;
            transform: translateY(-1px);
            box-shadow: 0 18px 42px rgba(15, 23, 42, 0.09);
        }
        .ym-donation-kofi:before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            background: #ff5f5f;
        }
        .ym-donation-kofi__body {
            display: block;
            min-width: 0;
            max-width: 720px;
            text-align: center;
        }
        .ym-donation-kofi__eyebrow {
            display: block;
            margin: 0 0 8px;
            color: #be123c;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0;
            text-transform: uppercase;
        }
        .ym-donation-kofi__text {
            display: block;
            margin: 0;
            color: #374151;
            font-size: 17px;
            line-height: 1.65;
            text-align: center;
        }
        .ym-donation-kofi__button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            justify-self: center;
            min-width: 190px;
            min-height: 54px;
            padding: 14px 22px;
            border-radius: 6px;
            background: linear-gradient(135deg, #ff5f5f 0%, #e54848 100%);
            color: #ffffff !important;
            font-size: 15px;
            font-weight: 800;
            line-height: 1.2;
            text-decoration: none !important;
            white-space: nowrap;
            animation: ymDonationKofiGlow 2.8s ease-in-out infinite;
        }
        .ym-donation-kofi__button:hover,
        .ym-donation-kofi__button:focus {
            background: linear-gradient(135deg, #ff6b6b 0%, #d93f3f 100%);
            color: #ffffff !important;
        }
        /* Bottom-right corner, every width. The old build docked this into the left
           margin and hid itself whenever the gutter was under ~210px, which on a real
           1440px or 1536px window meant almost every site rendered nothing at all
           (measured 2026-09-08: visible on 1/33 at 1440, 6/33 at 1536). */
        .ym-donation-kofi-quick-wrap {
            clear: both;
            position: fixed;
            right: 18px;
            left: auto;
            /* Lifted clear of the bottom furniture measured across the fleet on
               2026-09-08: anchor ads (adthrive-footer 90px desktop / 50px mobile,
               floating_ads_bottom 58px) and the back-to-top buttons several themes
               park in this corner. Ad containers carry z-index 2147483535, far above
               this one, so an ad always paints over the button and never the reverse,
               and the script below walks the button upwards whenever something else
               owns the spot. */
            bottom: var(--ym-kofi-bottom, 104px);
            z-index: 99998;
            display: block;
            width: auto;
            max-width: calc(100vw - 36px);
            margin: 0;
            padding: 0;
            text-align: left;
        }
        .ym-donation-kofi-quick-wrap[hidden],
        .ym-donation-kofi-quick-dismissed .ym-donation-kofi-quick-wrap {
            display: none !important;
        }
        .ym-donation-kofi-quick {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            max-width: 100%;
        }
        .ym-donation-kofi-float {
            position: static;
            z-index: auto;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 50px;
            padding: 12px 18px;
            border-radius: 999px;
            background: linear-gradient(135deg, #ff5f5f 0%, #e54848 100%);
            color: #ffffff !important;
            font-family: inherit;
            font-size: 14px;
            font-weight: 800;
            line-height: 1.1;
            text-decoration: none !important;
            white-space: nowrap;
            box-shadow: 0 12px 28px rgba(229, 72, 72, 0.26);
            animation: ymDonationKofiGlowDark 2.8s ease-in-out infinite;
        }
        .ym-donation-kofi-float:hover,
        .ym-donation-kofi-float:focus {
            background: linear-gradient(135deg, #ff6b6b 0%, #d93f3f 100%);
            color: #ffffff !important;
            animation-play-state: paused;
        }
        .ym-donation-kofi-quick__close {
            appearance: none;
            -webkit-appearance: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            min-width: 30px;
            height: 30px;
            margin: 0;
            padding: 0;
            border: 1px solid #e5e7eb;
            border-radius: 999px;
            background: #ffffff;
            color: #4b5563;
            cursor: pointer;
            font-family: inherit;
            font-size: 17px;
            font-weight: 700;
            line-height: 1;
            box-shadow: 0 5px 14px rgba(15, 23, 42, 0.12);
        }
        .ym-donation-kofi-quick__close:hover,
        .ym-donation-kofi-quick__close:focus {
            border-color: #ffb4b4;
            background: #fff5f5;
            color: #e54848;
            outline: none;
        }
        @keyframes ymDonationKofiGlow {
            0%,
            100% {
                box-shadow: 0 0 0 0 rgba(255, 95, 95, 0.24);
            }
            50% {
                box-shadow: 0 0 0 7px rgba(255, 95, 95, 0.12);
            }
        }
        @keyframes ymDonationKofiGlowDark {
            0%,
            100% {
                box-shadow: 0 12px 28px rgba(229, 72, 72, 0.26), 0 0 0 0 rgba(255, 95, 95, 0.28);
            }
            50% {
                box-shadow: 0 12px 28px rgba(229, 72, 72, 0.26), 0 0 0 8px rgba(255, 95, 95, 0.14);
            }
        }
        @media (max-width: 900px) {
            .ym-donation-kofi {
                align-items: flex-start;
                gap: 18px;
                min-height: 0;
                padding: 22px;
            }
            .ym-donation-kofi__button {
                width: 100%;
                justify-self: stretch;
                margin-top: 2px;
            }
        }
        @media (max-width: 1024px) {
            .ym-donation-kofi-float {
                min-height: 44px;
                padding: 10px 14px;
                font-size: 13px;
            }
        }
        @media (max-width: 600px) {
            .ym-donation-kofi-quick-wrap {
                right: 12px;
                bottom: var(--ym-kofi-bottom, 76px);
            }
            .ym-donation-kofi-quick {
                gap: 8px;
            }
            .ym-donation-kofi-float {
                min-height: 42px;
                padding: 9px 13px;
                font-size: 12.5px;
            }
            .ym-donation-kofi-quick__close {
                width: 26px;
                min-width: 26px;
                height: 26px;
                font-size: 15px;
            }
        }
        /* Dark mode. The card now sits inside the article instead of after it, so a
           white block in a dark theme is no longer something a reader scrolls past.
           Themes that stamp html[data-theme="dark"] and readers who never touch a
           toggle (prefers-color-scheme) are both covered. The coral CTA stays: it is
           the brand colour and it reads fine on a dark surface. */
        @media (prefers-color-scheme: dark) {
            html:not([data-theme="light"]) .ym-donation-kofi,
            html:not([data-theme="light"]) .ym-donation-kofi:hover,
            html:not([data-theme="light"]) .ym-donation-kofi:focus {
                border-color: #2a3038;
                background: linear-gradient(180deg, #171a1f 0%, #1d2128 100%);
                color: #e8eaed;
                box-shadow: 0 16px 36px rgba(0, 0, 0, 0.38);
            }
            html:not([data-theme="light"]) .ym-donation-kofi__eyebrow {
                color: #ff8a8a;
            }
            html:not([data-theme="light"]) .ym-donation-kofi__text {
                color: #c3c7cd;
            }
            html:not([data-theme="light"]) .ym-donation-kofi-quick__close {
                border-color: #2a3038;
                background: #171a1f;
                color: #c3c7cd;
            }
        }
        html[data-theme="dark"] .ym-donation-kofi,
        html[data-theme="dark"] .ym-donation-kofi:hover,
        html[data-theme="dark"] .ym-donation-kofi:focus {
            border-color: #2a3038;
            background: linear-gradient(180deg, #171a1f 0%, #1d2128 100%);
            color: #e8eaed;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.38);
        }
        html[data-theme="dark"] .ym-donation-kofi__eyebrow {
            color: #ff8a8a;
        }
        html[data-theme="dark"] .ym-donation-kofi__text {
            color: #c3c7cd;
        }
        html[data-theme="dark"] .ym-donation-kofi-quick__close {
            border-color: #2a3038;
            background: #171a1f;
            color: #c3c7cd;
        }
        @media (prefers-reduced-motion: reduce) {
            .ym-donation-kofi__button,
            .ym-donation-kofi-float {
                animation: none;
            }
        }
    
/*# sourceURL=ym-donation-scope-kofi-inline-css */
