<script id="ym-aawp-creators-price-hydrator-20260606-2">
(function(){
  if (window.YM_AAWP_CREATORS_PRICE_HYDRATOR_20260606_2) return;
  window.YM_AAWP_CREATORS_PRICE_HYDRATOR_20260606_2 = true;
  var endpoint = "https:\/\/pcnmobile.com\/wp-json\/ym-aawp-creators\/v1\/prices";
  function collect(){
    var seen = Object.create(null), asins = [];
    document.querySelectorAll('.aawp-product[data-aawp-product-id], [data-aawp-product-id], [data-aawp-product-asin]').forEach(function(el){
      var asin = (el.getAttribute('data-aawp-product-id') || el.getAttribute('data-aawp-product-asin') || '').trim();
      if (/^[A-Z0-9]{10}$/.test(asin) && !seen[asin]) {
        seen[asin] = true;
        asins.push(asin);
      }
    });
    return asins.slice(0, 40);
  }
  function priceTargets(root){
    return Array.prototype.slice.call(root.querySelectorAll(
      '.aawp-product__price:not(.aawp-product__price--old):not(.aawp-product__price--saved),' +
      '.aawp-box__price--current,.price--current'
    ));
  }
  function rootsForAsin(asin){
    return Array.prototype.slice.call(document.querySelectorAll('[data-aawp-product-id="' + asin + '"], [data-aawp-product-asin="' + asin + '"]'));
  }
  function clearNotice(node){
    var n = node.parentNode && node.parentNode.querySelector ? node.parentNode.querySelector('.ym-creators-price-timestamp') : null;
    if (n) n.remove();
  }
  function writeNotice(node, text){
    clearNotice(node);
    if (!text) return;
    var small = document.createElement('small');
    small.className = 'ym-creators-price-timestamp';
    small.style.display = 'block';
    small.style.fontSize = '11px';
    small.style.lineHeight = '1.3';
    small.style.color = '#667085';
    small.textContent = text;
    node.insertAdjacentElement('afterend', small);
  }
  function writeFallback(root, updatedAt){
    priceTargets(root).forEach(function(node){
      node.textContent = '';
      node.style.display = 'none';
      node.style.visibility = 'hidden';
      node.setAttribute('data-ym-creators-price-stale', '1');
      if (updatedAt) node.setAttribute('data-ym-creators-price-updated', updatedAt);
      clearNotice(node);
    });
  }
  function apply(items, asins){
    items = items || {};
    Object.keys(items).forEach(function(asin){
      var item = items[asin];
      rootsForAsin(asin).forEach(function(root){
        if (!item || item.stale || !item.html) {
          writeFallback(root, item && item.updated_at ? item.updated_at : '');
          return;
        }
        priceTargets(root).forEach(function(node){
          node.innerHTML = item.html;
          node.style.display = '';
          node.style.visibility = 'visible';
          node.removeAttribute('data-ym-creators-price-stale');
          node.setAttribute('data-ym-creators-price-updated', item.updated_at || '');
          writeNotice(node, item.needs_time ? item.time_html : '');
        });
      });
    });
    (asins || []).forEach(function(asin){
      if (items[asin]) return;
      rootsForAsin(asin).forEach(function(root){ writeFallback(root, ''); });
    });
    try { window.dispatchEvent(new Event('ym:aawp:price-hydrated')); } catch(e) {}
  }
  var asked = {};
  function run(){
    var asins = collect();
    if (!asins.length || !window.fetch) return;
    var key = asins.join(',');
    if (asked[key]) return;   // the load-event re-run only matters when new boxes appeared
    asked[key] = 1;
    // one URL per 10 minutes for everyone (not a per-call cache-buster), so the browser, nginx and Cloudflare can answer it
    fetch(endpoint + '?asins=' + encodeURIComponent(key) + '&_ym=' + Math.floor(Date.now() / 600000), {credentials:'same-origin'})
      .then(function(res){ return res.ok ? res.json() : null; })
      .then(function(data){ if (data && data.items) apply(data.items, asins); })
      .catch(function(){});
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  else run();
  window.addEventListener('load', run);
})();
</script>
