<style id="ym-fix-kofi-phone">@media (max-width:600px){.ym-donation-kofi-quick-wrap{display:none!important}}</style>
<style id="ym-disable-sticky-header-css">
html {
	scroll-padding-top: 0 !important;
}

body.ym-theme-generatepress .main-navigation.navigation-stick,
body.ym-theme-generatepress .main-navigation.is_stuck,
body.ym-theme-generatepress .sticky-enabled .main-navigation.is_stuck,
