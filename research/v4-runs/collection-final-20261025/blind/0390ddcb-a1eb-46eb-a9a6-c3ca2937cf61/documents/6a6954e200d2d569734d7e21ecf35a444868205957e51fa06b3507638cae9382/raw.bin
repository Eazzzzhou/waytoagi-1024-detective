<script id="ym-disable-sticky-header-js">
(function () {
  function resetGeneratePress() {
    document.querySelectorAll('.main-navigation.navigation-stick, .main-navigation.is_stuck, #mobile-header.navigation-stick, #mobile-header.is_stuck').forEach(function (el) {
      el.classList.remove('navigation-stick', 'is_stuck');
      ['position', 'top', 'right', 'left', 'bottom', 'width', 'max-width', 'transform'].forEach(function (prop) {
        el.style.removeProperty(prop);
      });
    });
  }

  function resetAsona() {
    document.querySelectorAll('.site-header[data-is-sticky], .site-header[data-sticky-animate]').forEach(function (el) {
      el.removeAttribute('data-is-sticky');
      el.removeAttribute('data-sticky-animate');
    });
  }

  function resetDivi() {
    var header = document.getElementById('main-header');
    if (header) {
      header.classList.remove('et-fixed-header');
    }
    document.body.classList.remove('et_fixed_nav_temp');
  }

  function run() {
    if (document.body.classList.contains('ym-theme-generatepress')) {
      resetGeneratePress();
    } else if (document.body.classList.contains('ym-theme-asona')) {
      resetAsona();
    } else if (document.body.classList.contains('ym-theme-divi')) {
      resetDivi();
    }
  }

  run();
  window.addEventListener('load', run, { passive: true });
  window.addEventListener('resize', run, { passive: true });
  window.addEventListener('scroll', run, { passive: true });
})();
</script>
