  (function () {
    var form = document.getElementById('oc-signup-form');
    if (!form) return;
    var msg = document.getElementById('oc-signup-msg');
    var input = document.getElementById('oc-signup-email');
    var btn = form.querySelector('button[type="submit"]');

    function say(text, state) {
      msg.textContent = text;
      if (state) { msg.setAttribute('data-state', state); }
      else { msg.removeAttribute('data-state'); }
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = input.value.trim();
      if (!email || !input.checkValidity()) {
        say('Enter a valid email address.', 'error');
        input.focus();
        return;
      }
      btn.disabled = true;
      var original = btn.textContent;
      btn.textContent = 'Subscribing...';
      say('');

      fetch('https://gjufxkpcv0.execute-api.us-east-1.amazonaws.com/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: email,
          tag: 'openclawdc-newsletter',
          source: 'openclawdc',
          page: window.location.pathname,
          website: form.querySelector('input[name="website"]').value
        })
      })
        .then(function (res) {
          if (!res.ok) throw new Error('Signup failed');
          return res.json().catch(function () { return {}; });
        })
        .then(function (data) {
          say((data && data.message) || "You're in. See you Wednesday.");
          input.value = '';
          if (typeof gtag !== 'undefined') {
            gtag('event', 'newsletter_signup', {
              page: window.location.pathname,
              position: 'blog_inline',
              source: 'openclawdc',
              tag: 'openclawdc-newsletter',
              list_tag: 'openclawdc-newsletter'
            });
          }
        })
        .catch(function () {
          say('Something went wrong. Please try again.', 'error');
        })
        .finally(function () {
          btn.disabled = false;
          btn.textContent = original;
        });
    });
  })();
  </script>  <script>
