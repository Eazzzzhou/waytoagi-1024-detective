              page: location.pathname
            })
          }).then(function (res) {
            if (!res.ok) throw new Error('failed');
            msg.style.display = 'block';
            msg.style.color = '#2e7d43';
            msg.textContent = "You're in! Check your inbox Wednesday.";
            emailEl.value = '';
            if (window.gtag) gtag('event', 'newsletter_signup', {
              location: 'footer',
              source: 'openclawdc',
              tag: 'openclawdc-newsletter',
              list_tag: 'openclawdc-newsletter',
              page: location.pathname
            });
          }).catch(function () {
            msg.style.display = 'block';
            msg.style.color = '#ef4444';
            msg.textContent = 'Something went wrong. Please try again.';
          }).finally(function () {
            btn.disabled = false;
            btn.textContent = 'Subscribe';
          });
        });
      })();
    </script> <!-- Safety-net outbound/affiliate click tracking. Most CTAs fire their own
         inline gtag event; this only covers links that do NOT already have one,
         so nothing is double-counted. --> <script>
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a || !window.gtag || a.hasAttribute('data-ga-manual')) return;
        var inline = a.getAttribute('onclick');
        if (inline && inline.indexOf('gtag') !== -1) return; // already tracked
        var href = a.getAttribute('href') || '';
        if (/amzn\.to|amazon\./i.test(href)) {
          gtag('event', 'affiliate_click', { location: 'auto', url: href, page: location.pathname });
        } else if (/\/ai-training\/?|cloudyeti\.io\/meet/i.test(href)) {
          gtag('event', 'training_page_cta_click', { location: 'auto', url: href, page: location.pathname });
        }
      }, true);
    </script> </body> </html>