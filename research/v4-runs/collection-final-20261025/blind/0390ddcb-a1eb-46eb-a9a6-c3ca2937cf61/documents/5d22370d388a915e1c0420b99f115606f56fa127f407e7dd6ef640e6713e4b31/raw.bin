      (function () {
        var widget = document.getElementById('fb-widget');
        if (!widget) return;
        var ask = document.getElementById('fb-ask');
        var form = document.getElementById('fb-form');
        var thanks = document.getElementById('fb-thanks');
        var rating = '';
        function post(payload) {
          payload.site = 'openclawdc.com';
          payload.page = location.pathname;
          return fetch('https://n2ipbuesqk.execute-api.us-east-1.amazonaws.com/feedback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        }
        widget.querySelectorAll('[data-fb]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            rating = btn.getAttribute('data-fb');
            post({ rating: rating }).catch(function () {});
            if (window.gtag) gtag('event', 'feedback_rating', { rating: rating, page: location.pathname });
            ask.hidden = true;
            ask.style.display = 'none';
            form.hidden = false;
          });
        });
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var msg = document.getElementById('fb-msg').value.trim();
          var hp = form.querySelector('input[name="website"]').value;
          if (msg) post({ rating: rating, message: msg, website: hp }).catch(function () {});
          form.hidden = true;
          thanks.hidden = false;
        });
        document.getElementById('fb-skip').addEventListener('click', function () {
          form.hidden = true;
          thanks.hidden = false;
        });
      })();
    </script> <!-- Footer newsletter capture — posts to the same endpoint as /newsletter. --> <script>
