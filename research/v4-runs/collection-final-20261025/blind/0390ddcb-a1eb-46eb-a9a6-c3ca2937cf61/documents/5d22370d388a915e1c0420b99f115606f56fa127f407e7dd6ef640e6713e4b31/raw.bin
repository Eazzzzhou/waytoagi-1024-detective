          btn.textContent = 'Subscribing...';
          fetch('https://gjufxkpcv0.execute-api.us-east-1.amazonaws.com/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: emailEl.value,
              source: 'openclawdc',
