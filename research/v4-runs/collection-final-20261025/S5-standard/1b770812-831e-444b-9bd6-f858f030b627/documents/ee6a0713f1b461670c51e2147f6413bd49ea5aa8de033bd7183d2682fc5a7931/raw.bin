hite [\u0026_p]:mb-5 [\u0026_p]:text-[17px] [\u0026_p]:text-zinc-800 [\u0026_p]:leading-[1.7] [\u0026_p]:dark:text-zinc-200 [\u0026_strong]:font-semibold [\u0026_strong]:text-zinc-950 [\u0026_strong]:dark:text-white [\u0026_ul]:mb-6 [\u0026_ul]:ml-0 [\u0026_ul]:list-none [\u0026_ul]:p-0 [\u0026_ul_li]:relative [\u0026_ul_li]:mb-2.5 [\u0026_ul_li]:pl-[22px] [\u0026_ul_li]:text-[16px] [\u0026_ul_li]:text-zinc-700 [\u0026_ul_li]:leading-[1.6] [\u0026_ul_li]:before:absolute [\u0026_ul_li]:before:top-[11px] [\u0026_ul_li]:before:left-0.5 [\u0026_ul_li]:before:size-1.5 [\u0026_ul_li]:before:rounded-full [\u0026_ul_li]:before:bg-ignition [\u0026_ul_li]:before:content-[''] [\u0026_ul_li]:dark:text-zinc-30038:[\"$\",\"section\",null,{\"className\":\"relative bg-white dark:bg-zinc-950\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-[1320px] grid-cols-1 gap-10 px-6 py-16 md:px-8 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-14 xl:grid-cols-[260px_minmax(0,1fr)_280px]\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"sticky top-[84px] hidden self-start lg:block\",\"children\":[\"$\",\"$L43\",null,{\"items\":[{\"id\":\"takeaways\",\"label\":\"Key takeaways\",\"number\":\"00\"},{\"id\":\"whats-new\",\"label\":\"What's new\",\"number\":\"01\"},{\"id\":\"agents-window\",\"label\":\"Agents panel\",\"number\":\"02\"},{\"id\":\"design-mode\",\"label\":\"Design-to-code\",\"number\":\"03\"},{\"id\":\"composer-evolution\",\"label\":\"Composer\",\"number\":\"04\"},{\"id\":\"mcp-model-routing\",\"label\":\"MCP + routing\",\"number\":\"05\"},{\"id\":\"vs-claude-code\",\"label\":\"vs Claude Code\",\"number\":\"06\"},{\"id\":\"rollout-pitfalls\",\"label\":\"Pitfalls\",\"number\":\"07\"},{\"id\":\"faq\",\"label\":\"FAQ\",\"number\":\"08\"}]}]}],[\"$\",\"article\",null,{\"className\":\"prose-none min-w-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"$44\",\"children\":[[\"$\",\"p\",null,{\"className\":\"lede\",\"children\":[\"Cursor 3 is the first version of the AI IDE that genuinely earns the \\\"agentic\\\" label. Three working surfaces — the parallel\",\" \",[\"$\",\"a\",null,{\"className\":\"link\",\"href\":\"https://cursor.com/en-US\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":\"Agents\"}],\" \",\"panel, a design-driven Composer workflow, and a meaningfully evolved multi-file\",\" \",[\"$\",\"a\",null,{\"className\":\"link\",\"href\":\"https://cursor.com/blog/2-0\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":\"Composer\"}],\" \",\"— move Cursor from a smart code editor into a multi-agent orchestration environment, and the head-to-head against Claude Code finally becomes a workload-specific choice rather than a brand preference.\"]}],[\"$\",\"p\",null,{\"children\":[\"The headline change is structural rather than cosmetic. Cursor 2 was already agent-centered (see Cursor's own\",\" \",\"$L45\",\"), but Cursor 3 hardens parallel agents, design-driven scaffolding and explicit approval gates as first-class workflows. Each of those addresses a real gap that teams hit when trying to scale AI-assisted development beyond solo experimentation. This guide walks through what shipped per Cursor's\",\" \",\"$L46\",\", how those surfaces compose in day-to-day work, and how Cursor 3 stacks up against Claude Code on three representative workloads.\"]}],\"$L47\"]}],\"$L48\",\"$L49\",\"$L4a\",\"$L4b\",\"$L4c\",\"$L4d\",\"$L4e\",\"$L4f\",\"$L50\",\"$L51\",\"$L52\",\"$L53\",\"$L54\",\"$L55\",\"$L56\",\"$L57\",\"$L58\",\"$L59\",\"$L5a\",\"$L5b\",\"$L5c\",\"$L5d\",\"$L5e\",\"$L5f\",\"$L60\",\"$L61\",\"$L62\",\"$L63\",\"$L64\",\"$L65\",\"$L66\",\"$L67\",\"$L68\",\"$L69\",\"$L6a\"]}],\"$L6b\"]}]}]\n39:[\"$\",\"section\",null,{\"className\":\"relative isolate overflow-hidden bg-[#0a0a0b] py-20 text-white\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"mask-[radial-gradient(ellipse_at_center,black_30%,transparent_75%)] pointer-events-none absolute inset-0 [-webkit-mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)] [background-image:linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:56px_56px]\"}],[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"pointer-events-none absolute top-1/2 left-1/2 size-[900px] -translate-x-1/2 -translate-y-1/2 blur-[30px] [background:radial-gradient(circle,rgba(255,107,26,0.18),rgba(255,107,26,0.04)_30%,transparent_65%)]\"}],[\"$\",\"div\",null,{\"className\":\"relative z-[2] mx-auto grid max-w-[1320px] items-center gap-14 px-4 md:px-8 lg:grid-cols-[1.3fr_1fr]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-4.5 inline-flex items-center gap-2.5 font-mono text-[11px] text-ignition uppercase tracking-[0.14em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-px w-5 bg-ignition\"}],\"Pick the right AI IDE\"]}],[\"$\",\"h2\",null,{\"className\":\"m-0 mb-4.5 font-light text-[clamp(30px,3.8vw,50px)] leading-[1.04] tracking-[-0.03em]\",\"children\":[\"AI IDE choice is workload-dependent — Cursor 3 wins\",\" \",[\"$\",\"em\",null,{\"className\":\"bg-clip-text font-normal font-serif text-transparent italic\",\"style\":{\"backgroundImage\":\"linear-gradient(180deg, #fff 40%, var(--color-ignition-2) 80%, var(--color-ignition) 100%)\"},\"children\":\"some\"}],\" \",\"workloads, not all.\"]}],[\"$\",\"p\",null,{\"className\":\"m-0 mb-7 max-w-[520px] text-[16px] text-white/72 leading-[1.6]\",\"children\":\"Our team runs head-to-head AI IDE assessments — Cursor, Claude Code, Codex CLI, Windsurf — calibrated to your team's workloads, with measurable productivity outcomes.\"}],[\"$\",\"div\",null,{\"className\":\"mb-6 flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L28\",null,{\"className\":\"group relative inline-flex h-[52px] items-center justify-center gap-2 overflow-hidden rounded-lg bg-[#0a0a0b] px-7 font-medium text-[15px] text-white shadow-[0_0_0_1px_#0a0a0b,0_10px_30px_-10px_rgba(255,107,26,0.4)] transition-transform hover:-translate-y-0.5\",\"data-cta-location\":\"final-primary\",\"href\":\"/get-started\",\"children\":[[\"$\",\"span\",null,{\"className\":\"relative z-[1]\",\"children\":\"Get started\"}],[\"$\",\"$L6c\",null,{\"ref\":\"$undefined\",\"icon\":{\"name\":\"arrow-up-right\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M7 7h10v10\",\"key\":\"1tivn9\"}],[\"path\",{\"d\":\"M7 17 17 7\",\"key\":\"1vkiza\"}]]},\"className\":\"relative z-[1] size-4 transition-transform group-hover:translate-x-0.5\"}]]}],[\"$\",\"$L28\",null,{\"className\":\"inline-flex h-[52px] items-center justify-center gap-2 rounded-lg border border-white/15 bg-white/5 px-7 font-medium text-[15px] text-white transition-colors hover:border-white/30 hover:bg-white/10\",\"data-cta-location\":\"final-secondary\",\"href\":\"/services/ai-transformation\",\"children\":\"Explore AI \u0026 digital transformation\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-x-7 gap-y-2 font-mono text-[11px] text-white/55 uppercase tracking-[0.1em]\",\"children\":[[\"$\",\"span\",\"0\",{\"className\":\"inline-flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"size-1.5 rounded-full bg-ignition\"}],\"Free consultation\"]}],[\"$\",\"span\",\"1\",{\"className\":\"inline-flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"size-1.5 rounded-full bg-ignition\"}],\"Expert guidance\"]}],[\"$\",\"span\",\"2\",{\"className\":\"inline-flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"size-1.5 rounded-full bg-ignition\"}],\"Tailored solutions\"]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] p-7\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"style\":{\"position\":\"absolute\",\"inset\":-1,\"borderRadius\":\"18px\",\"padding\":1,\"background\":\"linear-gradient(135deg,#ff6b1a,transparent 60%)\",\"WebkitMask\":\"linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0)\",\"WebkitMaskComposite\":\"xor\",\"mask\":\"linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0)\",\"maskComposite\":\"exclude\",\"pointerEvents\":\"none\"}}],\"$L6d\",\"$L6e\",\"$L6f\"]}]]}]]}]\n3a:[\"$\",\"$L70\",null,{\"eyebrow\":\"FAQ · Cursor 3\",\"id\":\"faq\",\"items\":[{\"question\":\"How is the Cursor 3 multi-agent panel different from the single-agent flow in earlier Cursor?\",\"answer\":\"Earlier Cursor was, in practice, one assistant living inside the editor — you typed into a single chat, the assistant edited the codebase, and switching tasks meant switching context inside that one conversation. Cursor's Agents surface (built out across 2.0 and hardened in 3.x) introduces multiple parallel agents in the same workspace, each with its own working set, model selection, approval policy, and conversation history. You can spawn a research agent reading the codebase while a build agent is implementing features and a review agent is watching the diff for regressions. The unit of work shifts from 'one chat message' to 'one workspace of parallel collaborators'. In practice the human role becomes more about ferrying context between agents and approving diffs, less about typing prompts into a single conversation.\"},{\"question\":\"Is Cursor's design-to-code workflow actually useful for real designers, or is it just a demo?\",\"answer\":\"It's genuinely useful for component scaffolding, and meaningfully less useful for pixel-perfect production work. Cursor does not ship a separately branded design-to-code product on cursor.com/features; the real surface is the design-driven workflow Composer unlocks when you feed it a reference image. The honest answer: feeding a Figma component into Composer takes it from 0% to about 70% complete — reasonable markup, semantic structure, approximate spacing, decent Tailwind classes — in about two minutes. That removes a lot of mechanical implementation work. The remaining 30% — animation, focus states, accessibility, design-token consistency, the interaction polish that distinguishes shipped UI from a wireframe — still requires a designer-developer pair conversation. Teams that scope this workflow to one component at a time, with a deliberate review pass, get real lift. Teams that try to scaffold whole pages tend to ship output that looks AI-generated.\"},{\"question\":\"What do Composer's approval gates change in day-to-day work?\",\"answer\":\"The behavior change is that multi-file edits now stage as a single reviewable diff with per-file accept or reject controls, before anything writes to disk. The cognitive load reduction is bigger than it sounds. In the legacy auto-apply flow, a 12-file Composer run wrote 12 files and you had to remember which writes you wanted to keep and which to undo. That works for short sessions; it breaks down across longer ones. The new model stages everything as one preview, you accept or reject per file, and only accepted files write. For teams working on a shared codebase, this should be the team default. Auto-apply still exists in settings and is fine for solo experimentation on scratch projects, but turning it on in production is a regression-risk accelerator.\"},{\"question\":\"Which MCP servers should I wire up first in Cursor 3, and how should I scope them?\",\"answer\":\"Start with two: a filesystem MCP and either Linear or GitHub depending on where your issue tracking lives. Cursor 3's per-agent MCP scoping is the right primitive — give a build agent the filesystem MCP, give a planning agent the Linear MCP, give a review agent read-only GitHub, and don't expose either of the latter to the build agent. From there you can add documentation MCP servers (Notion, Confluence) for research agents, and observability MCP servers (Sentry, Datadog) for review agents. Avoid the temptation to grant every agent access to every server — the audit trail gets noisy fast, and the model has to think harder about which tools to use. Scoped access is both safer and gives you better output quality.\"},{\"question\":\"How does Cursor 3 compare on pricing with Claude Code?\",\"answer\":\"Pricing on both tools moves frequently, so verify the current numbers on cursor.com and Anthropic's site before standardizing a rollout. The high-level shape: Cursor's per-seat plan plus per-request model costs versus Claude Code's flat per-user subscription including most usage. For a team running multiple parallel agents on top-tier models, Cursor's per-request costs can accumulate quickly — which is why the routing policy matters so much (research agents on long-context bargain models, only build agents on top-tier coding models). For terminal-first teams running Claude Code within a flat-rate plan, the cost ceiling is more predictable. Most teams running both tools find that the cost difference is modest once routing is sensible; the bigger driver is which workloads each tool wins, not the per-token math.\"},{\"question\":\"What's the safest path to migrate a team from Cursor 2 to Cursor 3?\",\"answer\":\"Roll the three surfaces in sequence, not in parallel. Week one: upgrade everyone to Cursor 3, switch Composer to preview-then-approve as the team default, and leave the Agents panel unused. That alone reduces regression risk on multi-file edits without introducing new behaviors to learn. Week two: introduce the Agents panel with a strict cap of one writing agent plus one read-only research or review agent per developer. Week three: introduce the design-driven Composer workflow for component scaffolding only, with a clear rule that it is not for full pages and not a replacement for design review. Week four: review routing policy, token spend per agent, and approval-queue throughput. Adjust based on what you measure. Teams that try to introduce all three surfaces at once tend to hit the four pitfalls covered above simultaneously, which makes the rollout feel chaotic when it doesn't need to.\"}],\"title\":\"$L71\",\"variant\":\"section\"}]\n3b:[[\"$\",\"div\",null,{\"className\":\"bg-white px-6 pb-16 md:px-8 xl:group-has-[[data-blog-rail]]/blog:hidden dark:bg-zinc-950\",\"data-newsletter-inline\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-xl\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative rounded-[18px] bg-[#0a0a0b] p-5 text-white\",\"data-newsletter-card\":true,\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-3.5 block font-mono text-[10.5px] text-ignition-2 uppercase tracking-[0.12em]\",\"children\":\"Digital Applied newsletter\"}],[\"$\",\"h4\",null,{\"className\":\"m-0 mb-2.5 font-medium text-[15px] text-white leading-[1.3] tracking-[-0.01em]\",\"children\":\"Deep dives on AI, marketing and development.\"}],[\"$\",\"p\",null,{\"className\":\"m-0 mb-3.5 text-[12.5px] text-white/65 leading-normal\",\"children\":\"Practical guides and fresh insights by email. No recycled takes.\"}],[\"$\",\"$L73\",null,{\"source\":\"blog-inline\"}]]}]}]}],[\"$\",\"section\",null,{\"className\":\"bg-zinc-100 py-24 dark:bg-zinc-900\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1320px] px-4 md:px-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-3.5 inline-flex items-center gap-2.5 font-mono text-[11px] text-zinc-500 uppercase tracking-[0.14em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-px w-5 bg-ignition\"}],\"Related dispatches\"]}],[\"$\",\"h2\",null,{\"className\":\"m-0 font-normal text-[clamp(30px,3.6vw,44px)] text-zinc-950 leading-[1.05] tracking-[-0.025em] dark:text-white\",\"children\":[\"Continue exploring \",[\"$\",\"em\",null,{\"children\":\"AI IDEs.\"}]]}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-3\",\"children\":[[\"$\",\"$L28\",\"zed-ai-coding-deep-dive-multiplayer-agents-2026\",{\"className\":\"group flex min-h-[260px] flex-col gap-3.5