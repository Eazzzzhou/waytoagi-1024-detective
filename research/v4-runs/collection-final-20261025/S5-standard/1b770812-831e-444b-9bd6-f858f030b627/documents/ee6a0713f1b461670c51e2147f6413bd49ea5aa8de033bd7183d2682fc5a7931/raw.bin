,\"children\":[[\"$\",\"span\",null,{\"className\":\"self-start rounded-sm border border-ignition/20 bg-ignition/5 px-2 py-1 font-mono text-[10.5px] text-ignition uppercase tracking-[0.12em]\",\"children\":\"Development\"}],[\"$\",\"h4\",null,{\"className\":\"m-0 mt-1 font-medium text-[19px] text-zinc-950 leading-[1.22] tracking-[-0.015em] transition-colors group-hover:text-ignition dark:text-white\",\"children\":\"Windsurf 2 Deep Dive: Cascade Agents + Workflows 2026\"}],\"$L74\",\"$L75\"]}],\"$L76\",\"$L77\"]}],\"$L78\"]}]}]]\n3c:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3wmhf_43x-m0n.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n3d:[\"$\",\"$L79\",null,{\"children\":[\"$\",\"$1e\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@7a\"}]}]\n3f:[\"$\",\"div\",\"New surfaces\",{\"className\":\"relative bg-[#0a0a0b] px-5 py-6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-3.5 block font-mono text-[10.5px] text-white/50 uppercase tracking-[0.12em]\",\"children\":\"New surfaces\"}],[\"$\",\"div\",null,{\"className\":\"flex items-baseline gap-1 font-light text-[40px] text-white leading-none tracking-[-0.03em]\",\"children\":\"3\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[11.5px] text-white/55 leading-[1.4]\",\"children\":\"Agents · Design · Composer\"}],null,null]}]\n40:[\"$\",\"div\",\"Workloads compared\",{\"className\":\"relative bg-[#0a0a0b] px-5 py-6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-3.5 block font-mono text-[10.5px] text-white/50 uppercase tracking-[0.12em]\",\"children\":\"Workloads compared\"}],[\"$\",\"div\",null,{\"className\":\"flex items-baseline gap-1 font-light text-[40px] text-white leading-none tracking-[-0.03em]\",\"children\":\"3\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[11.5px] text-white/55 leading-[1.4]\",\"children\":\"vs Claude Code head-to-head\"}],null,null]}]\n41:[\"$\",\"div\",\"Model picks\",{\"className\":\"relative bg-[#0a0a0b] px-5 py-6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-3.5 block font-mono text-[10.5px] text-white/50 uppercase tracking-[0.12em]\",\"children\":\"Model picks\"}],[\"$\",\"div\",null,{\"className\":\"flex items-baseline gap-1 font-light text-[40px] text-white leading-none tracking-[-0.03em]\",\"children\":[\"$\",\"span\",null,{\"className\":\"font-light font-sans text-white\",\"children\":\"Multi\"}]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[11.5px] text-white/55 leading-[1.4]\",\"children\":\"Claude · GPT · Gemini\"}],null,null]}]\n42:[\"$\",\"div\",\"Recommended start\",{\"className\":\"relative bg-[#0a0a0b] px-5 py-6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-3.5 block font-mono text-[10.5px] text-white/50 uppercase tracking-[0.12em]\",\"children\":\"Recommended start\"}],[\"$\",\"div\",null,{\"className\":\"flex items-baseline gap-1 font-light text-[40px] text-white leading-none tracking-[-0.03em]\",\"children\":[\"$\",\"span\",null,{\"className\":\"font-light font-sans text-white\",\"children\":\"Composer + 1\"}]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[11.5px] text-white/55 leading-[1.4]\",\"children\":\"+ single agent\"}],null,null]}]\n45:[\"$\",\"a\",null,{\"className\":\"link\",\"href\":\"https://cursor.com/blog/2-0\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":\"2.0 announcement\"}]\n46:[\"$\",\"a\",null,{\"className\":\"link\",\"href\":\"https://cursor.com/changelog\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":\"changelog\"}]\n47:[\"$\",\"p\",null,{\"children\":[\"Note on terminology: Cursor brands the multi-agent panel and the design-driven workflow as\",\" \",[\"$\",\"a\",null,{\"className\":\"link\",\"href\":\"https://cursor.com/en-US\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":\"Agents\"}],\" \",\"and Composer rather than as separate products. The goal here is a clear workload-to-tool mapping you can defend in a procurement conversation, not a feature checklist.\"]}]\n48:[\"$\",\"div\",null,{\"className\":\"my-12 scroll-mt-[90px] border-zinc-950 border-t-2 pt-7 dark:border-white\",\"id\":\"takeaways\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-6 flex items-center gap-2.5 font-mono text-[11px] text-zinc-950 uppercase tracking-[0.14em] dark:text-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"size-1.5 rounded-full bg-ignition shadow-[0_0_8px_var(--color-ignition)]\"}],\"Key takeaways\"]}],[\"$\",\"ol\",null,{\"className\":\"m-0 list-none p-0\",\"children\":[[\"$\",\"li\",\"The parallel Agents panel is the killer feature.\",{\"className\":\"grid grid-cols-[40px_1fr] gap-4 border-zinc-200 border-b py-5 last:border-b-0 dark:border-zinc-800\",\"children\":[[\"$\",\"span\",null,{\"className\":\"pt-1 font-mono text-[12px] text-ignition tracking-[0.08em]\",\"children\":\"01\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-1.5 block font-semibold text-[15.5px] text-zinc-950 leading-[1.4] tracking-[-0.005em] dark:text-white\",\"children\":\"The parallel Agents panel is the killer feature.\"}],[\"$\",\"span\",null,{\"className\":\"text-[14.5px] text-zinc-600 leading-[1.6] dark:text-zinc-400\",\"children\":\"Cursor's Agents surface (built out across 2.0 and 3.x) lets you run several agents in parallel on different tasks in one project — each with its own working set, model, and approval policy. It changes how mid-sized refactors feel.\"}]]}]]}],[\"$\",\"li\",\"Design-driven Composer workflows genuinely lift design-to-code work.\",{\"className\":\"grid grid-cols-[40px_1fr] gap-4 border-zinc-200 border-b py-5 last:border-b-0 dark:border-zinc-800\",\"children\":[[\"$\",\"span\",null,{\"className\":\"pt-1 font-mono text-[12px] text-ignition tracking-[0.08em]\",\"children\":\"02\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-1.5 block font-semibold text-[15.5px] text-zinc-950 leading-[1.4] tracking-[-0.005em] dark:text-white\",\"children\":\"Design-driven Composer workflows genuinely lift design-to-code work.\"}],[\"$\",\"span\",null,{\"className\":\"text-[14.5px] text-zinc-600 leading-[1.6] dark:text-zinc-400\",\"children\":\"Feeding a reference image into Composer and iterating against the rendered output closes a real loop that Figma plugins and ad-hoc screenshot prompts never did. Best for component scaffolding, not pixel-perfect production work.\"}]]}]]}],[\"$\",\"li\",\"Composer's explicit approval gates are the right default.\",{\"className\":\"grid grid-cols-[40px_1fr] gap-4 border-zinc-200 border-b py-5 last:border-b-0 dark:border-zinc-800\",\"children\":[[\"$\",\"span\",null,{\"className\":\"pt-1 font-mono text-[12px] text-ignition tracking-[0.08em]\",\"children\":\"03\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-1.5 block font-semibold text-[15.5px] text-zinc-950 leading-[1.4] tracking-[-0.005em] dark:text-white\",\"children\":\"Composer's explicit approval gates are the right default.\"}],[\"$\",\"span\",null,{\"className\":\"text-[14.5px] text-zinc-600 leading-[1.6] dark:text-zinc-400\",\"children\":\"Multi-file edits stage as a reviewable diff with explicit accept-per-file controls before anything writes. This is the single biggest reduction in AI-induced regression risk Cursor has shipped — and it should be on by default.\"}]]}]]}],[\"$\",\"li\",\"MCP integration is now competitive, not differentiated.\",{\"className\":\"grid grid-cols-[40px_1fr] gap-4 border-zinc-200 border-b py-5 last:border-b-0 dark:border-zinc-800\",\"children\":[[\"$\",\"span\",null,{\"className\":\"pt-1 font-mono text-[12px] text-ignition tracking-[0.08em]\",\"children\":\"04\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-1.5 block font-semibold text-[15.5px] text-zinc-950 leading-[1.4] tracking-[-0.005em] dark:text-white\",\"children\":\"MCP integration is now competitive, not differentiated.\"}],\"$L7b\"]}]]}],\"$L7c\"]}]]}]\n49:[\"$\",\"h2\",null,{\"className\":\"m-0 mt-14 mb-5 scroll-mt-[90px] font-normal text-[clamp(26px,3vw,36px)] text-zinc-950 leading-[1.15] tracking-[-0.025em] dark:text-white\",\"id\":\"whats-new\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-3.5 block font-medium font-mono text-[11px] text-ignition uppercase tracking-[0.12em]\",\"children\":[\"01\",\" — \",\"What's New\"]}],[\"Cursor 3 ships\",\" \",[\"$\",\"em\",null,{\"className\":\"font-normal font-serif text-ignition-2 italic\",\"children\":\"three\"}],\" \",\"major surfaces.\"]]}]\n7d:T6e7,max-w-[720px] [\u0026_*:where(p,h3,ul)]:text-pretty [\u0026_a.link:hover]:bg-ignition/10 [\u0026_a.link:hover]:text-ignition [\u0026_a.link]:border-ignition [\u0026_a.link]:border-b [\u0026_a.link]:pb-px [\u0026_a.link]:font-medium [\u0026_a.link]:text-zinc-950 [\u0026_a.link]:transition-colors [\u0026_a.link]:dark:text-white [\u0026_code]:rounded-[4px] [\u0026_code]:bg-zinc-100 [\u0026_code]:px-1.5 [\u0026_code]:py-0.5 [\u0026_code]:font-mono [\u0026_code]:text-[0.88em] [\u0026_code]:text-zinc-950 [\u0026_code]:dark:bg-zinc-800 [\u0026_code]:dark:text-white [\u0026_h3]:mt-9 [\u0026_h3]:mb-3.5 [\u0026_h3]:font-medium [\u0026_h3]:text-[22px] [\u0026_h3]:text-zinc-950 [\u0026_h3]:leading-tight [\u0026_h3]:tracking-[-0.015em] [\u0026_h3]:dark:text-white [\u0026_ol:not([class])\u003eli]:mb-2.5 [\u0026_ol:not([class])\u003eli]:pl-[6px] [\u0026_ol:not([class])\u003eli]:text-[16px] [\u0026_ol:not([class])\u003eli]:text-zinc-700 [\u0026_ol:not([class])\u003eli]:leading-[1.6] [\u0026_ol:not([class])\u003eli]:marker:font-medium [\u0026_ol:not([class])\u003eli]:marker:text-ignition [\u0026_ol:not([class])\u003eli]:marker:tabular-nums [\u0026_ol:not([class])\u003eli]:dark:text-zinc-300 [\u0026_ol:not([class])]:mb-6 [\u0026_ol:not([class])]:list-decimal [\u0026_ol:not([class])]:pl-[22px] [\u0026_p.lede]:mb-7 [\u0026_p.lede]:font-normal [\u0026_p.lede]:text-[19px] [\u0026_p.lede]:text-zinc-950 [\u0026_p.lede]:leading-[1.6] [\u0026_p.lede]:dark:text-white [\u0026_p]:mb-5 [\u0026_p]:text-[17px] [\u0026_p]:text-zinc-800 [\u0026_p]:leading-[1.7] [\u0026_p]:dark:text-zinc-200 [\u0026_strong]:font-semibold [\u0026_strong]:text-zinc-950 [\u0026_strong]:dark:text-white [\u0026_ul]:mb-6 [\u0026_ul]:ml-0 [\u0026_ul]:list-none [\u0026_ul]:p-0 [\u0026_ul_li]:relative [\u0026_ul_li]:mb-2.5 [\u0026_ul_li]:pl-[22px] [\u0026_ul_li]:text-[16px] [\u0026_ul_li]:text-zinc-700 [\u0026_ul_li]:leading-[1.6] [\u0026_ul_li]:before:absolute [\u0026_ul_li]:before:top-[11px] [\u0026_ul_li]:before:left-0.5 [\u0026_ul_li]:before:size-1.5 [\u0026_ul_li]:before:rounded-full [\u0026_ul_li]:before:bg-ignition [\u0026_ul_li]:before:content-[''] [\u0026_ul_li]:dark:text-zinc-3004a:[\"$\",\"div\",null,{\"className\":\"$7d\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"The Cursor 3\",\" \",[\"$\",\"a\",null,{\"className\":\"link\",\"href\":\"https://cursor.com/changelog\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":\"changelog\"}],\" \",\"reads like three product launches stapled together. That isn't framing — it's accurate. The parallel Agents panel, the design-driven Composer workflow, and Composer's evolved multi-file diff each represent a distinct interaction model, with distinct affordances and distinct best-fit workloads. Reading the changelog as a single \\\"version bump\\\" misses the architectural intent.\"]}],[\"$\",\"p\",null,{\"children\":\"The unifying theme is that Cursor is no longer trying to be an assistant that lives in your editor. It's trying to be a workspace in which multiple AI agents and one human collaborate on the same project — with surfaces tuned to the different kinds of tasks that workspace needs to support. Code generation, visual design implementation, multi-file refactoring, and ambient background work all get their own room.\"}]]}]\n4b:[\"$\",\"div\",null,{\"className\":\"my-8 flex flex-col gap-4\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"relative flex flex-col gap-5 rounded-2xl border border-zinc-200 bg-white p-6 md:flex-row md:gap-8 md:p-7 dark:border-zinc-800 dark:bg-zinc-900\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4 md:w-[220px] md:shrink-0 md:flex-col md:gap-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-1 flex-col gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-mono text-[10.5px] text-zinc-500 uppercase tracking-[0.12em]\",\"children\":\"Surface 01\"}],[\"$\",\"h5\",null,{\"className\":\"m-0 font-medium text-[18px] text-zinc-950 leading-[1.3] tracking-[-0.01em] dark:text-white\",\"children\":\"Parallel Agents panel\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex items-baseline gap-1 font-light text-[48px] text-zinc-900 leading-none tracking-[-0.03em] md:order-first dark:text-zinc-100\",\"children\":[\"Agents\",\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"hidden w-px self-stretch bg-zinc-200/60 md:block dark:bg-zinc-800/60\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-1 flex-col justify-between gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"m-0 text-[13.5px] text-zinc-600 leading-[1.6] dark:text-zinc-400\",\"children\":\"Run multiple Agents in parallel on different tasks within one project — each with its own working set, model selection, and approval policy. Cloud Agents extend the same primitive to remote machines.\"}],[\"$\",\"div\",null,{\"className\":\"w-full self-start border-zinc-100 border-t pt-2 text-left md:self-end md:text-right dark:border-zinc-800\",\"children\":[\"$\",\"span\",null,{\"className\":\"font-mono text-[10px] text-ignition uppercase tracking-widest\",\"children\":\"Agents · Cloud Agents\"}]}]]}]]}],[\"$\",\"div\",\"1\",{\"className\":\"relative flex flex-col gap-5 rounded-2xl border border-zinc-200 bg-white p-6 md:flex-row md:gap-8 md:p-7 dark:border-zinc-800 dark:bg-zinc-900\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4 md:w-[220px] md:shrink-0 md:flex-col md:gap-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-1 flex-col gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-mono text-[10.5px] text-zinc-500 uppercase tracking-[0.12em]\",\"children\":\"Surface 02\"}],[\"$\",\"h5\",null,{\"className\":\"m-0 font-medium text-[18px] text-zinc-950 leading-[1.3] tracking-[-0.01em] dark:text-white\",\"children\":\"Design-driven Composer workflow\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex items-baseline gap-1 font-light text-[48px] text-zinc-900 leading-none tracking-[-0.03em] md:order-first dark:text-zinc-100\",\"children\":[\"Design\",\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"hidden w-px self-stretch bg-zinc-200/60 md:block dark:bg-zinc-800/60\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-1 flex-col justify-between gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"m-0 text-[13.5px] text-zinc-600 leading-[1.6] dark:text-zinc-400\",\"children\":\"Feed a reference image (Figma export, screenshot, sketch) into Composer, scaffold component code, and iterate against the rendered output. Not a separately branded product — it's Composer wired for design-to-code work.\"}],[\"$\",\"div\",null,{\"className\":\"w-full self-start border-zinc-100 border-t pt-2 text-left md:self-end md:text-right dark:border-zinc-800\",\"children\":[\"$\",\"span\",null,{\"className\":\"font-mono text-[10px] text-ignition uppercase tracking-widest\",\"children\":\"Composer workflow\"}]}]]}]]}],[\"$\",\"div\",\"2\",{\"className\":\"relative flex flex-col gap-5 rounded-2xl border border-zinc-200 bg-white p-6 md:flex-row md:gap-8 md:p-7 dark:border-zinc-800 dark:bg-zinc-900\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4 md:w-[220px] md:shrink-0 md:flex-col md:gap-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-1 flex-col gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-mono text-[10.5px] text-zinc-500 uppercase tracking-[0.12em]\",\"children\":\"Surface 03\"}],\"$L7e\"]}],\"$L7f\"]}],\"$L80\",\"$L81\"]}]]}]\n82:T6e7,max-w-[720px] [\u0026_*:where(p,h3,ul)]:text-pretty [\u0026_a.link:hover]:bg-ignition/10 [\u0026_a.link:hover]:text-ignition [\u0026_a.link]:border-ignition [\u0026_a.link]:border-b [\u0026_a.link]:pb-px [\u0026_a.link]:font-medium [\u0026_a.link]:text-zinc-950 [\u0026_a.link]:transition-colors [\u0026_a.link]:dark:text-white [\u0026_code]:rounded-[4px] [\u0026_code]:bg-zinc-100 [\u0026_code]:px-1.5 [\u0026_code]:py-0.5 [\u0026_code]:font-mono [\u0026_code]:text-[0.88em] [\u0026_code]:text-zinc-950 [\u0026_code]:dark:bg-zinc-800 [\u0026_code]:dark:text-white [\u0026_h3]:mt-9 [\u0026_h3]:mb-3.5 [\u0026_h3]:font-medium [\u0026_h3]:text-[22px] [\u0026_h3]:text-zinc-950 [\u0026_h3]:leading-tight [\u0026_h3]:tracking-[-0.015em] [\u0026_h3]:dark:text-white [\u0026_ol:not([class])\u003eli]:mb-2.5 [\u0026_ol:not([class])\u003eli]:pl-[6px] [\u0026_ol:not([class])\u003eli]:text-[16px] [\u0026_ol:not([class])\u003eli]:text-zinc-700 [\u0026_ol:not([class])\u003eli]:leading-[1.6] [\u0026_ol:not([class])\u003eli]:marker:font-medium [\u0026_ol:not([class])\u003eli]:marker:text-ignition [\u0026_ol:not([class])\u003eli]:marker:tabular-nums [\u0026_ol:not([class])\u003eli]:dark:text-zinc-300 [\u0026_ol:not([class])]:mb-6 [\u0026_ol:not([class])]:list-decimal [\u0026_ol:not([class])]:pl-[22px] [\u0026_p.lede]:mb-7 [\u0026_p.lede]:font-normal [\u0026_p.lede]:text-[19px] [\u0026_p.lede]:text-zinc-950 [\u0026_p.lede]:leading-[1.6] [\u0026_p.lede]:dark:text-white [\u0026_p]:mb-5 [\u0026_p]:text-[17px] [\u0026_p]:text-zinc-800 [\u0026_p]:leading-[1.7] [\u0026_p]:dark:text-zinc-200 [\u0026_strong]:font-semibold [\u0026_strong]:text-zinc-950 [\u0026_strong]:dark:text-white [\u0026_ul]:mb-6 [\u0026_ul]:ml-0 [\u0026_ul]:list-none [\u0026_ul]:p-0 [\u0026_ul_li]:relative [\u0026_ul_li]:mb-2.5 [\u0026_ul_li]:pl-[22px] [\u0026_ul_li]:text-[16px] [\u0026_ul_li]:text-zinc-700 [\u0026_ul_li]:leading-[1.6] [\u0026_ul_li]:before:absolute [\u0026_ul_li]:before:top-[11px] [\u0026_ul_li]:before:left-0.5 [\u0026_ul_li]:before:size-1.5 [\u0026_ul_li]:before:rounded-full [\u0026_ul_li]:before:bg-ignition [\u0026_ul_li]:before:content-[''] [\u0026_ul_li]:dark:text-zinc-3004c:[\"$\",\"div\",null,{\"className\":\"$82\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"Two smaller changes are easy to miss but worth flagging. First, Cursor 3's model picker exposes per-surface defaults — you can route Composer to Claude Sonnet 4.6 while keeping the Agents panel on a mix of Sonnet plus GPT-5.5, with Gemini reserved for long-context retrieval. Second,\",\" \",[\"$\",\"a\",null,{\"className\":\"link\",\"href\":\"https://cursor.com/en-US\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":\"MCP server scoping\"}],\" \",\"can be configured per-agent rather than per-workspace, which lets you give a single agent access to your Linear MCP without exposing it to every other surface.\"]}],[\"$\",\"p\",null,{\"children\":\"Neither of those is headline material on its own. Together with the three big surfaces, they're what makes Cursor 3 feel like a workspace rather than a chat box. The rest of this guide walks each of those surfaces and the workflows they unlock.\"}]]}]\n4d:[\"$\",\"div\",null,{\"className\":\"relative my-7 overflow-hidden rounded-xl bg-[#0a0a0b] px-7 py-5.5 text-white\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute top-0 bottom-0 left-0 w-[3px] bg-ignition\"}],[\"$\",\"span\",null,{\"className\":\"mb-2 block font-mono text-[10.5px] text-ignition-2 uppercase tracking-[0.14em]\",\"children\":\"Release framing\"}],[\"$\",\"div\",null,{\"className\":\"text-[15.5px] text-white leading-[1.6]\",\"children\":[\"Cursor 3 is best read as\",\" \",[\"$\",\"em\",null,{\"className\":\"font-serif text-white italic\",\"children\":\"three working surfaces\"}],\" \",\"shipped in one version: the parallel Agents panel, design-driven Composer scaffolding, and evolved multi-file Composer review. Each addresses a different gap in AI-assisted development, and each wins or loses on different workloads. The right rollout strategy is to introduce them one surface at a time, not all at once.\"]}]]}]\n4e:[\"$\",\"h2\",null,{\"className\":\"m-0 mt-14 mb-5 scroll-mt-[90px] font-normal text-[clamp(26px,3vw,36px)] text-zinc-950 leading-[1.15] tracking-[-0.025em] dark:text-white\",\"id\":\"agents-window\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-3.5 block font-medium font-mono text-[11px] text-ignition uppercase tracking-[0.12em]\",\"children\":[\"02\",\" — \",\"Agents Panel\"]}],[\"Multi-agent\",\" \",[\"$\",\"em\",null,{\"className\":\"font-normal font-serif text-ignition-2 italic\",\"children\":\"parallel\"}],\" \",\"workflows in one IDE.\"]]}]\n83:T6e7,"])</script><script>self.__next_f.push([1,"max-w-[720px] [\u0026_*:where(p,h3,ul)]:text-pretty [\u0026_a.link:hover]:bg-ignition/10 [\u0026_a.link:hover]:text-ignition [\u0026_a.link]:border-ignition [\u0026_a.link]:border-b [\u0026_a.link]:pb-px [\u0026_a.link]:font-medium [\u0026_a.link]:text-zinc-950 [\u0026_a.link]:transition-colors [\u0026_a.link]:dark:text-white [\u0026_code]:rounded-[4px] [\u0026_code]:bg-zinc-100 [\u0026_code]:px-1.5 [\u0026_code]:py-0.5 [\u0026_code]:font-mono [\u0026_code]:text-[0.88em] [\u0026_code]:text-zinc-950 [\u0026_code]:dark:bg-zinc-800 [\u0026_code]:dark:text-white [\u0026_h3]:mt-9 [\u0026_h3]:mb-3.5 [\u0026_h3]:font-medium [\u0026_h3]:text-[22px] [\u0026_h3]:text-zinc-950 [\u0026_h3]:leading-tight [\u0026_h3]:tracking-[-0.015em] [\u0026_h3]:dark:text-white [\u0026_ol:not([class])\u003eli]:mb-2.5 [\u0026_ol:not([class])\u003eli]:pl-[6px] [\u0026_ol:not([class])\u003eli]:text-[16px] [\u0026_ol:not([class])\u003eli]:text-zinc-700 [\u0026_ol:not([class])\u003eli]:leading-[1.6] [\u0026_ol:not([class])\u003eli]:marker:font-medium [\u0026_ol:not([class])\u003eli]:marker:text-ignition [\u0026_ol:not([class])\u003eli]:marker:tabular-nums [\u0026_ol:not([class])\u003eli]:dark:text-zinc-300 [\u0026_ol:not([class])]:mb-6 [\u0026_ol:not([class])]:list-decimal [\u0026_ol:not([class])]:pl-[22px] [\u0026_p.lede]:mb-7 [\u0026_p.lede]:font-normal [\u0026_p.lede]:text-[19px] [\u0026_p.lede]:text-zinc-950 [\u0026_p.lede]:leading-[1.6] [\u0026_p.lede]:dark:text-white [\u0026_p]:mb-5 [\u0026_p]:text-[17px] [\u0026_p]:text-zinc-800 [\u0026_p]:leading-[1.7] [\u0026_p]:dark:text-zinc-200 [\u0026_strong]:font-semibold [\u0026_strong]:text-zinc-950 [\u0026_strong]:dark:text-white [\u0026_ul]:mb-6 [\u0026_ul]:ml-0 [\u0026_ul]:list-none [\u0026_ul]:p-0 [\u0026_ul_li]:relative [\u0026_ul_li]:mb-2.5 [\u0026_ul_li]:pl-[22px] [\u0026_ul_li]:text-[16px] [\u0026_ul_li]:text-zinc-700 [\u0026_ul_li]:leading-[1.6] [\u0026_ul_li]:before:absolute [\u0026_ul_li]:before:top-[11px] [\u0026_ul_li]:before:left-0.5 [\u0026_ul_li]:before:size-1.5 [\u0026_ul_li]:before:rounded-full [\u0026_ul_li]:before:bg-ignition [\u0026_ul_li]:before:content-[''] [\u0026_ul_li]:dark:text-zinc-3004f:[\"$\",\"div\",null,{\"className\":\"$83\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"The parallel\",\" \",[\"$\",\"a\",null,{\"className\":\"link\",\"href\":\"https://cursor.com/en-US\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":\"Agents\"}],\" \",\"panel is the single biggest reason to upgrade. It opens as a sidebar that lists every active agent in the workspace, with status (idle, running, awaiting approval), the file or task scope, and the model selected. Spawning a new agent takes two clicks; the new agent inherits the workspace context but maintains its own conversation, file working set, and tool permissions.\",\" \",[\"$\",\"a\",null,{\"className\":\"link\",\"href\":\"https://cursor.com/en-US\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":\"Cloud Agents\"}],\" \",\"extend the same primitive to remote compute when the work outgrows your local machine.\"]}],[\"$\",\"p\",null,{\"children\":\"What changes in practice is the cadence of work. Instead of one agent doing one task at a time, you can spawn a research agent to audit the codebase while a build agent writes tests against the existing implementation and a review agent watches the diff for regressions. The human role shifts from typing into a single chat to ferrying context between agents and approving the diffs each one produces.\"}]]}]\n50:[\"$\",\"div\",null,{\"className\":\"my-8 flex flex-col gap-4\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"relative flex flex-col gap-5 overflow-hidden rounded-2xl p-6 md:flex-row md:gap-8 md:p-7 border border-white/10 bg-[#0a0a0b] text-white\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"style\":{\"position\":\"absolute\",\"inset\":-1,\"borderRadius\":\"16px\",\"padding\":1,\"background\":\"linear-gradient(135deg,#ff6b1a,transparent 60%)\",\"WebkitMask\":\"linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0)\",\"WebkitMaskComposite\":\"xor\",\"mask\":\"linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0)\",\"maskComposite\":\"exclude\",\"pointerEvents\":\"none\"}}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-3 md:w-[220px] md:shrink-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 font-mono text-[10.5px] uppercase tracking-[0.14em] text-ignition-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"size-1.5 rounded-full bg-current\"}],\"Archetype 01\"]}],[\"$\",\"h5\",null,{\"className\":\"m-0 font-medium text-[22px] leading-[1.2] tracking-[-0.02em] text-white\",\"children\":[\"Research\",\" \",[\"$\",\"em\",null,{\"className\":\"font-normal font-serif text-ignition-2 italic\",\"children\":\"Agent\"}]]}],[\"$\",\"div\",null,{\"className\":\"self-start\",\"children\":[\"$\",\"span\",null,{\"className\":\"inline-block rounded-md px-2.5 py-1.5 font-mono text-[12px] tracking-[-0.01em] bg-ignition/10 text-ignition-2\",\"children\":\"Read-only · long-context model\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"hidden w-px self-stretch bg-zinc-200/60 md:block dark:bg-zinc-800/60\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-1 flex-col justify-between gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"m-0 text-[13.5px] leading-[1.6] text-white/72\",\"children\":\"Audits the codebase, summarizes architecture, finds reuse opportunities, and writes a plan into a docs/ markdown file. No writes outside docs/. Gemini or Claude Sonnet long-context is the natural pick.\"}],[\"$\",\"div\",null,{\"className\":\"self-start pt-1 md:self-end\",\"children\":[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm bg-ignition/10 px-2 py-1 font-mono text-[10px] text-ignition uppercase tracking-[0.12em]\",\"children\":\"Read-only · Gemini / Sonnet\"}]}]]}]]}],[\"$\",\"div\",\"1\",{\"className\":\"relative flex flex-col gap-5 overflow-hidden rounded-2xl p-6 md:flex-row md:gap-8 md:p-7 border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-3 md:w-[220px] md:shrink-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 font-mono text-[10.5px] uppercase tracking-[0.14em] text-zinc-500\",\"children\":[[\"$\",\"span\",null,{\"className\":\"size-1.5 rounded-full bg-current\"}],\"Archetype 02\"]}],[\"$\",\"h5\",null,{\"className\":\"m-0 font-medium text-[22px] leading-[1.2] tracking-[-0.02em] text-zinc-950 dark:text-white\",\"children\":[\"Build\",\" \",[\"$\",\"em\",null,{\"className\":\"font-normal font-serif text-ignition-2 italic\",\"children\":\"Agent\"}]]}],[\"$\",\"div\",null,{\"className\":\"self-start\",\"children\":[\"$\",\"span\",null,{\"className\":\"inline-block rounded-md px-2.5 py-1.5 font-mono text-[12px] tracking-[-0.01em] bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300\",\"children\":\"Composer-backed · explicit gates\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"hidden w-px self-stretch bg-zinc-200/60 md:block dark:bg-zinc-800/60\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-1 flex-col justify-between gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"m-0 text-[13.5px] leading-[1.6] text-zinc-600 dark:text-zinc-400\",\"children\":\"Implements the plan the research agent produced. Stages every multi-file edit as a Composer diff with per-file approval. Claude Sonnet 4.6 is the strong default for this loop.\"}],[\"$\",\"div\",null,{\"className\":\"self-start pt-1 md:self-end\",\"children\":[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm bg-ignition/10 px-2 py-1 font-mono text-[10px] text-ignition uppercase tracking-[0.12em]\",\"children\":\"Writes · Claude Sonnet\"}]}]]}]]}],\"$L84\",\"$L85\"]}]\n86:T6e7,max-w-[720px] [\u0026_*:where(p,h3,ul)]:text-pretty [\u0026_a.link:hover]:bg-ignition/10 [\u0026_a.link:hover]:text-ignition [\u0026_a.link]:border-ignition [\u0026_a.link]:border-b [\u0026_a.link]:pb-px [\u0026_a.link]:font-medium [\u0026_a.link]:text-zinc-950 [\u0026_a.link]:transition-colors [\u0026_a.link]:dark:text-white [\u0026_code]:rounded-[4px] [\u0026_code]:bg-zinc-100 [\u0026_code]:px-1.5 [\u0026_code]:py-0.5 [\u0026_code]:font-mono [\u0026_code]:text-[0.88em] [\u0026_code]:text-zinc-950 [\u0026_code]:dark:bg-zinc-800 [\u0026_code]:dark:text-white [\u0026_h3]:mt-9 [\u0026_h3]:mb-3.5 [\u0026_h3]:font-medium [\u0026_h3]:text-[22px] [\u0026_h3]:text-zinc-950 [\u0026_h3]:leading-tight [\u0026_h3]:tracking-[-0.015em] [\u0026_h3]:dark:text-white [\u0026_ol:not([class])\u003eli]:mb-2.5 [\u0026_ol:not([class])\u003eli]:pl-[6px] [\u0026_ol:not([class])\u003eli]:text-[16px] [\u0026_ol:not([class])\u003eli]:text-zinc-700 [\u0026_ol:not([class])\u003eli]:leading-[1.6] [\u0026_ol:not([class])\u003eli]:marker:font-medium [\u0026_ol:not([class])\u003eli]:marker:text-ignition [\u0026_ol:not([class])\u003eli]:marker:tabular-nums [\u0026_ol:not([class])\u003eli]:dark:text-zinc-300 [\u0026_ol:not([class])]:mb-6 [\u0026_ol:not([class])]:list-decimal [\u0026_ol:not([class])]:pl-[22px] [\u0026_p.lede]:mb-7 [\u0026_p.lede]:font-normal [\u0026_p.lede]:text-[19px] [\u0026_p.lede]:text-zinc-950 [\u0026_p.lede]:leading-[1.6] [\u0026_p.lede]:dark:text-white [\u0026_p]:mb-5 [\u0026_p]:text-[17px] [\u0026_p]:text-zinc-800 [\u0026_p]:leading-[1.7] [\u0026_p]:dark:text-zinc-200 [\u0026_strong]:font-semibold [\u0026_strong]:text-zinc-950 [\u0026_strong]:dark:text-white [\u0026_ul]:mb-6 [\u0026_ul]:ml-0 [\u0026_ul]:list-none [\u0026_ul]:p-0 [\u0026_ul_li]:relative [\u0026_ul_li]:mb-2.5 [\u0026_ul_li]:pl-[22px] [\u0026_ul_li]:text-[16px] [\u0026_ul_li]:text-zinc-700 [\u0026_ul_li]:leading-[1.6] [\u0026_ul_li]:before:absolute [\u0026_ul_li]:before:top-[11px] [\u0026_ul_li]:before:left-0.5 [\u0026_ul_li]:before:size-1.5 [\u0026_ul_li]:before:rounded-full [\u0026_ul_li]:before:bg-ignition [\u0026_ul_li]:before:content-[''] [\u0026_ul_li]:dark:text-zinc-30051:[\"$\",\"div\",null,{\"className\":\"$86\",\"children\":[[\"$\",\"p\",null,{\"children\":\"The four-archetype split above is the pattern that earns its keep in our own work — and it generalizes well. Most teams won't need all four agents running simultaneously, but having the vocabulary to spawn a read-only research or review agent alongside the active build agent is what makes the panel feel different from a chat sidebar. The agents stay live; you switch between them with keyboard shortcuts as fluidly as switching between editor tabs.\"}],[\"$\",\"p\",null,{\"children\":[\"There's a real cost discipline question hiding inside this. Running four parallel agents at once can burn through token budget quickly, especially if the research and review agents are on long-context models. Cursor 3 surfaces per-agent context usage (see the\",\" \",[\"$\",\"a\",null,{\"className\":\"link\",\"href\":\"https://cursor.com/changelog\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":\"Context Usage Breakdown changelog\"}],\"), which is the right primitive — but teams need an explicit rule of thumb. Our working default: never more than two writing agents at once, read-only research and review agents on cheaper models, hard ceilings per agent set in the workspace settings.\"]}]]}]\n52:[\"$\",\"blockquote\",null,{\"className\":\"my-7 border-ignition border-l-[3px] bg-zinc-50 px-6 py-5 font-serif text-[19px] text-zinc-950 italic leading-normal tracking-[-0.005em] dark:bg-zinc-900 dark:text-white\",\"children\":[\"\\\"The Agents panel changes the unit of work from 'one message' to 'one workspace of parallel collaborators'. It's the first AI IDE feature that genuinely reshapes the rhythm of a coding session.\\\"\",[\"$\",\"cite\",null,{\"className\":\"mt-3 block font-medium font-mono text-[11px] text-zinc-500 uppercase not-italic tracking-widest\",\"children\":\"— Cursor 3 hands-on, May 2026\"}]]}]\n53:[\"$\",\"h2\",null,{\"className\":\"m-0 mt-14 mb-5 scroll-mt-[90px] font-normal text-[clamp(26px,3vw,36px)] text-zinc-950 leading-[1.15] tracking-[-0.025em] dark:text-white\",\"id\":\"design-mode\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-3.5 block font-medium font-mono text-[11px] text-ignition uppercase tracking-[0.12em]\",\"children\":[\"03\",\" — \",\"Design-driven Composer\"]}],[\"Image-to-code via\",\" \",[\"$\",\"em\",null,{\"className\":\"font-normal font-serif text-ignition-2 italic\",\"children\":\"Composer\"}],\" \",\"with a tight review loop.\"]]}]\n87:T6e7,max-w-[720px] [\u0026_*:where(p,h3,ul)]:text-pretty [\u0026_a.link:hover]:bg-ignition/10 [\u0026_a.link:hover]:text-ignition [\u0026_a.link]:border-ignition [\u0026_a.link]:border-b [\u0026_a.link]:pb-px [\u0026_a.link]:font-medium [\u0026_a.link]:text-zinc-950 [\u0026_a.link]:transition-colors [\u0026_a.link]:dark:text-white [\u0026_code]:rounded-[4px] [\u0026_code]:bg-zinc-100 [\u0026_code]:px-1.5 [\u0026_code]:py-0.5 [\u0026_code]:font-mono [\u0026_code]:text-[0.88em] [\u0026_code]:text-zinc-950 [\u0026_code]:dark:bg-zinc-800 [\u0026_code]:dark:text-white [\u0026_h3]:mt-9 [\u0026_h3]:mb-3.5 [\u0026_h3]:font-medium [\u0026_h3]:text-[22px] [\u0026_h3]:text-zinc-950 [\u0026_h3]:leading-tight [\u0026_h3]:tracking-[-0.015em] [\u0026_h3]:dark:text-white [\u0026_ol:not([class])\u003eli]:mb-2.5 [\u0026_ol:not([class])\u003eli]:pl-[6px] [\u0026_ol:not([class])\u003eli]:text-[16px] [\u0026_ol:not([class])\u003eli]:text-zinc-700 [\u0026_ol:not([class])\u003eli]:leading-[1.6] [\u0026_ol:not([class])\u003eli]:marker:font-medium [\u0026_ol:not([class])\u003eli]:marker:text-ignition [\u0026_ol:not([class])\u003eli]:marker:tabular-nums [\u0026_ol:not([class])\u003eli]:dark:text-zinc-300 [\u0026_ol:not([class])]:mb-6 [\u0026_ol:not([class])]:list-decimal [\u0026_ol:not([class])]:pl-[22px] [\u0026_p.lede]:mb-7 [\u0026_p.lede]:font-normal [\u0026_p.lede]:text-[19px] [\u0026_p.lede]:text-zinc-950 [\u0026_p.lede]:leading-[1.6] [\u0026_p.lede]:dark:text-white [\u0026_p]:mb-5 [\u0026_p]:text-[17px] [\u0026_p]:text-zinc-800 [\u0026_p]:leading-[1.7] [\u0026_p]:dark:text-zinc-200 [\u0026_strong]:font-semibold [\u0026_strong]:text-zinc-950 [\u0026_strong]:dark:text-white [\u0026_ul]:mb-6 [\u0026_ul]:ml-0 [\u0026_ul]:list-none [\u0026_ul]:p-0 [\u0026_ul_li]:relative [\u0026_ul_li]:mb-2.5 [\u0026_ul_li]:pl-[22px] [\u0026_ul_li]:text-[16px] [\u0026_ul_li]:text-zinc-700 [\u0026_ul_li]:leading-[1.6] [\u0026_ul_li]:before:absolute [\u0026_ul_li]:before:top-[11px] [\u0026_ul_li]:before:left-0.5 [\u0026_ul_li]:before:size-1.5 [\u0026_ul_li]:before:rounded-full [\u0026_ul_li]:before:bg-ignition [\u0026_ul_li]:before:content-[''] [\u0026_ul_li]:dark:text-zinc-30054:[\"$\",\"div\",null,{\"className\":\"$87\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"Cursor does not ship a separately branded design-to-code product on\",\" \",[\"$\",\"a\",null,{\"className\":\"link\",\"href\":\"https://cursor.com/en-US\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":\"cursor.com/features\"}],\" \",\"— the real surface is the design-driven workflow that\",\" \",[\"$\",\"a\",null,{\"className\":\"link\",\"href\":\"https://cursor.com/blog/2-0\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":\"Composer\"}],\" \",\"unlocks when you point it at a reference image. The workflow: drop a reference image into Composer (Figma export, production screenshot, hand sketch), describe the target framework and component library, and Cursor scaffolds the component code. You then iterate prompt by prompt, comparing the rendered output to the reference and pushing back through Composer's diff review surface.\"]}],[\"$\",\"p\",null,{\"children\":[\"The honest framing is that this is excellent for\",\" \",[\"$\",\"strong\",null,{\"children\":\"component scaffolding\"}],\" — getting a Tailwind / Radix / shadcn version of a Figma component from 0% to 70% complete in two minutes, with reasonable layout, semantic markup, and approximate spacing. It is not a replacement for design system discipline or for the last 30% of polish work, which still requires a designer-developer pair conversation.\"]}]]}]\n55:[\"$\",\"div\",null,{\"className\":\"relative my-8 overflow-hidden rounded-2xl bg-[#0a0a0b] p-7 text-white\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"pointer-events-none absolute top-[-30%] right-[-10%] size-[400px] [background:radial-gradient(circle,rgba(255,107,26,0.1),transparent_60%)]\"}],[\"$\",\"div\",null,{\"className\":\"relative mb-4 flex flex-wrap items-baseline justify-between gap-4\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"m-0 font-medium text-[17px] text-white tracking-[-0.01em]\",\"children\":\"Design-driven Composer quality by task class · 5-min scaffolding pass\"}],[\"$\",\"span\",null,{\"className\":\"font-mono text-[10.5px] text-white/50 uppercase tracking-[0.12em]\",\"children\":\"Source: Hands-on review across 20 representative components\"}]]}],[\"$\",\"div\",null,{\"className\":\"relative\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"grid grid-cols-1 items-center gap-3.5 border-whi