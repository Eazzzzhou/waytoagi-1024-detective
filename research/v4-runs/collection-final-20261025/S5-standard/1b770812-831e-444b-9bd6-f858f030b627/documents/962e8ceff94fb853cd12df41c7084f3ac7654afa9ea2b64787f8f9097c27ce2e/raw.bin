<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script>
      // AI 味尺(/aismell、/en/aismell)防闪白:同步读三态主题,在任何 CSS 前给 <html> 打 data-theme + color-scheme。
      // 主站其他页面保持浅色,这里不碰。React 端(sections/aismell/index.tsx)读同一个 key 并保持同步。
      (function () {
        try {
          if (!/^\/(en\/)?aismell(\/|$)/.test(location.pathname)) return;
          var t = localStorage.getItem("aismell:theme");
          if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
          var d = t === "dark" || ((!t || t === "system") && matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.style.colorScheme = d ? "dark" : "light";
          if (d) document.documentElement.style.backgroundColor = "#0d0e11";
        } catch (e) {}
      })();
    </script>
    <script>
      // 主站深浅色防闪白:同步读偏好(src/lib/theme.ts 同一 key),首帧前给 <html> 打 data-mode。AI 味尺页由上面那段接管。
      (function () {
        try {
          if (/^\/(en\/)?aismell(\/|$)/.test(location.pathname)) return;
          var t = localStorage.getItem("agihunt:theme");
          var d = t === "dark" || (t !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.dataset.mode = d ? "dark" : "light";
          document.documentElement.style.colorScheme = d ? "dark" : "light";
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/mark.svg" />
    <link rel="alternate icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <script>
      // iOS Safari 聚焦 <16px 输入框会自动放大整页;maximum-scale=1 只禁这个行为
      // (iOS 10+ 用户双指缩放不受 maximum-scale 限制,可访问性不受影响)。
      // 只对 iOS 加:安卓会因此真的禁掉手动缩放。
      if (/iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1)) {
        document
          .querySelector("meta[name=viewport]")
          .setAttribute("content", "width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover");
      }
    </script>
