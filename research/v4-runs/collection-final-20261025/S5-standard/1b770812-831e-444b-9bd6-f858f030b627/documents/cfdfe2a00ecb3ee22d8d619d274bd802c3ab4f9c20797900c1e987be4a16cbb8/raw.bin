<script>
(function () {
  var prep = window.__CSDN_BLOG_SIDEBAR_PREP__ || {};
  var root = document.getElementById('csdn-blog-sidebar');
  if (!root) {
    return;
  }
  var drawer = !!prep.drawer;
  var collapsed = prep.collapsed !== false;
  var width = drawer ? 0 : (collapsed ? 72 : 256);
  var nodes = root.querySelectorAll('.layout-sidebar-aside, .layout-sidebar-shadow');
  for (var i = 0; i < nodes.length; i++) {
    nodes[i].style.width = width + 'px';
    nodes[i].style.minWidth = width + 'px';
    nodes[i].style.maxWidth = width + 'px';
    nodes[i].style.flex = '0 0 ' + width + 'px';
    nodes[i].style.overflow = width === 0 ? 'hidden' : '';
  }
  root.classList.toggle('is-drawer', drawer);
  root.classList.toggle('is-collapse-mode', !drawer);
  root.classList.toggle('is-collapsed', !drawer && collapsed);
  root.classList.toggle('is-hidden', drawer);
  if (!drawer && collapsed) {
    var menus = root.querySelector('.layout-menus');
    if (menus) {
      menus.classList.add('collapse');
    }
    var items = root.querySelectorAll('.layout-menu-item');
    for (var j = 0; j < items.length; j++) {
      items[j].classList.add('collapse');
    }
    var infos = root.querySelectorAll('.layout-menu-item_info');
    for (var k = 0; k < infos.length; k++) {
      infos[k].classList.add('vertical');
    }
    var footer = root.querySelector('.layout-menus—footer');
    if (footer) {
      footer.style.display = 'none';
    }
  }
  document.documentElement.removeAttribute('data-csdn-sidebar-prep');
  root.style.visibility = 'visible';
})();
</script>
