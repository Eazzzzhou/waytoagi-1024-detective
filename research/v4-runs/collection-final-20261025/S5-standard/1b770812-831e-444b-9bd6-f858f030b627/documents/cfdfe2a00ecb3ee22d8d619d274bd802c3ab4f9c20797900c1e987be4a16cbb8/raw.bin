<style>
/* Layered artwork adapted from the existing VIP skin.
   Internal layers: decorations 1-3, main 4; left cards follow DOM order 1-7,
   brand 8. No document-level overlay or interception of article interactions. */
.csdn-taotoken-motion {
  --tao-ease: cubic-bezier(.22,.68,.22,1);
  --tao-scale: 1;
  position: relative;
  display: block;
  width: 100%;
  height: min(660px, calc(100dvh - 64px)) !important;
  overflow: hidden;
  isolation: isolate;
  cursor: pointer;
  text-decoration: none !important;
  color: #745239;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
  pointer-events: auto;
}
.csdn-taotoken-motion:focus-visible { outline: 2px solid #745239; outline-offset: -3px; }
.csdn-taotoken-motion *, .csdn-taotoken-motion *::before { box-sizing: border-box; }
.csdn-taotoken-motion img { display: block; max-width: none !important; height: auto !important; object-fit: contain !important; border: 0; user-select: none; -webkit-user-drag: none; }
.csdn-taotoken-motion__stage { position: absolute; top: 0; pointer-events: none; }
.csdn-taotoken-motion--left { height: min(860px, calc(100dvh - 64px)) !important; }
.csdn-taotoken-motion--left .csdn-taotoken-motion__stage {
  width: 320px; height: 860px; right: 0;
  transform: scale(var(--tao-scale)); transform-origin: right top;
}
.csdn-taotoken-motion__brand {
  position: absolute; top: 46px; left: 75px; z-index: 8;
  color: #745239;
  display: flex; gap: 8px; align-items: center;
  font: 600 25px/32px Arial, "PingFang SC", sans-serif;
  white-space: nowrap; opacity: .5; transition: opacity 400ms var(--tao-ease);
}
.csdn-taotoken-motion__mark { display: block; width: 26px; height: 26px; flex: 0 0 26px; }
.csdn-taotoken-motion__cards {
  position: absolute; inset: 0; opacity: .49;
  transition: opacity 400ms var(--tao-ease);
  -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 65%, transparent 100%);
  mask-image: linear-gradient(90deg, #000 0%, #000 65%, transparent 100%);
}
.csdn-taotoken-motion__card {
  position: absolute; left: 0; top: 0; width: 280px !important; height: auto;
  transform-origin: 0 0;
  transform: translate(var(--rest-x), var(--rest-y)) rotate(var(--angle));
  transition: transform 420ms var(--tao-ease);
  filter: drop-shadow(-8px 10px 12px rgb(84 52 24 / .08));
}
.csdn-taotoken-motion--left:is(:hover, :focus-visible, .is-preview-active) .csdn-taotoken-motion__card {
  transform: translate(var(--open-x), var(--open-y)) rotate(var(--angle));
}
.csdn-taotoken-motion--left:is(:hover, :focus-visible, .is-preview-active) :is(.csdn-taotoken-motion__cards, .csdn-taotoken-motion__brand) { opacity: 1; }

.csdn-taotoken-motion--right .csdn-taotoken-motion__stage {
  width: 360px; height: 500px; left: 0;
  transform: scale(var(--tao-scale)); transform-origin: left top;
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 100%);
  mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 100%);
}
.csdn-taotoken-motion__title {
  position: absolute; left: 45px; top: 66px; width: 210px !important; height: auto;
  /* Keep the text's left-to-right fade independent of stage size and position. */
  -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / .15) 0%, #000 55%);
  mask-image: linear-gradient(90deg, rgb(0 0 0 / .15) 0%, #000 55%);
  opacity: .3; transform: translate(0, 0) scale(1); transform-origin: 0 50%;
  transition: transform 320ms var(--tao-ease) 160ms, opacity 300ms ease 160ms;
}
.csdn-taotoken-motion__composition { position: absolute; inset: 0; }
.csdn-taotoken-motion__main {
  position: absolute; left: 8px; top: 142px; width: 325px !important; height: auto;
  z-index: 4; opacity: 0;
  transform: translate(-25px, -56px) scale(.2); transform-origin: 30% 35%;
  transition: transform 330ms var(--tao-ease) 160ms, opacity 270ms ease 160ms;
}
.csdn-taotoken-motion__decor {
  position: absolute; inset: 0; opacity: 0;
  transform: scale(.18) rotate(var(--tao-enter-angle, 0deg)); transform-origin: 165px 231px;
  transition: transform 180ms var(--tao-ease), opacity 150ms ease;
}
.csdn-taotoken-motion__decor img { position: absolute; height: auto; }
/* Opposing entrance turns settle back to the original supplied composition. */
.csdn-taotoken-motion__ribbons { z-index: 1; --tao-enter-angle: 7deg; }
.csdn-taotoken-motion__ribbons img { width: 317px !important; left: 2px; top: 105px; }
.csdn-taotoken-motion__prizes { z-index: 2; --tao-enter-angle: -7deg; }
.csdn-taotoken-motion__prizes img { width: 275px !important; left: 37px; top: 64px; }
.csdn-taotoken-motion__tickets { z-index: 3; --tao-enter-angle: 5deg; }
.csdn-taotoken-motion__tickets img { width: 318px !important; left: 23px; top: 135px; }
.csdn-taotoken-motion--right[data-ready="true"]:is(:hover, :focus-visible, .is-preview-active) .csdn-taotoken-motion__title {
  opacity: 0; transform: translate(14px, 30px) scale(.78); transition-delay: 0ms;
}
.csdn-taotoken-motion--right[data-ready="true"]:is(:hover, :focus-visible, .is-preview-active) .csdn-taotoken-motion__main {
  opacity: 1; transform: translate(0, 0) scale(1); transition-delay: 0ms;
}
.csdn-taotoken-motion--right[data-ready="true"]:is(:hover, :focus-visible, .is-preview-active) .csdn-taotoken-motion__decor {
  opacity: 1; transform: scale(1) rotate(0deg);
  transition-duration: 330ms, 190ms; transition-delay: 340ms;
}
/* Embedded-slot adapter. Keep the host's column widths and central article intact. */
html body.has-simple-ad-background-skin:has(.csdn-taotoken-motion) {
  background: linear-gradient(90deg,#f6f2ed 0%,#fcfaf7 28%,#fff 76%) !important;
}
html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) main,
html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .blog-content-box,
html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) #article-header-box {
  background-color: transparent !important;
}
.simple-ad-slot__fixed:has(> .csdn-taotoken-motion) {
  background-image: none !important;
  overflow: hidden !important;
  pointer-events: none;
}
html body .simple-column-page.has-ad-slots #mainBox .simple-ad-slot__fixed:has(> .csdn-taotoken-motion) {
  top: var(--mogrow-skin-toolbar-height, 48px) !important;
}
/* Artwork expansion stays outside the article and its independent action rail. */
html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) {
  max-width: calc(max(45vw, 820px) + 660px);
}
html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .simple-ad-slot-left {
  width: 200px; min-width: 200px; max-width: 200px; flex: 0 0 200px;
}
html body .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-left .simple-ad-slot__fixed:has(> .csdn-taotoken-motion) {
  --tao-left-frame: clamp(200px, calc((100vw - max(45vw, 820px)) / 2 - 196px), 320px);
  width: var(--tao-left-frame) !important;
  margin-left: calc(200px - var(--tao-left-frame)) !important;
}
html body .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-right .simple-ad-slot__fixed:has(> .csdn-taotoken-motion) {
  width: clamp(256px, calc((100vw - max(45vw, 820px)) / 2 - 100px), 400px) !important;
  margin-left: 0 !important;
}
/* Remove legacy side backgrounds only inside this creative. */
html body.has-simple-ad-background-skin .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-right .simple-ad-slot__fixed:has(> .csdn-taotoken-motion) {
  background-color: transparent !important;
}
html body.has-simple-ad-background-skin .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-right .simple-ad-slot__fixed:has(> .csdn-taotoken-motion)::before,
html body.has-simple-ad-background-skin .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-right .simple-ad-slot__fixed:has(> .csdn-taotoken-motion)::after {
  content: none !important;
}
@media (prefers-reduced-motion: reduce) {
  .csdn-taotoken-motion *, .csdn-taotoken-motion *::before {
    transition-duration: 0s !important; transition-delay: 0s !important;
  }
}
/* No hovering required on touch devices. PC background slots are hidden by host
   on mobile; if independently embedded on touch, show the completed composition. */
@media (hover: none) {
  .csdn-taotoken-motion__card { transform: translate(var(--open-x), var(--open-y)) rotate(var(--angle)); }
  .csdn-taotoken-motion__cards, .csdn-taotoken-motion__brand { opacity: 1; }
  .csdn-taotoken-motion--right[data-ready="true"] .csdn-taotoken-motion__title { opacity: 0; }
  .csdn-taotoken-motion--right[data-ready="true"] .csdn-taotoken-motion__main,
  .csdn-taotoken-motion--right[data-ready="true"] .csdn-taotoken-motion__decor { opacity: 1; transform: none; }
}

/* Reserve an independent right column and scale artwork within it. */
@media (max-width: 1599px) {
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) {
    max-width: none; justify-content: flex-start; gap: 24px; padding: 0 12px;
  }
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .simple-ad-slot-left {
    display: none;
  }
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) > main {
    width: auto; min-width: 0; flex: 1 1 0;
  }
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .article-aside-container {
    width: 36px; flex: 0 0 36px;
  }
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .simple-ad-slot-right {
    display: block !important; width: 224px; min-width: 224px; max-width: 224px; flex: 0 0 224px;
  }
  html body .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-right .simple-ad-slot__fixed:has(> .csdn-taotoken-motion) {
    left: auto !important; right: 12px !important; width: 224px !important; margin-left: 0 !important;
  }
}
@media (max-width: 900px) {
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .simple-ad-slot-right { display: none !important; }
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) { gap: 16px; }
}
</style>
<script>
/* Standalone, dependency-free skin. Use instead of, not alongside, the old skin. */
(() => {
  'use strict';
  // All twelve CDN assets are byte-for-byte verified against the lossless originals.
  const assets = {
    "card-deepseek": "https://i-operation.csdnimg.cn/images/6780bb9dd4eb484aae6d026902a7085a.webp",
    "card-kimi": "https://i-operation.csdnimg.cn/images/182f705e09ca456ca7b259e56072f461.webp",
    "card-glm": "https://i-operation.csdnimg.cn/images/335a569346564288bb730b4d21c44e22.webp",
    "card-seedance": "https://i-operation.csdnimg.cn/images/1cf91f268764483fb963d207269993ae.webp",
    "card-qwen": "https://i-operation.csdnimg.cn/images/b351960e75d647b28ee26b8fcc8f2bf7.webp",
    "card-minimax": "https://i-operation.csdnimg.cn/images/7e3dc73b79514d1eb00c85c50f46c200.webp",
    "card-doubao": "https://i-operation.csdnimg.cn/images/9cbb1d0768ee4151ab915fd7dde33ee2.webp",
    "right-main": "https://i-operation.csdnimg.cn/images/4da2ad1333684acd965049252bde100e.webp",
    "right-prizes": "https://i-operation.csdnimg.cn/images/fc0e45eaf47949cbb7cbf3c742d3a3be.webp",
    "right-ribbons": "https://i-operation.csdnimg.cn/images/488bf47c7b0b4cd6b94e98e6f08e1434.webp",
    "right-title": "https://i-operation.csdnimg.cn/images/118adbc7a8844a5b83022ccca40a1417.webp",
    "right-tickets": "https://i-operation.csdnimg.cn/images/c96ae377edea42a5b293dd93acdeacdf.webp"
};
  const asset = name => assets[name];
  // Campaign URL confirmed by the user; preserve channel attribution.
  const target = 'https://taotoken.net/coding-plan?utm_source=blogbackground';
  const cards = [
    ['doubao', 'Doubao-Seed 系列', 96, 150, 48, 130, -22],
    ['minimax', 'minimax', 85, 177, 40, 200, -24],
    ['qwen', 'qwen 系列', 72, 211, 35, 270, -26],
    ['seedance', 'seedance', 60, 254, 32, 340, -28],
    ['glm', 'GLM 系列', 52, 308, 40, 415, -30],
    ['kimi', 'kimi', 48, 378, 45, 490, -32],
    ['deepseek', 'deepseek 系列', 45, 463, 55, 565, -34],
  ];
  function image(name, className, width, height) {
    const img = document.createElement('img');
    img.className = className;
    img.src = asset(name);
    img.alt = '';
    img.width = width;
    img.height = height;
    img.draggable = false;
    img.decoding = 'async';
    return img;
  }
  function mount(host, side) {
    if (host.querySelector('.csdn-taotoken-motion')) return;
    const link = document.createElement('a');
    link.className = `csdn-taotoken-motion csdn-taotoken-motion--${side}`;
    link.href = target;
    link.target = '_blank';
    link.rel = 'noopener';
    link.setAttribute('aria-label', side === 'left'
      ? '了解 TaoToken：Doubao-Seed、minimax、qwen、seedance、GLM、kimi、deepseek（新窗口）'
      : '1024 程序员节 Coding Plan 限时秒杀，查看活动（新窗口）');
    const stage = document.createElement('span');
    stage.className = 'csdn-taotoken-motion__stage';
    stage.setAttribute('aria-hidden', 'true');
    link.append(stage);
    if (side === 'left') {
      const deck = document.createElement('span');
      deck.className = 'csdn-taotoken-motion__cards';
      for (const [id, , x, y, ox, oy, angle] of cards) {
        const card = image(`card-${id}`, 'csdn-taotoken-motion__card', 560, 640);
        card.style.cssText = `--rest-x:${x}px;--rest-y:${y}px;--open-x:${ox}px;--open-y:${oy}px;--angle:${angle}deg`;
        deck.append(card);
      }
      const brand = document.createElement('span');
      brand.className = 'csdn-taotoken-motion__brand';
      // Official TaoToken mark: https://static.taotoken.net/release/taotoken_fe/dist/logo.svg
      const mark = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      mark.setAttribute('viewBox', '0 0 152 145');
      mark.setAttribute('class', 'csdn-taotoken-motion__mark');
      mark.setAttribute('fill', 'currentColor');
      const shapes = [
        'M83 73C83 76.866 79.866 80 76 80C72.134 80 69 76.866 69 73C69 69.134 72.134 66 76 66C79.866 66 83 69.134 83 73Z',
        'M0 83.6813V117L20 97H58.5C60.7091 97 62.5 98.7909 62.5 101V129L38.3135 145H76H113.687L89.5 129V101C89.5 98.7909 91.2909 97 93.5 97H132L152 117V83.6813C152 78.8277 147.713 75.0923 142.905 75.7565L76 85L9.09486 75.7565C4.28697 75.0923 0 78.8277 0 83.6813Z',
        'M76 0H38.3135L62.5 16V44C62.5 46.2091 60.7091 48 58.5 48H20L0 28V61.3187C0 66.1723 4.28697 69.9077 9.09486 69.2435L76 60L142.905 69.2435C147.713 69.9077 152 66.1723 152 61.3187V28L132 48H93.5C91.2909 48 89.5 46.2091 89.5 44V16L113.687 0H76Z'
      ];
      for (const d of shapes) {
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', d);
        mark.append(path);
      }
      brand.append(mark, document.createTextNode('TaoToken'));
      stage.append(deck, brand);
    } else {
      stage.append(image('right-title', 'csdn-taotoken-motion__title', 510, 618));
      const composition = document.createElement('span');
      composition.className = 'csdn-taotoken-motion__composition';
      for (const [id, width, height] of [['ribbons',902,880], ['prizes',775,929], ['tickets',906,498]]) {
        const layer = document.createElement('span');
        layer.className = `csdn-taotoken-motion__decor csdn-taotoken-motion__${id}`;
        layer.append(image(`right-${id}`, '', width, height));
        composition.append(layer);
      }
      composition.append(image('right-main', 'csdn-taotoken-motion__main', 811, 679));
      stage.append(composition);
      // No delayed JS animation jobs: CSS cancels pending transitions on reversal.
      Promise.all(Array.from(stage.querySelectorAll('img'), img => img.decode())).then(() => {
        link.dataset.ready = 'true';
      }).catch(() => {
        link.dataset.ready = 'false'; // Keep text + accessible link if any art fails.
      });
    }
    host.replaceChildren(link);
    const resize = () => {
      const width = link.clientWidth;
      const nominal = side === 'left' ? 320 : 360;
      const maxScale = side === 'left' ? 1 : Math.min(4 / 3, link.clientHeight / 500);
      link.style.setProperty('--tao-scale', (Math.min(maxScale, width / nominal) * 0.94).toFixed(4));
    };
    resize();
    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(resize);
      observer.observe(link);
      const cleanup = () => observer.disconnect();
      window.addEventListener('pagehide', cleanup, { once: true });
      window.addEventListener('pageshow', event => {
        if (event.persisted && link.isConnected) { observer.observe(link); resize(); }
      });
    }
  }
  function mountAll() {
    const left = document.querySelector('[data-taotoken-slot="left"], .simple-ad-slot-left .simple-ad-slot__fixed');
    const right = document.querySelector('[data-taotoken-slot="right"], .simple-ad-slot-right .simple-ad-slot__fixed');
    if (left) mount(left, 'left');
    if (right) mount(right, 'right');
    return Boolean(left && right);
  }
  function init() {
    if (mountAll()) return;
    const observer = new MutationObserver(() => {
      if (mountAll()) { observer.disconnect(); clearTimeout(timeout); }
    });
    observer.observe(document.body, { childList: true, subtree: true });
    const timeout = setTimeout(() => observer.disconnect(), 10000);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
})();
