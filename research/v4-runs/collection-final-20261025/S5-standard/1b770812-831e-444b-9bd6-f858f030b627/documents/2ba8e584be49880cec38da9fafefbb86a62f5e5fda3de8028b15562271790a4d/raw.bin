        'csdn-sidebar-expanded',
        'csdn-sidebar-collapsed',
        'csdn-sidebar-hidden'
      );
      if (drawer) {
        body.classList.add('csdn-sidebar-mode-drawer', 'csdn-sidebar-hidden');
      } else {
        body.classList.add('csdn-sidebar-mode-collapse');
        body.classList.add(collapsed ? 'csdn-sidebar-collapsed' : 'csdn-sidebar-expanded');
      }
    })();
    </script>
