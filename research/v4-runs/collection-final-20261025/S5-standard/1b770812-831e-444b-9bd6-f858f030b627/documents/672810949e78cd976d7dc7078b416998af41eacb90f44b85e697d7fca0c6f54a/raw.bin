              </span>
            </a>`}).join(``):`<p class="search-empty">No matches. Try a tool name or a shorter term.</p>`}function m(e){c.length&&(s=(e+c.length)%c.length,p(),n.querySelector(`.search-hit.is-active`)?.scrollIntoView({block:`nearest`}))}let h;async function g(e){let r=e.trim();if(!r){c=[],s=-1,n.innerHTML=``;return}if(await l(),!a){n.innerHTML=`<p class="search-empty">Search isn't available here (it builds with the site).</p>`;return}let i=await a.search(r),o=await Promise.all(i.results.slice(0,8).map(e=>e.data()));t.value.trim()===r&&(c=o,s=o.length?0:-1,p())}t.addEventListener(`input`,()=>{clearTimeout(h),h=setTimeout(()=>g(t.value),180)}),t.addEventListener(`keydown`,e=>{if(e.key===`ArrowDown`)e.preventDefault(),m(s+1);else if(e.key===`ArrowUp`)e.preventDefault(),m(s-1);else if(e.key===`Enter`){let t=c[s];t&&(e.preventDefault(),window.location.href=t.url)}}),r.forEach(e=>e.addEventListener(`click`,u)),i.forEach(e=>e.addEventListener(`click`,d)),document.addEventListener(`keydown`,t=>{(t.metaKey||t.ctrlKey)&&t.key.toLowerCase()===`k`?(t.preventDefault(),e.hidden?u():d()):t.key===`Escape`&&!e.hidden&&d()})}</script> <button id="theme-toggle" class="theme-toggle" aria-label="Change color theme" type="button" data-state="system" data-astro-cid-l6lhmie6> <svg class="theme-toggle__icon" data-icon="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-astro-cid-l6lhmie6> <rect x="2" y="3" width="20" height="14" rx="2" data-astro-cid-l6lhmie6></rect> <line x1="8" y1="21" x2="16" y2="21" data-astro-cid-l6lhmie6></line> <line x1="12" y1="17" x2="12" y2="21" data-astro-cid-l6lhmie6></line> </svg> <svg class="theme-toggle__icon" data-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-astro-cid-l6lhmie6> <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" data-astro-cid-l6lhmie6></path> </svg> <svg class="theme-toggle__icon" data-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-astro-cid-l6lhmie6> <circle cx="12" cy="12" r="4" data-astro-cid-l6lhmie6></circle> <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" data-astro-cid-l6lhmie6></path> </svg> </button><script type="module">var e=[`system`,`dark`,`light`],t={system:`auto`,dark:`dark`,light:`light`};function n(){let e=localStorage.getItem(`theme`);return e===`dark`||e===`light`?e:`system`}function r(e){return e===`system`?matchMedia(`(prefers-color-scheme: light)`).matches?`light`:`dark`:e}function i(e){e===`system`?localStorage.removeItem(`theme`):localStorage.setItem(`theme`,e),document.documentElement.dataset.theme=r(e);let n=document.getElementById(`theme-toggle`);n&&(n.dataset.state=e,n.setAttribute(`aria-label`,`Theme: ${t[e]}. Click to cycle theme.`))}function a(){i(n());let t=document.getElementById(`theme-toggle`);t&&t.addEventListener(`click`,()=>{let t=n(),r=e[(e.indexOf(t)+1)%e.length];i(r)})}document.addEventListener(`DOMContentLoaded`,a),document.addEventListener(`astro:page-load`,a);</script> </div> </nav> </div> </header> <main id="main-content" data-astro-cid-m66uj5id> <!-- Hero ─────────────────────────────────────────── --><article class="post" data-format="review" data-category="build" data-pagefind-body data-astro-cid-m66uj5id> <header class="post-hero brand-surface" data-astro-cid-m66uj5id> <div class="hero-grid" aria-hidden="true" data-astro-cid-m66uj5id></div> <div class="post-hero__glow" aria-hidden="true" data-astro-cid-m66uj5id></div> <div class="post-hero__inner" data-astro-cid-m66uj5id> <div class="post-hero__meta" data-pagefind-ignore data-astro-cid-m66uj5id> <span class="post-hero__format" data-astro-cid-m66uj5id>Review</span> <span class="post-hero__sep" aria-hidden="true" data-astro-cid-m66uj5id>/</span> <a class="post-hero__category" href="/category/build/" data-astro-cid-m66uj5id>Build</a>  <span class="post-hero__sep" aria-hidden="true" data-astro-cid-m66uj5id>/</span> <a class="post-hero__category" href="/category/build/coding/" data-astro-cid-m66uj5id>Coding</a>  </div> <h1 class="post-hero__title" data-astro-cid-m66uj5id>Cursor review: I paid for 11 months, then cancelled</h1> <p class="post-hero__desc" data-astro-cid-m66uj5id>Cursor review from someone who actually paid: $510.70 across 11 months, a third of it metered usage. What it does well, and what I got wrong about the bill.</p> <div class="post-hero__media" data-astro-cid-m66uj5id> <img class="post-hero__cover" src="/og/cursor-review.webp" alt="Cursor review: I paid for 11 months, then cancelled" width="1200" height="630" loading="eager" decoding="async" data-pagefind-meta="image[src]" data-astro-cid-m66uj5id> </div> <div class="post-hero__rating" data-astro-cid-m66uj5id> <span class="post-rating__stars" style="--rating-pct: 84.00000000000001%" role="img" aria-label="Rated 4.2 out of 5" data-astro-cid-m66uj5id> <span class="post-rating__stars-bg" data-astro-cid-m66uj5id>★★★★★</span> <span class="post-rating__stars-fg" data-astro-cid-m66uj5id>★★★★★</span> </span> <span class="post-rating__num" data-astro-cid-m66uj5id>4.2 / 5</span> <span class="post-rating__label" data-astro-cid-m66uj5id>Power Tool</span> </div> <div class="post-hero__byline" data-astro-cid-m66uj5id> <a class="post-hero__byline-name" href="/author/ryan-parker/" data-astro-cid-m66uj5id>By Ryan Parker</a> <span class="post-hero__sep" aria-hidden="true" data-astro-cid-m66uj5id>·</span> <time class="post-hero__date" datetime="2026-07-28T00:00:00.000Z" data-astro-cid-m66uj5id>2026-07-28</time>  <span class="post-hero__sep" aria-hidden="true" data-astro-cid-m66uj5id>·</span> <span class="post-hero__updated" data-astro-cid-m66uj5id>updated 2026-08-01</span>  </div> </div> </header> <!-- Body ─────────────────────────────────────────── --> <section class="post-body" data-astro-cid-m66uj5id> <div class="post-body__inner" data-astro-cid-m66uj5id> <div class="post-body__prose" data-astro-cid-m66uj5id> <details class="post-toc" data-pagefind-ignore data-astro-cid-m66uj5id> <summary class="post-toc__summary" data-astro-cid-m66uj5id>Contents</summary> <nav class="post-toc__nav" aria-label="Table of contents" data-astro-cid-m66uj5id> <ol class="post-toc__list" data-astro-cid-m66uj5id> <li class="post-toc__item" data-astro-cid-m66uj5id> <a class="post-toc__link" href="#is-cursor-worth-it" data-astro-cid-m66uj5id>Is Cursor worth it?</a> </li><li class="post-toc__item" data-astro-cid-m66uj5id> <a class="post-toc__link" href="#what-does-cursor-actually-do-in-2026" data-astro-cid-m66uj5id>What does Cursor actually do in 2026?</a> </li><li class="post-toc__item" data-astro-cid-m66uj5id> <a class="post-toc__link" href="#how-much-does-cursor-really-cost" data-astro-cid-m66uj5id>How much does Cursor really cost?</a> </li><li class="post-toc__item" data-astro-cid-m66uj5id> <a class="post-toc__link" href="#who-is-cursor-for" data-astro-cid-m66uj5id>Who is Cursor for?</a> </li><li class="post-toc__item" data-astro-cid-m66uj5id> <a class="post-toc__link" href="#the-good" data-astro-cid-m66uj5id>The good</a> </li><li class="post-toc__item" data-astro-cid-m66uj5id> <a class="post-toc__link" href="#the-bad" data-astro-cid-m66uj5id>The bad</a> </li><li class="post-toc__item" data-astro-cid-m66uj5id> <a class="post-toc__link" href="#what-are-the-best-cursor-alternatives" data-astro-cid-m66uj5id>What are the best Cursor alternatives?</a> </li><li class="post-toc__item" data-astro-cid-m66uj5id> <a class="post-toc__link" href="#final-word" data-astro-cid-m66uj5id>Final word</a> </li> </ol> </nav> </details>  
<h2 id="is-cursor-worth-it">Is Cursor worth it?</h2>
<span class="tool-logo" style="--logo-size:96px" data-astro-cid-zijrtw2k> <img src="https://cdn.aialleyway.com/tool-logos/cursor.png" alt="Cursor logo" width="800" height="800" loading="lazy" decoding="async" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" data-astro-cid-zijrtw2k> <span class="tool-logo__fallback" aria-hidden="true" data-astro-cid-zijrtw2k>C</span> </span>
<p>Yes, with one condition: set a spend limit on day one. A flat $20 buys a genuinely good editor, and the metered usage on top is fair but unbounded. I paid Cursor $510.70 across eleven months before cancelling, a third of it metered charges I could have capped and never did, and the editor was never the reason I left.</p>
<p>For how Cursor compares with everything else I have measured, see <a href="/best-ai-for-coding/">the same brief run through seven tools</a>.</p>
<div class="post-cta"><a href="/get-cursor/" target="_blank" rel="nofollow noopener" class="primary-button primary-button--md" data-astro-cid-6f6bgjbe> <span class="primary-button__label" data-astro-cid-6f6bgjbe>Try Cursor free</span> <span class="primary-button__arrow" aria-hidden="true" data-astro-cid-6f6bgjbe>→</span> </a></div>
<p>Where I stand, so you can weigh the rest: I moved from Cursor to <a href="/is-claude-code-worth-it/">Claude Code</a> in January 2026, and we earn referral credits on Claude signups. Every figure below is from my own invoices.</p>
<h2 id="what-does-cursor-actually-do-in-2026">What does Cursor actually do in 2026?</h2>
<p>Open Cursor today and you do not land in a code editor. You land in an agent.</p>
<p><img src="/blog/cursor-review/cursor-agent-home.webp" alt="Cursor's 2026 home screen: an empty agent prompt reading Plan, Build, slash for skills, at for context, with a Composer 2.5 Fast model selector and a Plan New Idea button" loading="lazy" decoding="async" width="1508" height="1150"/></p>
<p>That screenshot is the default view on a current install. A prompt box, a model selector, a “Plan New Idea” button, and a hint that <code>/shell</code> runs terminal commands. No file tree in the centre, no open buffer, no cursor blinking in code.</p>
<p>The 2026 reviews have caught up with this and lead on agents. What has not caught up is Cursor’s reputation, which is still “VS Code with good autocomplete”, and several of the older published reviews describe exactly that product. The centre of gravity has moved from typing alongside an assistant to briefing one, which puts Cursor closer to a terminal agent than most people expect.</p>
<p>The VS Code lineage is still underneath. It remains a fork, so your extensions, keybindings and settings carry over, and that is still the strongest practical argument for choosing it over a tool that asks you to abandon your setup. You can drop back into a normal editor window whenever you want.</p>
<p>What sits on top is now a full agent stack: skills you define, hooks, a plan mode, and Composer as the in-house model alongside frontier models from other labs. The pitch is that you brief work, review a result, and stay in one window while doing it.</p>
<h3 id="the-slash-commands-tell-you-what-it-wants-you-to-do">The slash commands tell you what it wants you to do</h3>
<p>A product’s hint text is an honest signal of where its makers think the value is, and Cursor cycles through several on that empty home screen. <code>/shell</code> runs terminal commands without leaving the window. <code>/plan</code> switches on Plan Mode, described in the app as a way to improve agent execution. <code>/create-skill</code> builds a reusable skill, with the app framing skills as the way you customise Cursor around your own workflows.</p>
<p>None of those are editor features. They are agent-management features, and they are what the product leads with before you have typed anything. Two years ago the equivalent hints would have been about autocomplete.</p>

































<table><thead><tr><th>What the app surfaces</th><th>What it does</th></tr></thead><tbody><tr><td><code>/shell</code></td><td>Runs terminal commands without leaving the window</td></tr><tr><td><code>/plan</code></td><td>Plan Mode, framed as improving agent execution</td></tr><tr><td><code>/create-skill</code></td><td>Builds a reusable skill for your own workflows</td></tr><tr><td><code>@</code></td><td>Pulls specific files or symbols into context</td></tr><tr><td>Shift-Tab twice</td><td>Debug Mode, for reproducing and solving hard bugs</td></tr><tr><td>⌘N</td><td>Starts a new agent</td></tr></tbody></table>
<p>Every row is an instruction for managing an agent. Not one autocomplete or formatting command among the things Cursor advertises on an empty screen. The tiling matters too: the interface assumes you will run several agents at once and want to watch them in parallel.</p>
<h3 id="how-it-gets-context">How it gets context</h3>
<p>The prompt box advertises two symbols, and they carry most of the workflow. <code>@</code> pulls in context, letting you point the agent at specific files, folders, docs or past chats rather than hoping it finds them. <code>/</code> reaches your skills.</p>
<p>This is the meaningful difference from a terminal agent that simply reads whatever it decides it needs. Cursor makes context an explicit act. You choose what goes in. Whether that is a strength depends on your temperament: it is more control and more typing, and it means a badly-scoped prompt is your fault rather than the model’s.</p>
<p>A model selector sits under the prompt, showing Composer 2.5 Fast on my account with a lock icon beside it. On the free tier the better models are visible but gated.</p>
<h3 id="what-the-paid-tiers-actually-add">What the paid tiers actually add</h3>
<p>The <a href="https://cursor.com/pricing">pricing page</a> is specific about the jump from free to paid, and it is mostly about limits rather than capability. Individual buys extended limits on the agent, generous limits for Grok and Composer, access to frontier models, and MCPs, skills and hooks. Cloud agents are included. Bugbot, the agentic code reviewer, arrives on usage-based billing.</p>
<p>That last phrase is the pattern in miniature: a headline feature listed under a $20 plan that the $20 does not cover. It is available to you, and it bills separately.</p>
<p>Teams at $40 per user adds shared context across a team, a marketplace for internal rules and skills, usage analytics, a team-wide privacy mode and SSO. Cursor also states that with privacy mode enabled, code data is not used for training by them or their model providers, which is the answer most people working on client code will want before installing anything.</p>
<h2 id="how-much-does-cursor-really-cost">How much does Cursor really cost?</h2>
<p>The plans are simple. The bill is not. Across eleven months I paid $510.70: $340 in subscription and $170.70 in on-demand charges billed after the fact, on a plan advertised at $20 a month. Here is how that happens.</p>













































<table><thead><tr><th>Plan</th><th>Price</th><th>What you get</th></tr></thead><tbody><tr><td>Hobby</td><td>$0, no card required</td><td>Limited agent requests, access to Composer</td></tr><tr><td>Pro</td><td>$20 / month</td><td>Extended agent limits, frontier models, MCPs, skills, hooks, cloud agents</td></tr><tr><td>Pro Plus</td><td>$60 / month</td><td>The tier Cursor recommends for daily agent users</td></tr><tr><td>Ultra</td><td>$200 / month</td><td>The tier Cursor recommends for agent power users</td></tr><tr><td>Teams Standard</td><td>$40 / user / month</td><td>Team billing, shared context, Bugbot code review, SSO</td></tr><tr><td>Teams Premium</td><td>$120 / user / month</td><td>Higher included usage across the team</td></tr><tr><td>Enterprise</td><td>On request</td><td>Pooled usage, SCIM, audit logs, access controls</td></tr></tbody></table>
<p>Pro, Pro Plus and Ultra sit behind a tier picker inside the Individual card, so the $20 is the only figure on the card itself. All three prices are published in <a href="https://cursor.com/docs/account/pricing">Cursor’s billing docs</a>. Two things the table does not show decide what you actually pay. The first is on-demand usage: <a href="https://cursor.com/pricing">Cursor’s pricing page</a> states that every plan includes a set amount of model usage, and that usage continues past it, billed in arrears. The second is that prices exclude tax, which the same page notes in its FAQ.</p>
<p>Here is my real invoice history, from the month I subscribed to the month I stopped.</p>
<p><img src="/blog/cursor-review/cursor-invoice-history.webp" alt="Cursor invoice history from March 2025 to January 2026 showing flat twenty dollar Cursor Pro charges, then additional token-based usage charges, a Cursor Pro Plus upgrade at sixty dollars, and a final small charge in January 2026" loading="lazy" decoding="async" width="1380" height="1080"/></p>
<p>I subscribed to Cursor Pro at $20 in March 2025. For five months the bill was exactly $20 and I had no complaints. In August, on-demand charges started appearing alongside the subscription. In late October I upgraded to Cursor Pro Plus at $60, hoping a bigger allowance would end the overage. It did not.</p>
<p><img src="/blog/cursor-review/cursor-monthly-cost-cliff.webp" alt="Bar chart of monthly Cursor spend from July to November 2025, rising from twenty dollars in July to a peak of one hundred and fifty-nine dollars in October once the sixty dollar tier and metered usage combined" loading="lazy" decoding="async" width="1920" height="1080"/></p>
<p>October 2025 cost me <strong>$159.22</strong> across four separate charges: $20 for Pro, $60 for the Pro Plus upgrade, and $79.22 of on-demand usage. November came to <strong>$110.00</strong>, of which $50 was usage. Neither month involved unusual work.</p>
<p>Across the full eleven months I paid Cursor <strong>$510.70</strong>. Of that, $340 was subscription and <strong>$170.70 was on-demand billing</strong> charged after the work was done. A third of my total spend was not predictable from the plan price I thought I had bought.</p>
<h3 id="what-you-can-do-about-it">What you can do about it</h3>
<p>The control I needed existed on the plan I was already paying for, and I never used it. Cursor’s <a href="https://cursor.com/help/account-and-billing/spend-limits">spend-limit docs</a> are unambiguous: on Pro, Pro Plus and Ultra you set a monthly cap on on-demand usage from the Spending tab in your dashboard. Not an enterprise feature, not a support ticket. A field I could have filled in during my first week.</p>
<p>That reframes my own story, so I will say it plainly rather than bury it: a meaningful share of my $170.70 is my fault. I assumed the subscription was the cost, did not read the billing docs, and noticed the charges only when the card statement arrived. If you take one thing from this review, make it that field.</p>
<p>The other lever is model choice. The expensive lines on my invoices were the reasoning-heavy models, and the cheaper ones barely registered. Matching model to task is the single biggest thing under your control, and the interface makes it a one-click change.</p>
<h2 id="who-is-cursor-for">Who is Cursor for?</h2>
<ul>
<li><strong>Developers who want AI in an editor they already know.</strong> The VS Code foundation means no migration cost, and that is a real advantage over tools that ask you to change how you work.</li>
<li><strong>People who code moderately and predictably.</strong> My five flat $20 months are the proof this works. If your usage sits inside the allowance, $20 buys a lot.</li>
<li><strong>Teams that want code review built in.</strong> The $40 tier adds Bugbot, shared context and SSO, which is a coherent package rather than a price bump.</li>
<li><strong>People working under a confidentiality obligation.</strong> Cursor states that with privacy mode on, code data is not used for training by them or their model providers, and the team tier can enforce it across everyone rather than trusting each person to tick a box.</li>
<li><strong>Anyone who wants model choice in one place.</strong> Frontier models from several labs behind one subscription is genuinely convenient.</li>
<li><strong>Not for heavy agent users, or anyone who needs a predictable bill.</strong> This is the group I fell into. If you delegate large tasks all day, the meter runs, and you will find out how fast only in arrears.</li>
</ul>
<p>The dividing line is not seniority or language or project size. It is whether your usage is bursty. A steady drip of small edits sits comfortably inside the allowance for $20 a month. A habit of handing over large, multi-file jobs several times a day does not, and no plan on the page reliably contains it.</p>
<p>If the honest description of your situation is that there is no codebase yet, then the category is wrong rather than the plan. An app builder will get you a working prototype faster than any editor will, and <a href="/lovable-review/">Lovable</a> is the one I have put through a measured build.</p>
<p>If you are unsure which side you fall on, the free tier answers it faster than any review can, including <a href="/picks/">the rest of our picks</a>. Use it for a fortnight on real work and watch how quickly you meet the limits. That tells you more about your future bill than the plan cards do.</p>
<h2 id="the-good">The good</h2>
<h3 id="it-was-worth-20-for-five-months-straight">It was worth $20 for five months straight</h3>
<p>The most honest evidence I can give is my own invoice column. March through July 2025 read $20.00, $20.00, $20.00, $20.00, $20.00, with no usage charges attached. During those months Cursor did everything I asked at list price, and I would have told you it was excellent value. That period is why the rating here is not lower.</p>
<p>Five consecutive clean months is not a trial. It is long enough to build habits, ship real work and form a settled opinion, and my settled opinion at the time was that $20 was cheap.</p>
<h3 id="the-vs-code-foundation-removes-the-switching-cost">The VS Code foundation removes the switching cost</h3>
<p>It is a fork, so extensions, themes, keybindings and settings come across intact. Compared with adopting a terminal agent, where you rebuild your habits from scratch, this is the least disruptive way to get serious AI help into an existing workflow. That advantage is structural and no amount of billing frustration takes it away.</p>
<p>Adopting it is a download rather than a migration, with no need to defend a tooling change to colleagues who like their setup. When I left, this was the thing I actually missed.</p>
<h3 id="model-choice-in-one-subscription-is-genuinely-useful">Model choice in one subscription is genuinely useful</h3>
<p>My invoices name the models I was calling: Claude Sonnet and Claude Opus variants, alongside Cursor’s own Composer. Being able to pick a model per task, without holding separate subscriptions, is convenience you notice daily.</p>
<p>It also has a cost benefit if you use it deliberately. Each usage line on my Cursor invoices names its model and its call count, so the per-call cost falls straight out of the arithmetic:</p>



































<table><thead><tr><th>Model on my invoices</th><th>Calls</th><th>Charged</th><th>Per call</th></tr></thead><tbody><tr><td>Sonnet 4</td><td>88</td><td>$2.34</td><td>$0.027</td></tr><tr><td>Sonnet 4 thinking</td><td>371</td><td>$17.16</td><td>$0.046</td></tr><tr><td>Sonnet 4.5 thinking</td><td>510</td><td>$40.69</td><td>$0.080</td></tr><tr><td>Opus 4.5 high-thinking</td><td>15</td><td>$1.27</td><td>$0.085</td></tr></tbody></table>
<p>Three times the cost per call between the cheapest and the dearest, for work that often did not need the difference. Matching model to task is the biggest lever you control, and a tool tied to a single lab cannot offer it at all.</p>
<h3 id="the-free-tier-lets-you-reach-the-real-product">The free tier lets you reach the real product</h3>
<p>Hobby costs nothing and asks for no card, and it gives you limited agent requests plus Composer access rather than a crippled demo. My cancelled account still sits there. Plenty of tools in this category gate the actual experience behind a card; this one does not.</p>
<h3 id="the-agent-stack-is-deeper-than-its-reputation">The agent stack is deeper than its reputation</h3>
<p>Skills, hooks, plan mode, cloud agents and a <code>/shell</code> command add up to something you can shape around your own workflow. If your mental model of Cursor is “VS Code with autocomplete”, it has moved a long way past that.</p>
<p>The tiled agent panes are the detail that gave me most pause about leaving. Being able to run several agents and watch them side by side in a graphical window is something a terminal genuinely does worse, and if parallel delegation is how you work, that interface is a real argument for staying.</p>
<h3 id="team-features-are-a-real-package-not-a-price-bump">Team features are a real package, not a price bump</h3>
<p>At $40 per user the Teams tier adds Bugbot for agentic code review, shared team context, usage analytics and SSO. For a team already standardised on VS Code, that is a coherent step up rather than the usual enterprise tax.</p>
<h2 id="the-bad">The bad</h2>
<h3 id="a-third-of-what-i-paid-cursor-was-not-the-subscription">A third of what I paid Cursor was not the subscription</h3>
<p>Of the $510.70 I paid Cursor across eleven months, $170.70 was on-demand billing. That is 33% of my total spend arriving after the fact, on a product whose headline price is $20. Nothing about it is hidden: the pricing page states that on-demand usage continues after your included amount and is billed in arrears, and the docs set out the rates.</p>
<p>The complaint is about emphasis rather than concealment. The card says $20 in large type and the metering is a sentence in an FAQ, so the number that anchors your expectation is the one least likely to match your invoice.</p>
<p>My Cursor invoice history, March 2025 to January 2026, split between what I agreed to in advance and what arrived afterwards:</p>



























































<table><thead><tr><th>Month</th><th>Subscription</th><th>On-demand</th><th>Total</th></tr></thead><tbody><tr><td>Mar–Jul 2025</td><td>$20.00 each</td><td>none</td><td>$20.00 each</td></tr><tr><td>Aug 2025</td><td>$20.00</td><td>$37.16</td><td>$57.16</td></tr><tr><td>Sep 2025</td><td>$20.00</td><td>$2.29</td><td>$22.29</td></tr><tr><td>Oct 2025</td><td>$80.00</td><td>$79.22</td><td><strong>$159.22</strong></td></tr><tr><td>Nov 2025</td><td>$60.00</td><td>$50.00</td><td><strong>$110.00</strong></td></tr><tr><td>Dec 2025</td><td>$60.00</td><td>$1.27</td><td>$61.27</td></tr><tr><td>Jan 2026</td><td>none</td><td>$0.76</td><td>$0.76</td></tr><tr><td><strong>Eleven months</strong></td><td><strong>$340.00</strong></td><td><strong>$170.70</strong></td><td><strong>$510.70</strong></td></tr></tbody></table>
<p>Read the on-demand column on its own and the pattern is obvious: it is near zero when the work is light and it is the largest line on the invoice when the work is interesting.</p>
<h3 id="the-60-plan-ran-out-in-about-a-week">The $60 plan ran out in about a week</h3>
<p>I upgraded to Pro Plus specifically to stop the overage. The larger allowance was gone in roughly a week of normal work, and the on-demand charges resumed on top of the higher subscription. Paying three times more did not buy predictability, which is the thing I was actually trying to purchase.</p>
<p>That is the moment the product lost me, and it is worth being precise about why. I did not object to paying more for more. I objected to paying three times more and still not knowing what the month would cost. An upgrade that raises the floor without lowering the variance solves the wrong problem.</p>
<h3 id="two-of-my-last-four-months-cost-more-than-100">Two of my last four months cost more than $100</h3>
<p>October 2025: $159.22. November 2025: $110.00. Those are not stories about a runaway script or a mistake, they are ordinary months. When a $20 tool bills $159, the number on the plan card has stopped being useful for budgeting.</p>
<p>October is the clearest example of how the charges arrive. Four separate hits: $20 for the old plan, $40 of usage, $60 for the upgrade, then another $39.22 of usage six days later. No single charge looks alarming. The sum is eight times the advertised price.</p>
<h3 id="metered-api-rates-lose-to-a-flat-cap-once-you-are-heavy">Metered API rates lose to a flat cap once you are heavy</h3>
<p>I assumed for months that Cursor was taking a cut on the Anthropic models my invoices show me calling. It is not. <a href="https://cursor.com/docs/account/pricing">The billing docs</a> are clear that third-party models on individual plans are charged at the model’s API price, and the $0.25 per million token Cursor Token Rate applies only to Teams and Enterprise. I was paying list.</p>
<p>That correction sharpens the real point rather than removing it. Metered API pricing is honest and it is also unbounded, so at high volume you are competing against capped subscriptions from the labs themselves. Being precise about the arithmetic, because it is easy to flatter my own decision here: my two heaviest Cursor months carried $79.22 and $50.00 of metered usage on top of the subscription, for totals of $159.22 and $110.00. Claude Max 5x bills me $110 a month once tax is added. The gap is not that one is cheap and the other expensive. It is that one has a ceiling and the other does not.</p>
<p><img src="/blog/cursor-review/cursor-overage-share.webp" alt="Stat card: 33 percent of everything paid to Cursor was metered usage rather than subscription, from a total of $510.70 across eleven months" loading="lazy" decoding="async" width="1920" height="1080"/></p>
<h3 id="you-carry-the-context-burden">You carry the context burden</h3>
<p>The prompt box makes context an explicit act. <code>@</code> points the agent at files, folders or symbols, which is more control than an agent that decides for itself, and also more work. Every session you are choosing what goes in.</p>
<p>That has a real failure mode: a badly-scoped prompt produces a confidently wrong answer, and the fault is yours rather than the model’s. A terminal agent that reads the repository on its own removes that step and the mistake with it. Which trade you prefer is temperament, but it is the one place where Cursor asks more of you than its rivals do, and it is not a billing complaint.</p>
<h3 id="the-public-rating-is-genuinely-bad">The public rating is genuinely bad</h3>
<p>As of July 2026, Cursor holds <strong>1.6 out of 5 on <a href="https://www.trustpilot.com/review/cursor.com">Trustpilot</a> across 278 ratings</strong>, with the summary citing an unstable interface and frequent changes. Aggregate ratings skew negative for developer tools and this should not be read as the whole picture, but a score that low on that many reviews is not noise either, and billing complaints are a recurring theme in it.</p>
<p>Two things stop that number meaning what it looks like it means. Claude sits at 1.5 across 1,720 ratings on the same platform, so the tool I switched to scores no better. And on <a href="https://www.g2.com/products/cursor/reviews">G2</a>, where reviewers are verified business users, Cursor holds <strong>4.7 out of 5 from 307 reviews</strong>, tying Claude Code’s 4.7 with roughly three times the review volume.</p>

























<table><thead><tr><th>Aggregate</th><th>Cursor</th><th>Claude / Claude Code</th></tr></thead><tbody><tr><td>Trustpilot</td><td>1.6 / 5 from 278</td><td>1.5 / 5 from 1,720</td></tr><tr><td>G2, the coding products</td><td>4.7 / 5 from 307</td><td>4.7 / 5 from 108</td></tr><tr><td>G2, parent product</td><td>—</td><td>4.6 / 5 from 403</td></tr></tbody></table>
<p>The two platforms flatly disagree, and that is the honest summary. Trustpilot skews toward people moved to write by a bill they did not expect, and rates both tools about the same. G2 skews toward people evaluating a tool at work, and rates both coding products identically at 4.7, with Cursor carrying three times the volume. Neither is a reason to buy or skip either one.</p>
<p>It is worth holding that number against the rest of the evidence rather than in place of it. During my own first five months I would have rated Cursor around four out of five without hesitation, and nothing I saw in that period resembles a 1.6. A product can be genuinely good and still collect a wall of angry reviews when the thing people are angry about is the invoice, and that is roughly what the split looks like here.</p>
<h3 id="what-i-got-wrong-and-what-i-am-not-claiming">What I got wrong, and what I am not claiming</h3>
<p>Three criticisms I had drafted did not survive checking Cursor’s own documentation, and cutting them is more useful to you than keeping them. I believed the Pro Plus and Ultra prices were unpublished; they are, at $60 and $200. I believed Cursor took a margin on third-party models; on individual plans it charges the model’s API rate. I believed the plan I bought had been renamed away; “Cursor Pro Plus” at $60 is still exactly that.</p>
<p>The one that stings is the spend limit, because it was available on my plan the whole time and I never opened the Spending tab. A meaningful share of my $170.70 is a documented control I did not use.</p>
<p>The score gap with my <a href="/is-claude-code-worth-it/">whether Claude Code is worth it</a> also invites an inference I want to head off: it is not a judgement that Cursor writes worse code. In eleven months it never produced a wrong-answer failure costly enough that I still remember it. I cannot give you a rigorous capability verdict either, because I did not run the two tools side by side on identical tasks. What I have is eleven months of invoices, and the 4.2 reflects cost behaviour, which is the axis I can actually evidence.</p>
<h2 id="what-are-the-best-cursor-alternatives">What are the best Cursor alternatives?</h2>
<p>If the metered billing is what puts you off, three options are worth a look.</p>
<p><strong><a href="/is-claude-code-worth-it/">Claude Code</a></strong> is where I went, and I put the two side by side in <a href="/claude-code-vs-cursor/">Claude Code vs Cursor</a>. It is a terminal agent rather than an editor, which is a real workflow change, and its own pricing has a two-layer limit system worth understanding first. What it gave me was a ceiling. Its own pricing has its surprises, which I cover there.</p>
<p><strong><a href="/get-codex/" rel="nofollow noopener" target="_blank">Codex</a></strong> is the closest like-for-like if you want an agent without leaving OpenAI’s ecosystem. It is included on every ChatGPT tier from Free upward, with a Go tier at $8 and Plus at $20 below the heavier plans, and it ships a local CLI and IDE extension alongside a cloud sandbox.</p>
<p><strong><a href="/get-antigravity/" rel="nofollow noopener" target="_blank">Antigravity</a></strong> is the low-commitment way to test whether agent-style work suits you, because it costs nothing. Google retired Gemini CLI in June 2026 and moved those users here. I ran a full build on its free tier for the <a href="/google-antigravity-review/">Google Antigravity review</a>.</p>
<p>None of these makes Cursor a bad tool, and two of the three ask you to give up the editor entirely, which is a real cost rather than a footnote. They matter only if unpredictable billing is your specific objection, and if it is not, staying put is the sensible answer.</p>
<h2 id="final-word">Final word</h2>
<p>The short version of this Cursor review: a good editor attached to a pricing model that punishes the people who use it most. For five months it was the best $20 I spent on software, and I would still recommend it at that level without hesitation. The trouble starts precisely when the tool succeeds, because the more work you delegate, the further your bill drifts from the number that sold you the plan.</p>
<p>If you are a moderate user, buy it and enjoy it. If you are heading toward daily agent work, do the arithmetic first, because I did not, and eleven months later I had paid $510.70 for a $20 subscription and moved on.</p>
<p>The version of this review I expected to write was harsher, and checking Cursor’s documentation made it milder twice over. The first seven months are a good tool at a fair price. The last four are a cautionary tale about a meter I could have capped with one field and did not. Both halves are true, and which one you get depends on how much you delegate and whether you read the billing docs before the card statement.</p>

























<table><thead><tr><th>If you</th><th>Then</th></tr></thead><tbody><tr><td>Code moderately, inside the included allowance</td><td>Pro at $20 is good value. Set a limit anyway</td></tr><tr><td>Delegate heavily most days</td><td>Price Pro Plus at $60 or Ultra at $200 properly before assuming $20</td></tr><tr><td>Cannot tolerate a variable bill</td><td>Set the spend limit on day one, or buy a flat-rate tool</td></tr><tr><td>Want to keep the editor you already know</td><td>The VS Code base is the strongest single reason to stay</td></tr></tbody></table>
<p>So set a spend limit on day one, pick cheaper models for routine work, and check the invoice rather than the plan card at the end of month two. Do that and Cursor is a Power Tool many people will be happy with for years. Skip it and you will learn what I did, more expensively.</p>
<div class="post-cta"><a href="/get-cursor/" target="_blank" rel="nofollow noopener" class="primary-button primary-button--md" data-astro-cid-6f6bgjbe> <span class="primary-button__label" data-astro-cid-6f6bgjbe>Try Cursor free</span> <span class="primary-button__arrow" aria-hidden="true" data-astro-cid-6f6bgjbe>→</span> </a></div>  </div> <section class="post-faq" aria-labelledby="post-faq-title" data-astro-cid-m66uj5id> <h2 id="post-faq-title" class="post-faq__title" data-astro-cid-m66uj5id>Frequently asked questions</h2> <div class="post-faq__list" data-astro-cid-m66uj5id> <details class="post-faq__item" data-astro-cid-m66uj5id> <summary class="post-faq__q" data-astro-cid-m66uj5id>Is Cursor worth it?</summary> <p class="post-faq__a" data-astro-cid-m66uj5id>It depends entirely on how hard you push it, which is not the answer the pricing page implies. I paid for Cursor for eleven months and it was good value for five of them, when my bill was a flat $20 and the included allowance covered everything I did. The editor is capable, the model range is wide, and building on VS Code means your extensions and shortcuts come with you.</p><p class="post-faq__a" data-astro-cid-m66uj5id>It stopped being worth it for me when I started running agents seriously. Usage past your included allowance is billed after the fact, and my October 2025 bill came to $159.22 with roughly half of that unplanned.</p><p class="post-faq__a" data-astro-cid-m66uj5id>Across the full eleven months I paid $510.70, of which $170.70 was on-demand billing rather than subscription. If you code moderately, it is a solid $20 tool. If you delegate heavily, price the meter rather than the plan. I score it 4.2 out of 5.</p> </details><details class="post-faq__item" data-astro-cid-m66uj5id> <summary class="post-faq__q" data-astro-cid-m66uj5id>How much does Cursor actually cost?</summary> <p class="post-faq__a" data-astro-cid-m66uj5id>Hobby is free with no card required. The paid individual tiers are Pro at $20 a month, Pro Plus at $60 and Ultra at $200, and teams pay $40 or $120 per user. Only the $20 shows on the pricing card itself, because Pro Plus and Ultra sit behind a tier picker, but all three prices are published in Cursor&#39;s billing docs.</p><p class="post-faq__a" data-astro-cid-m66uj5id>Those are not the numbers on your card if you use agents at volume. Every plan includes a set amount of model usage, and on-demand usage continues past it, billed in arrears at the model&#39;s API rate.</p><p class="post-faq__a" data-astro-cid-m66uj5id>In my case that added $170.70 across eleven months on top of $340 in subscriptions. Prices also exclude tax. You can cap the metered part with a monthly spend limit from the Spending tab, on any paid individual plan, which is the single most useful thing to know before subscribing.</p> </details><details class="post-faq__item" data-astro-cid-m66uj5id> <summary class="post-faq__q" data-astro-cid-m66uj5id>Why did you switch from Cursor to Claude Code?</summary> <p class="post-faq__a" data-astro-cid-m66uj5id>Cost predictability, not capability. When I upgraded to the $60 plan the included allowance ran out in about a week, and metered charges pushed my monthly total past $100 more than once. I had assumed Cursor was taking a margin on the Anthropic models my invoices show me calling, and while writing this review I checked and found that is wrong: individual plans are charged at the model&#39;s API price, with no Cursor markup.</p><p class="post-faq__a" data-astro-cid-m66uj5id>So the honest reason is arithmetic rather than grievance. Metered API pricing is fair and it is also unbounded, and at my volume a capped subscription won. My two heaviest Cursor months totalled $159.22 and $110.00, of which $79.22 and $50.00 were metered; Claude Max 5x bills me $110 including tax, with a hard cap.</p><p class="post-faq__a" data-astro-cid-m66uj5id>I should add that Cursor offers a spend limit on paid individual plans and I never set one, which would have changed the picture. I cancelled and was downgraded to the free tier, where the account still sits.</p> </details><details class="post-faq__item" data-astro-cid-m66uj5id> <summary class="post-faq__q" data-astro-cid-m66uj5id>Is Cursor still just a VS Code fork?</summary> <p class="post-faq__a" data-astro-cid-m66uj5id>Less than it used to be, and this is where most reviews are out of date. Cursor started as a VS Code fork with AI woven into the editor, and most published reviews still describe it that way, leading on tab completion and inline edits.</p><p class="post-faq__a" data-astro-cid-m66uj5id>Open it today and the default screen is an agent prompt reading &#39;Plan, Build, / for skills, @ for context&#39;, with a Composer model selector and a Plan New Idea button. There are skills, hooks, a /shell command and a plan mode.</p><p class="post-faq__a" data-astro-cid-m66uj5id>The VS Code lineage is still there and your extensions still work, but the product&#39;s centre of gravity has moved from typing alongside an assistant to briefing an agent, which puts it much closer to terminal agents than the older reviews suggest.</p> </details><details class="post-faq__item" data-astro-cid-m66uj5id> <summary class="post-faq__q" data-astro-cid-m66uj5id>Is Cursor better than Claude Code?</summary> <p class="post-faq__a" data-astro-cid-m66uj5id>For most people who want AI inside an editor, yes. Cursor keeps you in a VS Code window with your extensions and keybindings intact, shows you changes inline, and starts at $20 against Claude Max&#39;s $100. If you want to watch the work happen rather than review it afterwards, Cursor is the better fit and the cheaper one.</p><p class="post-faq__a" data-astro-cid-m66uj5id>I moved to Claude Code anyway, for one reason: my Cursor bill was metered and unbounded, and at my volume a capped plan won. That is a statement about my usage, not about which tool writes better code. I scored the two head to head in Claude Code vs Cursor, where three axes tie and Cursor takes three of the rest.</p> </details><details class="post-faq__item" data-astro-cid-m66uj5id> <summary class="post-faq__q" data-astro-cid-m66uj5id>What is Cursor&#39;s free plan good for?</summary> <p class="post-faq__a" data-astro-cid-m66uj5id>Evaluating the tool, and not much beyond that. The Hobby tier costs nothing, needs no credit card, and gives you limited agent requests plus access to Composer, which is enough to judge whether the workflow suits you before paying anything.</p><p class="post-faq__a" data-astro-cid-m66uj5id>The limits bite quickly on real work, and the better models carry a lock icon until you upgrade, so you can see what you are missing without being able to use it. Treat it as a genuine trial rather than a permanent home.</p><p class="post-faq__a" data-astro-cid-m66uj5id>That said, it is a more honest free tier than most, because you reach the actual product rather than a crippled demo, and my own cancelled account has sat on it since January without being nagged into resubscribing. If you are trying to work out whether you would blow past the included allowance on a paid plan, a fortnight of real work on Hobby will answer that faster than any pricing page can.</p> </details> </div> </section> <div class="post-share" data-pagefind-ignore data-astro-cid-m66uj5id> <div class="sharebar" data-share-url="https://aialleyway.com/cursor-review/" data-share-title="Cursor review: I paid for 11 months, then cancelled" aria-label="Share this post" data-astro-cid-zd4mq2vi> <span class="sharebar__label" data-astro-cid-zd4mq2vi>Share</span> <div class="sharebar__buttons" data-astro-cid-zd4mq2vi> <a class="sharebar__btn" href="https://twitter.com/intent/tweet?text=Cursor%20review%3A%20I%20paid%20for%2011%20months%2C%20then%20cancelled&amp;url=https%3A%2F%2Faialleyway.com%2Fcursor-review%2F" target="_blank" rel="noopener noreferrer" aria-label="Share on X" data-astro-cid-zd4mq2vi> <svg viewBox="0 0 24 24" width="16" height=