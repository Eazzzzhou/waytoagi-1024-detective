l="noopener noreferrer" aria-label="Share on Reddit" data-astro-cid-zd4mq2vi> <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" data-astro-cid-zd4mq2vi> <path d="M12 0C5.373 0 0 5.373 0 12c0 3.314 1.343 6.314 3.515 8.485l-2.286 2.286C.775 23.225 1.097 24 1.738 24H12c6.627 0 12-5.373 12-12S18.627 0 12 0zm4.388 12.998a1.32 1.32 0 01.027.26c0 2.198-2.563 3.983-5.723 3.983s-5.723-1.785-5.723-3.983c0-.089.01-.176.027-.262a1.32 1.32 0 01-.785-1.206 1.323 1.323 0 012.243-.95 6.485 6.485 0 013.539-1.12l.677-3.184a.277.277 0 01.331-.214l2.246.477a.951.951 0 11-.108.451l-2.012-.427-.608 2.861a6.473 6.473 0 013.492 1.117 1.323 1.323 0 011.847.365 1.32 1.32 0 01-.79 2.073zm-6.737.42a.951.951 0 100-1.903.951.951 0 000 1.903zm4.396-.952a.951.951 0 10-1.903 0 .951.951 0 001.903 0zm-.677 2.531a.276.276 0 00-.39 0c-.48.48-1.397.518-1.666.518-.27 0-1.187-.038-1.666-.518a.277.277 0 00-.39.39c.756.757 2.207.815 2.056.815.15 0 1.6-.058 2.056-.815a.277.277 0 000-.39z" data-astro-cid-zd4mq2vi></path> </svg> </a> <button type="button" class="sharebar__btn sharebar__copy" data-copy aria-label="Copy link" data-astro-cid-zd4mq2vi> <svg class="sharebar__icon-link" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-astro-cid-zd4mq2vi> <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" data-astro-cid-zd4mq2vi></path> <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" data-astro-cid-zd4mq2vi></path> </svg> <svg class="sharebar__icon-check" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-astro-cid-zd4mq2vi> <path d="M20 6 9 17l-5-5" data-astro-cid-zd4mq2vi></path> </svg> <span class="sharebar__copy-text" data-astro-cid-zd4mq2vi>Copy link</span> </button> </div> </div><script type="module">docum