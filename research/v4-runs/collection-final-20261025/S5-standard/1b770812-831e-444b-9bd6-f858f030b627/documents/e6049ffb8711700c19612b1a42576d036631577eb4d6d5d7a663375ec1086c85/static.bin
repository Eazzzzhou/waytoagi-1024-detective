g-gray-200 rounded\"}],[\"$\",\"div\",null,{\"className\":\"h-4 w-5/6 bg-gray-200 rounded\"}],[\"$\",\"div\",null,{\"className\":\"h-4 w-4/6 bg-gray-200 rounded\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"h-32 bg-gray-100 rounded-lg animate-pulse\"}],[\"$\",\"div\",null,{\"className\":\"h-8 w-32 bg-gray-200 rounded\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"h-6 w-32 bg-gray-200 rounded\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-2 gap-4\",\"children\":[[\"$\",\"div\",\"1\",{\"className\":\"h-20 bg-gray-100 rounded-lg animate-pulse\"}],[\"$\",\"div\",\"2\",{\"className\":\"h-20 bg-gray-100 rounded-lg animate-pulse\"}],[\"$\",\"div\",\"3\",{\"className\":\"h-20 bg-gray-100 rounded-lg animate-pulse\"}],[\"$\",\"div\",\"4\",{\"className\":\"h-20 bg-gray-100 rounded-lg animate-pulse\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"h-6 w-24 bg-gray-200 rounded\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"div\",\"1\",{\"className\":\"h-16 bg-gray-100 rounded-lg animate-pulse\"}],[\"$\",\"div\",\"2\",{\"className\":\"h-16 bg-gray-100 rounded-lg animate-pulse\"}],[\"$\",\"div\",\"3\",{\"className\":\"h-16 bg-gray-100 rounded-lg animate-pulse\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"h-6 w-32 bg-gray-200 rounded\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-3 gap-4\",\"children\":[[\"$\",\"div\",\"1\",{\"className\":\"h-48 bg-gray-100 rounded-lg animate-pulse\"}],[\"$\",\"div\",\"2\",{\"className\":\"h-48 bg-gray-100 rounded-lg animate-pulse\"}],[\"$\",\"div\",\"3\",{\"className\":\"h-48 bg-gray-100 rounded-lg animate-pulse\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"h-6 w-20 bg-gray-200 rounded\"}],\"$L2b\"]}],\"$L2c\"]}],\"$L2d\"]}]}],\"$L2e\"]}],\"children\":\"$L2f\"}]\n30:T1433,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@context\":\"https://schema.org\",\"@id\":\"https://opentools.ai/tools/text-to-cad#software\",\"@type\":[\"SoftwareApplication\",\"Product\"],\"name\":\"text-to-cad\",\"description\":\"text-to-cad is an open-source CAD plugin for AI coding agents. It gives Claude Code, Codex, Cursor, Gemini, Grok, OpenCode, Windsurf, Zed, VS Code, and other compatible assistants a practical way to create CAD artifacts from natural-language instructions. The project README says it can generate STEP, GLB, STL, and 3MF files, run design-for-manufacturing checks, create engineering drawings, and connect work to 3D printing, sheet metal, and CNC fabrication services.\\n\\nThe setup paths are concrete. Claude Code users can add the earthtojake marketplace and install the plugin. Codex users can add the same marketplace after upgrading to a recent Codex release. Claude Desktop users can run the cadgen MCP server through uvx, which gives the assistant a local CAD process and viewer flow. The repository also documents Cursor and other clients, so teams can use the tool in the editor or terminal agent they already use instead of moving the whole task to a separate CAD environment.\\n\\nThe value is speed during early hardware and product exploration. A builder can describe a bracket, enclosure, fixture, adapter, or visual mockup, then inspect the generated model before asking the agent for another pass. That does not replace mechanical engineering review, tolerance checks, material selection, regulatory review, or safety validation. It does make the first sketch and handoff faster, especially for software-heavy teams that already live in AI-assisted development workflows.\\n\\ntext-to-cad is strongest when the problem can be described clearly in words and the expected output is a prototype, example, or starting geometry file. It is weaker when the work depends on precise manufacturing tolerances that have not been specified. The README also notes that CAD runtime components may download on first launch, so setup needs a working network connection.\\n\\nPricing is simple: the project is MIT licensed and open source. Users still need their chosen agent, uv or uvx, and any paid model or fabrication services they decide to connect. For OpenTools readers, the important point is that text-to-cad turns agent chat into inspectable CAD files instead of leaving hardware ideas as loose text. It is a focused bridge between coding-agent workflows and physical-product prototyping, with enough documented setup detail to test quickly. The current repository also shows active attention to agent-specific installation notes, which matters because CAD generation only becomes useful when the surrounding assistant can install, call, view, and revise the generated artifacts without a brittle manual handoff during early design reviews.\",\"image\":\"https://imagedelivery.net/FCiXvK7dG4mSm_W_033WNA/8cf46fe7-773c-4ef8-a104-0a3b4ab47a00/Toolpage\",\"url\":\"https://opentools.ai/tools/text-to-cad\",\"applicationCategory\":\"DeveloperApplication\",\"keywords\":\"text-to-cad, text-to-cad review, text-to-cad pricing, text-to-cad alternatives, text-to-cad tutorials, cad, 3d-modeling, agent-tools, claude-code, codex, mcp, 3d-printing, developer-tools, open-source, fabrication\",\"operatingSystem\":\"Web\",\"downloadUrl\":\"https://github.com/earthtojake/text-to-cad\",\"installUrl\":\"https://github.com/earthtojake/text-to-cad\",\"requirements\":\"Web browser\",\"offers\":[{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\",\"name\":\"Open source\",\"availability\":\"https://schema.org/InStock\"}],\"author\":{\"@type\":\"Organization\",\"name\":\"text-to-cad\",\"url\":\"https://github.com/earthtojake/text-to-cad\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"OpenTools\",\"url\":\"https://opentools.ai\"},\"interactionStatistic\":{\"@type\":\"InteractionCounter\",\"interactionType\":\"https://schema.org/LikeAction\",\"userInteractionCount\":0},\"brand\":{\"@type\":\"Brand\",\"name\":\"text-to-cad\"}},{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://opentools.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tools\",\"item\":\"https://opentools.ai/tools\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"text-to-cad\",\"item\":\"https://opentools.ai/tools/text-to-cad\"}]},{\"@type\":\"WebPage\",\"@id\":\"https://opentools.ai/tools/text-to-cad#webpage\",\"url\":\"https://opentools.ai/tools/text-to-cad\",\"name\":\"text-to-cad review, pricing, alternatives, tutorials, and FAQs\",\"description\":\"text-to-cad is an open-source CAD plugin for Claude Code, Codex, Cursor and other agents that creates STEP, STL, GLB and 3MF model files. Setup, use cases\",\"mainEntity\":{\"@id\":\"https://opentools.ai/tools/text-to-cad#software\"},\"dateCreated\":\"2026-10-06T04:38:22.828Z\",\"dateModified\":\"2026-10-06T04:40:10.052Z\",\"hasPart\":[{\"@type\":\"WebPageElement\",\"name\":\"text-to-cad overview\",\"url\":\"https://opentools.ai/tools/text-to-cad#overview\"},{\"@type\":\"WebPageElement\",\"name\":\"text-to-cad pricing\",\"url\":\"https://opentools.ai/tools/text-to-cad#pricing\"},{\"@type\":\"WebPageElement\",\"name\":\"text-to-cad frequently asked questions\",\"url\":\"https://opentools.ai/tools/text-to-cad#faq\"}]}]}29:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$30\"}}]\n31:\"static/chunks/38437-ee93a236b14e7a5e.js\"\n32:\"static/chunks/25009-3f135e692f33042e.js\"\n33:\"static/chunks/88548-c2056af432950b22.js\"\n34:\"static/chunks/59185-94b362ebd9ff1278.js\"\n35:\"static/chunks/84121-cc1ab20896ca7823.js\"\n36:\"static/chunks/21286-f7fa7281e32490da.js\"\n37:\"static/chunks/94988-c62168b40f9e25a3.js\"\n38:\"static/chunks/21673-e8bb8f57cc128eaa.js\"\n39:\"static/chunks/41554-fb3